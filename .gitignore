# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# design reference project (Figma exports + unoptimised PNGs) - not shipped
design/
ceramic-brussels-project.zip
ceramic-brussels-html.zip
# raw typeface packages. Only the two WOFF2 web cuts in public/fonts/ belong in
# the repo; the desktop TTFs the client licensed must not be committed.
font/
*.ttf
*.otf
Noi Grotesk font package.zip

# Local secrets for `wrangler pages dev`. Never commit.
.dev.vars

# Preview route wrappers, generated at build time by src/integrations/preview-routes.mjs
src/preview/

# Written by the Cloudflare adapter on every build (a redirect to dist/server/wrangler.json).
# Pages CI reads it at deploy time and fails when the target is gone; scripts/pages-worker.mjs removes it.
.wrangler/

# Lilanga's static build of the Figma pages (165 MB of PNGs); see docs/design-pages-plan.md
html pages/
