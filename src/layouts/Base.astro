---
import { LOCALES, type LocaleId } from '../lib/locales';
import { useTranslations, localePath } from '../lib/i18n';
import { getSettings, getNavPages, getNavigation, getCurrentEdition, getPartners } from '../lib/queries';
import { resolveNavItem } from '../lib/links';
import { HUBS } from '../lib/hubs';
import { urlFor } from '../sanity/image';
import EditLink from '../components/EditLink.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MenuOverlay from '../components/MenuOverlay.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { categoriesInUse } from '../lib/tracking';
import { VisualEditing } from '@sanity/astro/visual-editing';
import PreviewEditLinks from '../components/PreviewEditLinks.astro';
import { isPreview } from '../lib/previewContext';
import '../styles/design.css';

/**
 * The frame around every page: the design's header (dates mark, wordmark,
 * language switcher, menu button), the slide-in menu, and the footer band.
 * Everything textual comes from Sanity; the lockups are brand artwork.
 *
 * Design by Lilanga (identity, chrome, type system); data wiring by Kamindu.
 */
interface Props {
  lang: LocaleId;
  title: string;
  description?: string;
  /** Path without locale prefix, e.g. "exhibitors" - used for hreflang. */
  path?: string;
  /** Per-locale paths, when slugs differ per language. */
  altPaths?: Partial<Record<LocaleId, string>>;
  noIndex?: boolean;
  /** 'acid' paints the whole page yellow, as the art prize section is;
   *  'dark' knocks it out in black, as the locked VIP tabs are. */
  theme?: 'default' | 'acid' | 'dark';
  /** Alias kept for pages written against the skeleton: 'brand' = 'acid'. */
  tone?: 'default' | 'brand';
  /** Social share image for this page. Falls back to the one in Site settings. */
  image?: any;
  /** Document this page renders, so the Edit button can deep-link to it. */
  editId?: string;
  editType?: string;
}

const {
  lang,
  title,
  description,
  path = '',
  altPaths,
  noIndex,
  theme = 'default',
  tone = 'default',
  image,
  editId,
  editType,
} = Astro.props;
const acid = theme === 'acid' || tone === 'brand';
const dark = theme === 'dark';
// True inside a /preview/ render: drafts, stega-encoded strings, and the
// Studio's editing overlay mounted at the end of the body.
const preview = isPreview();
const t = useTranslations(lang);

const [settings, navPages, navigation, edition, partners] = await Promise.all([
  getSettings(lang),
  getNavPages(lang),
  getNavigation(lang),
  getCurrentEdition(lang),
  getPartners(lang),
]);

const siteName = settings?.siteName ?? 'ceramic brussels';
/** The header's lockup links to the main partner (tier "main") when there is one. */
const mainPartner = partners.find((p: any) => p.tier === 'main') ?? null;
const fullTitle = title === siteName ? siteName : `${title} — ${siteName}`;
const metaDescription = description ?? settings?.defaultSeo?.description ?? settings?.tagline ?? '';

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(localePath(lang, path), site).href;

/**
 * Social share image. Facebook, LinkedIn and WhatsApp all want an absolute URL
 * and refuse to crop, so pin it to the 1200x630 they expect. Falls back to the
 * site-wide image in Site settings, so a page that sets nothing still shares
 * with a picture.
 */
const shareImage = image?.asset ? image : settings?.defaultSeo?.ogImage;
const ogImage = shareImage?.asset
  ? urlFor(shareImage).width(1200).height(630).fit('crop').auto('format').quality(80).url()
  : null;
const ogImageAlt = shareImage?.alt ?? undefined;

const alternates = LOCALES.map((l) => ({
  lang: l.id,
  href: new URL(localePath(l.id, altPaths?.[l.id] ?? path), site).href,
}));

/**
 * The menu comes from Sanity, sub-items included: each item's children become
 * the small line under it in the overlay ("about / laureates / awards / jury").
 * If nobody has filled it in yet, fall back to the hubs plus any standalone
 * page that set a navigation label, so the site is never without a menu.
 */
const editorNav = (navigation?.items ?? [])
  .map((item: any) => {
    const link = resolveNavItem(lang, item);
    if (!link) return null;
    const children = (item.children ?? []).map((c: any) => resolveNavItem(lang, c)).filter(Boolean);
    return { ...link, children, sub: children.length ? children.map((c: any) => c.label).join(' / ') : undefined };
  })
  .filter(Boolean) as { label: string; href: string; external: boolean; sub?: string; children: any[] }[];

/**
 * The menu's own order, which is not the order `hubs.ts` lists the hubs in:
 * the design puts **VIP after partners**, where HUBS has it next to the
 * programme it left. A hub missing from this list still follows, so adding
 * one cannot drop it from the menu. This orders the fallback only - the live
 * menu is the `navigation` document, and the VIP row there is the editor's
 * to add (Setup → Menu and footer).
 */
const MENU_ORDER = ['guest-of-honour', 'art-prize', 'programme', 'partners', 'vip', 'visit', 'about'];
const byMenuOrder = (a: { route: string }, b: { route: string }) => {
  const at = MENU_ORDER.indexOf(a.route);
  const bt = MENU_ORDER.indexOf(b.route);
  return (at < 0 ? MENU_ORDER.length : at) - (bt < 0 ? MENU_ORDER.length : bt);
};

const fallbackNav = [
  { label: t('nav.exhibitors'), href: localePath(lang, 'exhibitors'), external: false, sub: t('nav.sub.exhibitors'), children: [] },
  ...Object.values(HUBS).sort(byMenuOrder).map((hub) => ({
    label: t(hub.title),
    href: localePath(lang, hub.route),
    external: false,
    sub: hub.tabs.filter((tab) => !tab.hidden).map((tab) => t(tab.label)).join(' / '),
    children: [],
  })),
  ...navPages.map((p: any) => ({ label: p.label, href: localePath(lang, p.slug), external: false, children: [] })),
];

const nav = editorNav.length ? editorNav : fallbackNav;

const footerLinks = (navigation?.footerItems ?? [])
  .map((i: any) => resolveNavItem(lang, i))
  .filter(Boolean) as { label: string; href: string; external: boolean }[];

const fallbackFooter = [
  settings?.instagramUrl && { label: t('common.instagram'), href: settings.instagramUrl, external: true },
  settings?.newsletterUrl && { label: t('nav.newsletter'), href: settings.newsletterUrl, external: true },
  settings?.linkedinUrl && { label: t('common.linkedin'), href: settings.linkedinUrl, external: true },
].filter(Boolean) as { label: string; href: string; external: boolean }[];

const footerNav = footerLinks.length ? footerLinks : fallbackFooter;
const copyright = settings?.copyright ?? `© ${siteName}, ${new Date().getFullYear()}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    {(noIndex || preview) && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:locale" content={lang} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
        </>
      )
    }
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="preload" href="/fonts/noi-grotesk-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>

  <body class:list={[{ 'acid-page': acid, 'dark-page': dark }]}>
    <a class="skip" href="#main">{t('common.skip')}</a>

    <Header
      lang={lang}
      siteName={siteName}
      path={path}
      altPaths={altPaths}
      datesMark={edition?.datesMark}
      mainPartner={mainPartner}
    />
    <MenuOverlay lang={lang} items={nav} siteName={siteName} newsletterUrl={settings?.newsletterUrl} />

    <div class="edit-bar">
      <EditLink id="navigation" type="navigation" label="Edit menu" />
      {editId && editType && <EditLink id={editId} type={editType} lang={lang} label="Edit this content" />}
    </div>

    <main id="main">
      <slot />
    </main>

    {/* The cookie banner stays out of Studio previews: editors are not visitors. */}
    <Footer
      siteName={siteName}
      links={footerNav}
      copyright={copyright}
      consentLabel={!preview && categoriesInUse().length > 0 ? t('consent.settings') : undefined}
    />
    {!preview && <CookieConsent lang={lang} />}

    <script>
      // The design's page behaviours, as built (html pages): the trailing
      // arrow of a link becomes a span that slides on hover; key figures
      // count up when they scroll into view; sections and images below the
      // fold fade in. All of it steps aside for prefers-reduced-motion.
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');

      // The pinned header and title band shrink once the page is scrolled.
      // A little hysteresis (72 down, 24 up) keeps the two states from
      // flickering into each other at the threshold.
      let shrunk = false;
      let changedAt = 0;
      let pending = 0;
      const onScroll = () => {
        const y = window.scrollY;
        if (y > 72 && !shrunk) shrunk = true;
        else if (y < 24 && shrunk) shrunk = false;
        else return;
        // One change per transition: a state that has just flipped stays put
        // until the sizes have settled, so a scroll that lands near the
        // threshold cannot chatter between the two. The change is not
        // dropped, only deferred - otherwise letting go inside the window
        // would leave the wrong band size until the next scroll.
        const now = performance.now();
        const wait = 350 - (now - changedAt);
        if (wait > 0) {
          shrunk = !shrunk;
          clearTimeout(pending);
          pending = setTimeout(onScroll, wait);
          return;
        }
        changedAt = now;
        document.body.toggleAttribute('data-scrolled', shrunk);
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      const ARROWS = new Set(['→', '↗', '←']);
      document.querySelectorAll('a').forEach((a) => {
        if (a.querySelector('.link-arrow')) return;
        const walker = document.createTreeWalker(a, NodeFilter.SHOW_TEXT);
        let last: Text | null = null;
        let node: Node | null;
        while ((node = walker.nextNode())) {
          const text = node.nodeValue?.trimEnd();
          if (text && ARROWS.has(text.at(-1) ?? '')) last = node as Text;
        }
        if (!last?.nodeValue) return;
        const m = last.nodeValue.match(/([→↗←])\s*$/);
        if (!m || m.index === undefined) return;
        const span = document.createElement('span');
        span.className = 'link-arrow';
        span.dataset.arrow = m[1];
        span.setAttribute('aria-hidden', 'true');
        span.textContent = m[1];
        last.nodeValue = last.nodeValue.slice(0, m.index).trimEnd();
        last.after(span);
      });

      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      if (!reduced.matches && 'IntersectionObserver' in window && counters.length) {
        const fmt = new Intl.NumberFormat('en-US');
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              io.unobserve(el);
              const target = Number(el.dataset.count ?? 0);
              const suffix = el.dataset.countSuffix ?? '';
              const start = performance.now();
              const finish = () => (el.textContent = `${fmt.format(target)}${suffix}`);
              const tick = (now: number) => {
                if (reduced.matches) return finish();
                const p = Math.min((now - start) / 1350, 1);
                const eased = 1 - (1 - p) ** 3;
                el.textContent = `${fmt.format(Math.round(target * eased))}${suffix}`;
                if (p < 1) requestAnimationFrame(tick);
              };
              el.textContent = `0${suffix}`;
              requestAnimationFrame(tick);
            });
          },
          { threshold: 0.35 },
        );
        counters.forEach((el) => io.observe(el));
        reduced.addEventListener('change', (e) => {
          if (!e.matches) return;
          io.disconnect();
          counters.forEach((el) => {
            el.textContent = `${fmt.format(Number(el.dataset.count ?? 0))}${el.dataset.countSuffix ?? ''}`;
          });
        });
      }

      if (!reduced.matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.removeAttribute('data-reveal-pending');
              io.unobserve(entry.target);
            });
          },
          { threshold: 0, rootMargin: '0px 0px -24px 0px' },
        );
        document.querySelectorAll('main > section, main .content-wrap > div, main .content-wrap > section').forEach((el) => {
          if (el.getBoundingClientRect().top >= innerHeight) {
            el.classList.add('motion-reveal');
            el.setAttribute('data-reveal-pending', '');
            io.observe(el);
          }
        });
        document.querySelectorAll<HTMLImageElement>('main img').forEach((img) => {
          if (img.complete) return;
          img.classList.add('motion-image');
          img.setAttribute('data-image-pending', '');
          const done = () => img.removeAttribute('data-image-pending');
          img.addEventListener('load', done, { once: true });
          img.addEventListener('error', done, { once: true });
          window.setTimeout(done, 4000);
        });
        const settle = () => {
          io.disconnect();
          document.querySelectorAll('[data-reveal-pending], [data-image-pending]').forEach((el) => {
            el.removeAttribute('data-reveal-pending');
            el.removeAttribute('data-image-pending');
          });
        };
        reduced.addEventListener('change', () => reduced.matches && settle());
        addEventListener('beforeprint', settle);
        document.addEventListener('focusin', (e) => {
          (e.target as Element | null)?.closest('[data-reveal-pending]')?.removeAttribute('data-reveal-pending');
        });
      }
    </script>

    {
      preview && (
        <>
          <VisualEditing enabled />
          <PreviewEditLinks />
          {/* Keep navigation inside the preview tree: the pages link to their
              published addresses, which would drop the reader out of drafts. */}
          <script is:inline>
            (function () {
              var LOCALES = ['en', 'fr', 'nl'];
              function rewrite(a) {
                var url;
                try {
                  url = new URL(a.getAttribute('href'), location.href);
                } catch (e) {
                  return;
                }
                if (url.origin !== location.origin) return;
                if (LOCALES.indexOf(url.pathname.split('/')[1]) === -1) return;
                a.setAttribute('href', '/preview' + url.pathname + url.search + url.hash);
              }
              function all() {
                document.querySelectorAll('a[href]').forEach(rewrite);
              }
              all();
              new MutationObserver(all).observe(document.body, { childList: true, subtree: true });
            })();
          </script>
        </>
      )
    }
  </body>
</html>

<style is:global>
  /* Noi Grotesk - the two weights the design uses. These are the licensed cut
     the client supplied (Noi Grotesk Fix, version 2.000), converted to WOFF2
     from the desktop TTFs; the raw package stays out of the repo. It replaced
     the trial cut on 2026-09-09. Same em, ascender, descender and cap height,
     so nothing needed re-measuring - but the advances differ by 1-2%, and the
     trial carried no accents, curly quotes, dashes or arrows at all, so
     everything outside plain ASCII used to fall back to Helvetica. */
  @font-face {
    font-family: 'Noi Grotesk';
    src: url('/fonts/noi-grotesk-400.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Noi Grotesk';
    src: url('/fonts/noi-grotesk-600.woff2') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  /* Black, from the same package: the exhibitor letters' hover and selected
     state (client feedback, 2026-09-16). */
  @font-face {
    font-family: 'Noi Grotesk';
    src: url('/fonts/noi-grotesk-900.woff2') format('woff2');
    font-weight: 900;
    font-style: normal;
    font-display: swap;
  }

  /* The design's look is in src/styles/design.css (Lilanga's build of the
     sixteen design pages: preflight, utilities, header, menu, footer, grid).
     What is left here: the tokens the older components still read, the
     page frame, and the site's own furniture (skip link, edit bar). */
  :root {
    --acid: var(--color-acid, #ffed00);
    --ground: #ffffff;
    --surface: #fafaf9;
    --surface-2: #f0efed;
    --ink: #050505;
    --ink-2: #55534f;
    --ink-3: #8a8781;
    --rule: #e0dedb;
    --accent: #050505;
    --measure: 68ch;
    --shell: 1140px;
    --font: 'Noi Grotesk', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    --brand: var(--acid);
    --paper: #f6f5ec;
  }
  /* The Figma is a light, acid-on-white identity with no dark counterpart, so
     the palette deliberately does not invert. */
  html {
    scroll-behavior: smooth;
  }
  body {
    min-width: 320px;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--ground);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }
  main {
    flex: 1;
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  ::selection {
    background: var(--acid);
    color: var(--ink);
  }
  /* Whole-page acid, used by the art prize section: the design wraps those
     pages in `.yellow-page`, which also flattens the header wash and turns
     the footer band into an acid-to-white gradient. */
  body.acid-page {
    background: var(--acid);
    --band-bg: var(--acid);
  }
  /* The art prize header fades from white at the top into the acid. The
     fine black rule under it (2026-09-16) came off again on 2026-09-23.
     2026-09-24: "a tiny bit more white" - the white holds a little before
     the fade starts, and the acid arrives later. */
  body.acid-page .site-header.acid-wash {
    background: linear-gradient(#fff 0%, #fff 12%, var(--acid) 74%);
  }

  /* design.css hovers every pill to white on black; the stroke follows the
     text colour, so it turned white and drew a white ring round the black
     pill on a coloured page (client feedback, 2026-09-23). It stays black. */
  :where(.pill, .section-head a, .subnav a, [data-filter], .home-quicklinks a, .home-image-cta, .home-final-cta, footer a):hover {
    border-color: #050505 !important;
  }

  /* The underlined arrow links - "more on the fair →", "discover her work →",
     the film's link, the banner's line ("gallery applications are open →"),
     "leave the VIP area →". Underlined at rest, the line close under the
     letters; on hover it wipes out to the right while the arrow slides on
     (client feedback, 2026-09-24: the reverse of the old hover, which drew
     the line in). The line is a background so it can animate and sit
     nearer the baseline than text-decoration puts it. `.u-line` is the
     same line on a span inside the link, for a block whose link is the
     whole band. */
  .arrow-link,
  .u-line {
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-size: 100% 2px;
    /* A little air between the letters and the line (client feedback,
       2026-09-25: they touched). */
    background-position: 100% 100%;
    transition: background-size 0.4s var(--motion-ease, cubic-bezier(0.22, 1, 0.36, 1));
  }
  :is(a, button).arrow-link:is(:hover, :focus-visible),
  a:is(:hover, :focus-visible) > .u-line {
    background-size: 0 2px;
  }
  :is(.arrow-link, .u-line) .link-arrow {
    transition: transform 0.3s var(--motion-ease, cubic-bezier(0.22, 1, 0.36, 1));
    display: inline-block;
  }
  /* The page script trims the space before a typed arrow; put it back. */
  .u-line .link-arrow {
    margin-inline-start: 0.22em;
  }
  :is(a, button).arrow-link:is(:hover, :focus-visible) .link-arrow,
  a:is(:hover, :focus-visible) > .u-line .link-arrow {
    transform: translate(10px);
  }
  @media (prefers-reduced-motion: reduce) {
    .arrow-link,
    .u-line,
    :is(.arrow-link, .u-line) .link-arrow {
      transition: none;
    }
  }

  /* The underlined text links - the email addresses above all: on hover
     the underline fades away and the ↗ slides on, as the homepage's links
     do (client feedback, 2026-09-24). design.css pushed the line down and
     turned it yellow instead. */
  a.text-link {
    text-decoration: underline 1px;
    text-underline-offset: 0.12em;
    text-decoration-color: currentColor;
    transition: text-decoration-color 0.3s var(--motion-ease, ease);
  }
  a.text-link:is(:hover, :focus-visible) {
    text-underline-offset: 0.12em;
    text-decoration-color: transparent;
  }

  /* Links an editor puts in text, everywhere (client feedback, 2026-09-25):
     underlined at rest, and on hover an acid highlight sweeps in behind the
     words - the awards tab's gallery links. On the acid art prize pages the
     highlight is black and the words turn white; on the black VIP pages it
     stays acid, the words black. The arrow links, pills and the contact
     page's addresses keep their own hovers. */
  :where(.rich-text) a:not(.pill, .arrow-link, .text-link),
  a.hl-link {
    --hl: var(--acid);
    --hl-ink: #050505;
    text-decoration: underline 1px;
    text-underline-offset: 0.12em;
    background: linear-gradient(var(--hl), var(--hl)) no-repeat 0 0 / 0 100%;
    transition:
      background-size 0.35s var(--motion-ease, cubic-bezier(0.22, 1, 0.36, 1)),
      color 0.2s;
  }
  :where(.rich-text) a:not(.pill, .arrow-link, .text-link):is(:hover, :focus-visible),
  a.hl-link:is(:hover, :focus-visible) {
    background-size: 100% 100%;
    color: var(--hl-ink);
  }
  body.acid-page :where(.rich-text) a:not(.pill, .arrow-link, .text-link),
  body.acid-page a.hl-link {
    --hl: #050505;
    --hl-ink: #fff;
  }
  @media (prefers-reduced-motion: reduce) {
    :where(.rich-text) a,
    a.hl-link {
      transition: none;
    }
  }

  /* Whole-page black, used by the three locked VIP tabs (Figma VIP frames,
     2026-09-17): the header, the title band, the page and the footer are one
     black field, every mark knocked out white, and the active tab is a white
     chip. The tokens flip rather than each rule being restated, so the
     shared blocks (sections, slideshow, pills, PortableText) come along.

     The brand artwork is black-on-transparent SVG and PNG with no white
     counterpart, so it is inverted in place - it is pure black line work,
     which inverts exactly. A coloured mark would need its own file. */
  body.dark-page {
    background: var(--dark-ground);
    color: #fff;
    --dark-ground: #050505;
    --ground: var(--dark-ground);
    --band-bg: var(--dark-ground);
    --surface: #141414;
    --surface-2: #1c1c1c;
    --ink: #ffffff;
    --ink-2: #c9c7c3;
    --ink-3: #96938e;
    --rule: #ffffff;
    --accent: #ffffff;
  }
  body.dark-page :is(.site-header, footer).acid-wash {
    background: var(--dark-ground);
  }
  body.dark-page .site-header {
    border-bottom: 1px solid #fff;
  }
