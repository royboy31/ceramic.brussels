---
import { LOCALES, type LocaleId } from '../lib/locales';
import { useTranslations, localePath } from '../lib/i18n';
import { getSettings, getNavPages, getNavigation } from '../lib/queries';
import { urlFor } from '../sanity/image';
import EditLink from '../components/EditLink.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MenuOverlay from '../components/MenuOverlay.astro';

interface Props {
  lang: LocaleId;
  title: string;
  description?: string;
  /** Path without locale prefix, e.g. "exhibitors" - used for hreflang. */
  path?: string;
  /** Per-locale paths, when slugs differ per language. */
  altPaths?: Partial<Record<LocaleId, string>>;
  noIndex?: boolean;
  /** 'acid' paints the whole page yellow, as the art prize section is. */
  theme?: 'default' | 'acid';
  /** Social share image for this page. Falls back to the one in Site settings. */
  image?: any;
  /** Document this page renders, so the Edit button can deep-link to it. */
  editId?: string;
  editType?: string;
}

const { lang, title, description, path = '', altPaths, noIndex, theme = 'default', image, editId, editType } =
  Astro.props;
const t = useTranslations(lang);

const [settings, navPages, navigation] = await Promise.all([
  getSettings(lang),
  getNavPages(lang),
  getNavigation(lang),
]);

const siteName = settings?.siteName ?? 'Ceramic Brussels';
const fullTitle = title === siteName ? siteName : `${title} — ${siteName}`;
const metaDescription = description ?? settings?.defaultSeo?.description ?? settings?.tagline ?? '';

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(localePath(lang, path), site).href;

/**
 * Social share image. Facebook, LinkedIn and WhatsApp all want an absolute URL
 * and refuse to crop, so pin it to the 1200x630 they expect rather than passing
 * the original through. Falls back to the site-wide image in Site settings, so
 * a page that sets nothing still shares with a picture.
 */
const shareImage = image?.asset ? image : settings?.defaultSeo?.ogImage;
const ogImage = shareImage?.asset
  ? urlFor(shareImage).width(1200).height(630).fit('crop').auto('format').quality(80).url()
  : null;
const ogImageAlt = shareImage?.alt ?? undefined;

const alternates = LOCALES.map((l) => ({
  lang: l.id,
  href: new URL(localePath(l.id, altPaths?.[l.id] ?? path), site).href,
}));

/** Turn one editor-defined menu item into a label + href. */
function resolveNavItem(item: any) {
  if (!item?.label) return null;

  if (item.kind === 'external') {
    return item.url ? { label: item.label, href: item.url, external: true } : null;
  }
  if (item.kind === 'page') {
    return item.pageSlug ? { label: item.label, href: localePath(lang, item.pageSlug) } : null;
  }
  // 'route', and anything unset, points at a built-in section.
  return { label: item.label, href: localePath(lang, item.route ?? '') };
}

/**
 * The menu comes from Sanity. If nobody has filled it in yet, fall back to
 * every built-in section plus any page that set a navigation label - so the
 * site is never left without a menu.
 */
const editorNav = (navigation?.items ?? []).map(resolveNavItem).filter(Boolean) as {
  label: string;
  href: string;
  external?: boolean;
}[];

const fallbackNav = [
  { label: t('nav.exhibitors'), href: localePath(lang, 'exhibitors') },
  { label: t('nav.artists'), href: localePath(lang, 'artists') },
  { label: t('nav.programme'), href: localePath(lang, 'programme') },
  { label: t('nav.news'), href: localePath(lang, 'news') },
  { label: t('nav.awards'), href: localePath(lang, 'awards') },
  { label: t('nav.partners'), href: localePath(lang, 'partners') },
  { label: t('nav.press'), href: localePath(lang, 'press') },
  { label: t('nav.editions'), href: localePath(lang, 'editions') },
  ...navPages.map((p: any) => ({ label: p.label, href: localePath(lang, p.slug) })),
];

const nav = editorNav.length ? editorNav : fallbackNav;

/**
 * Footer links come from two places - the editable footer menu and the contact
 * details in Site settings - so the same address can legitimately arrive twice
 * (Instagram is in both by default). Merge and de-duplicate by href.
 */
const footerLinks = [
  ...(navigation?.footerItems ?? []).map(resolveNavItem).filter(Boolean),
  settings?.contactEmail && { label: settings.contactEmail, href: `mailto:${settings.contactEmail}` },
  settings?.instagramUrl && { label: 'Instagram', href: settings.instagramUrl },
  settings?.newsletterUrl && { label: 'Newsletter', href: settings.newsletterUrl },
  { label: 'Studio', href: '/studio' },
].filter(Boolean) as { label: string; href: string }[];

const seenHrefs = new Set<string>();
const footerNav = footerLinks.filter((link) => {
  const key = link.href.replace(/\/$/, '').toLowerCase();
  if (seenHrefs.has(key)) return false;
  seenHrefs.add(key);
  return true;
});

const current = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    {noIndex && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:locale" content={lang} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
        </>
      )
    }
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="preload" href="/fonts/noi-grotesk-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>

  <body class={theme === 'acid' ? 'acid-page' : undefined}>
    <a class="skip" href="#main">Skip to content</a>

    <Header lang={lang} siteName={siteName} path={path} altPaths={altPaths} />
    <MenuOverlay lang={lang} items={nav} newsletterUrl={settings?.newsletterUrl} />

    <div class="edit-bar">
      <EditLink id="navigation" type="navigation" label="Edit menu" />
      {editId && editType && <EditLink id={editId} type={editType} lang={lang} label="Edit this content" />}
    </div>

    <main id="main">
      <slot />
    </main>

    <Footer siteName={siteName} links={footerNav} />

  </body>
</html>

<style is:global>
  /* Noi Grotesk - the two weights the design uses. Swap these two files when
     the licensed (non-trial) cut arrives; nothing else needs to change. */
  @font-face {
    font-family: 'Noi Grotesk';
    src: url('/fonts/noi-grotesk-400.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Noi Grotesk';
    src: url('/fonts/noi-grotesk-600.woff2') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --acid: #fff350;
    --ground: #ffffff;
    --surface: #fafaf9;
    --surface-2: #f0efed;
    --ink: #050505;
    --ink-2: #55534f;
    --ink-3: #8a8781;
    --rule: #e0dedb;
    --accent: #050505;
    --measure: 68ch;
    --shell: 1140px;
    --font: 'Noi Grotesk', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  /* The Figma is a light, acid-on-white identity with no dark counterpart, so
     the palette deliberately does not invert. Reinstating dark mode means
     designing it first - see the note in the handover. */

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-width: 320px;
    /* Short pages still push the footer to the bottom, so the page background
       never shows underneath it. */
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--ground);
    color: var(--ink);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  button {
    font: inherit;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  ::selection {
    background: var(--acid);
    color: var(--ink);
  }

  /* Whole-page acid, used by the art prize section. */
  body.acid-page {
    background: var(--acid);
  }

  /* 12-column grid, 30px gutters - the spine of every page in the design. */
  .page-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0 30px;
    padding-inline: 30px;
  }

  @media (max-width: 900px) {
    .page-grid {
      gap: 0 16px;
      padding-inline: 16px;
    }
  }

  @media (max-width: 640px) {
    .page-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0 10px;
      padding-inline: 10px;
    }
  }

  /* Type helpers from the design system. */
  .display {
    letter-spacing: -0.052em;
    line-height: 0.92;
  }
  .eyebrow {
    font-size: clamp(0.72rem, 1vw, 1rem);
    text-transform: uppercase;
  }
  .text-link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }
  .rule {
    border-top: 1px solid currentColor;
  }

  .shell {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 50;
    background: var(--ink);
    color: var(--ground);
    padding: 0.5rem 0.9rem;
  }

  .edit-bar {
    display: flex;
    justify-content: flex-end;
    padding-inline: 30px;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }
  .edit-bar:empty {
    display: none;
  }

  /* content primitives - still used by the pages that are not ported yet */
  main {
    flex: 1;
    padding: 0 30px 4rem;
  }

  @media (max-width: 900px) {
    main {
      padding-inline: 16px;
    }
  }

  @media (max-width: 640px) {
    main {
      padding-inline: 10px;
    }
  }

  /* main already carries the gutter, so a grid inside it must not add another. */
  main .page-grid {
    padding-inline: 0;
  }
  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin: 0 0 0.5rem;
    text-wrap: balance;
  }
  h2 {
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    margin: 2.5rem 0 0.8rem;
  }
  h3 {
    font-size: 1.05rem;
    margin: 1.6rem 0 0.4rem;
  }
  p {
    margin: 0 0 1rem;
  }

  .lede {
    color: var(--ink-2);
    font-size: 1.05rem;
    max-width: var(--measure);
  }
  .prose {
    max-width: var(--measure);
  }
  .meta {
    color: var(--ink-3);
    font-size: 0.85rem;
  }
  .empty {
    background: var(--surface);
    border: 1px dashed var(--rule);
    padding: 1.5rem;
    color: var(--ink-2);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.6rem 1.4rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }

  .card a.card-link {
    color: inherit;
    text-decoration: none;
  }
  .card h3 {
    margin: 0.6rem 0 0.15rem;
    font-size: 1rem;
  }
  .card a.card-link:hover h3 {
    text-decoration: underline;
  }

  .pill {
    display: inline-block;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.15rem 0.9rem;
    font-size: 0.9rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.88rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.5rem;
    margin-top: 3rem;
  }
</style>
