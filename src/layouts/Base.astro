---
import { LOCALES, type LocaleId } from '../lib/locales';
import { useTranslations, localePath, formatDateRange } from '../lib/i18n';
import { getSettings, getNavPages, getNavigation, getCurrentEdition } from '../lib/queries';
import { resolveNavItem } from '../lib/links';
import { HUBS } from '../lib/hubs';
import EditLink from '../components/EditLink.astro';
import SanityImage from '../components/SanityImage.astro';

/**
 * The frame around every page, laid out as in the design: a header with the
 * dates mark, the wordmark, the language switcher and a hamburger that opens
 * the menu overlay; a footer with the copyright line and the social pills.
 * Skeleton styling only - the tokens below are the place to restyle it.
 */
interface Props {
  lang: LocaleId;
  title: string;
  description?: string;
  /** Path without locale prefix, e.g. "exhibitors" - used for hreflang. */
  path?: string;
  /** Per-locale paths, when slugs differ per language. */
  altPaths?: Partial<Record<LocaleId, string>>;
  noIndex?: boolean;
  /** Document this page renders, so the Edit button can deep-link to it. */
  editId?: string;
  editType?: string;
  /** Yellow page background, as on the art-prize pages. */
  tone?: 'default' | 'brand';
}

const { lang, title, description, path = '', altPaths, noIndex, editId, editType, tone = 'default' } = Astro.props;
const t = useTranslations(lang);

const [settings, navPages, navigation, edition] = await Promise.all([
  getSettings(lang),
  getNavPages(lang),
  getNavigation(lang),
  getCurrentEdition(lang),
]);

const siteName = settings?.siteName ?? 'ceramic brussels';
const fullTitle = title === siteName ? siteName : `${title} — ${siteName}`;
const metaDescription = description ?? settings?.defaultSeo?.description ?? settings?.tagline ?? '';

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(localePath(lang, path), site).href;

const alternates = LOCALES.map((l) => ({
  lang: l.id,
  href: new URL(localePath(l.id, altPaths?.[l.id] ?? path), site).href,
}));

/**
 * The menu comes from Sanity, sub-items included. If nobody has filled it in
 * yet, fall back to the hubs plus any standalone page that set a navigation
 * label - so the site is never left without a menu.
 */
const editorNav = (navigation?.items ?? [])
  .map((item: any) => {
    const link = resolveNavItem(lang, item);
    if (!link) return null;
    const children = (item.children ?? []).map((c: any) => resolveNavItem(lang, c)).filter(Boolean);
    return { ...link, children };
  })
  .filter(Boolean) as { label: string; href: string; external: boolean; children: any[] }[];

const fallbackNav = [
  { label: t('nav.exhibitors'), href: localePath(lang, 'exhibitors'), external: false, children: [] },
  ...Object.values(HUBS).map((hub) => ({
    label: t(hub.title),
    href: localePath(lang, hub.route),
    external: false,
    children: [],
  })),
  { label: t('nav.news'), href: localePath(lang, 'news'), external: false, children: [] },
  ...navPages.map((p: any) => ({ label: p.label, href: localePath(lang, p.slug), external: false, children: [] })),
];

const nav = editorNav.length ? editorNav : fallbackNav;

const footerLinks = [
  ...(navigation?.footerItems ?? []).map((i: any) => resolveNavItem(lang, i)).filter(Boolean),
].filter(Boolean) as { label: string; href: string; external: boolean }[];

const fallbackFooter = [
  settings?.instagramUrl && { label: t('common.instagram'), href: settings.instagramUrl, external: true },
  settings?.newsletterUrl && { label: t('nav.newsletter'), href: settings.newsletterUrl, external: true },
  settings?.linkedinUrl && { label: t('common.linkedin'), href: settings.linkedinUrl, external: true },
].filter(Boolean) as { label: string; href: string; external: boolean }[];

const footerNav = footerLinks.length ? footerLinks : fallbackFooter;
const copyright = settings?.copyright ?? `© ${siteName}, ${new Date().getFullYear()}`;

const current = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => current === href || (href !== localePath(lang) && current.startsWith(href + '/'));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    {noIndex && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}

    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>

  <body data-tone={tone}>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="dates" href={localePath(lang, 'visit')}>
          {
            edition?.datesMark?.asset ? (
              <SanityImage image={edition.datesMark} widths={[300, 600]} sizes="300px" loading="eager" />
            ) : edition ? (
              <span>{formatDateRange(edition.startDate, edition.endDate, lang)}</span>
            ) : null
          }
        </a>

        <a class="brand" href={localePath(lang)}>{siteName}</a>

        <div class="header-right">
          <nav class="locales" aria-label={t('common.language')}>
            {
              LOCALES.map((l, i) => (
                <>
                  {i > 0 && <span aria-hidden="true">/</span>}
                  <a
                    href={localePath(l.id, altPaths?.[l.id] ?? path)}
                    hreflang={l.id}
                    aria-current={l.id === lang ? 'true' : undefined}
                  >
                    {l.id}
                  </a>
                </>
              ))
            }
          </nav>

          <details class="menu">
            <summary aria-label={t('nav.menu')}>
              <span class="burger" aria-hidden="true"></span>
            </summary>
            <nav class="menu-panel" aria-label="Main">
              <ul>
                {
                  nav.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        aria-current={isCurrent(item.href) ? 'page' : undefined}
                        {...(item.external ? { rel: 'noopener noreferrer' } : {})}
                      >
                        {item.label}
                      </a>
                      {item.children?.length > 0 && (
                        <p class="sub">
                          {item.children.map((c: any, i: number) => (
                            <>
                              {i > 0 && ' / '}
                              <a href={c.href}>{c.label}</a>
                            </>
                          ))}
                        </p>
                      )}
                    </li>
                  ))
                }
                {
                  settings?.newsletterUrl && (
                    <li class="newsletter">
                      <a href={settings.newsletterUrl} rel="noopener noreferrer">
                        → {t('nav.newsletter')}
                      </a>
                    </li>
                  )
                }
              </ul>
              <EditLink id="navigation" type="navigation" label="Edit menu" />
            </nav>
          </details>
        </div>
      </div>
    </header>

    {
      editId && editType && (
        <div class="edit-bar shell">
          <EditLink id={editId} type={editType} lang={lang} label="Edit this content" />
        </div>
      )
    }

    <main id="main" class="shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <p class="copyright">{copyright}</p>
        <div class="footer-links">
          {
            footerNav.map((item) => (
              <a href={item.href} {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                {item.label}
              </a>
            ))
          }
          <a class="studio" href="/studio">Studio</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ground: #ffffff;
    --surface: #fafaf9;
    --surface-2: #f0efed;
    --ink: #1a1a19;
    --ink-2: #55534f;
    --ink-3: #8a8781;
    --rule: #e0dedb;
    --accent: #1a1a19;
    --brand: #fff350;
    --measure: 68ch;
    --shell: 1380px;
    --font: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --ground: #121211;
      --surface: #1a1a19;
      --surface-2: #232322;
      --ink: #ececea;
      --ink-2: #a8a5a0;
      --ink-3: #7a7772;
      --rule: #2e2e2c;
      --accent: #ececea;
      --brand: #d9ce2a;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  body[data-tone='brand'] {
    background: var(--brand);
  }

  .shell {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 10;
    background: var(--ink);
    color: var(--ground);
    padding: 0.5rem 0.9rem;
  }

  a {
    color: var(--accent);
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* header */
  .site-header {
    background: linear-gradient(var(--brand), var(--ground));
    margin-bottom: 2rem;
  }
  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }
  .dates {
    color: var(--ink);
    text-decoration: none;
    font-size: 1.2rem;
  }
  .dates img {
    max-width: 290px;
  }
  .brand {
    font-weight: 500;
    font-size: 1.4rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    text-align: center;
  }
  .header-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.5rem;
  }
  .locales {
    display: flex;
    gap: 0.4rem;
    font-size: 0.95rem;
    text-transform: uppercase;
  }
  .locales a {
    color: var(--ink);
    text-decoration: none;
  }
  .locales a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* menu overlay */
  .menu summary {
    list-style: none;
    cursor: pointer;
    width: 2.6rem;
    height: 2rem;
    display: grid;
    place-items: center;
  }
  .menu summary::-webkit-details-marker,
  .menu summary::marker {
    display: none;
    content: '';
  }
  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 2.4rem;
    height: 3px;
    background: var(--ink);
    content: '';
  }
  .burger {
    position: relative;
  }
  .burger::before {
    position: absolute;
    top: -9px;
  }
  .burger::after {
    position: absolute;
    top: 9px;
  }
  .menu-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(100%, 30rem);
    background: var(--brand);
    color: #1a1a19;
    padding: 4rem 2rem 2rem;
    overflow-y: auto;
    z-index: 20;
    text-align: right;
  }
  .menu-panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-panel li {
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.15);
  }
  .menu-panel li > a {
    font-size: 1.6rem;
    color: #1a1a19;
    text-decoration: none;
  }
  .menu-panel li > a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .menu-panel .sub {
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    color: #55534f;
  }
  .menu-panel .sub a {
    color: inherit;
    text-decoration: none;
  }
  .menu-panel .newsletter {
    border: 0;
    margin-top: 1rem;
  }
  .menu[open] summary {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 21;
  }
  .menu[open] .burger {
    background: transparent;
  }
  .menu[open] .burger::before {
    top: 0;
    transform: rotate(45deg);
  }
  .menu[open] .burger::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .edit-bar {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: -1.25rem;
    margin-bottom: 1rem;
  }

  /* content primitives */
  main {
    padding-bottom: 4rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
    text-wrap: balance;
  }
  h2 {
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 2.5rem 0 0.8rem;
  }
  h3 {
    font-size: 1.15rem;
    margin: 1.4rem 0 0.4rem;
  }
  p {
    margin: 0 0 1rem;
  }

  .lede {
    font-size: clamp(1.3rem, 2.5vw, 2rem);
    line-height: 1.25;
    max-width: 30ch;
    margin-bottom: 2rem;
    text-wrap: balance;
  }
  .prose {
    max-width: var(--measure);
  }
  .meta {
    color: var(--ink-3);
    font-size: 0.85rem;
  }
  .kicker {
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 0.95rem;
    margin: 0 0 0.4rem;
  }
  .empty {
    background: var(--surface);
    border: 1px dashed var(--rule);
    padding: 1.5rem;
    color: var(--ink-2);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 2rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  .two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem 3rem;
  }
  .card a.card-link {
    color: inherit;
    text-decoration: none;
  }
  .card h3 {
    margin: 0.6rem 0 0.15rem;
  }
  .card a.card-link:hover h3 {
    text-decoration: underline;
  }

  .rule {
    border: 0;
    border-top: 1px solid var(--ink);
    margin: 2rem 0;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0;
  }
  .band {
    display: block;
    background: var(--brand);
    color: #1a1a19;
    text-align: center;
    text-transform: uppercase;
    font-size: clamp(1.2rem, 3vw, 2.2rem);
    padding: 1.6rem 1rem;
    margin: 2.5rem 0;
    text-decoration: none;
  }

  /* footer */
  .site-footer {
    background: linear-gradient(var(--ground), var(--brand));
    padding: 2rem 0 1.5rem;
    font-size: 0.9rem;
    color: var(--ink);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .copyright {
    margin: 0;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .footer-links a {
    border: 1px solid var(--ink);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    color: var(--ink);
    text-decoration: none;
  }
  .footer-links .studio {
    border-style: dashed;
    color: var(--ink-3);
  }
</style>
