---
import { LOCALES, type LocaleId } from '../lib/locales';
import { useTranslations, localePath } from '../lib/i18n';
import { getSettings, getNavPages, getNavigation } from '../lib/queries';
import EditLink from '../components/EditLink.astro';

interface Props {
  lang: LocaleId;
  title: string;
  description?: string;
  /** Path without locale prefix, e.g. "exhibitors" - used for hreflang. */
  path?: string;
  /** Per-locale paths, when slugs differ per language. */
  altPaths?: Partial<Record<LocaleId, string>>;
  noIndex?: boolean;
  /** Document this page renders, so the Edit button can deep-link to it. */
  editId?: string;
  editType?: string;
}

const { lang, title, description, path = '', altPaths, noIndex, editId, editType } = Astro.props;
const t = useTranslations(lang);

const [settings, navPages, navigation] = await Promise.all([
  getSettings(lang),
  getNavPages(lang),
  getNavigation(lang),
]);

const siteName = settings?.siteName ?? 'Ceramic Brussels';
const fullTitle = title === siteName ? siteName : `${title} — ${siteName}`;
const metaDescription = description ?? settings?.defaultSeo?.description ?? settings?.tagline ?? '';

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(localePath(lang, path), site).href;

const alternates = LOCALES.map((l) => ({
  lang: l.id,
  href: new URL(localePath(l.id, altPaths?.[l.id] ?? path), site).href,
}));

/** Turn one editor-defined menu item into a label + href. */
function resolveNavItem(item: any) {
  if (!item?.label) return null;

  if (item.kind === 'external') {
    return item.url ? { label: item.label, href: item.url, external: true } : null;
  }
  if (item.kind === 'page') {
    return item.pageSlug ? { label: item.label, href: localePath(lang, item.pageSlug) } : null;
  }
  // 'route', and anything unset, points at a built-in section.
  return { label: item.label, href: localePath(lang, item.route ?? '') };
}

/**
 * The menu comes from Sanity. If nobody has filled it in yet, fall back to
 * every built-in section plus any page that set a navigation label - so the
 * site is never left without a menu.
 */
const editorNav = (navigation?.items ?? []).map(resolveNavItem).filter(Boolean) as {
  label: string;
  href: string;
  external?: boolean;
}[];

const fallbackNav = [
  { label: t('nav.exhibitors'), href: localePath(lang, 'exhibitors') },
  { label: t('nav.artists'), href: localePath(lang, 'artists') },
  { label: t('nav.programme'), href: localePath(lang, 'programme') },
  { label: t('nav.news'), href: localePath(lang, 'news') },
  { label: t('nav.awards'), href: localePath(lang, 'awards') },
  { label: t('nav.partners'), href: localePath(lang, 'partners') },
  { label: t('nav.press'), href: localePath(lang, 'press') },
  { label: t('nav.editions'), href: localePath(lang, 'editions') },
  ...navPages.map((p: any) => ({ label: p.label, href: localePath(lang, p.slug) })),
];

const nav = editorNav.length ? editorNav : fallbackNav;

/**
 * Footer links come from two places - the editable footer menu and the contact
 * details in Site settings - so the same address can legitimately arrive twice
 * (Instagram is in both by default). Merge and de-duplicate by href.
 */
const footerLinks = [
  ...(navigation?.footerItems ?? []).map(resolveNavItem).filter(Boolean),
  settings?.contactEmail && { label: settings.contactEmail, href: `mailto:${settings.contactEmail}` },
  settings?.instagramUrl && { label: 'Instagram', href: settings.instagramUrl },
  settings?.newsletterUrl && { label: 'Newsletter', href: settings.newsletterUrl },
  { label: 'Studio', href: '/studio' },
].filter(Boolean) as { label: string; href: string }[];

const seenHrefs = new Set<string>();
const footerNav = footerLinks.filter((link) => {
  const key = link.href.replace(/\/$/, '').toLowerCase();
  if (seenHrefs.has(key)) return false;
  seenHrefs.add(key);
  return true;
});

const current = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    {noIndex && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}

    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={localePath(lang)}>
          {siteName}
          {settings?.tagline && <span class="tagline">{settings.tagline}</span>}
        </a>

        <nav class="locales" aria-label={t('common.language')}>
          {
            LOCALES.map((l) => (
              <a
                href={localePath(l.id, altPaths?.[l.id] ?? path)}
                hreflang={l.id}
                aria-current={l.id === lang ? 'true' : undefined}
              >
                {l.id}
              </a>
            ))
          }
        </nav>
      </div>

      <nav class="main-nav" aria-label="Main">
        <div class="shell nav-row">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={current === item.href ? 'page' : undefined}
                    {...(item.external ? { rel: 'noopener noreferrer' } : {})}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <EditLink id="navigation" type="navigation" label="Edit menu" />
        </div>
      </nav>
    </header>

    {
      (editId || Astro.url.pathname) && (
        <div class="edit-bar shell">
          {editId && editType && <EditLink id={editId} type={editType} lang={lang} label="Edit this content" />}
        </div>
      )
    }

    <main id="main" class="shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <div>
          <strong>{siteName}</strong>
          {settings?.practicalInfo?.address && <p class="addr">{settings.practicalInfo.address}</p>}
        </div>
        <div class="footer-links">
          {footerNav.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ground: #ffffff;
    --surface: #fafaf9;
    --surface-2: #f0efed;
    --ink: #1a1a19;
    --ink-2: #55534f;
    --ink-3: #8a8781;
    --rule: #e0dedb;
    --accent: #1f4fa3;
    --measure: 68ch;
    --shell: 1140px;
    --font: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --ground: #121211;
      --surface: #1a1a19;
      --surface-2: #232322;
      --ink: #ececea;
      --ink-2: #a8a5a0;
      --ink-3: #7a7772;
      --rule: #2e2e2c;
      --accent: #8fb0e8;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .shell {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 10;
    background: var(--ink);
    color: var(--ground);
    padding: 0.5rem 0.9rem;
  }

  a {
    color: var(--accent);
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* header */
  .site-header {
    border-bottom: 1px solid var(--rule);
    margin-bottom: 2.5rem;
  }
  .header-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.4rem;
    padding-bottom: 1rem;
  }
  .brand {
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }
  .brand .tagline {
    display: block;
    font-weight: 400;
    font-size: 0.8rem;
    color: var(--ink-3);
    letter-spacing: 0;
  }
  .locales {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .locales a {
    color: var(--ink-3);
    text-decoration: none;
    padding: 0.15rem 0.35rem;
  }
  .locales a[aria-current] {
    color: var(--ground);
    background: var(--ink);
  }

  .nav-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .edit-bar {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: -1.75rem;
    margin-bottom: 1rem;
    min-height: 0;
  }
  .edit-bar:empty {
    display: none;
  }

  .main-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0 0 0.9rem;
    font-size: 0.88rem;
  }
  .main-nav a {
    color: var(--ink-2);
    text-decoration: none;
    padding: 0.2rem 0;
    border-bottom: 2px solid transparent;
  }
  .main-nav a:hover {
    color: var(--ink);
  }
  .main-nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  /* content primitives */
  main {
    padding-bottom: 4rem;
  }
  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
    text-wrap: balance;
  }
  h2 {
    font-size: 1.3rem;
    letter-spacing: -0.01em;
    margin: 2.5rem 0 0.8rem;
  }
  h3 {
    font-size: 1.05rem;
    margin: 1.6rem 0 0.4rem;
  }
  p {
    margin: 0 0 1rem;
  }

  .lede {
    color: var(--ink-2);
    font-size: 1.05rem;
    max-width: var(--measure);
  }
  .prose {
    max-width: var(--measure);
  }
  .meta {
    color: var(--ink-3);
    font-size: 0.85rem;
  }
  .empty {
    background: var(--surface);
    border: 1px dashed var(--rule);
    padding: 1.5rem;
    color: var(--ink-2);
  }
  .empty a {
    color: var(--accent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.6rem 1.4rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }

  .card a.card-link {
    color: inherit;
    text-decoration: none;
  }
  .card h3 {
    margin: 0.6rem 0 0.15rem;
    font-size: 1rem;
  }
  .card a.card-link:hover h3 {
    text-decoration: underline;
  }

  .pill {
    display: inline-block;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: var(--surface-2);
    color: var(--ink-2);
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.88rem;
  }

  /* footer */
  .site-footer {
    border-top: 1px solid var(--rule);
    padding: 2rem 0 3rem;
    font-size: 0.87rem;
    color: var(--ink-2);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .footer-inner .addr {
    white-space: pre-line;
    margin: 0.4rem 0 0;
    color: var(--ink-3);
  }
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
</style>
