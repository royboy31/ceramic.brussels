---
import { LOCALES, type LocaleId } from '../lib/locales';
import { useTranslations, localePath } from '../lib/i18n';
import { getSettings, getNavPages, getNavigation, getCurrentEdition } from '../lib/queries';
import { resolveNavItem } from '../lib/links';
import { HUBS } from '../lib/hubs';
import { urlFor } from '../sanity/image';
import EditLink from '../components/EditLink.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MenuOverlay from '../components/MenuOverlay.astro';
import { VisualEditing } from '@sanity/astro/visual-editing';
import { isPreview } from '../lib/previewContext';

/**
 * The frame around every page: the design's header (dates mark, wordmark,
 * language switcher, menu button), the slide-in menu, and the footer band.
 * Everything textual comes from Sanity; the lockups are brand artwork.
 *
 * Design by Lilanga (identity, chrome, type system); data wiring by Kamindu.
 */
interface Props {
  lang: LocaleId;
  title: string;
  description?: string;
  /** Path without locale prefix, e.g. "exhibitors" - used for hreflang. */
  path?: string;
  /** Per-locale paths, when slugs differ per language. */
  altPaths?: Partial<Record<LocaleId, string>>;
  noIndex?: boolean;
  /** 'acid' paints the whole page yellow, as the art prize section is. */
  theme?: 'default' | 'acid';
  /** Alias kept for pages written against the skeleton: 'brand' = 'acid'. */
  tone?: 'default' | 'brand';
  /** Social share image for this page. Falls back to the one in Site settings. */
  image?: any;
  /** Document this page renders, so the Edit button can deep-link to it. */
  editId?: string;
  editType?: string;
}

const {
  lang,
  title,
  description,
  path = '',
  altPaths,
  noIndex,
  theme = 'default',
  tone = 'default',
  image,
  editId,
  editType,
} = Astro.props;
const acid = theme === 'acid' || tone === 'brand';
// True inside a /preview/ render: drafts, stega-encoded strings, and the
// Studio's editing overlay mounted at the end of the body.
const preview = isPreview();
const t = useTranslations(lang);

const [settings, navPages, navigation, edition] = await Promise.all([
  getSettings(lang),
  getNavPages(lang),
  getNavigation(lang),
  getCurrentEdition(lang),
]);

const siteName = settings?.siteName ?? 'ceramic brussels';
const fullTitle = title === siteName ? siteName : `${title} — ${siteName}`;
const metaDescription = description ?? settings?.defaultSeo?.description ?? settings?.tagline ?? '';

const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(localePath(lang, path), site).href;

/**
 * Social share image. Facebook, LinkedIn and WhatsApp all want an absolute URL
 * and refuse to crop, so pin it to the 1200x630 they expect. Falls back to the
 * site-wide image in Site settings, so a page that sets nothing still shares
 * with a picture.
 */
const shareImage = image?.asset ? image : settings?.defaultSeo?.ogImage;
const ogImage = shareImage?.asset
  ? urlFor(shareImage).width(1200).height(630).fit('crop').auto('format').quality(80).url()
  : null;
const ogImageAlt = shareImage?.alt ?? undefined;

const alternates = LOCALES.map((l) => ({
  lang: l.id,
  href: new URL(localePath(l.id, altPaths?.[l.id] ?? path), site).href,
}));

/**
 * The menu comes from Sanity, sub-items included: each item's children become
 * the small line under it in the overlay ("about / laureates / awards / jury").
 * If nobody has filled it in yet, fall back to the hubs plus any standalone
 * page that set a navigation label, so the site is never without a menu.
 */
const editorNav = (navigation?.items ?? [])
  .map((item: any) => {
    const link = resolveNavItem(lang, item);
    if (!link) return null;
    const children = (item.children ?? []).map((c: any) => resolveNavItem(lang, c)).filter(Boolean);
    return { ...link, children, sub: children.length ? children.map((c: any) => c.label).join(' / ') : undefined };
  })
  .filter(Boolean) as { label: string; href: string; external: boolean; sub?: string; children: any[] }[];

const fallbackNav = [
  { label: t('nav.exhibitors'), href: localePath(lang, 'exhibitors'), external: false, sub: t('nav.sub.exhibitors'), children: [] },
  ...Object.values(HUBS).map((hub) => ({
    label: t(hub.title),
    href: localePath(lang, hub.route),
    external: false,
    sub: hub.tabs.map((tab) => t(tab.label)).join(' / '),
    children: [],
  })),
  ...navPages.map((p: any) => ({ label: p.label, href: localePath(lang, p.slug), external: false, children: [] })),
];

const nav = editorNav.length ? editorNav : fallbackNav;

const footerLinks = (navigation?.footerItems ?? [])
  .map((i: any) => resolveNavItem(lang, i))
  .filter(Boolean) as { label: string; href: string; external: boolean }[];

const fallbackFooter = [
  settings?.instagramUrl && { label: t('common.instagram'), href: settings.instagramUrl, external: true },
  settings?.newsletterUrl && { label: t('nav.newsletter'), href: settings.newsletterUrl, external: true },
  settings?.linkedinUrl && { label: t('common.linkedin'), href: settings.linkedinUrl, external: true },
].filter(Boolean) as { label: string; href: string; external: boolean }[];

const footerNav = footerLinks.length ? footerLinks : fallbackFooter;
const copyright = settings?.copyright ?? `© ${siteName}, ${new Date().getFullYear()}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    {(noIndex || preview) && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:locale" content={lang} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
        </>
      )
    }
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="preload" href="/fonts/noi-grotesk-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>

  <body class={acid ? 'acid-page' : undefined}>
    <a class="skip" href="#main">Skip to content</a>

    <Header lang={lang} siteName={siteName} path={path} altPaths={altPaths} datesMark={edition?.datesMark} />
    <MenuOverlay lang={lang} items={nav} newsletterUrl={settings?.newsletterUrl} />

    <div class="edit-bar">
      <EditLink id="navigation" type="navigation" label="Edit menu" />
      {editId && editType && <EditLink id={editId} type={editType} lang={lang} label="Edit this content" />}
    </div>

    <main id="main">
      <slot />
    </main>

    <Footer siteName={siteName} links={footerNav} copyright={copyright} />

    {
      preview && (
        <>
          <VisualEditing enabled />
          {/* Keep navigation inside the preview tree: the pages link to their
              published addresses, which would drop the reader out of drafts. */}
          <script is:inline>
            (function () {
              var LOCALES = ['en', 'fr', 'nl'];
              function rewrite(a) {
                var url;
                try {
                  url = new URL(a.getAttribute('href'), location.href);
                } catch (e) {
                  return;
                }
                if (url.origin !== location.origin) return;
                if (LOCALES.indexOf(url.pathname.split('/')[1]) === -1) return;
                a.setAttribute('href', '/preview' + url.pathname + url.search + url.hash);
              }
              function all() {
                document.querySelectorAll('a[href]').forEach(rewrite);
              }
              all();
              new MutationObserver(all).observe(document.body, { childList: true, subtree: true });
            })();
          </script>
        </>
      )
    }
  </body>
</html>

<style is:global>
  /* Noi Grotesk - the two weights the design uses. Swap these two files when
     the licensed (non-trial) cut arrives; nothing else needs to change. */
  @font-face {
    font-family: 'Noi Grotesk';
    src: url('/fonts/noi-grotesk-400.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Noi Grotesk';
    src: url('/fonts/noi-grotesk-600.woff2') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --acid: #fff350;
    --ground: #ffffff;
    --surface: #fafaf9;
    --surface-2: #f0efed;
    --ink: #050505;
    --ink-2: #55534f;
    --ink-3: #8a8781;
    --rule: #e0dedb;
    --accent: #050505;
    --measure: 68ch;
    --shell: 1140px;
    --font: 'Noi Grotesk', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    /* aliases used by the hub components */
    --brand: var(--acid);
    --paper: #f6f5ec;
  }

  /* The Figma is a light, acid-on-white identity with no dark counterpart, so
     the palette deliberately does not invert. Reinstating dark mode means
     designing it first - see the note in the handover. */

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-width: 320px;
    /* Short pages still push the footer to the bottom, so the page background
       never shows underneath it. */
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--ground);
    color: var(--ink);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  button {
    font: inherit;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  ::selection {
    background: var(--acid);
    color: var(--ink);
  }

  /* Whole-page acid, used by the art prize section. */
  body.acid-page {
    background: var(--acid);
  }

  /* 12-column grid, 30px gutters - the spine of every page in the design. */
  .page-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0 30px;
    padding-inline: 30px;
  }

  @media (max-width: 900px) {
    .page-grid {
      gap: 0 16px;
      padding-inline: 16px;
    }
  }

  @media (max-width: 640px) {
    .page-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0 10px;
      padding-inline: 10px;
    }
  }

  /* Shared page furniture from the frames: a lowercase section title, panel
     headings with a rule, the large intro paragraph and the body size. */
  .section-title {
    text-transform: lowercase;
    font-size: clamp(2rem, 4.8vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 600;
    margin: 0 0 1.5rem;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 0;
    margin: 0;
    padding: 0 0 1.75rem;
  }
  .section-head .section-title {
    margin: 0;
  }

  .panel-title {
    text-transform: lowercase;
    border-bottom: 2px solid var(--ink);
    margin: 0 0 1.25rem;
    padding-bottom: 0.2rem;
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
    font-weight: 600;
  }

  .intro-large {
    max-width: 1160px;
    margin: 0 0 2.5rem;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1.25;
    letter-spacing: -0.035em;
  }

  .body-24 {
    font-size: clamp(1rem, 1.5vw, 1.5rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .tabs .pill {
    border-radius: 0;
    padding: 0.35rem 1.1rem;
    font-family: inherit;
    font-size: clamp(1rem, 1.8vw, 1.75rem);
    background: none;
    color: inherit;
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
  }
  .tabs .pill[aria-pressed='true'],
  .tabs .pill[aria-current] {
    background: var(--acid);
  }

  /* Type helpers from the design system. */
  .display {
    letter-spacing: -0.052em;
    line-height: 0.92;
  }
  .eyebrow {
    font-size: clamp(0.72rem, 1vw, 1rem);
    text-transform: uppercase;
  }
  .text-link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }
  .rule {
    border-top: 1px solid currentColor;
  }

  .shell {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 50;
    background: var(--ink);
    color: var(--ground);
    padding: 0.5rem 0.9rem;
  }

  .edit-bar {
    display: flex;
    justify-content: flex-end;
    padding-inline: 30px;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }
  .edit-bar:empty {
    display: none;
  }

  /* content primitives - still used by the pages that are not ported yet */
  main {
    flex: 1;
    padding: 0 30px 4rem;
  }

  @media (max-width: 900px) {
    main {
      padding-inline: 16px;
    }
  }

  @media (max-width: 640px) {
    main {
      padding-inline: 10px;
    }
  }

  /* main already carries the gutter, so a grid inside it must not add another. */
  main .page-grid {
    padding-inline: 0;
  }
  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin: 0 0 0.5rem;
    text-wrap: balance;
  }
  h2 {
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    margin: 2.5rem 0 0.8rem;
  }
  h3 {
    font-size: 1.05rem;
    margin: 1.6rem 0 0.4rem;
  }
  p {
    margin: 0 0 1rem;
  }

  .lede {
    color: var(--ink-2);
    font-size: 1.05rem;
    max-width: var(--measure);
  }
  .prose {
    max-width: var(--measure);
  }
  .meta {
    color: var(--ink-3);
    font-size: 0.85rem;
  }
  .empty {
    background: var(--surface);
    border: 1px dashed var(--rule);
    padding: 1.5rem;
    color: var(--ink-2);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.6rem 1.4rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }

  .card a.card-link {
    color: inherit;
    text-decoration: none;
  }
  .card h3 {
    margin: 0.6rem 0 0.15rem;
    font-size: 1rem;
  }
  .card a.card-link:hover h3 {
    text-decoration: underline;
  }

  .pill {
    display: inline-block;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.15rem 0.9rem;
    font-size: 0.9rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.88rem;
  }

</style>
