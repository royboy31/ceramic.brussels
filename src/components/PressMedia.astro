---
import HubNav from './HubNav.astro';
import SanityImage from './SanityImage.astro';
import VideoEmbed from './VideoEmbed.astro';
import { LOCALE_IDS, type LocaleId } from '../lib/locales';
import { useTranslations, localePath, formatDateNumeric, formatMonthYear } from '../lib/i18n';
import { instagramUrl, resolveLink } from '../lib/links';
import { styleAttrs } from '../lib/textStyle';
import { getPressClips, getNews, getEditions, getPartners, getStories } from '../lib/queries';
import { urlFor } from '../sanity/image';

/**
 * Press & media, as the designer's hand-off of 2026-09-21 draws it: a
 * "press & media" title band with four pills - stories, press, photos &
 * videos, media partners - each its own page. Since backend request #19
 * they are the tabs of a hub of their own (`src/lib/hubs.ts`, mounted by
 * `hubs/PressMedia.astro`): this renders the band and the one view for
 * `tab`. A view opens with the lead(s) of its page document - `intro`
 * under the first heading, `intro2` under the second on stories and press.
 */
interface Props {
  lang: LocaleId;
  tab: string;
  /** The tab's page document (leads, tab label), once an editor has made one. */
  page: any;
  /** Every page of the hub, for the pill labels. */
  pages: any[];
  settings: any;
}

const { lang, tab, page, pages, settings } = Astro.props;
const t = useTranslations(lang);
const external = { target: '_blank', rel: 'noopener noreferrer' };

// Only what the tab draws.
const [clips, news, editions, partners, stories] = await Promise.all([
  tab === 'press' ? getPressClips() : [],
  tab === 'press' ? getNews(lang) : [],
  tab === 'press' || tab === 'photos-videos' ? getEditions(lang) : [],
  tab === 'media-partners' ? getPartners(lang) : [],
  tab === 'stories' ? getStories(lang) : [],
]);

/* ---------------------------------------------------------------- stories */
/*
 * Interviews and the collectors' voices series are `story` documents (#21):
 * a card each, whose link says where "read the interview" goes - a news
 * item, a page of this site, or the site that hosts the series - so the
 * arrow follows the link. The "discover Ceramics Now" pill beside the
 * collectors' lead is Site settings → Press → Collectors' voices link.
 */
const card = (s: any) => {
  const link = resolveLink(lang, s.link);
  return { ...s, date: s.publishedAt, url: link?.href, arrow: link?.arrow ?? '→', external: link?.external ?? false };
};
const interviews = stories.filter((s: any) => s.kind === 'interview').map(card);
const collectors = stories.filter((s: any) => s.kind === 'collectors-voice').map(card);
const hasStories = interviews.length > 0 || collectors.length > 0;
const seriesLink = resolveLink(lang, settings?.collectorsVoicesLink);

/* ------------------------------------------------------------------ press */
const CLIPS_FIRST = 6;

/*
 * Press releases are news items in the "press release" category, which are
 * already published in all three languages - so the design's "read in EN /
 * FR / NL" pills are the item's page in each language.
 *
 * The "sort by" pills are editions: the item's own (#22), or failing that
 * the first edition that ends after it was published - the fair is in
 * January, so a release from February 2026 on is about 2027.
 */
const releases = news.filter((n: any) => n.category === 'press-release');
const byEnd = [...editions].filter((e: any) => e.endDate).sort((a: any, b: any) => a.endDate.localeCompare(b.endDate));
const editionOf = (r: any) =>
  r.edition ?? (byEnd.find((e: any) => e.endDate >= r.publishedAt.slice(0, 10)) ?? byEnd[byEnd.length - 1])?.year;
const releaseGroups = editions
  .map((e: any) => ({
    year: e.year,
    label: e.ordinal ?? String(e.year),
    items: releases.filter((r: any) => r.publishedAt && editionOf(r) === e.year),
  }))
  .filter((g: any) => g.items.length > 0);

// Each edition's press clippings book, as the old site linked them.
const reviews = [...editions]
  .filter((e: any) => e.pressClipsUrl)
  .sort((a: any, b: any) => a.year - b.year);

const agencies: any[] = settings?.pressContacts ?? [];

const hasPress = clips.length > 0 || releaseGroups.length > 0 || reviews.length > 0 || agencies.length > 0;

/* ------------------------------------------------------- photos & videos */
const galleries = editions
  .map((e: any) => ({
    year: e.year,
    film: e.film?.url ? e.film : null,
    images: (e.images ?? []).filter((img: any) => img?.asset),
  }))
  .filter((g: any) => g.images.length > 0 || g.film);
const hasPhotos = galleries.length > 0;

/**
 * The frame's rhythm, twelve pictures long: a full-width picture, two
 * halves, three thirds, two halves, a full-width one, three thirds. The
 * gallery repeats it for as many pictures as the edition has.
 */
const RHYTHM = ['hero', 'half', 'half', 'third', 'third', 'third', 'half', 'half', 'hero', 'third', 'third', 'third'];
const IMAGE_SIZES: Record<string, { widths: number[]; sizes: string }> = {
  hero: { widths: [900, 1400, 2000], sizes: '100vw' },
  half: { widths: [700, 1000, 1400], sizes: '(max-width: 800px) 100vw, 50vw' },
  third: { widths: [480, 720, 960], sizes: '(max-width: 800px) 100vw, 33vw' },
};
/** "Hall A © Geoffrey Fritsch, 2026", as the frame writes each caption. */
const captionOf = (img: any, year: number) => {
  const who = [img.caption, img.workTitle].filter(Boolean).join(', ');
  const credit = img.credit ? `© ${img.credit}` : '';
  const line = [who, credit].filter(Boolean).join(' ');
  return line ? `${line}${img.year || year ? `, ${img.year ?? year}` : ''}` : '';
};

/* -------------------------------------------------------- media partners */
const mediaPartners = partners.filter((p: any) => p.tier === 'media');
const hasPartners = mediaPartners.length > 0;
/**
 * The logos as one family, the way the partners hub sizes them (request
 * #11): the wider the file, the shorter its slot, and the editor's
 * "Logo size (%)" on top.
 */
const logoHeight = (p: any) => {
  const ar = p.logo?.dimensions?.aspectRatio;
  const base = !ar || !Number.isFinite(ar) || ar <= 0 ? 80 : Math.min(110, Math.max(44, 118 / Math.pow(ar, 0.45)));
  return Math.round(base * ((p.logoScale ?? 100) / 100));
};
---

<HubNav lang={lang} route="press-media" active={tab} pages={pages} class="press-band" />

<div class="press-media">

  {/* ------------------------------------------------------------ stories */}
  {
    tab === 'stories' && (
      <section class="view" data-view-panel="stories">
        {!hasStories && page?.intro && (
          <p class="intro-large lead-top" {...styleAttrs(page.introStyle)}>
            {page.intro}
          </p>
        )}
        {!hasStories && <p class="empty">{t('press.storiesEmpty')}</p>}
        {interviews.length > 0 && (
          <>
            <div class="section-intro">
              <h2>{t('press.interviews')}</h2>
              {page?.intro && (
                <p class="lead" {...styleAttrs(page.introStyle)}>
                  {page.intro}
                </p>
              )}
            </div>
            <div class="interview-grid" data-more-list>
              {interviews.map((story: any) => (
                <article class="story-card">
                  {story.image?.asset && (
                    <SanityImage image={story.image} aspect={1.5} widths={[440, 660, 880]} sizes="(max-width: 800px) 100vw, 33vw" />
                  )}
                  <h3>{story.title}</h3>
                  {story.role && <strong>{story.role}</strong>}
                  {story.text && <p>{story.text}</p>}
                  {story.url && (
                    <a class="small-pill" href={story.url} {...(story.external ? external : {})}>
                      {t('press.readInterview')} {story.arrow}
                    </a>
                  )}
                </article>
              ))}
            </div>
          </>
        )}
        {collectors.length > 0 && (
          <>
            <div class="section-intro collectors">
              <h2>{t('press.collectorsVoices')}</h2>
              {(page?.intro2 || seriesLink) && (
                <div class="lead-row">
                  {page?.intro2 && (
                    <p class="lead" {...styleAttrs(page.intro2Style)}>
                      {page.intro2}
                    </p>
                  )}
                  {seriesLink && (
                    <a class="small-pill" href={seriesLink.href} {...(seriesLink.external ? external : {})}>
                      {seriesLink.label} {seriesLink.arrow}
                    </a>
                  )}
                </div>
              )}
            </div>
            <div class="collector-list">
              {collectors.map((story: any) => (
                <article>
                  {story.image?.asset && (
                    <SanityImage image={story.image} aspect={1.5} widths={[700, 1000, 1400]} sizes="(max-width: 800px) 100vw, 50vw" />
                  )}
                  <div>
                    <p class="dated">
                      <strong>{formatMonthYear(story.date, lang)}</strong>
                    </p>
                    <h3>{story.title}</h3>
                    {story.text && <p>{story.text}</p>}
                    {story.url && (
                      <a class="small-pill" href={story.url} {...(story.external ? external : {})}>
                        {t('press.readInterview')} {story.arrow}
                      </a>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </>
        )}
      </section>
    )
  }

  {/* -------------------------------------------------------------- press */}
  {
    tab === 'press' && (
      <section class="view" data-view-panel="press">
        {!hasPress && <p class="empty">{t('press.empty')}</p>}
        {clips.length > 0 && (
          <>
            <div class="top-section">
              <h2>{t('press.asSeen')}</h2>
              {page?.intro && (
                <p class="lead" {...styleAttrs(page.introStyle)}>
                  {page.intro}
                </p>
              )}
            </div>
            <div class="press-cards" data-more-list data-more-step={CLIPS_FIRST}>
              {clips.map((clip: any, i: number) => {
                const href = clip.url ?? clip.pdfUrl;
                return (
                  <a class="press-card" href={href} hidden={i >= CLIPS_FIRST} {...(href ? external : {})}>
                    {clip.cover?.asset && (
                      <SanityImage image={clip.cover} aspect={3 / 4} widths={[400, 600, 800]} sizes="(max-width: 800px) 100vw, 33vw" class="cover" />
                    )}
                    <div class="card-body">
                      <p class="dated small">
                        <time datetime={clip.publishedAt}>{formatDateNumeric(clip.publishedAt, lang)}</time>
                      </p>
                      <h3>{clip.title}</h3>
                      <p class="card-foot">
                        <strong>{clip.outlet}</strong>
                        {href && <span>{t('press.readTheArticle')} ↗</span>}
                      </p>
                    </div>
                  </a>
                );
              })}
            </div>
            {clips.length > CLIPS_FIRST && (
              <button class="load-more" type="button" data-more>
                {t('press.loadMore')} <span>↓</span>
              </button>
            )}
          </>
        )}

        {(releaseGroups.length > 0 || reviews.length > 0) && (
          <>
            <div class="top-section">
              <h2>{t('press.room')}</h2>
              {page?.intro2 && (
                <p class="lead" {...styleAttrs(page.intro2Style)}>
                  {page.intro2}
                </p>
              )}
              {settings?.pressKitUrl && (
                <p class="kit">
                  <a class="small-pill" href={settings.pressKitUrl} {...external}>
                    {t('about.pressKit')} ↗
                  </a>
                </p>
              )}
            </div>
            <div class:list={['room-grid', { single: !releaseGroups.length || !reviews.length }]}>
              {releaseGroups.length > 0 && (
                <section class="releases">
                  <h3>{t('press.releases')}</h3>
                  {releaseGroups.length > 1 && (
                    <div class="sort" data-filter-bar="releases">
                      <b>{t('press.sortBy')}:</b>
                      {releaseGroups.map((g: any, i: number) => (
                        <button type="button" data-filter={g.year} aria-pressed={String(i === 0)}>
                          {g.label}
                        </button>
                      ))}
                    </div>
                  )}
                  {releaseGroups.map((g: any, i: number) => (
                    <div data-filter-group="releases" data-value={g.year} hidden={i > 0}>
                      {g.items.map((r: any) => (
                        <article>
                          <p class="dated">
                            <strong>{formatMonthYear(r.publishedAt, lang)}</strong>
                          </p>
                          <h4 {...styleAttrs(r.titleStyle)}>{r.title}</h4>
                          <div class="languages">
                            {LOCALE_IDS.map((l) => (
                              <a class="small-pill" href={localePath(l, `news/${r.slug}`)} hreflang={l}>
                                {t('press.readIn')} {l.toUpperCase()} →
                              </a>
                            ))}
                          </div>
                        </article>
                      ))}
                    </div>
                  ))}
                </section>
              )}
              {reviews.length > 0 && (
                <section class="reviews">
                  <h3>{t('press.reviews')}</h3>
                  {reviews.map((e: any) => (
                    <a href={e.pressClipsUrl} {...external}>
                      {e.year}, {e.ordinal ?? e.year} <span>↗</span>
                    </a>
                  ))}
                </section>
              )}
            </div>
          </>
        )}

        {agencies.length > 0 && (
          <section class="agencies">
            <h3>{t('press.agencies')}</h3>
            <div class="agency-grid">
              {agencies.map((c: any) => (
                <article>
                  {c.region && (
                    <strong {...styleAttrs(c.regionStyle)}>
                      {t('press.relations').replace('{region}', c.region)}
                    </strong>
                  )}
                  {c.name && <p>{c.name}</p>}
                  {c.email && (
                    <a class="mail" href={`mailto:${c.email}`}>
                      {c.email} ↗
                    </a>
                  )}
                  {(c.url || c.instagram) && (
                    <p class="pills">
                      {c.url && (
                        <a class="small-pill" href={c.url} {...external}>
                          {t('common.website')} ↗
                        </a>
                      )}
                      {c.instagram && (
                        <a class="small-pill" href={instagramUrl(c.instagram)} {...external}>
                          {t('common.instagram')} ↗
                        </a>
                      )}
                    </p>
                  )}
                </article>
              ))}
            </div>
          </section>
        )}
      </section>
    )
  }

  {/* ---------------------------------------------------- photos & videos */}
  {
    tab === 'photos-videos' && (
      <section class="view" data-view-panel="photos-videos">
        {page?.intro && (
          <p class="intro-large lead-top" {...styleAttrs(page.introStyle)}>
            {page.intro}
          </p>
        )}
        {!hasPhotos && <p class="empty">{t('about.imagesEmpty')}</p>}
        {/* The frame's "search by media ↓" pill is not built: nothing says
            what it searches (question for the designer, request #19). */}
        {galleries.length > 1 && (
          <div class="sort filters" data-filter-bar="photos">
            <b>{t('faq.filters')}:</b>
            {galleries.map((g: any, i: number) => (
              <button type="button" data-filter={g.year} aria-pressed={String(i === 0)}>
                {g.year}
              </button>
            ))}
          </div>
        )}
        {galleries.map((g: any, i: number) => (
          <div class="photo-grid" data-filter-group="photos" data-value={g.year} hidden={i > 0}>
            {g.film && (
              <figure class="hero film">
                <VideoEmbed
                  url={g.film.url}
                  poster={
                    g.film.poster?.asset
                      ? urlFor(g.film.poster).width(1800).height(1013).fit('crop').auto('format').quality(78).url()
                      : '/assets/video-still.webp'
                  }
                  label={g.film.title ?? String(g.year)}
                />
                {g.film.title && <figcaption>{g.film.title}</figcaption>}
              </figure>
            )}
            {g.images.map((img: any, n: number) => {
              const shape = RHYTHM[n % RHYTHM.length];
              const caption = captionOf(img, g.year);
              return (
                <figure class={shape}>
                  <SanityImage image={img} widths={IMAGE_SIZES[shape].widths} sizes={IMAGE_SIZES[shape].sizes} />
                  {caption && <figcaption>{caption}</figcaption>}
                </figure>
              );
            })}
          </div>
        ))}
      </section>
    )
  }

  {/* ----------------------------------------------------- media partners */}
  {
    tab === 'media-partners' && (
      <section class="view" data-view-panel="media-partners">
        {page?.intro && (
          <p class="intro-large lead-top" {...styleAttrs(page.introStyle)}>
            {page.intro}
          </p>
        )}
        {!hasPartners && <p class="empty">{t('press.partnersEmpty')}</p>}
        <ul class="logo-grid">
          {mediaPartners.map((p: any) => {
            const inner = p.logo?.asset ? (
              <SanityImage image={p.logo} widths={[240, 480]} sizes="240px" class="logo" placeholder={false} />
            ) : (
              <span class="wordmark">{p.name}</span>
            );
            return (
              <li style={`--logo-h:${logoHeight(p)}px`}>
                {p.url ? (
                  <a href={p.url} {...external} aria-label={p.logo?.asset ? p.name : undefined}>
                    {inner}
                  </a>
                ) : (
                  inner
                )}
              </li>
            );
          })}
        </ul>
      </section>
    )
  }
</div>

<style>
  /* From the press & media hand-off (2026-09-21). */
  /* A gap, not a sibling margin: a hidden view still counts as a sibling. */
  .press-media {
    flex-direction: column;
    gap: 80px;
    padding: 0 var(--gutter) 80px;
    display: flex;
  }
  .view[hidden] {
    display: none;
  }
  .view > :first-child {
    margin-top: 0;
  }

  .small-pill {
    white-space: nowrap;
    border: 1px solid;
    border-radius: 999px;
    align-items: center;
    padding: 1px 12px;
    font-size: 20px;
    line-height: 28px;
    display: inline-flex;
    transition:
      color 0.18s,
      background-color 0.18s;
  }
  .small-pill:hover {
    color: #fff;
    background: #050505;
  }

  /* Section heads: a 2px rule, the name at 52px, the lead beside or under it. */
  .top-section,
  .section-intro {
    border-top: 2px solid;
    padding-top: 10px;
  }
  .top-section + *,
  .section-intro + * {
    margin-top: 42px;
  }
  .top-section h2,
  .section-intro h2 {
    letter-spacing: -0.05em;
    font-size: 52px;
    font-weight: 400;
    line-height: 1.05;
  }
  .top-section .kit {
    margin-top: 24px;
  }
  /* The leads (request #19): under a heading, or at the top of a view that
     has none. Wired by Kamindu on 2026-09-22; Lilanga to restyle. */
  .lead {
    max-width: 62ch;
    margin-top: 24px;
    font-size: 24px;
    line-height: 1.25;
  }
  .lead-row {
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 24px 40px;
    display: flex;
  }
  .lead-row .lead {
    flex: 1 1 40ch;
  }
  .lead-row .small-pill {
    margin-top: 24px;
  }
  .lead-top {
    margin-bottom: 40px;
  }
  /* The magazine cover leading a press card (request #20). */
  .press-card :global(img.cover) {
    width: 100%;
    height: auto;
    margin-bottom: 16px;
    display: block;
  }
  .press-cards + .top-section,
  .load-more + .top-section,
  .interview-grid + .section-intro {
    margin-top: 80px;
  }

  .dated {
    text-transform: uppercase;
    align-items: center;
    gap: 12px;
    font-size: 22px;
    display: flex;
  }
  .dated::after {
    content: '';
    background: currentColor;
    flex: 1;
    height: 1px;
  }
  .dated.small {
    font-size: 16px;
  }

  .load-more {
    cursor: pointer;
    background: 0 0;
    border: 0;
    border-bottom: 2px solid;
    margin: 52px auto 0;
    font-size: 38px;
    display: block;
  }
  .load-more span {
    transition: transform 0.2s;
    display: inline-block;
  }
  .load-more:hover span {
    transform: translateY(5px);
  }

  /* stories */
  .interview-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    display: grid;
  }
  .story-card :global(img) {
    object-fit: cover;
    width: 100%;
    height: 289px;
  }
  .story-card h3 {
    margin-top: 8px;
    font-size: 40px;
    line-height: 1;
  }
  .story-card strong {
    text-transform: uppercase;
    margin-top: 16px;
    font-size: 24px;
    display: block;
  }
  .story-card p {
    margin: 10px 0 20px;
    font-size: 24px;
    line-height: 1.25;
  }
  .collector-list article {
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
    display: grid;
  }
  .collector-list :global(img) {
    object-fit: cover;
    width: 100%;
    height: 447px;
  }
  .collector-list h3 {
    letter-spacing: -0.04em;
    margin-top: 30px;
    font-size: 40px;
    line-height: 1.05;
  }
  .collector-list p:not(.dated) {
    margin: 22px 0 28px;
    font-size: 24px;
    line-height: 1.25;
  }

  /* press: the clippings */
  .press-cards {
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    display: grid;
  }
  .press-card {
    border: 1px solid;
    flex-direction: column;
    display: flex;
  }
  .press-card[hidden] {
    display: none;
  }
  .card-body {
    flex-direction: column;
    flex: 1;
    gap: 6px;
    padding: 12px 10px 10px;
    display: flex;
  }
  .card-body h3 {
    letter-spacing: -0.03em;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.1;
  }
  .card-foot {
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    margin-top: auto;
    padding-top: 12px;
    font-size: 16px;
    display: flex;
  }
  .card-foot strong {
    text-transform: uppercase;
    font-size: 12px;
  }
  .press-card:hover .card-foot span {
    text-decoration: underline;
  }

  /* press: the press room */
  .room-grid {
    grid-template-columns: 2fr 1fr;
    gap: 40px;
    display: grid;
  }
  .room-grid.single {
    grid-template-columns: 1fr;
  }
  .room-grid h3,
  .agencies h3 {
    border-bottom: 2px solid;
    padding-bottom: 8px;
    font-size: 34px;
    font-weight: 600;
    line-height: 1;
  }
  .sort {
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin: 38px 0 30px;
    font-size: 21px;
    display: flex;
  }
  .sort b {
    text-transform: uppercase;
    font-weight: 400;
  }
  .sort button {
    cursor: pointer;
    background: #fff;
    border: 1px solid;
    border-radius: 999px;
    padding: 1px 12px;
    font-size: 18px;
    line-height: 28px;
    transition:
      color 0.18s,
      background-color 0.18s;
  }
  .sort button[aria-pressed='true'],
  .sort button:hover {
    color: #fff;
    background: #000;
  }
  .releases article {
    padding: 0 0 48px;
  }
  .releases h3 + [data-filter-group] {
    margin-top: 30px;
  }
  .releases h4 {
    max-width: 800px;
    margin-top: 28px;
    font-size: 38px;
    font-weight: 400;
    line-height: 1.08;
  }
  .languages {
