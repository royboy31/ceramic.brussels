---
import HubNav from './HubNav.astro';
import SanityImage from './SanityImage.astro';
import VideoEmbed from './VideoEmbed.astro';
import { LOCALE_IDS, type LocaleId } from '../lib/locales';
import { useTranslations, localePath, formatDateNumeric, formatMonthYear } from '../lib/i18n';
import { instagramUrl } from '../lib/links';
import { styleAttrs } from '../lib/textStyle';
import { getPressClips, getNews, getEditions, getPartners } from '../lib/queries';
import { urlFor } from '../sanity/image';

/**
 * About → press & media, as the designer's press & media hand-off of
 * 2026-09-21 draws it: a "press & media" title band with four pills -
 * stories, press, photos & videos, media partners - each its own page.
 *
 * BACKEND-REQUEST #19: the four are meant to be tabs of a hub of their own,
 * with an address each. Until `hubs.ts` has one, they are four views of
 * this one tab: the pills switch between them in place and write the view
 * into the hash (`#photos-videos`), so a view can be linked to. Without
 * script every view shows, one under the other. Each view is a <section>
 * that moves onto its own tab unchanged once the hub exists.
 *
 * A view with nothing to show has no pill, and the first one that does is
 * the one that opens: today that is press (the agencies and the press
 * reviews are in), since no story exists yet.
 */
interface Props {
  lang: LocaleId;
  settings: any;
}

const { lang, settings } = Astro.props;
const t = useTranslations(lang);
const external = { target: '_blank', rel: 'noopener noreferrer' };

const [clips, news, editions, partners] = await Promise.all([
  getPressClips(),
  getNews(lang),
  getEditions(lang),
  getPartners(lang),
]);

/* ---------------------------------------------------------------- stories */
/*
 * BACKEND-REQUEST #21: interviews (portrait, name, the role they speak in -
 * guest of honour, main partner, media partner - a short text and a link)
 * and the collectors' voices series (date, picture, title, text, link, and
 * the "discover Ceramics Now ↗" link beside its intro). No document carries
 * either, so the view has nothing to render and no pill.
 */
const interviews: any[] = [];
const collectors: any[] = [];
const hasStories = interviews.length > 0 || collectors.length > 0;

/* ------------------------------------------------------------------ press */
const CLIPS_FIRST = 6;

/*
 * Press releases are news items in the "press release" category, which are
 * already published in all three languages - so the design's "read in EN /
 * FR / NL" pills are the item's page in each language.
 *
 * BACKEND-REQUEST #22: the "sort by" pills are editions, and `NEWS_CARD`
 * does not return the item's edition (the field exists, hidden). Meanwhile
 * a release belongs to the first edition that ends after it was published -
 * the fair is in January, so a release from February 2026 on is about 2027.
 */
const releases = news.filter((n: any) => n.category === 'press-release');
const byEnd = [...editions].filter((e: any) => e.endDate).sort((a: any, b: any) => a.endDate.localeCompare(b.endDate));
const editionOf = (date: string) =>
  (byEnd.find((e: any) => e.endDate >= date.slice(0, 10)) ?? byEnd[byEnd.length - 1])?.year;
const releaseGroups = editions
  .map((e: any) => ({
    year: e.year,
    label: e.ordinal ?? String(e.year),
    items: releases.filter((r: any) => r.publishedAt && editionOf(r.publishedAt) === e.year),
  }))
  .filter((g: any) => g.items.length > 0);

// Each edition's press clippings book, as the old site linked them.
const reviews = [...editions]
  .filter((e: any) => e.pressClipsUrl)
  .sort((a: any, b: any) => a.year - b.year);

const agencies: any[] = settings?.pressContacts ?? [];

const hasPress = clips.length > 0 || releaseGroups.length > 0 || reviews.length > 0 || agencies.length > 0;

/* ------------------------------------------------------- photos & videos */
const galleries = editions
  .map((e: any) => ({
    year: e.year,
    film: e.film?.url ? e.film : null,
    images: (e.images ?? []).filter((img: any) => img?.asset),
  }))
  .filter((g: any) => g.images.length > 0 || g.film);
const hasPhotos = galleries.length > 0;

/**
 * The frame's rhythm, twelve pictures long: a full-width picture, two
 * halves, three thirds, two halves, a full-width one, three thirds. The
 * gallery repeats it for as many pictures as the edition has.
 */
const RHYTHM = ['hero', 'half', 'half', 'third', 'third', 'third', 'half', 'half', 'hero', 'third', 'third', 'third'];
const IMAGE_SIZES: Record<string, { widths: number[]; sizes: string }> = {
  hero: { widths: [900, 1400, 2000], sizes: '100vw' },
  half: { widths: [700, 1000, 1400], sizes: '(max-width: 800px) 100vw, 50vw' },
  third: { widths: [480, 720, 960], sizes: '(max-width: 800px) 100vw, 33vw' },
};
/** "Hall A © Geoffrey Fritsch, 2026", as the frame writes each caption. */
const captionOf = (img: any, year: number) => {
  const who = [img.caption, img.workTitle].filter(Boolean).join(', ');
  const credit = img.credit ? `© ${img.credit}` : '';
  const line = [who, credit].filter(Boolean).join(' ');
  return line ? `${line}${img.year || year ? `, ${img.year ?? year}` : ''}` : '';
};

/* -------------------------------------------------------- media partners */
const mediaPartners = partners.filter((p: any) => p.tier === 'media');
const hasPartners = mediaPartners.length > 0;
/**
 * The logos as one family, the way the partners hub sizes them (request
 * #11): the wider the file, the shorter its slot, and the editor's
 * "Logo size (%)" on top.
 */
const logoHeight = (p: any) => {
  const ar = p.logo?.dimensions?.aspectRatio;
  const base = !ar || !Number.isFinite(ar) || ar <= 0 ? 80 : Math.min(110, Math.max(44, 118 / Math.pow(ar, 0.45)));
  return Math.round(base * ((p.logoScale ?? 100) / 100));
};

/* ----------------------------------------------------------------- views */
const views = [
  { slug: 'stories', label: t('press.stories'), show: hasStories },
  { slug: 'press', label: t('tabs.press'), show: hasPress },
  { slug: 'photos-videos', label: t('press.photosVideos'), show: hasPhotos },
  { slug: 'media-partners', label: t('press.mediaPartners'), show: hasPartners },
].filter((v) => v.show);
const items = views.map((v) => ({ slug: v.slug, label: v.label, href: `#${v.slug}` }));
const first = views[0]?.slug;
---

<HubNav lang={lang} route="about" active={first ?? ''} title={t('tabs.pressMedia')} items={items} class="press-band" />

<div class="press-media" data-press-media data-first={first}>
  {views.length === 0 && <p class="empty">{t('press.empty')}</p>}

  {/* ------------------------------------------------------------ stories */}
  {
    hasStories && (
      <section class="view" data-view-panel="stories">
        {interviews.length > 0 && (
          <>
            <div class="section-intro">
              <h2>{t('press.interviews')}</h2>
            </div>
            <div class="interview-grid" data-more-list>
              {interviews.map((story: any) => (
                <article class="story-card">
                  {story.image?.asset && (
                    <SanityImage image={story.image} aspect={1.5} widths={[440, 660, 880]} sizes="(max-width: 800px) 100vw, 33vw" />
                  )}
                  <h3>{story.title}</h3>
                  {story.role && <strong>{story.role}</strong>}
                  {story.text && <p>{story.text}</p>}
                  {story.url && (
                    <a class="small-pill" href={story.url}>
                      {t('press.readInterview')} →
                    </a>
                  )}
                </article>
              ))}
            </div>
          </>
        )}
        {collectors.length > 0 && (
          <>
            <div class="section-intro collectors">
              <h2>{t('press.collectorsVoices')}</h2>
            </div>
            <div class="collector-list">
              {collectors.map((story: any) => (
                <article>
                  {story.image?.asset && (
                    <SanityImage image={story.image} aspect={1.5} widths={[700, 1000, 1400]} sizes="(max-width: 800px) 100vw, 50vw" />
                  )}
                  <div>
                    <p class="dated">
                      <strong>{formatMonthYear(story.date, lang)}</strong>
                    </p>
                    <h3>{story.title}</h3>
                    {story.text && <p>{story.text}</p>}
                    {story.url && (
                      <a class="small-pill" href={story.url}>
                        {t('press.readInterview')} →
                      </a>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </>
        )}
      </section>
    )
  }

  {/* -------------------------------------------------------------- press */}
  {
    hasPress && (
      <section class="view" data-view-panel="press">
        {clips.length > 0 && (
          <>
            <div class="top-section">
              <h2>{t('press.asSeen')}</h2>
              {/* BACKEND-REQUEST #19: the frame's lead under this heading ("Discover a
                  selection of articles…") is copy, and has no field. */}
            </div>
            <div class="press-cards" data-more-list data-more-step={CLIPS_FIRST}>
              {clips.map((clip: any, i: number) => {
                const href = clip.url ?? clip.pdfUrl;
                return (
                  <a class="press-card" href={href} hidden={i >= CLIPS_FIRST} {...(href ? external : {})}>
                    {/* BACKEND-REQUEST #20: the design leads each card with the
                        magazine's cover; `pressClip` has no image field. */}
                    <div class="card-body">
                      <p class="dated small">
                        <time datetime={clip.publishedAt}>{formatDateNumeric(clip.publishedAt, lang)}</time>
                      </p>
                      <h3>{clip.title}</h3>
                      <p class="card-foot">
                        <strong>{clip.outlet}</strong>
                        {href && <span>{t('press.readTheArticle')} ↗</span>}
                      </p>
                    </div>
                  </a>
                );
              })}
            </div>
            {clips.length > CLIPS_FIRST && (
              <button class="load-more" type="button" data-more>
                {t('press.loadMore')} <span>↓</span>
              </button>
            )}
          </>
        )}

        {(releaseGroups.length > 0 || reviews.length > 0) && (
          <>
            <div class="top-section">
              <h2>{t('press.room')}</h2>
              {/* BACKEND-REQUEST #19: the frame's lead ("Benefiting from strong
                  international visibility…") is copy, and has no field. */}
              {settings?.pressKitUrl && (
                <p class="kit">
                  <a class="small-pill" href={settings.pressKitUrl} {...external}>
                    {t('about.pressKit')} ↗
                  </a>
                </p>
              )}
            </div>
            <div class:list={['room-grid', { single: !releaseGroups.length || !reviews.length }]}>
              {releaseGroups.length > 0 && (
                <section class="releases">
                  <h3>{t('press.releases')}</h3>
                  {releaseGroups.length > 1 && (
                    <div class="sort" data-filter-bar="releases">
                      <b>{t('press.sortBy')}:</b>
                      {releaseGroups.map((g: any, i: number) => (
                        <button type="button" data-filter={g.year} aria-pressed={String(i === 0)}>
                          {g.label}
                        </button>
                      ))}
                    </div>
                  )}
                  {releaseGroups.map((g: any, i: number) => (
                    <div data-filter-group="releases" data-value={g.year} hidden={i > 0}>
                      {g.items.map((r: any) => (
                        <article>
                          <p class="dated">
                            <strong>{formatMonthYear(r.publishedAt, lang)}</strong>
                          </p>
                          <h4 {...styleAttrs(r.titleStyle)}>{r.title}</h4>
                          <div class="languages">
                            {LOCALE_IDS.map((l) => (
                              <a class="small-pill" href={localePath(l, `news/${r.slug}`)} hreflang={l}>
                                {t('press.readIn')} {l.toUpperCase()} →
                              </a>
                            ))}
                          </div>
                        </article>
                      ))}
                    </div>
                  ))}
                </section>
              )}
              {reviews.length > 0 && (
                <section class="reviews">
                  <h3>{t('press.reviews')}</h3>
                  {reviews.map((e: any) => (
                    <a href={e.pressClipsUrl} {...external}>
                      {e.year}, {e.ordinal ?? e.year} <span>↗</span>
                    </a>
                  ))}
                </section>
              )}
            </div>
          </>
        )}

        {agencies.length > 0 && (
          <section class="agencies">
            <h3>{t('press.agencies')}</h3>
            <div class="agency-grid">
              {agencies.map((c: any) => (
                <article>
                  {c.region && (
                    <strong {...styleAttrs(c.regionStyle)}>
                      {t('press.relations').replace('{region}', c.region)}
                    </strong>
                  )}
                  {c.name && <p>{c.name}</p>}
                  {c.email && (
                    <a class="mail" href={`mailto:${c.email}`}>
                      {c.email} ↗
                    </a>
                  )}
                  {(c.url || c.instagram) && (
                    <p class="pills">
                      {c.url && (
                        <a class="small-pill" href={c.url} {...external}>
                          {t('common.website')} ↗
                        </a>
                      )}
                      {c.instagram && (
                        <a class="small-pill" href={instagramUrl(c.instagram)} {...external}>
                          {t('common.instagram')} ↗
                        </a>
                      )}
                    </p>
                  )}
                </article>
              ))}
            </div>
          </section>
        )}
      </section>
    )
  }

  {/* ---------------------------------------------------- photos & videos */}
  {
    hasPhotos && (
      <section class="view" data-view-panel="photos-videos">
        {/* BACKEND-REQUEST #19: the frame's lead ("ceramic brussels unfolds over
            five days of discovery…") is copy, and has no field. The frame's
            "search by media ↓" pill is not built: nothing says what it searches. */}
        {galleries.length > 1 && (
          <div class="sort filters" data-filter-bar="photos">
            <b>{t('faq.filters')}:</b>
            {galleries.map((g: any, i: number) => (
              <button type="button" data-filter={g.year} aria-pressed={String(i === 0)}>
                {g.year}
              </button>
            ))}
          </div>
        )}
        {galleries.map((g: any, i: number) => (
          <div class="photo-grid" data-filter-group="photos" data-value={g.year} hidden={i > 0}>
            {g.film && (
              <figure class="hero film">
                <VideoEmbed
                  url={g.film.url}
                  poster={
                    g.film.poster?.asset
                      ? urlFor(g.film.poster).width(1800).height(1013).fit('crop').auto('format').quality(78).url()
                      : '/assets/video-still.webp'
                  }
                  label={g.film.title ?? String(g.year)}
                />
                {g.film.title && <figcaption>{g.film.title}</figcaption>}
              </figure>
            )}
            {g.images.map((img: any, n: number) => {
              const shape = RHYTHM[n % RHYTHM.length];
              const caption = captionOf(img, g.year);
              return (
                <figure class={shape}>
                  <SanityImage image={img} widths={IMAGE_SIZES[shape].widths} sizes={IMAGE_SIZES[shape].sizes} />
                  {caption && <figcaption>{caption}</figcaption>}
                </figure>
              );
            })}
          </div>
        ))}
      </section>
    )
  }

  {/* ----------------------------------------------------- media partners */}
  {
    hasPartners && (
      <section class="view" data-view-panel="media-partners">
        {/* BACKEND-REQUEST #19: the frame's lead ("The strong commitment of
            leading media outlets…") is copy, and has no field. */}
        <ul class="logo-grid">
          {mediaPartners.map((p: any) => {
            const inner = p.logo?.asset ? (
              <SanityImage image={p.logo} widths={[240, 480]} sizes="240px" class="logo" placeholder={false} />
            ) : (
              <span class="wordmark">{p.name}</span>
            );
            return (
              <li style={`--logo-h:${logoHeight(p)}px`}>
                {p.url ? (
                  <a href={p.url} {...external} aria-label={p.logo?.asset ? p.name : undefined}>
                    {inner}
                  </a>
                ) : (
                  inner
                )}
              </li>
            );
          })}
        </ul>
      </section>
    )
  }
</div>

<style>
  /* From the press & media hand-off (2026-09-21). */
  /* A gap, not a sibling margin: a hidden view still counts as a sibling. */
  .press-media {
    flex-direction: column;
    gap: 80px;
    padding: 0 var(--gutter) 80px;
    display: flex;
  }
  .view[hidden] {
    display: none;
  }
  .view > :first-child {
    margin-top: 0;
  }

  .small-pill {
    white-space: nowrap;
    border: 1px solid;
    border-radius: 999px;
    align-items: center;
    padding: 1px 12px;
    font-size: 20px;
    line-height: 28px;
    display: inline-flex;
    transition:
      color 0.18s,
      background-color 0.18s;
  }
  .small-pill:hover {
    color: #fff;
    background: #050505;
  }

  /* Section heads: a 2px rule, the name at 52px, the lead beside or under it. */
  .top-section,
  .section-intro {
    border-top: 2px solid;
    padding-top: 10px;
  }
  .top-section + *,
  .section-intro + * {
    margin-top: 42px;
  }
  .top-section h2,
  .section-intro h2 {
    letter-spacing: -0.05em;
    font-size: 52px;
    font-weight: 400;
    line-height: 1.05;
  }
  .top-section .kit {
    margin-top: 24px;
  }
  .press-cards + .top-section,
  .load-more + .top-section,
  .interview-grid + .section-intro {
    margin-top: 80px;
  }

  .dated {
    text-transform: uppercase;
    align-items: center;
    gap: 12px;
    font-size: 22px;
    display: flex;
  }
  .dated::after {
    content: '';
    background: currentColor;
    flex: 1;
    height: 1px;
  }
  .dated.small {
    font-size: 16px;
  }

  .load-more {
    cursor: pointer;
    background: 0 0;
    border: 0;
    border-bottom: 2px solid;
    margin: 52px auto 0;
    font-size: 38px;
    display: block;
  }
  .load-more span {
    transition: transform 0.2s;
    display: inline-block;
  }
  .load-more:hover span {
    transform: translateY(5px);
  }

  /* stories */
  .interview-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    display: grid;
  }
  .story-card :global(img) {
    object-fit: cover;
    width: 100%;
    height: 289px;
  }
  .story-card h3 {
    margin-top: 8px;
    font-size: 40px;
    line-height: 1;
  }
  .story-card strong {
    text-transform: uppercase;
    margin-top: 16px;
    font-size: 24px;
    display: block;
  }
  .story-card p {
    margin: 10px 0 20px;
    font-size: 24px;
    line-height: 1.25;
  }
  .collector-list article {
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
    display: grid;
  }
  .collector-list :global(img) {
    object-fit: cover;
    width: 100%;
    height: 447px;
  }
  .collector-list h3 {
    letter-spacing: -0.04em;
    margin-top: 30px;
    font-size: 40px;
    line-height: 1.05;
  }
  .collector-list p:not(.dated) {
    margin: 22px 0 28px;
    font-size: 24px;
    line-height: 1.25;
  }

  /* press: the clippings */
  .press-cards {
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    display: grid;
  }
  .press-card {
    border: 1px solid;
    flex-direction: column;
    display: flex;
  }
  .press-card[hidden] {
    display: none;
  }
  .card-body {
    flex-direction: column;
    flex: 1;
    gap: 6px;
    padding: 12px 10px 10px;
    display: flex;
  }
  .card-body h3 {
    letter-spacing: -0.03em;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.1;
  }
  .card-foot {
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    margin-top: auto;
    padding-top: 12px;
    font-size: 16px;
    display: flex;
  }
  .card-foot strong {
    text-transform: uppercase;
    font-size: 12px;
  }
  .press-card:hover .card-foot span {
    text-decoration: underline;
  }

  /* press: the press room */
  .room-grid {
    grid-template-columns: 2fr 1fr;
    gap: 40px;
    display: grid;
  }
  .room-grid.single {
    grid-template-columns: 1fr;
  }
  .room-grid h3,
  .agencies h3 {
    border-bottom: 2px solid;
    padding-bottom: 8px;
    font-size: 34px;
    font-weight: 600;
    line-height: 1;
  }
  .sort {
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin: 38px 0 30px;
    font-size: 21px;
    display: flex;
  }
  .sort b {
    text-transform: uppercase;
    font-weight: 400;
  }
  .sort button {
    cursor: pointer;
    background: #fff;
    border: 1px solid;
    border-radius: 999px;
    padding: 1px 12px;
    font-size: 18px;
    line-height: 28px;
    transition:
      color 0.18s,
      background-color 0.18s;
  }
  .sort button[aria-pressed='true'],
  .sort button:hover {
    color: #fff;
    background: #000;
  }
  .releases article {
    padding: 0 0 48px;
  }
  .releases h3 + [data-filter-group] {
    margin-top: 30px;
  }
  .releases h4 {
    max-width: 800px;
    margin-top: 28px;
    font-size: 38px;
    font-weight: 400;
    line-height: 1.08;
  }
  .languages {
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 30px;
    display: flex;
  }
  .languages .small-pill {
    font-size: 18px;
  }
  .reviews > a {
    text-underline-offset: 4px;
    justify-content: flex-start;
    gap: 0.3em;
    padding: 16px 0 8px;
    font-size: 36px;
    text-decoration: underline 1px;
    display: flex;
  }
  .reviews > a:first-of-type {
    margin-top: 14px;
  }
  .reviews span {
    transition: transform 0.2s;
  }
  .reviews a:hover span {
    transform: translate(8px);
  }

  /* press: the agencies */
  .agencies {
    margin-top: 80px;
  }
  .agency-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 42px;
    display: grid;
  }
  .agency-grid strong {
    text-transform: uppercase;
    font-size: 22px;
    display: block;
  }
  .agency-grid p,
  .agency-grid .mail {
    margin-top: 14px;
    font-size: 22px;
  }
  .agency-grid .mail {
    text-underline-offset: 0.12em;
    text-decoration: underline 1px;
    display: inline-block;
  }
  .agency-grid .pills {
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
    display: flex;
  }

  /* photos & videos */
  .filters {
    margin: 20px 0 45px;
  }
  .photo-grid {
    grid-template-columns: repeat(6, 1fr);
    gap: 28px 40px;
    display: grid;
  }
  .photo-grid[hidden] {
    display: none;
  }
  .photo-grid figure {
    margin: 0;
  }
  .photo-grid .hero {
    grid-column: span 6;
  }
  .photo-grid .half {
    grid-column: span 3;
  }
  .photo-grid .third {
    grid-column: span 2;
  }
  .photo-grid :global(img) {
    object-fit: cover;
    width: 100%;
