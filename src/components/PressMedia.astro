<script>
  // The four views: one at a time, named in the hash so a view can be linked
  // to. The panels carry no id of the same name on purpose: the browser
  // would scroll to it and take the title band off the screen. Without this
  // script every view shows, one under the other.
  const root = document.querySelector<HTMLElement>('[data-press-media]');
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-view-panel]'));
  const pills = Array.from(document.querySelectorAll<HTMLAnchorElement>('.press-band a[data-view]'));
  if (root && panels.length > 1) {
    const show = (name: string | undefined) => {
      const target = panels.find((p) => p.dataset.viewPanel === name) ?? panels[0];
      for (const panel of panels) panel.hidden = panel !== target;
      for (const pill of pills) {
        const on = pill.dataset.view === target.dataset.viewPanel;
        pill.classList.toggle('active', on);
        if (on) pill.setAttribute('aria-current', 'page');
        else pill.removeAttribute('aria-current');
      }
    };
    show(location.hash.slice(1) || root.dataset.first);
    for (const pill of pills) {
      pill.addEventListener('click', (event) => {
        event.preventDefault();
        history.replaceState(null, '', `#${pill.dataset.view}`);
        show(pill.dataset.view);
      });
    }
    addEventListener('hashchange', () => show(location.hash.slice(1)));
  }

  // Year and edition pills: one group at a time.
  for (const bar of document.querySelectorAll<HTMLElement>('[data-filter-bar]')) {
    const name = bar.dataset.filterBar;
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('button[data-filter]'));
    const groups = Array.from(document.querySelectorAll<HTMLElement>(`[data-filter-group="${name}"]`));
    for (const button of buttons) {
      button.addEventListener('click', () => {
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
        for (const group of groups) group.hidden = group.dataset.value !== button.dataset.filter;
      });
    }
  }

  // "load more": the next few cards of the list above the button.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-more]')) {
    const list = button.previousElementSibling as HTMLElement | null;
    const step = Number(list?.dataset.moreStep) || 6;
    button.addEventListener('click', () => {
      const rest = Array.from(list?.querySelectorAll<HTMLElement>(':scope > [hidden]') ?? []);
      rest.slice(0, step).forEach((el) => (el.hidden = false));
      if (rest.length <= step) button.remove();
    });
  }
</script>
