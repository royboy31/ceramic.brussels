<script>
  // The views are tabs of their own since request #19; nothing switches
  // them here any more.

  // Year and edition pills: one group at a time.
  for (const bar of document.querySelectorAll<HTMLElement>('[data-filter-bar]')) {
    const name = bar.dataset.filterBar;
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('button[data-filter]'));
    const groups = Array.from(document.querySelectorAll<HTMLElement>(`[data-filter-group="${name}"]`));
    for (const button of buttons) {
      button.addEventListener('click', () => {
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
        for (const group of groups) group.hidden = group.dataset.value !== button.dataset.filter;
      });
    }
  }

  // "load more": the next few cards of the list above the button.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-more]')) {
    const list = button.previousElementSibling as HTMLElement | null;
    const step = Number(list?.dataset.moreStep) || 6;
    button.addEventListener('click', () => {
      const rest = Array.from(list?.querySelectorAll<HTMLElement>(':scope > [hidden]') ?? []);
      rest.slice(0, step).forEach((el) => (el.hidden = false));
      if (rest.length <= step) button.remove();
    });
  }
</script>
