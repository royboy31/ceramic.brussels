---
import Base from '../../layouts/Base.astro';
import HubNav from '../../components/HubNav.astro';
import PageSections from '../../components/PageSections.astro';
import SanityImage from '../../components/SanityImage.astro';
import Slideshow from '../../components/Slideshow.astro';
import PortableText from '../../components/PortableText.astro';
import { LOCALE_IDS, type LocaleId } from '../../lib/locales';
import { useTranslations } from '../../lib/i18n';
import { getHubPages, getPartners } from '../../lib/queries';
import { HUBS, PARTNER_TABS, hubTabPath, pageForTab , hubAltPaths } from '../../lib/hubs';
import { styleAttrs } from '../../lib/textStyle';

/**
 * The partners hub, as the design's partners pages draw it. The content
 * starts right under the tabs: the frames have no heading repeating the
 * tab's name (the first HTML build did). Institutions - and the tabs the
 * design has no frame for: main partner, event partners, media - are a
 * two-column grid of entries: the name over a rule, the text, then the
 * "website ↗" pill and the logo side by side. The hotel is one entry: the
 * photo with its slideshow beside the name, the text and the pill. Markup
 * and rules are Lilanga's build of the Figma partners frames.
 *
 * The name itself is not a link (client feedback of 2026-09-17, with the
 * annotated institutions frame): the pill carries the website, and it is
 * the pill everywhere - institutions, hotel, main, event and media.
 */
const { lang, tab } = Astro.props as { lang: LocaleId; tab: string };
const t = useTranslations(lang);

const [pages, partners] = await Promise.all([getHubPages(lang, 'partners'), getPartners(lang)]);
const page = pageForTab(pages, tab);
const hubTab = HUBS.partners.tabs.find((x) => x.slug === tab);
const tabLabel = page?.tabLabel ?? (hubTab ? t(hubTab.label) : tab);

const tiers = PARTNER_TABS[tab] ?? [];
const listed = partners.filter((p: any) => tiers.includes(p.tier));
const featured = tab === 'hotel';
const path = hubTabPath('partners', tab, lang);
const altPaths = hubAltPaths('partners', tab);
const external = { target: '_blank', rel: 'noopener noreferrer' };

/*
 * BACKEND-REQUEST #11: a per-partner logo scale on `partner` (see
 * docs/backend-requests.md). The logo files are of wildly different
 * proportions, and one fixed box makes a square mark read half the size of a
 * 4:1 wordmark beside it - the client's "sometimes the logos are very small,
 * sometimes big". Until an editor can set a size, the slot's height is
 * derived from the file's own aspect ratio (`dimensions`, which the IMAGE
 * projection already returns): the wider the file, the shorter the slot, so
 * the logos cover comparable area and read as one family. Between equal
 * height (exponent 0) and equal area (0.5); 0.45 keeps the widest wordmark
 * inside the 250px slot.
 */
const logoHeight = (image: any, max = 78, base = 92) => {
  const ar = image?.dimensions?.aspectRatio;
  if (!ar || !Number.isFinite(ar) || ar <= 0) return max;
  return Math.round(Math.min(max, Math.max(38, base / Math.pow(ar, 0.45))));
};
---

<Base
  lang={lang}
  title={page?.seo?.title ?? `${t('nav.partners')} — ${tabLabel}`}
  description={page?.seo?.description ?? page?.intro}
  noIndex={page?.seo?.noIndex}
  image={page?.seo?.ogImage ?? page?.cover}
  path={path}
  altPaths={altPaths}
  editId={page?._id}
  editType={page?._type}
>
  <HubNav lang={lang} route="partners" active={tab} pages={pages} />

  <div class:list={['content-wrap', featured ? 'hotel-page' : 'institutions-page']}>
    {page?.intro && <p class="intro-large" {...styleAttrs(page.introStyle)}>{page.intro}</p>}
    {page && <PageSections lang={lang} sections={page.sections} />}
    {
      page?.body && (
        <div class="body-24 page-body">
          <PortableText value={page.body} fieldStyle={page.bodyStyle} />
        </div>
      )
    }

    {
      listed.length === 0 ? (
        <p class="empty">{t('partners.empty')}</p>
      ) : featured ? (
        listed.map((p: any, i: number) => (
          <div class="hotel">
            <figure>
              {p.images?.some((img: any) => img?.asset) ? (
                <Slideshow
                  images={p.images}
                  widths={[670, 1000, 1340]}
                  sizes="(max-width: 700px) 100vw, 670px"
                  label={p.name}
                  id={`hotel-${i + 1}`}
                />
              ) : (
                <div class="hotel-placeholder" />
              )}
            </figure>
            <section>
              <h2 class="panel-title" {...styleAttrs(p.nameStyle)}>
                {p.name}
              </h2>
              {p.description && (
                <div class="body-24">
                  <PortableText value={p.description} fieldStyle={p.descriptionStyle} />
                </div>
              )}
              {p.url && (
                <a class="pill" href={p.url} {...external}>
                  {t('common.website')} ↗
                </a>
              )}
            </section>
          </div>
        ))
      ) : (
        <div class="institutions">
          {listed.map((p: any) => (
            <article>
              <h3 {...styleAttrs(p.nameStyle)}>{p.name}</h3>
              <div class="text">
                {p.description && <PortableText value={p.description} fieldStyle={p.descriptionStyle} />}
              </div>
              <div class="institution-foot">
                {p.url && (
                  <a class="pill" href={p.url} {...external}>
                    {t('common.website')} ↗
                  </a>
                )}
                {p.logo?.asset && (
                  /* BACKEND-REQUEST #11: slot height from the file's aspect ratio, see `logoHeight` above. */
                  <span class="logo-slot" style={`--logo-h:${logoHeight(p.logo)}px`}>
                    <SanityImage image={p.logo} widths={[250, 500]} sizes="250px" class="logo" placeholder={false} />
                  </span>
                )}
              </div>
            </article>
          ))}
        </div>
      )
    }

    {
      page?.images?.length > 0 && (
        <ul class="image-row">
          {page.images.map((img: any) => (
            <li>
              <SanityImage image={img} aspect={3 / 2} sizes="(max-width: 640px) 100vw, 440px" widths={[440, 880]} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>

<style>
  /* From the design's partners pages (html pages/partners/*). */
  .page-body {
    max-width: 1160px;
    margin: 0 0 40px;
  }
  .empty {
    margin-top: 40px;
    font-size: 24px;
  }
  /* With no lead or body above, the list starts right under the tabs: the
     frames put the first title's rule and the hotel photo ~65px under them. */
  .content-wrap > .institutions:first-child,
  .content-wrap > .hotel:first-child {
    margin-top: 33px;
  }

  /* institutions - and every other list tab */
  .institutions {
    grid-template-columns: 1fr 1fr;
    gap: 80px 40px;
    margin-top: 55px;
    display: grid;
  }
  /* Title rule as on the guest of honour page (client feedback, 2026-09-16). */
  .institutions h3 {
    border-bottom: 2px solid;
    letter-spacing: -0.04em;
    font-size: 36px;
    font-weight: 600;
    line-height: 1.2;
  }
  .institutions .text {
    min-height: 210px;
    padding-top: 25px;
  }
  .institutions .text :global(p) {
    white-space: pre-line;
    font-size: 24px;
    line-height: 1.25;
    letter-spacing: -0.03em;
  }
  .institutions .text :global(p + p) {
    margin-top: 1em;
  }
  .institution-foot {
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    min-height: 78px;
    display: flex;
  }
  .institution-foot .pill {
    flex: none;
  }
  /*
   * The design's logo slot is a 250px-wide block against the right edge of the
   * card, and its two examples are set text of about the same size. The real
   * logos are files of wildly different proportions - 4:1 wordmarks next to
   * near-square marks, several with transparent padding baked in - so the slot
   * is fixed and the file is fitted into it, right-aligned. Sizing each file to
   * its own bounds instead is what left one logo stranded mid-card and the next
   * twice its size. `margin-left: auto` keeps the logo right when the partner
   * has no website and it is the only thing in the row; `--logo-h` is set per
   * partner in the frontmatter (see `logoHeight`) so a square mark and a wide
   * wordmark carry about the same weight.
   */
  .logo-slot {
    flex: 1 1 auto;
    /* A replaced element will not shrink past its own width without this, so
       in a narrow column the pill is what gives, and it collapses into a
       three-line oval. The logo gives instead, and stays right-aligned. */
    min-width: 0;
    max-width: 250px;
    margin-left: auto;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }
  .logo-slot :global(.logo) {
    object-fit: contain;
    object-position: right center;
    width: 100%;
    min-width: 0;
    height: var(--logo-h, 78px);
  }

  /* hotel */
  .hotel {
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 55px;
    display: grid;
  }
  .hotel figure {
    margin: 0;
    position: relative;
  }
  .hotel :global(img) {
    width: 100%;
  }
  .hotel-placeholder {
    aspect-ratio: 3 / 2;
    background: #f0efed;
  }
  .hotel .pill {
    margin-top: 35px;
  }

  /*
   * Client feedback of 2026-09-17: "make the website buttons less thick,
   * harmonise everywhere", with the footer pills as the reference - a 1px
   * stroke close to the text, tight letter-spacing, no tall oval. The global
   * `.pill` (design.css) is 24px over a 34px line with 3px/18px of padding;
   * this scopes the slimmer set to the partners tabs, where the pill sits
   * under 24px body text.
   */
  /* Since 2026-09-23 the site's one pill size (Base.astro). */
  .pill {
    padding: var(--pill-pad);
    font-size: var(--pill-size);
    line-height: var(--pill-lh);
    letter-spacing: var(--pill-ls);
  }

  .image-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin: 90px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (width<=700px) {
    .institutions {
      grid-template-columns: 1fr;
    }
    .institutions .text {
      min-height: 0;
    }
    .institutions h3 {
      font-size: 28px;
    }
    .hotel {
      grid-template-columns: 1fr;
    }
    .image-row {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-top: 40px;
    }
  }
</style>
