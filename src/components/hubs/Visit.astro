---
import Base from '../../layouts/Base.astro';
import HubNav from '../../components/HubNav.astro';
import PageSections from '../../components/PageSections.astro';
import SanityImage from '../../components/SanityImage.astro';
import PartnerName from '../PartnerName.astro';
import Slideshow from '../../components/Slideshow.astro';
import PortableText from '../../components/PortableText.astro';
import { LOCALE_IDS, type LocaleId } from '../../lib/locales';
import { useTranslations, formatDate, localePath, type StringKey } from '../../lib/i18n';
import { FAQ_CATEGORIES } from '../../lib/options';
import { getHubPages, getSettings, getCurrentEdition, getPartners } from '../../lib/queries';
import { HUBS, hubTabPath, pageForTab , hubAltPaths } from '../../lib/hubs';
import { styleAttrs } from '../../lib/textStyle';

/**
 * Visitors info, as the design's visitors-info pages draw it. Practical
 * info: two columns - photo, address, tickets, hotel deal at the left;
 * intro, opening hours, access, the venue diagram at the right - then the
 * photo row -
 * from the current edition (hours, tickets) and site settings (venue,
 * access, hotel deal, photos). Food & drinks: the intro and a three-column
 * grid of the `food-drinks` partners with their slideshow figure. Floor plan and
 * FAQ have no design page and follow the same patterns. Markup and rules
 * are Lilanga's build of the frames.
 */
const { lang, tab } = Astro.props as { lang: LocaleId; tab: string };
const t = useTranslations(lang);

/**
 * The FAQ's questions under their category headings, in the order of
 * FAQ_CATEGORIES (client mock-up of 2026-09-15); a question without a
 * category, or with one the list no longer has, sits under "other". Only
 * the categories in use get a heading and a filter pill.
 */
const faqGroups = (faq: any[] | undefined) => {
  const known = FAQ_CATEGORIES.map((c) => c.value as string);
  const of = (q: any) => (known.includes(q.category) ? q.category : 'other');
  return known
    .map((value) => ({ value, label: t(`faq.category.${value}` as StringKey), items: (faq ?? []).filter((q) => of(q) === value) }))
    .filter((g) => g.items.length > 0);
};

const [pages, settings, edition, partners] = await Promise.all([
  getHubPages(lang, 'visit'),
  getSettings(lang),
  getCurrentEdition(lang),
  getPartners(lang),
]);
const page = pageForTab(pages, tab);
const hubTab = HUBS.visit.tabs.find((x) => x.slug === tab);
const tabLabel = page?.tabLabel ?? (hubTab ? t(hubTab.label) : tab);

const practical = tab === 'practical-info';
const info = settings?.practicalInfo ?? {};
const vendors = partners.filter((p: any) => p.tier === 'food-drinks');
const hotel = info.hotelDeal?.partner;
const hotelHref = info.hotelDeal?.url ?? localePath(lang, hubTabPath('partners', 'hotel', lang));

/** "ceramic brussels’ 4th edition will take place from 20 till 24 January 2027 at Tour & Taxis, Brussels." */
const composed =
  edition?.startDate && edition?.endDate
    ? t('visit.introSentence', {
        ordinal: edition.ordinal ?? `${edition.year}`,
        from: new Date(edition.startDate).getDate(),
        till: formatDate(edition.endDate, lang),
        venue: edition.venue ?? info.venueName ?? '',
      })
    : '';
const intro = page?.intro ?? (practical ? (info.intro ?? composed) : undefined);
const introStyle = page?.intro ? page.introStyle : practical && info.intro ? info.introStyle : null;

const lines = (s: string | undefined) => String(s ?? '').split(/\r?\n/).filter(Boolean);
/** The photo row at the foot of the page: site-settings images, then the hub page's own. */
const photos: any[] = (practical ? [...(info.images ?? []), ...(page?.images ?? [])] : (page?.images ?? [])).filter(
  (img: any) => img?.asset,
);
const siteName = settings?.siteName ?? 'ceramic brussels';
const path = hubTabPath('visit', tab, lang);
const altPaths = hubAltPaths('visit', tab);
---

<Base
  lang={lang}
  title={page?.seo?.title ?? `${t('nav.visit')} — ${tabLabel}`}
  description={page?.seo?.description ?? intro}
  noIndex={page?.seo?.noIndex}
  image={page?.seo?.ogImage ?? page?.cover ?? (practical ? info.heroImage : undefined)}
  path={path}
  altPaths={altPaths}
  editId={practical ? 'siteSettings' : page?._id}
  editType={practical ? 'siteSettings' : page?._type}
>
  <HubNav lang={lang} route="visit" active={tab} pages={pages} />

  {
    practical && (
      <div class="content-wrap practical">
        {/* Two independent columns, as the frame draws them: each runs down on
            its own, so neither leaves a gap under the other's longer panel.
            On a phone the four groups interleave (photo, intro + hours,
            address to hotel, access + map) - see the CSS. */}
        <div class="two-col columns">
          <section>
            {info.heroImage?.asset && (
              <SanityImage
                image={info.heroImage}
                widths={[700, 1000, 1400]}
                sizes="(max-width: 700px) 100vw, 50vw"
                loading="eager"
                class="visit-photo"
              />
            )}
            <div class="group address">
              <h2 class="panel-title">{t('visit.address')}</h2>
              <p class="body-24">
                {info.venueName && <strong>{info.venueName}</strong>}
                {lines(info.address).map((l) => (
                  <>
                    <br />
                    {l}
                  </>
                ))}
              </p>

              <h2 class="panel-title">{t('visit.tickets')}</h2>
              {edition?.tickets?.length ? (
                <div class="body-24">
                  {edition.tickets.map((tk: any) => (
                    <p>
                      <strong {...styleAttrs(tk.nameStyle)}>{tk.name}</strong>
                      <br />
                      {tk.price}
                      {tk.note && ` (${tk.note})`}
                    </p>
                  ))}
                  {edition.ticketsNote && <p {...styleAttrs(edition.ticketsNoteStyle)}>{edition.ticketsNote}</p>}
                </div>
              ) : (
                <p class="empty">{t('visit.noTickets')}</p>
              )}
              {edition?.ticketsUrl && (
                <a class="pill cta acid" href={edition.ticketsUrl} target="_blank" rel="noopener noreferrer">
                  {t('visit.bookTickets')} <span class="link-arrow" data-arrow="↗" aria-hidden="true">↗</span>
                </a>
              )}

              {(hotel || info.hotelDeal?.text) && (
                <>
                  <h2 class="panel-title">{t('visit.hotelDeal')}</h2>
                  <p class="body-24">
                    {hotel?.name && <strong>{hotel.name}</strong>}
                    {info.hotelDeal?.text && (
                      <>
                        <br />
                        {info.hotelDeal.text}
                      </>
                    )}
                  </p>
                  <a
                    class="pill cta light"
                    href={hotelHref}
                    {...(/^https?:\/\//.test(hotelHref) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {t('visit.discoverHotel')} <span class="link-arrow" data-arrow="↗" aria-hidden="true">↗</span>
                  </a>
                </>
              )}
            </div>
          </section>

          <section>
            <div class="group hours">
              {intro && (
                <p class="intro-large" {...styleAttrs(introStyle)}>
                  {intro}
                </p>
              )}
              <h2 class="panel-title">{t('visit.openingHours')}</h2>
              {edition?.openingHours?.length ? (
                <div class="body-24">
                  {edition.openingHours.map((d: any) => (
                    <p>
                      <strong {...styleAttrs(d.labelStyle)}>{d.label ?? formatDate(d.date, lang)}</strong>
                      {(d.slots ?? []).map((s: any) => (
                        <>
                          <br />
                          {[s.time, s.label].filter(Boolean).join(' ')}
                          {s.invitationOnly && ` (${t('visit.invitation')})`}
                        </>
                      ))}
                    </p>
                  ))}
                  {edition.lastEntry && <p {...styleAttrs(edition.lastEntryStyle)}>{edition.lastEntry}</p>}
                </div>
              ) : (
                <p class="empty">{t('visit.noHours')}</p>
              )}
            </div>

            <div class="group access">
              <h2 class="panel-title">{t('visit.access')}</h2>
              {info.access?.length > 0 && (
                <div class="body-24">
                  {info.access.map((a: any) => (
                    <p>
                      <strong {...styleAttrs(a.modeStyle)}>{a.mode}</strong>
                      {lines(a.text).map((l) => (
                        <>
                          <br />
                          {l}
                        </>
                      ))}
                    </p>
                  ))}
                  {info.accessibility && <p {...styleAttrs(info.accessibilityStyle)}>{info.accessibility}</p>}
                </div>
              )}
              {/* The site diagram under the access modes, as the design
                  places it: the current edition's "Venue map" when it has
                  one, else the designer's 2027 drawing shipped with the
                  site (2026-09-17). */}
              {
                edition?.venueMap?.asset ? (
                  <SanityImage
                    image={{ ...edition.venueMap, alt: edition.venueMap.alt || t('visit.mapAlt') }}
                    widths={[760, 1140, 1520]}
                    sizes="(max-width: 900px) 100vw, 760px"
                    class="venue-map"
                  />
                ) : (
                  <img
                    class="venue-map"
                    src="/assets/venue-map.png"
                    width="760"
                    height="536"
                    loading="lazy"
                    decoding="async"
                    alt={t('visit.mapAlt')}
                  />
                )
              }
            </div>
          </section>
        </div>

        {photos.length > 0 && (
          <div class="photo-row">
            {photos.map((img: any) => (
              <SanityImage image={img} aspect={1.5} widths={[440, 660, 880]} sizes="(max-width: 700px) 100vw, 33vw" />
            ))}
          </div>
        )}
      </div>
    )
  }

  {
    tab === 'food-drinks' && (
      <div class="content-wrap food-page">
        {intro && (
          <p class="intro-large" {...styleAttrs(introStyle)}>
            {intro}
          </p>
        )}
        {vendors.length ? (
          <div class="food">
            {vendors.map((v: any, i: number) => {
              const shots = (v.images ?? []).filter((img: any) => img?.asset);
              return (
                <article>
                  <h2>
                    <PartnerName partner={v} />
                  </h2>
                  {shots.length > 0 && (
                    <figure>
                      <Slideshow
                        images={shots}
                        aspect={1.5}
                        widths={[440, 660, 900, 1340]}
                        sizes="(max-width: 700px) 100vw, (max-width: 1180px) 50vw, 33vw"
                        label={v.name}
                        id={`vendor-${i + 1}`}
                      />
                    </figure>
                  )}
                  {v.description && (
                    <div class="body-24">
                      <PortableText value={v.description} fieldStyle={v.descriptionStyle} />
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        ) : (
          <p class="empty">{t('partners.empty')}</p>
        )}
      </div>
    )
  }

  {
    tab === 'floor-plan' && (
      <div class="content-wrap practical">
        {intro && (
          <p class="intro-large" {...styleAttrs(introStyle)}>
            {intro}
          </p>
        )}
        {edition?.fairMapUrl ? (
          <a class="pill cta dark" href={edition.fairMapUrl} target="_blank" rel="noopener noreferrer">
            {t('visit.downloadMap')} ↗
          </a>
        ) : (
          <p class="empty body-24">{t('visit.noMap')}</p>
        )}
        {page && <PageSections lang={lang} sections={page.sections} />}
      </div>
    )
  }

  {
    tab === 'faq' && (
      <div class="faq-page">
        {intro && (
          <p class="intro-large" {...styleAttrs(introStyle)}>
            {intro}
          </p>
        )}
        {settings?.faq?.length ? (
          (() => {
            const groups = faqGroups(settings.faq);
            return (
              <>
                {groups.length > 1 && (
                  <div class="filters" id="faq-filters">
                    <span>{t('faq.filters')}:</span>
                    <button type="button" data-filter="" aria-pressed="true">
                      {t('faq.all')}
                    </button>
                    {groups.map((g) => (
                      <button type="button" data-filter={g.value} aria-pressed="false">
                        {g.label}
                      </button>
                    ))}
                  </div>
                )}
                <div class="faq-groups" id="faq-groups">
                  {groups.map((g) => (
                    <section class="faq-group" data-category={g.value}>
                      {/* No heading while nothing is categorised: one "other" group is just the list. */}
                      {(groups.length > 1 || g.value !== 'other') && <h2>{g.label}</h2>}
                      {g.items.map((q: any) => (
                        <details class="faq">
                          <summary>
                            <span class="question" {...styleAttrs(q.questionStyle)}>
                              {q.question}
                            </span>
                            <i aria-hidden="true">↓</i>
                          </summary>
                          <div class="answer">
                            <div>
                              <PortableText value={q.answer} fieldStyle={q.answerStyle} />
                            </div>
                          </div>
                        </details>
                      ))}
                    </section>
                  ))}
                </div>
              </>
            );
          })()
        ) : (
          <p class="empty body-24">{t('visit.noFaq')}</p>
        )}
        {page && <PageSections lang={lang} sections={page.sections} />}
        {(() => {
          const [before, after = ''] = t('visit.faqContact', { link: '\u0000' }).split('\u0000');
          return (
            <p class="faq-contact">
              {before}
              <a href={localePath(lang, hubTabPath('about', 'team', lang))}>{t('visit.faqContactLink')}</a>
              {after}
            </p>
          );
        })()}
      </div>
    )
  }

  {
    !practical && page?.body && (
      <div class="content-wrap">
        <div class="body-24">
          <PortableText value={page.body} fieldStyle={page.bodyStyle} />
        </div>
      </div>
    )
  }
</Base>

<style>
  /* From the design's visitors-info pages. */
  .columns {
    align-items: start;
  }
  .columns :global(.visit-photo) {
    object-fit: cover;
    width: 100%;
    height: 447px;
  }
  .panel-title {
    margin-top: 50px;
  }
  .group > .panel-title:first-child {
    margin-top: 0;
  }
  /* The frame's address rule sits ~125px under the photo. */
  .address {
    margin-top: 80px;
  }
  .hours > .intro-large + .panel-title {
    margin-top: 54px;
  }
  .access {
    margin-top: 45px;
  }
  /* The frame's opening-hours days sit closer than body-24's 28px. */
  .hours .body-24 :global(p + p) {
    margin-top: 18px;
  }
  /* The calls to action at the site's pill size, as the award ceremony
     page's buttons (client feedback, 2026-09-24: "less wide"). */
  .cta {
    margin-top: 30px;
    padding: var(--pill-pad);
  }
  .dark {
    color: var(--ground);
    background: var(--ink);
  }
  /* "book your tickets" is acid with black text, and turns black with white
     text on hover; "discover the hotel" is white with a black outline
     (client feedback, 2026-09-17). Both hovers are design.css's own .pill
     rule - it is .pill.dark that swaps the other way, so neither carries it. */
  .acid {
    color: var(--ink);
    background: var(--acid);
    border-color: var(--ink);
  }
  .light {
    color: var(--ink);
    background: var(--ground);
    border-color: var(--ink);
  }
  /* The labels (days, tickets, access modes) are the 600 cut in normal
     tracking; the browser's bold resolves to the 900 file. */
  .body-24 strong {
    text-transform: uppercase;
    letter-spacing: 0;
    font-weight: 600;
  }
  /* :global - the Sanity version is SanityImage's own <img>, outside this scope. */
  :global(.venue-map) {
    width: 100%;
    height: auto;
    margin-top: 35px;
  }
  .photo-row {
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 90px;
    display: grid;
  }
  .photo-row :global(img) {
    aspect-ratio: 1.5;
    object-fit: cover;
    width: 100%;
  }
  @media (width<=700px) {
    .photo-row {
      grid-template-columns: 1fr;
    }
    /* One column, read in order: photo, intro + hours, address to hotel,
       access + map. */
    .columns {
      gap: 0;
    }
    .columns > section {
      display: contents;
    }
    .columns :global(.visit-photo) {
      height: auto;
    }
    .hours {
      order: 1;
      margin-top: 28px;
    }
    .address {
      order: 2;
      margin-top: 50px;
    }
    .access {
      order: 3;
      margin-top: 50px;
    }
  }

  /* food & drinks. Three columns, so the pictures read smaller (client
     feedback, 2026-09-17); two once a column would be under ~330px, one on a
     phone. Each vendor is the same stack as before: title and ↗ over its
     rule, the slideshow, its counter, then the description. */
  .food {
    grid-template-columns: repeat(3, 1fr);
    gap: 50px 40px;
    margin-top: 55px;
    display: grid;
  }
  /* Title rule as on the guest of honour page (client feedback, 2026-09-16). */
  .food h2 {
    border-bottom: 2px solid;
    /* The frame's rule sits ~12px under the text, the picture 28px below it. */
    margin-bottom: 28px;
    padding-bottom: 4px;
    letter-spacing: -0.04em;
    font-size: 36px;
    font-weight: 600;
    line-height: 1.2;
  }
  .food figure {
    margin: 0;
    position: relative;
  }
  .food :global(img) {
    aspect-ratio: 1.5;
    object-fit: cover;
    width: 100%;
  }
  .food .body-24 {
    margin-top: 14px;
    font-size: var(--body-size);
    letter-spacing: var(--body-ls);
    line-height: var(--body-lh);
  }
  @media (width<=1180px) {
    .food {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (width<=700px) {
    .food {
      grid-template-columns: 1fr;
    }
    .food h2 {
      font-size: 30px;
    }
    .food .body-24 {
      font-size: 18px;
      line-height: 1.3;
    }
  }

  /* FAQ, from the visitors-info FAQ mock-up (2026-09-15): the questions in
     two columns, every one closed, each over its own rule; they fold open
     with the arrow turning and the answer growing. Rows pair across the
     columns, so opening one never moves the other column's questions. */
  .faq-page {
    padding: 8px var(--gutter) 100px;
  }
  .faq-page > .intro-large {
    max-width: 1100px;
    margin-bottom: 58px;
  }
  .filters {
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 40px;
    display: flex;
  }
  .filters span {
    margin-right: 8px;
    text-transform: uppercase;
  }
  .filters button {
    border: 1px solid;
    border-radius: 999px;
    padding: 5px 16px;
    font-size: 18px;
    background: #fff;
    cursor: pointer;
    transition:
      color 0.18s,
      background 0.18s;
  }
  .filters button[aria-pressed='true'],
  .filters button:hover {
    color: #fff;
    background: #000;
  }
  /* The groups flow down two columns, each heading over a rule with its
     questions beneath; a group never splits across the columns. */
  .faq-groups {
    columns: 2;
    column-gap: clamp(30px, 3vw, 44px);
  }
  .faq-group {
    break-inside: avoid;
    margin-bottom: clamp(40px, 4vw, 64px);
  }
  .faq-group h2 {
    letter-spacing: -0.03em;
    border-bottom: 1px solid;
    margin: 0;
    padding-bottom: 10px;
    font-size: clamp(22px, 2vw, 29px);
    font-weight: 700;
    line-height: 1.1;
  }
  .faq {
    border-bottom: 1px solid;
  }
  .faq summary {
    cursor: pointer;
    letter-spacing: -0.03em;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    padding: 34px 0 6px;
    font-size: clamp(22px, 2vw, 29px);
    line-height: 1.1;
    list-style: none;
    display: flex;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary i {
    flex: none;
    font-size: 1.15em;
    font-style: normal;
    line-height: 1;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .faq[open] summary i {
    transform: rotate(180deg);
  }
  .faq .answer {
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    display: grid;
  }
  .faq[open] .answer {
    grid-template-rows: 1fr;
  }
  /* The site's body size, like every other page (client feedback,
     2026-09-24: the answers were yet another size). */
  .faq .answer > div {
    letter-spacing: var(--body-ls);
    padding: 6px 0 20px;
    font-size: var(--body-size);
    line-height: var(--body-lh);
    overflow: hidden;
  }
  .faq .answer :global(p + p) {
    margin-top: 1em;
  }
  .faq-page .empty {
    padding-top: 10px;
  }
  .faq-contact {
    letter-spacing: -0.03em;
    margin-top: clamp(60px, 6vw, 90px);
    font-size: clamp(24px, 2.6vw, 38px);
    line-height: 1.2;
  }
  .faq-contact a {
    text-underline-offset: 0.15em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  @media (width<=760px) {
    .faq-groups {
      columns: 1;
    }
  }
  @media (width<=700px) {
    .faq-page > .intro-large {
      margin-bottom: 36px;
    }
    .faq-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .faq summary {
      padding-top: 26px;
    }
  }
</style>

<script>
  // FAQ filter pills: one category at a time, "all" showing every group.
  const bar = document.getElementById('faq-filters');
  const groups = Array.from(document.querySelectorAll<HTMLElement>('#faq-groups .faq-group'));
  if (bar && groups.length) {
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('button[data-filter]'));
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const value = button.dataset.filter ?? '';
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
        for (const group of groups) group.hidden = !!value && group.dataset.category !== value;
      });
    }
  }
</script>
