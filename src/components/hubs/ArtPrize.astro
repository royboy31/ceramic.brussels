---
import Base from '../../layouts/Base.astro';
import HubNav from '../../components/HubNav.astro';
import Sections from '../../components/Sections.astro';
import PageSections from '../../components/PageSections.astro';
import SanityImage from '../../components/SanityImage.astro';
import Slideshow from '../../components/Slideshow.astro';
import PortableText from '../../components/PortableText.astro';
import { LOCALE_IDS, type LocaleId } from '../../lib/locales';
import { useTranslations, localePath } from '../../lib/i18n';
import { getHubPages, getLaureates, getAwards, getPeople } from '../../lib/queries';
import { HUBS, hubTabPath, pageForTab , hubAltPaths } from '../../lib/hubs';
import { instagramUrl, artistHref } from '../../lib/links';
import { styleAttrs } from '../../lib/textStyle';

/**
 * The art prize hub on its acid ground, as the design's three art prize
 * pages draw it. About: the cover with its counter, dots and caption beside
 * the intro, the text sections two across, the partners row, the closing
 * images. Laureates: one row per laureate, picture and text alternating
 * sides. Awards: the intro line and a two-column masonry of award blocks.
 * Jury (no design page): the advisory-board article treatment.
 */
const { lang, tab } = Astro.props as { lang: LocaleId; tab: string };
const hub = HUBS['art-prize'];
const t = useTranslations(lang);

const pages = await getHubPages(lang, 'art-prize');
const page = pageForTab(pages, tab);

// The current edition's laureates; the latest edition with any when the
// current one has none yet.
const laureateYears = tab === 'laureates' ? await getLaureates(lang) : [];
const laureates: any[] = (laureateYears.find((y: any) => y.isCurrent) ?? laureateYears[0])?.laureates ?? [];
/** "PL" → "Poland" / "Pologne" / "Polen", in the page's language. */
const regions = new Intl.DisplayNames([lang], { type: 'region' });
const regionName = (code?: string) => {
  if (!code || !/^[A-Za-z]{2}$/.test(code)) return code ?? '';
  try {
    return regions.of(code.toUpperCase()) ?? code;
  } catch {
    return code;
  }
};

// The newest edition's art prize awards - the design lists one edition.
const allAwards = tab === 'awards' ? (await getAwards(lang)).filter((a: any) => a.family === 'art-prize' && a.year) : [];
const awardYear = allAwards[0]?.year;
const awards = allAwards.filter((a: any) => a.year === awardYear);

const jury = tab === 'jury' ? await getPeople(lang, 'jury') : [];

const path = hubTabPath('art-prize', tab, lang);
const altPaths = hubAltPaths('art-prize', tab);
const tabKey = hub.tabs.find((x) => x.slug === tab)?.label;
const tabLabel = page?.tabLabel ?? (tabKey ? t(tabKey) : tab);

/** The stack in the editor's order, runs of text blocks drawn two across as the design does. */
const runs: { text: boolean; items: any[] }[] = [];
for (const s of page?.sections ?? []) {
  const text = s?._type === 'contentSection';
  const last = runs[runs.length - 1];
  if (last && last.text === text) last.items.push(s);
  else runs.push({ text, items: [s] });
}
const firstText = runs.findIndex((r) => r.text);
/**
 * The cover is one image today; the design draws the hero as a slideshow
 * with a dot per picture and a "1/3" counter. Both follow the real count:
 * no dot for a lone picture.
 */
const heroImages: any[] = page?.cover?.asset ? [page.cover] : [];
const closing: any[] = (page?.images ?? []).filter((img: any) => img?.asset);

/**
 * The laureate bios end on a paragraph that is only the artist's "@handle"
 * linked to Instagram, and the artist's own instagram field is empty. The
 * client wants the instagram pill instead (feedback, 2026-09-16), so that
 * closing paragraph is lifted out of the text and becomes the pill's link.
 */
const liftInstagram = (blocks: any[] | undefined) => {
  const list = Array.isArray(blocks) ? blocks : [];
  const last = list[list.length - 1];
  const text = (last?.children ?? []).map((c: any) => c?.text ?? '').join('').trim();
  const link = (last?.markDefs ?? []).find((m: any) => /instagram\.com/i.test(m?.href ?? ''));
  if (last?._type !== 'block' || !link || !/^@[\w.]+$/.test(text)) return { blocks: list, href: null };
  return { blocks: list.slice(0, -1), href: link.href as string };
};

/** "A and B", "A, B and C" - the design writes "and". */
const joiner = (i: number, n: number) => (i === 0 ? '' : i === n - 1 ? ` ${t('common.and')} ` : ', ');
/** "Artist, *Title*, year" as the design captions a picture. */
const captionOf = (img: any, fallback?: string) => ({
  who: img?.caption ?? fallback,
  title: img?.workTitle,
  year: img?.year,
});
---

<Base
  lang={lang}
  title={page?.seo?.title ?? `${t('nav.artPrize')} — ${tabLabel}`}
  description={page?.seo?.description ?? page?.intro}
  noIndex={page?.seo?.noIndex}
  path={path}
  altPaths={altPaths}
  theme="acid"
  image={page?.seo?.ogImage ?? page?.cover}
  editId={page?._id}
  editType={page?._type}
>
  <HubNav lang={lang} route="art-prize" active={tab} pages={pages} dark />

  {
    tab === 'about' && (
      <div class="content-wrap prize-about">
        <div class="hero">
          {page?.cover?.asset ? (
            <figure>
              <SanityImage image={page.cover} loading="eager" sizes="(max-width: 700px) 100vw, 66vw" widths={[600, 900, 1200, 1800]} />
              {heroImages.length > 1 && (
                <span class="dots" aria-hidden="true">
                  {heroImages.map((_, i) => (
                    <i class:list={{ active: i === 0 }} />
                  ))}
                </span>
              )}
              <figcaption>
                <span class="counter">1/{heroImages.length}</span>
                {(page.cover.caption || page.cover.workTitle) && (
                  <span>
                    {captionOf(page.cover).who}
                    {captionOf(page.cover).title && (
                      <>
                        {captionOf(page.cover).who ? ', ' : ''}
                        <em>{captionOf(page.cover).title}</em>
                      </>
                    )}
                    {captionOf(page.cover).year && `, ${captionOf(page.cover).year}`}
                  </span>
                )}
              </figcaption>
            </figure>
          ) : (
            <div />
          )}
          {page?.intro && <p {...styleAttrs(page.introStyle)}>{page.intro}</p>}
        </div>

        {runs.map((run, i) =>
          run.text ? (
            <Sections lang={lang} sections={run.items} columns={2} statementFirst={i === firstText} class="blocks" />
          ) : (
            <PageSections lang={lang} sections={run.items} />
          ),
        )}

        {page?.body && (
          <div class="body-24 blocks">
            <PortableText value={page.body} fieldStyle={page.bodyStyle} />
          </div>
        )}

        {closing.length > 0 && (
          <div class="gallery">
            {closing.map((img: any) => (
              <SanityImage image={img} aspect={1.5} sizes="(max-width: 700px) 100vw, 33vw" widths={[400, 600, 900, 1200]} />
            ))}
          </div>
        )}
      </div>
    )
  }

  {
    tab === 'laureates' && (
      <div class="laureates">
        {page?.intro && <p class="intro-large" {...styleAttrs(page.introStyle)}>{page.intro}</p>}
        {laureates.length ? (
          laureates.map((l: any, i: number) => {
            const artist = l.artist ?? {};
            // Five pictures per laureate (client feedback, 2026-09-16).
            const images = (l.images ?? []).filter((img: any) => img?.asset).slice(0, 5);
            const text = liftInstagram(l.statement ?? artist.bio);
            const instagram = artist.instagram ? instagramUrl(artist.instagram) : text.href;
            const first = images[0] ?? (artist.portrait?.asset ? artist.portrait : null);
            const cap = captionOf(first, first?.workTitle ? undefined : artist.name);
            /* "Poland, 1996" as the design writes it: the written nationality, else the
               country named from its code in the page's language; the base line when neither is there. */
            const country = artist.nationality || regionName(artist.countryCode);
            const place =
              [country, artist.birthYear].filter(Boolean).join(', ') ||
              (artist.basedIn ? `${t('artists.basedIn')} ${artist.basedIn}` : '');
            return (
              <article class:list={[{ reverse: i % 2 === 1 }]}>
                <figure>
                  <div class="image">
                    {images.length > 0 ? (
                      <Slideshow
                        images={images.map((img: any) => ({
                          ...img,
                          // The design captions a work "*Title* series #5": the name stands in
                          // only for a picture with no title, and no credit is shown.
                          caption: img.caption ?? (img.workTitle ? undefined : artist.name),
                          credit: undefined,
                        }))}
                        aspect={2 / 3}
                        sizes="(max-width: 640px) 100vw, 433px"
                        widths={[433, 866, 1300]}
                        label={artist.name}
                        id={`laureate-${i + 1}`}
                      />
                    ) : first ? (
                      <>
                        <SanityImage image={first} aspect={2 / 3} sizes="(max-width: 640px) 100vw, 433px" widths={[433, 866, 1300]} />
                        <figcaption>
                          <b>1/1</b>
                          {(cap.who || cap.title) && (
                            <span>
                              {cap.who}
                              {cap.title && (
                                <>
                                  {cap.who ? ', ' : ''}
                                  <em>{cap.title}</em>
                                </>
                              )}
                              {cap.year && `, ${cap.year}`}
                            </span>
                          )}
                        </figcaption>
                      </>
                    ) : (
                      <div class="placeholder" />
                    )}
                  </div>
                </figure>
                <section>
                  <div class="name">
                    <h2 {...styleAttrs(artist.nameStyle)}>
                      {/* A laureate's name leads to the gallery presenting them, when one does (client, 2026-09-22). */}
                      {artistHref(lang, artist) ? <a href={artistHref(lang, artist)}>{artist.name}</a> : artist.name}
                    </h2>
                    {instagram && (
                      <a class="pill" href={instagram} target="_blank" rel="noopener noreferrer">
                        {t('common.instagram')} ↗
                      </a>
                    )}
                  </div>
                  {place && (
                    <p class="place" {...styleAttrs(artist.nationalityStyle)}>
                      {place}
                    </p>
                  )}
                  {text.blocks.length > 0 && (
                    <div class="bio">
                      <PortableText value={text.blocks} fieldStyle={l.statement ? l.statementStyle : artist.bioStyle} />
                    </div>
                  )}
                </section>
              </article>
            );
          })
        ) : (
          <p class="empty">{t('artPrize.noLaureates')}</p>
        )}
      </div>
    )
  }

  {
    tab === 'awards' && (
      <div class="content-wrap awards-page">
        {page?.intro && <p class="intro-large" {...styleAttrs(page.introStyle)}>{page.intro}</p>}
        {awards.length ? (
          <div class="award-grid">
            {awards.map((a: any) => (
              <article>
                <h2 {...styleAttrs(a.nameStyle)}>{a.name}</h2>
                {(a.laureates?.length > 0 || a.outcome) && (
                  <p class="award">
                    →{' '}
                    {(a.laureates ?? []).map((l: any, i: number) => (
                      <>
                        {joiner(i, a.laureates.length)}
                        {artistHref(lang, l) ? <a href={artistHref(lang, l)}>{l.name}</a> : l.name}
                      </>
                    ))}
                    {a.laureates?.length > 0 && a.outcome && ' '}
                    {a.outcome}
                  </p>
                )}
                {a.description && (
                  <div class="body">
                    <PortableText value={a.description} fieldStyle={a.descriptionStyle} />
                  </div>
                )}
                {a.image?.asset && <SanityImage image={a.image} sizes="(max-width: 700px) 100vw, 50vw" widths={[500, 800, 1200]} />}
              </article>
            ))}
          </div>
        ) : (
          <p class="empty">{t('awards.empty')}</p>
        )}
      </div>
    )
  }

  {
    tab === 'jury' && (
      <div class="content-wrap">
        {page?.intro && <p class="intro-large" {...styleAttrs(page.introStyle)}>{page.intro}</p>}
        {jury.length ? (
          <div class="people">
            {jury.map((p: any) => (
              <article>
                <h2>
                  {p.name}
                  {p.countryCode && <sup class="nationality">{p.countryCode}</sup>}
                </h2>
                <div>
                  {p.portrait?.asset ? <SanityImage image={p.portrait} sizes="197px" widths={[197, 394, 600]} /> : <div class="placeholder" />}
                  <section>
                    {p.role && <p class="role" {...styleAttrs(p.roleStyle)}>{p.role}</p>}
                    {p.bio && <PortableText value={p.bio} fieldStyle={p.bioStyle} />}
                    {(p.instagram || p.website) && (
                      <p class="links">
                        {p.instagram && (
                          <a class="pill" href={instagramUrl(p.instagram)} target="_blank" rel="noopener noreferrer">
                            {t('common.instagram')} ↗
                          </a>
                        )}
                        {p.website && (
                          <a class="pill" href={p.website} target="_blank" rel="noopener noreferrer">
                            {t('common.website')} ↗
                          </a>
                        )}
                      </p>
                    )}
                  </section>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty">{t('artPrize.noJury')}</p>
        )}
      </div>
    )
  }
</Base>

<style>
  /* From the design's art prize pages. */
  .hero {
    grid-template-columns: 2fr 1fr;
    gap: 40px;
    display: grid;
  }
  .hero figure {
    margin: 0;
    position: relative;
  }
  .hero :global(img) {
    width: 100%;
  }
  .dots {
    gap: 14px;
    display: flex;
    position: absolute;
    bottom: 42px;
    left: 50%;
    transform: translate(-50%);
  }
  .dots i {
    background: #fff;
    border-radius: 50%;
    width: 12px;
    height: 12px;
  }
  figcaption {
    justify-content: space-between;
    padding-top: 3px;
    display: flex;
  }
  /* Client feedback, 2026-09-16: the intro beside the cover is the size of
     the "5 laureates will be presented…" statement (40px), and that size is
     set a touch tighter than the design's -0.025em, here and in the
     statement. The counter under the cover is Regular. */
  .hero > p {
    letter-spacing: -0.035em;
    font-size: 40px;
    line-height: 46px;
  }
  .prize-about :global(.statement .cs-body .rich-text > p:first-child) {
    letter-spacing: -0.035em;
  }
  .hero .counter {
    font-size: 22px;
    font-weight: 400;
    line-height: 1.2;
  }
  .hero figcaption {
    align-items: baseline;
    padding-top: 6px;
  }
  .dots i:not(.active) {
    opacity: 0.5;
  }
  /* The "applications" block: lines an editor set to Lead are drawn at the
     statement size, and consecutive ones stack with no gap (the design's
     three "→" lines). */
  .prize-about :global(.cs-body .rich-text > p.lead) {
    letter-spacing: -0.035em;
    font-size: 40px;
    line-height: 46px;
    margin-bottom: 0;
  }
  .prize-about :global(.cs-body .rich-text > p.lead + p.lead) {
    margin-top: 0;
  }
  /* `blocks` is passed to Sections, whose markup carries no scope attribute. */
  :global(.blocks) {
    margin-top: 55px;
  }
  .gallery {
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 55px;
    display: grid;
  }
  .gallery :global(img) {
    aspect-ratio: 1.5;
    object-fit: cover;
    width: 100%;
  }

  /* The laureates, from art-prize/laureates/index.html (2026-09-14 build). */
  .laureates {
    padding: 0 var(--gutter) 100px;
  }
  .laureates .intro-large {
    margin-bottom: 55px;
  }
  .laureates article {
    grid-template-columns: 433px 1fr;
    gap: 40px;
    margin-bottom: 86px;
    display: grid;
  }
  .laureates article.reverse {
    grid-template-columns: 1fr 433px;
  }
  .laureates figure {
    margin: 0;
  }
  .reverse figure {
    order: 2;
  }
  .image {
    position: relative;
  }
  .image :global(img),
  .image .placeholder {
    object-fit: cover;
    width: 100%;
    aspect-ratio: 2 / 3;
    background: #f0efed;
  }
  .image :global(figcaption) {
    gap: 14px;
    padding-top: 3px;
    font-size: 15px;
  }
  .name {
    /* 2px, as above the guest of honour's name (client feedback, 2026-09-17). */
    border-top: 2px solid;
    justify-content: space-between;
    align-items: start;
    gap: 20px;
    padding-top: 8px;
    display: flex;
  }
  .name h2 {
    letter-spacing: -0.045em;
    font-size: 60px;
    font-weight: 400;
    line-height: 1;
  }
  .place {
    margin-top: 12px;
    font-size: 36px;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }
  /* Two columns, with the guest of honour page's body letter-spacing
     (client feedback, 2026-09-16; was one column in the 2026-09-15 mock-up). */
  .bio {
    columns: 2;
    column-gap: 40px;
    margin-top: 32px;
    font-size: 22px;
    line-height: 1.3;
    letter-spacing: -0.03em;
  }
  .bio :global(p) {
    break-inside: avoid;
  }
  .bio :global(p + p) {
    margin-top: 1.3em;
  }
  /* The instagram pill, the size of the partners' "website" pill (client
     feedback, 2026-09-23: "ideal size for the Instagram button"); the
     jury's pills too. */
  .laureates .pill,
  .people .pill {
    flex: none;
    padding: 1px 13px 0;
    font-size: 20px;
    line-height: 1.5;
    letter-spacing: -0.02em;
  }
  .laureates .pill {
    margin-top: 10px;
  }

  .awards-page .intro-large {
    margin-bottom: 0;
  }
  .award-grid {
    columns: 2;
    column-gap: 40px;
    margin-top: 50px;
  }
  .award-grid article {
    break-inside: avoid;
    margin-bottom: 60px;
  }
  /* Titles and body as on the guest of honour page: -0.04em, semibold, a
     2px rule right under the text; body -0.03em at 24/30. The "→ …" line is
     not underlined and matches the 40px text of the about tab (client
     feedback, 2026-09-16). */
  .award-grid h2 {
    border-bottom: 2px solid;
    letter-spacing: -0.04em;
    font-size: 40px;
    font-weight: 600;
    line-height: 48px;
  }
  .award {
    margin-top: 25px;
    font-size: 40px;
    line-height: 46px;
    letter-spacing: -0.035em;
  }
  .body {
    white-space: pre-line;
    margin-top: 28px;
    font-size: 24px;
    line-height: 30px;
    letter-spacing: -0.03em;
  }
  .body :global(p + p) {
    margin-top: 1.25em;
  }
  .award-grid :global(img) {
    width: 100%;
    margin-top: 36px;
  }

  /* The advisory-board treatment, for the jury. */
  .people {
    grid-template-columns: 1fr 1fr;
    gap: 70px 40px;
    margin-top: 55px;
    display: grid;
  }
  .people h2 {
    letter-spacing: -0.04em;
    border-bottom: 2px solid;
    font-size: 36px;
    font-weight: 600;
    line-height: 1.2;
  }
  .people article > div {
    grid-template-columns: 197px 1fr;
    gap: 40px;
    margin-top: 28px;
    display: grid;
  }
  .people :global(img),
  .people .placeholder {
    object-fit: cover;
    width: 197px;
    max-height: 270px;
    background: #f0efed;
  }
  .people section {
    font-size: 24px;
    line-height: 1.22;
    letter-spacing: -0.03em;
  }
  .people section :global(p) {
    margin-top: 16px;
  }
  /* The role as the advisory board sets it (PersonCard): capitals, Bold
     not Black (client feedback, 2026-09-23). */
  .people .role {
    margin-top: 0;
    white-space: pre-line;
    text-transform: uppercase;
    letter-spacing: 0;
    font-size: 24px;
    font-weight: 600;
    line-height: 30px;
  }
  /* The nationality after the name, as the artists list sets the country. */
  .nationality {
    margin-left: 0.3em;
    font-size: 0.55em;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1;
    vertical-align: top;
    position: relative;
    top: 0.12em;
  }
  .links {
    gap: 14px;
    display: flex;
  }
  .empty {
    padding-top: 40px;
    font-size: 24px;
  }

  @media (width<=800px) {
    .people {
      grid-template-columns: 1fr;
    }
    .people article > div {
      grid-template-columns: 120px 1fr;
      gap: 18px;
    }
    .people :global(img),
    .people .placeholder {
      width: 120px;
    }
    .people h2 {
      font-size: 28px;
    }
  }
  @media (width<=700px) {
    .hero,
    .gallery {
      grid-template-columns: 1fr;
    }
    .hero > p {
      font-size: 34px;
    }
    .prize-about :global(.cs-body .rich-text > p.lead) {
      font-size: 28px;
      line-height: 1.15;
    }
    .hero figcaption span {
      display: none;
    }
    .award-grid {
      columns: 1;
    }
    .award {
      font-size: 28px;
      line-height: 1.15;
    }
    .award-grid h2 {
      font-size: 30px;
      line-height: 1.2;
    }
    .body {
      font-size: 18px;
      line-height: 1.3;
    }
  }
  @media (width<=900px) {
    .laureates article,
    .laureates article.reverse {
      grid-template-columns: 34% 1fr;
      gap: 24px;
    }
    .laureates article.reverse {
      grid-template-columns: 1fr 34%;
    }
    .name h2 {
      font-size: 44px;
    }
    .place {
      font-size: 28px;
    }
    .bio {
      font-size: 19px;
      columns: 1;
    }
  }
  @media (width<=640px) {
    .laureates article,
    .laureates article.reverse {
      flex-direction: column;
      display: flex;
    }
    .reverse figure {
      order: 0;
    }
    .name h2 {
      font-size: 38px;
    }
    .place {
      font-size: 24px;
    }
    .bio {
      font-size: 17px;
    }
  }
</style>
