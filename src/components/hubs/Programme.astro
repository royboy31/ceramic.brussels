---
import Base from '../../layouts/Base.astro';
import HubNav from '../../components/HubNav.astro';
import PageSections from '../../components/PageSections.astro';
import Figure from '../../components/Figure.astro';
import Slideshow from '../../components/Slideshow.astro';
import LinkPill from '../../components/LinkPill.astro';
import SanityImage from '../../components/SanityImage.astro';
import PortableText from '../../components/PortableText.astro';
import { LOCALE_IDS, type LocaleId } from '../../lib/locales';
import { hasString, useTranslations, formatDayLong, formatTime, localePath } from '../../lib/i18n';
import { getHubPages, getProgramme } from '../../lib/queries';
import { HUBS, hubTabPath, pageForTab , hubAltPaths } from '../../lib/hubs';
import { styleAttrs } from '../../lib/textStyle';

/**
 * The programme hub, as the design's programme pages draw it. La Cambre is
 * the tab's `page` (its lead paragraph, then whatever stack the editor
 * builds). Talks and VIP are the current edition's events of that section,
 * grouped by day into the design's accordion: a ruled day heading with an
 * arrow, then one row per event - "{ category }" and the time over a rule,
 * the title, the "FR / with A, B & C" line - with the picture alternating
 * sides. Markup and rules are Lilanga's build of the Figma programme frames.
 */
const { lang, tab } = Astro.props as { lang: LocaleId; tab: string };
const t = useTranslations(lang);

const [pages, events] = await Promise.all([getHubPages(lang, 'programme'), getProgramme(lang)]);
const page = pageForTab(pages, tab);
const hubTab = HUBS.programme.tabs.find((x) => x.slug === tab);
const tabLabel = page?.tabLabel ?? (hubTab ? t(hubTab.label) : tab);

/** The category shown in braces above each event, "{ Artist Talk }": EVENT_KINDS, translated in STRINGS. */
const kindLabel = (kind: string) => {
  const key = `programme.kind.${kind}`;
  return hasString(key) ? t(key) : kind;
};

const section = tab === 'la-cambre' ? 'project' : tab;
const listed = events.filter((e: any) => e.section === section && e.startsAt);
const days = [...new Set(listed.map((e: any) => e.startsAt.slice(0, 10)))] as string[];
const onDay = (day: string) => listed.filter((e: any) => e.startsAt.startsWith(day));

/** Artists link to their page; other speaker types have no route. */
const speakerHref = (s: any) => (s?._type === 'artist' && s.slug ? localePath(lang, `artists/${s.slug}`) : undefined);

/**
 * The line under the title, "FR / with A, B & C": the languages, then the
 * free-text speakers line verbatim (editors write the "with" themselves) or
 * the structured speakers with the translated prefix and links.
 */
type MetaPart = { text: string } | { prefix: string; people: any[] };
function metaParts(e: any): MetaPart[] {
  const parts: MetaPart[] = [];
  if (e.languages?.length) parts.push({ text: e.languages.join(', ') });
  if (e.speakersText) parts.push({ text: e.speakersText });
  else if (e.speakers?.length) parts.push({ prefix: t('programme.speakers'), people: e.speakers });
  return parts;
}
/** Titles are written with line breaks in the Studio; keep them. */
const lines = (s: string) => String(s ?? '').split(/\r?\n/);

const isPage = tab === 'la-cambre';
/** The award ceremony tab: one column of pictures, one of the ceremony's events. */
const isAwards = tab === 'awards';

/**
 * The design draws a day's award ceremony as one block: "{ award ceremony }",
 * the hall and the start time over a rule, then one title naming every award
 * ("Best booth, best solo show … & art prize awards"). Editors may enter it as
 * one event or as one per award, so a day's events are folded into one: the
 * first kind, hall and time, the titles joined, the first speakers line. A
 * description only shows when the day is a single event - one per award
 * repeats the same paragraph.
 */
const joinList = (items: string[]) =>
  items.length < 2 ? (items[0] ?? '') : `${items.slice(0, -1).join(', ')} & ${items[items.length - 1]}`;
function ceremony(day: string) {
  const list = onDay(day);
  const first = list[0];
  return {
    ...first,
    kind: list.find((e: any) => e.kind)?.kind,
    location: list.find((e: any) => e.location)?.location,
    title: list.length === 1 ? first.title : joinList(list.map((e: any) => e.title).filter(Boolean)),
    titleStyle: list.length === 1 ? first.titleStyle : undefined,
    description: list.length === 1 ? first.description : undefined,
    languages: list.find((e: any) => e.languages?.length)?.languages,
    speakersText: list.find((e: any) => e.speakersText)?.speakersText,
    speakers: list.find((e: any) => e.speakers?.length)?.speakers,
  };
}
const showEmpty = days.length === 0 && (!isPage || !page);
const path = hubTabPath('programme', tab, lang);
const altPaths = hubAltPaths('programme', tab);
---

<Base
  lang={lang}
  title={page?.seo?.title ?? `${t('nav.programme')} — ${tabLabel}`}
  description={page?.seo?.description ?? page?.intro}
  noIndex={page?.seo?.noIndex}
  image={page?.seo?.ogImage ?? page?.cover}
  path={path}
  altPaths={altPaths}
  editId={page?._id}
  editType={page?._type}
>
  <HubNav lang={lang} route="programme" active={tab} pages={pages} />

  <div class:list={['content-wrap', { talks: !isPage, 'talks-tab': !isPage && !isAwards }]}>
    {page?.intro && <p class="intro-large" {...styleAttrs(page.introStyle)}>{page.intro}</p>}

    {
      page?.cover?.asset && (
        <SanityImage
          image={page.cover}
          loading="eager"
          aspect={16 / 9}
          widths={[600, 900, 1200, 1600]}
          sizes="(max-width: 1440px) 100vw, 1380px"
          class="cover"
        />
      )
    }

    {page && <PageSections lang={lang} sections={page.sections} />}

    {
      page?.body && (
        <div class="body-24 page-body">
          <PortableText value={page.body} fieldStyle={page.bodyStyle} />
        </div>
      )
    }

    {
      isPage && page?.images?.length > 0 && (
        <ul class="image-row">
          {page.images.map((img: any) => (
            <li>
              <SanityImage image={img} aspect={3 / 2} sizes="(max-width: 640px) 100vw, 440px" widths={[440, 880]} />
            </li>
          ))}
        </ul>
      )
    }

    {
      isAwards && days.length > 0 && (
        <div class="ceremony-layout">
          <aside class="ceremony-images">
            <Slideshow
              images={page?.images}
              pool="fair"
              seed={`hub-${tab}-aside`}
              aspect={670 / 447}
              sizes="(max-width: 900px) 100vw, 670px"
              widths={[670, 1340]}
              label={tabLabel}
              id={`${tab}-slideshow`}
            />
          </aside>

          <div class="ceremony-detail">
            {days.map((day) => (
              <section class="ceremony-day">
                <h2>{formatDayLong(day, lang)}</h2>
                {[ceremony(day)].map((e: any) => {
                  const parts = metaParts(e);
                  return (
                    <article>
                      <header>
                        <b>{e.kind ? `{ ${kindLabel(e.kind)} }` : ''}</b>
                        {/* BACKEND-REQUEST #3: the design's "HALL C" chip. `location` is
                            selected by getProgramme but no awards event carries one yet. */}
                        {e.location && <span class="hall">{e.location}</span>}
                        <time datetime={e.startsAt}>{formatTime(e.startsAt, lang)}</time>
                      </header>

                      <h3 {...styleAttrs(e.titleStyle)}>
                        {lines(e.title).map((line, k) => (
                          <>
                            {k > 0 && <br />}
                            {line}
                          </>
                        ))}
                      </h3>

                      {e.description && (
                        <div class="ceremony-body">
                          <PortableText value={e.description} fieldStyle={e.descriptionStyle} />
                        </div>
                      )}

                      {parts.length > 0 && (
                        <p class="ceremony-meta">
                          {parts.map((part, k) => (
                            <>
                              {k > 0 && ' / '}
                              {'people' in part ? (
                                <>
                                  {part.prefix}{' '}
                                  {part.people.map((sp: any, n: number) => (
                                    <>
                                      {n > 0 && (n === part.people.length - 1 ? ' & ' : ', ')}
                                      {speakerHref(sp) ? <a href={speakerHref(sp)}>{sp.name}</a> : sp.name}
                                    </>
                                  ))}
                                </>
                              ) : (
                                part.text
                              )}
                            </>
                          ))}
                        </p>
                      )}
                    </article>
                  );
                })}
              </section>
            ))}

            <p class="ceremony-links">
              <LinkPill lang={lang} href={localePath(lang, 'exhibitors/awards')} label={t('programme.exhibitorAwards')} />
              <LinkPill lang={lang} href={localePath(lang, hubTabPath('art-prize', 'awards', lang))} label={t('programme.artPrizeAwards')} />
            </p>
          </div>
        </div>
      )
    }

    {
      !isAwards && days.length > 0 && (
        <div class="talks-layout">
        <div class="days">
          {days.map((day, i) => (
            <details>
              <summary>
                {formatDayLong(day, lang)} <span aria-hidden="true">↓</span>
              </summary>
              <div class="events">
                {onDay(day).map((e: any, j: number) => {
                  const parts = metaParts(e);
                  const copy = (
                    <div>
                      <b>{e.kind ? `{ ${kindLabel(e.kind)} }` : ''}</b>
                      <time datetime={e.startsAt}>{formatTime(e.startsAt, lang)}</time>
                      <h2 {...styleAttrs(e.titleStyle)}>
                        {lines(e.title).map((line, k) => (
                          <>
                            {k > 0 && <br />}
                            {line}
                          </>
                        ))}
                      </h2>
                      {parts.length > 0 && (
                        <p>
                          {parts.map((part, k) => (
                            <>
                              {k > 0 && ' / '}
                              {'people' in part ? (
                                <>
                                  {part.prefix}{' '}
                                  {part.people.map((s: any, n: number) => (
                                    <>
                                      {n > 0 && (n === part.people.length - 1 ? ' & ' : ', ')}
                                      {speakerHref(s) ? <a href={speakerHref(s)}>{s.name}</a> : s.name}
                                    </>
                                  ))}
                                </>
                              ) : (
                                part.text
                              )}
                            </>
                          ))}
                        </p>
                      )}
                    </div>
                  );
                  const picture = (
                    <Figure
                      image={e.image}
                      pool="fair"
                      seed={e.slug ?? e._id}
                      aspect={460 / 289}
                      sizes="(max-width: 700px) 100vw, 460px"
                      widths={[460, 920, 1380]}
                    />
                  );
                  return (
                    <article>
                      {j % 2 === 0 ? copy : picture}
                      {j % 2 === 0 ? picture : copy}
                    </article>
                  );
                })}
              </div>
            </details>
          ))}
        </div>
        {/* The tab page's Images, beside the accordion; a sample picture from the fair until an editor adds some. */}
        {!isPage && (
          <aside class="talks-images">
            <Slideshow
              images={page?.images}
              pool="fair"
              seed={`hub-${tab}-aside`}
              aspect={3 / 2}
              sizes="(max-width: 900px) 100vw, 430px"
              widths={[430, 860, 1290]}
              label={tabLabel}
              id={`${tab}-slideshow`}
            />
          </aside>
        )}
        </div>
      )
    }

    {showEmpty && <p class="empty">{t('programme.empty')}</p>}
  </div>
</Base>

<style>
  /* From the design's programme pages (html pages/programme/*). */
  /* `cover` is passed to SanityImage, whose <img> carries no scope attribute. */
  :global(.cover) {
    width: 100%;
    margin: 40px 0;
  }
  .page-body {
    max-width: 1160px;
    margin-top: 40px;
  }
  .image-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin: 90px 0 0;
    padding: 0;
    list-style: none;
  }
  /* The award ceremony tab (design: programme - award ceremony): the
     pictures at the left, the ceremony's events at the right under a rule. */
  .ceremony-layout {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: 40px;
    margin-top: 52px;
    display: grid;
  }
  .ceremony-day h2 {
    letter-spacing: -0.04em;
    border-top: 1px solid;
    margin: 0;
    padding-top: 10px;
    font-size: clamp(34px, 3.3vw, 48px);
    font-weight: 400;
    line-height: 1.15;
  }
  .ceremony-day article {
    margin-top: 28px;
  }
  .ceremony-day header {
    align-items: center;
    gap: 14px;
    display: flex;
  }
  /* The hall chip and the time sit at the right, whether or not there is a hall. */
  .ceremony-day header b {
    margin-right: auto;
  }
  .ceremony-day header b {
    text-transform: lowercase;
    font-size: 30px;
    font-weight: 600;
    line-height: 1.1;
  }
  .ceremony-day header time {
    font-size: 30px;
    font-weight: 600;
    line-height: 1.1;
  }
  /* The design's boxed hall chip. */
  .ceremony-day .hall {
    text-transform: uppercase;
    border: 1px solid;
    padding: 2px 9px;
    font-size: 17px;
    line-height: 1.2;
  }
  .ceremony-day h3 {
    border-top: 1px solid;
    margin-top: 4px;
    padding-top: 10px;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.2;
  }
  .ceremony-body {
    margin-top: 14px;
    font-size: 20px;
    line-height: 1.3;
  }
  .ceremony-body :global(p + p) {
    margin-top: 14px;
  }
  .ceremony-meta {
    margin-top: 14px;
    font-size: 20px;
    line-height: 1.3;
  }
  .ceremony-links {
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
    display: flex;
  }
  @media (width<=900px) {
    .ceremony-layout {
      grid-template-columns: 1fr;
    }
  }
  @media (width<=700px) {
    .ceremony-day header b,
    .ceremony-day header time {
      font-size: 24px;
    }
    .ceremony-day h3 {
      font-size: 28px;
      line-height: 1.1;
    }
    .ceremony-body,
    .ceremony-meta {
      font-size: 18px;
    }
  }
  /* The accordion beside the tab's pictures, both from the top rule
     (programme talks mock-up, 2026-09-15). The frame sets the lead ~43px
     under the tab band and the accordion ~100px under the lead. */
  .talks-tab > .intro-large {
    margin-top: 14px;
  }
  .talks-layout {
    grid-template-columns: minmax(0, 1fr) 31%;
    align-items: start;
    gap: 40px;
    margin-top: 52px;
    display: grid;
  }
  .talks-tab > .intro-large + .talks-layout {
    margin-top: 98px;
  }
  /* 2px rules, 50px day headings in ~95px rows. */
  .days {
    border-bottom: 2px solid;
  }
  .days details {
    border-top: 2px solid;
  }
  .days summary {
    cursor: pointer;
    letter-spacing: -0.04em;
    justify-content: space-between;
    align-items: center;
    padding: 17px 0 18px;
    font-size: clamp(34px, 3.5vw, 50px);
    line-height: 1.15;
    list-style: none;
    display: flex;
  }
  .days summary::-webkit-details-marker {
    display: none;
  }
  .days summary span {
    font-size: 1.15em;
    line-height: 1;
  }
  .days details[open] summary span {
    transform: rotate(180deg);
  }
  .events {
    gap: 36px;
    padding-bottom: 50px;
    display: grid;
  }
  .events article {
    grid-template-columns: 2fr 1fr;
    gap: 40px;
    display: grid;
  }
  .events article:nth-child(2n) {
    grid-template-columns: 1fr 2fr;
  }
  .events :global(img) {
    object-fit: cover;
    width: 100%;
    height: 289px;
  }
  .events article > div {
    grid-template-columns: 1fr auto;
    align-content: start;
    display: grid;
  }
  .events b,
  .events time {
    font-size: 30px;
    line-height: 1.1;
  }
  .events h2 {
    border-top: 1px solid;
    grid-column: 1 / -1;
    margin-top: 4px;
    padding-top: 10px;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.2;
  }
  .events p {
    grid-column: 1 / -1;
    margin-top: 16px;
    font-size: 20px;
    line-height: 1.3;
  }
  .events {
    padding-top: 10px;
  }
  .events :global(img) {
    height: auto;
    aspect-ratio: 460 / 289;
  }
  @media (width<=900px) {
    .talks-layout {
      grid-template-columns: 1fr;
    }
  }
  .empty {
    margin-top: 40px;
    font-size: 24px;
  }
  @media (width<=700px) {
    .days summary {
      font-size: 34px;
    }
    .days summary span {
      font-size: 42px;
    }
    .events article,
    .events article:nth-child(2n) {
      grid-template-columns: 1fr;
    }
    .events article:nth-child(2n) :global(img) {
      order: 2;
    }
    .events b,
    .events time {
      font-size: 24px;
    }
    .events h2 {
      font-size: 28px;
      line-height: 1.1;
    }
    .events p {
      font-size: 18px;
      line-height: 1.3;
    }
    .image-row {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-top: 40px;
    }
  }
</style>
