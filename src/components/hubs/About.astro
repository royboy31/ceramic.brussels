---
import Base from '../../layouts/Base.astro';
import HubNav from '../../components/HubNav.astro';
import Sections from '../../components/Sections.astro';
import PageSections from '../../components/PageSections.astro';
import SanityImage from '../../components/SanityImage.astro';
import PortableText from '../../components/PortableText.astro';
import PersonCard from '../../components/PersonCard.astro';
import LinkPill from '../../components/LinkPill.astro';
import Slideshow from '../../components/Slideshow.astro';
import { LOCALE_IDS, type LocaleId } from '../../lib/locales';
import { useTranslations } from '../../lib/i18n';
import { getHubPages, getPeople, getSettings } from '../../lib/queries';
import { HUBS, hubTabPath, pageForTab , hubAltPaths } from '../../lib/hubs';
import { styleAttrs } from '../../lib/textStyle';

/**
 * About hub, as the design's about pages draw it. The fair: the large
 * intro, the hero figure beside the first text section, the other sections
 * two a row, the closing strip of photos. Advisory board: the intro and
 * the two-column people grid. Team (the design's "contact" page): the
 * intro, the directors as people cards with e-mail and phone, then the
 * team as smaller cards in the same grid. The press & media pill leads to
 * the hub of that name (`hubs/PressMedia.astro`, backend request #19),
 * which also took over the photo gallery. Markup and rules are Lilanga's
 * build of the frames.
 */
const { lang, tab } = Astro.props as { lang: LocaleId; tab: string };
const t = useTranslations(lang);


const pages = await getHubPages(lang, 'about');
const page = pageForTab(pages, tab);
const hubTab = HUBS.about.tabs.find((x) => x.slug === tab);
const tabLabel = page?.tabLabel ?? (hubTab ? t(hubTab.label) : tab);

const board = tab === 'advisory-board' ? await getPeople(lang, 'advisory-board') : [];
const team = tab === 'team' ? await getPeople(lang, 'team') : [];
/**
 * The team page, drawn as the design's "contact" page: the directors as
 * advisory-board cards with their e-mail and phone, then the rest of the
 * team two a row, name, role, e-mail and phone beside the portrait. The
 * design has no collaborators list, so that group is not shown here.
 * Who is a director is read from the role ("co-director", "directrice"…),
 * the one thing the person record says about it.
 */
const directors = team.filter((p: any) => /direct/i.test(p.role ?? ''));
const staff = team.filter((p: any) => !directors.includes(p));
const settings = await getSettings(lang);
const hasContactBlock =
  settings?.organiserText || settings?.organiserLink || settings?.postalAddress || settings?.contactEmail;

// The fair: the first text section sits beside the hero, the rest two a
// row, as the design's about page lays them out.
const stack: any[] = page?.sections ?? [];
const leadSection = stack[0]?._type === 'contentSection' ? stack[0] : null;
const rest = leadSection ? stack.slice(1) : stack;
/** The rest in the editor's order: runs of text blocks two a row, other blocks where they were put. */
const runs: { text: boolean; items: any[] }[] = [];
for (const section of rest) {
  const text = section?._type === 'contentSection';
  const last = runs[runs.length - 1];
  if (last && last.text === text) last.items.push(section);
  else runs.push({ text, items: [section] });
}
const closingImages = (page?.images ?? []).filter((img: any) => img?.asset);
/**
 * The hero of "ceramic brussels" is a slideshow in the design (client
 * feedback, 2026-09-17: "make the big image at the top of the page a
 * 3-image slideshow"). `PAGE` in queries.ts returns one `cover` per page and
 * `images` is the closing strip, so there is one picture to show; the markup
 * is the shared Slideshow so an array needs no rework here.
 * See BACKEND-REQUEST #12.
 */
const heroImages = [page?.cover].filter((img: any) => img?.asset);
// Base appends the site name to every title. The first tab is the hub itself
// and is labelled with the site name, and an SEO title an editor ended with
// it would carry it twice ("About — ceramic brussels — ceramic brussels").
const isHubRoot = HUBS.about.tabs[0]?.slug === tab;
const siteName = settings?.siteName ?? 'ceramic brussels';
const seoTitle = page?.seo?.title;
const ownTitle = seoTitle?.toLowerCase().endsWith(` — ${siteName}`.toLowerCase())
  ? seoTitle.slice(0, -` — ${siteName}`.length)
  : seoTitle;
const path = hubTabPath('about', tab, lang);
const altPaths = hubAltPaths('about', tab);
const wrap = { 'the-fair': 'about', 'advisory-board': 'advisory', team: 'team-page' }[tab] ?? '';
---

<Base
  lang={lang}
  title={ownTitle || (isHubRoot ? t('nav.about') : `${t('nav.about')} — ${tabLabel}`)}
  description={page?.seo?.description ?? page?.intro}
  noIndex={page?.seo?.noIndex}
  image={page?.seo?.ogImage ?? page?.cover}
  path={path}
  altPaths={altPaths}
  editId={page?._id}
  editType={page?._type}
>
  <HubNav lang={lang} route="about" active={tab} pages={pages} />

  <div class:list={wrap === 'team-page' ? [wrap] : ['content-wrap', wrap]}>
    {
      page?.intro && (
        <p class="intro-large" {...styleAttrs(page.introStyle)}>
          {page.intro}
        </p>
      )
    }

    {/* ---------------------------------------------------------- the fair */}
    {
      tab === 'the-fair' &&
        (page ? (
          <>
            <div class="hero">
              {/* BACKEND-REQUEST #12: the design wants this hero to be a
                  three-image slideshow; `PAGE` in queries.ts returns a single
                  `cover`, so the slideshow is fed the one image it has and
                  will show its dots and counter the moment an array arrives. */}
              <Slideshow
                images={heroImages}
                widths={[900, 1200, 1800]}
                sizes="(max-width: 700px) 100vw, 66vw"
                label={page.title}
                id="about-hero"
              />
              {leadSection && <Sections lang={lang} sections={[leadSection]} columns={1} textColumns={1} />}
            </div>
            {runs.map((run) =>
              run.text ? (
                <div class="two-col copy">
                  {run.items.map((section: any) => (
                    <Sections lang={lang} sections={[section]} columns={1} textColumns={1} />
                  ))}
                </div>
              ) : (
                <PageSections lang={lang} sections={run.items} />
              ),
            )}
            {closingImages.length > 0 && (
              <div class="strip">
                {closingImages.map((img: any) => (
                  <SanityImage image={img} aspect={1.5} widths={[440, 660, 880]} sizes="(max-width: 700px) 100vw, 33vw" />
                ))}
              </div>
            )}
          </>
        ) : (
          <p class="empty">
            {t('about.pageEmpty')}
          </p>
        ))
    }

    {/* --------------------------------------------- advisory board / team */}
    {
      tab === 'advisory-board' &&
        (board.length ? (
          <div class="people">
            {board.map((p: any) => (
              <PersonCard lang={lang} person={p} />
            ))}
          </div>
        ) : (
          <p class="empty">{t('about.peopleEmpty')}</p>
        ))
    }

    {/* ------------------------------------------------------------- team */}
    {
      tab === 'team' && directors.length > 0 && (
        <div class="people directors">
          {directors.map((p: any) => (
            <PersonCard lang={lang} person={p} variant="contact" />
          ))}
        </div>
      )
    }
    {
      tab === 'team' && staff.length > 0 && (
        <>
          <h2 class="team-title">{t('tabs.team').toLowerCase()}</h2>
          <div class="people team-grid">
            {staff.map((p: any) => (
              <PersonCard lang={lang} person={p} variant="team" />
            ))}
            {/* The design's closing block: the organiser line, the "discover
                studio emosi's projects ↗" pill, the ASBL's postal address and
                the contact address, all from Site settings → Contact (#13).
                Each shows only once an editor has filled it. */}
            {hasContactBlock && (
              <section class="contact-block">
                <h2 class="team-title">{t('nav.contact').toLowerCase()}</h2>
                {settings.organiserText && (
                  <p class="body-24" {...styleAttrs(settings.organiserTextStyle)}>
                    {settings.organiserText}
                  </p>
                )}
                {settings.organiserLink && (
                  <p class="organiser-link">
                    <LinkPill lang={lang} link={settings.organiserLink} />
                  </p>
                )}
                {settings.postalAddress && <p class="body-24 postal">{settings.postalAddress}</p>}
                {settings.contactEmail && (
                  <p class="body-24">
                    <a class="text-link" href={`mailto:${settings.contactEmail}`}>
                      {`${settings.contactEmail}\u00a0↗`}
                    </a>
                  </p>
                )}
              </section>
            )}
          </div>
        </>
      )
    }
    {tab === 'team' && team.length === 0 && <p class="empty">{t('about.peopleEmpty')}</p>}

    {/* ------------------------------ page text on the tabs that carry one */}
    {page && tab !== 'the-fair' && <PageSections lang={lang} sections={page.sections} />}
    {
      page?.body && (
        <div class="body-24 page-body">
          <PortableText value={page.body} fieldStyle={page.bodyStyle} />
        </div>
      )
    }
    {
      tab !== 'the-fair' && closingImages.length > 0 && (
        <div class="strip">
          {closingImages.map((img: any) => (
            <SanityImage image={img} aspect={1.5} widths={[440, 660, 880]} sizes="(max-width: 700px) 100vw, 33vw" />
          ))}
        </div>
      )
    }
  </div>
</Base>

<style>
  /* From the design's about page. */
  .about > .intro-large {
    margin-bottom: 60px;
  }
  .hero {
    grid-template-columns: 2fr 1fr;
    gap: 40px;
    display: grid;
  }
  .hero figure {
    margin: 0;
    position: relative;
  }
  .hero :global(img) {
    object-fit: cover;
    width: 100%;
    height: 605px;
  }
  /* The slideshow's dots sit on the bottom edge of the picture, as the frame
     draws them; the caption line only earns its place once there is more
     than one picture to count. */
  .hero :global(.slideshow .dots) {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 605px;
    align-items: flex-end;
    justify-content: center;
    padding: 0 0 16px;
    gap: 14px;
  }
  .hero :global(.slideshow .dots a) {
    background: #fff;
  }
  .hero :global(.slideshow[data-slides='1'] figcaption) {
    display: none;
  }
  .copy {
    margin-top: 50px;
  }
  .strip {
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 60px;
    display: grid;
  }
  .strip :global(img) {
    aspect-ratio: 1.5;
    object-fit: cover;
    width: 100%;
  }
  .strip figure {
    margin: 0;
  }
  .strip figcaption {
    margin-top: 3px;
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .credit {
    color: var(--ink-3);
  }
  @media (width<=700px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero :global(img) {
      height: auto;
    }
    .hero :global(.slideshow .dots) {
      height: auto;
      inset: auto 0 16px;
    }
    .strip {
      grid-template-columns: 1fr;
    }
  }

  /* From the design's advisory-board page. */
  .people {
    grid-template-columns: 1fr 1fr;
    gap: 70px 40px;
    margin-top: 55px;
    display: grid;
  }
  .group {
    margin-top: 80px;
  }
  @media (width<=800px) {
    .people {
      grid-template-columns: 1fr;
    }
  }

  /* The advisory board three a row (client feedback, 2026-09-17): a card is
     a third of the shell, so the portrait is a share of it rather than a
     fixed 197px, and the type steps down with the column. The biography now
     runs the card's full width under the portrait, which is what makes a
     third of a window readable at all. Two a row under 1200px, one under
     800px - her complaint was a narrow window, so the layout has to fold. */
  .advisory .people {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 60px 30px;
    --portrait-col: minmax(0, 44%);
    --portrait-gap: 17px;
  }
  .advisory .people :global(.role) {
    font-size: 20px;
    line-height: 26px;
  }
  .advisory .people :global(.bio) {
    font-size: 20px;
  }
  .advisory .people :global(.bio .rich-text p + p) {
    margin-top: 24px;
  }
  @media (width<=1200px) {
    .advisory .people {
      grid-template-columns: 1fr 1fr;
      gap: 70px 40px;
    }
  }
  @media (width<=800px) {
    .advisory .people {
      grid-template-columns: 1fr;
      --portrait-col: 120px;
      --portrait-gap: 18px;
    }
    .advisory .people :global(.role) {
      font-size: 17px;
      line-height: 1.35;
    }
    .advisory .people :global(.bio) {
      font-size: 18px;
    }
  }

  /* From the design's contact page (the team tab). */
  .team-page {
    padding: 10px var(--gutter) 110px;
  }
  .team-page > .intro-large {
    max-width: 1160px;
  }
  .team-page > .intro-large + .directors {
    margin-top: 50px;
  }
  /* The design's small grey "team" label over a hairline rule the width of
     the page (client feedback, 2026-09-17), not the big black panel title. */
  /* "team", and the contact block's own heading: the page's title style over
     a 2px rule (Figma "about - contact", 2026-09-17). */
  .team-title {
    letter-spacing: -0.04em;
    border-bottom: 2px solid var(--ink);
    margin-top: 60px;
    padding-bottom: 8px;
    font-size: 36px;
    font-weight: 600;
    line-height: 1.2;
  }
  .contact-block .team-title {
    margin-top: 0;
  }
  .contact-block .body-24,
  .contact-block .organiser-link {
    margin-top: 20px;
  }
  /* The address is typed on three lines in the Studio. */
  .contact-block .postal {
    white-space: pre-line;
  }
  .people.team-grid {
    gap: 45px 40px;
    margin-top: 24px;
  }
  .team-page .empty {
    margin-top: 40px;
  }
  @media (width<=640px) {
    .team-page > .intro-large {
      font-size: 30px;
    }
    .team-title {
      font-size: 24px;
    }
  }

  /* images */
  .gallery + .gallery {
    margin-top: 80px;
  }
  .page-body {
    margin-top: 40px;
    max-width: 1160px;
  }
</style>
