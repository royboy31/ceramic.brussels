---
import Base from '../../layouts/Base.astro';
import HubNav from '../../components/HubNav.astro';
import Sections from '../../components/Sections.astro';
import PageSections from '../../components/PageSections.astro';
import SanityImage from '../../components/SanityImage.astro';
import PortableText from '../../components/PortableText.astro';
import PersonCard from '../../components/PersonCard.astro';
import { LOCALE_IDS, type LocaleId } from '../../lib/locales';
import { useTranslations, formatDate } from '../../lib/i18n';
import { instagramUrl } from '../../lib/links';
import { getHubPages, getPeople, getPressClips, getSettings, getEditions } from '../../lib/queries';
import { HUBS, hubTabPath, pageForTab , hubAltPaths } from '../../lib/hubs';
import { styleAttrs } from '../../lib/textStyle';

/**
 * About hub, as the design's about pages draw it. The fair: the large
 * intro, the hero figure beside the first text section, the other sections
 * two a row, the closing strip of photos. Advisory board: the intro and
 * the two-column people grid. Team (2026-09-14 build): the intro, the
 * directors with portrait and biography, then the team and the
 * collaborators as grids of small cards. Press and images have no design
 * page and follow the same patterns. Markup and rules are Lilanga's build
 * of the frames.
 */
const { lang, tab } = Astro.props as { lang: LocaleId; tab: string };
const t = useTranslations(lang);


const pages = await getHubPages(lang, 'about');
const page = pageForTab(pages, tab);
const hubTab = HUBS.about.tabs.find((x) => x.slug === tab);
const tabLabel = page?.tabLabel ?? (hubTab ? t(hubTab.label) : tab);

const board = tab === 'advisory-board' ? await getPeople(lang, 'advisory-board') : [];
const team = tab === 'team' ? await getPeople(lang, 'team') : [];
const collaborators = tab === 'team' ? await getPeople(lang, 'collaborator') : [];
/**
 * The team page (2026-09-14 build) opens with the two directors, portrait
 * beside biography, then the rest of the team as a grid of small cards.
 * Who is a director is read from the role ("co-director", "directrice"…),
 * the one thing the person record says about it.
 */
const directors = team.filter((p: any) => /direct/i.test(p.role ?? ''));
const staff = team.filter((p: any) => !directors.includes(p));
/** "GP" - the initials standing in for a missing portrait, as the design draws them. */
const initials = (name: string) =>
  String(name ?? '')
    .split(/\s+/)
    .map((w) => w.charAt(0))
    .join('')
    .slice(0, 3)
    .toUpperCase();

const [clips, settings] = tab === 'press' ? await Promise.all([getPressClips(), getSettings(lang)]) : [[], null];
// Newest first, grouped by year, which is how a press list is actually read.
const years = [...new Set(clips.map((c: any) => c.publishedAt?.slice(0, 4)))]
  .filter(Boolean)
  .sort((a, b) => String(b).localeCompare(String(a)));

const editions = tab === 'images' ? (await getEditions(lang)).filter((e: any) => e.images?.some((img: any) => img?.asset)) : [];

// The fair: the first text section sits beside the hero, the rest two a
// row, as the design's about page lays them out.
const stack: any[] = page?.sections ?? [];
const leadSection = stack[0]?._type === 'contentSection' ? stack[0] : null;
const rest = leadSection ? stack.slice(1) : stack;
/** The rest in the editor's order: runs of text blocks two a row, other blocks where they were put. */
const runs: { text: boolean; items: any[] }[] = [];
for (const section of rest) {
  const text = section?._type === 'contentSection';
  const last = runs[runs.length - 1];
  if (last && last.text === text) last.items.push(section);
  else runs.push({ text, items: [section] });
}
const closingImages = (page?.images ?? []).filter((img: any) => img?.asset);
const path = hubTabPath('about', tab, lang);
const altPaths = hubAltPaths('about', tab);
const wrap = { 'the-fair': 'about', 'advisory-board': 'advisory', team: 'team-page', press: 'press', images: 'images' }[tab] ?? '';

const captionOf = (img: any) => [img.caption, img.workTitle, img.year].filter(Boolean).length > 0 || img.credit;
---

<Base
  lang={lang}
  title={page?.seo?.title ?? `${t('nav.about')} — ${tabLabel}`}
  description={page?.seo?.description ?? page?.intro}
  noIndex={page?.seo?.noIndex}
  image={page?.seo?.ogImage ?? page?.cover}
  path={path}
  altPaths={altPaths}
  editId={page?._id}
  editType={page?._type}
>
  <HubNav lang={lang} route="about" active={tab} pages={pages} />

  <div class:list={wrap === 'team-page' ? [wrap] : ['content-wrap', wrap]}>
    {
      page?.intro && (
        <p class="intro-large" {...styleAttrs(page.introStyle)}>
          {page.intro}
        </p>
      )
    }

    {/* ---------------------------------------------------------- the fair */}
    {
      tab === 'the-fair' &&
        (page ? (
          <>
            <div class="hero">
              <figure>
                {page.cover?.asset && (
                  <SanityImage image={page.cover} widths={[900, 1200, 1800]} sizes="(max-width: 700px) 100vw, 66vw" loading="eager" />
                )}
                <span class="dots" aria-hidden="true">
                  <i />
                  <i />
                  <i />
                </span>
              </figure>
              {leadSection && <Sections lang={lang} sections={[leadSection]} columns={1} textColumns={1} />}
            </div>
            {runs.map((run) =>
              run.text ? (
                <div class="two-col copy">
                  {run.items.map((section: any) => (
                    <Sections lang={lang} sections={[section]} columns={1} textColumns={1} />
                  ))}
                </div>
              ) : (
                <PageSections lang={lang} sections={run.items} />
              ),
            )}
            {closingImages.length > 0 && (
              <div class="strip">
                {closingImages.map((img: any) => (
                  <SanityImage image={img} aspect={1.5} widths={[440, 660, 880]} sizes="(max-width: 700px) 100vw, 33vw" />
                ))}
              </div>
            )}
          </>
        ) : (
          <p class="empty">
            {t('about.pageEmpty')}
          </p>
        ))
    }

    {/* --------------------------------------------- advisory board / team */}
    {
      tab === 'advisory-board' &&
        (board.length ? (
          <div class="people">
            {board.map((p: any) => (
              <PersonCard lang={lang} person={p} />
            ))}
          </div>
        ) : (
          <p class="empty">{t('about.peopleEmpty')}</p>
        ))
    }

    {/* ------------------------------------------------------------- team */}
    {
      tab === 'team' && directors.length > 0 && (
        <section class="directors">
          {directors.map((p: any) => (
            <article>
              <div class="team-portrait">
                {p.portrait?.asset ? (
                  <SanityImage image={p.portrait} aspect={4 / 5} widths={[210, 420, 630]} sizes="210px" />
                ) : (
                  <span aria-hidden="true">{initials(p.name)}</span>
                )}
              </div>
              <div>
                <h2>{p.name}</h2>
                {p.role && (
                  <p class="role" {...styleAttrs(p.roleStyle)}>
                    {p.role}
                  </p>
                )}
                {p.bio && <PortableText value={p.bio} fieldStyle={p.bioStyle} />}
              </div>
            </article>
          ))}
        </section>
      )
    }
    {
      tab === 'team' && staff.length > 0 && (
        <>
          <h2 class="team-title">{t('tabs.team').toLowerCase()}</h2>
          <section class="team-grid">
            {staff.map((p: any) => (
              <article>
                <div class="team-portrait team-portrait--small">
                  {p.portrait?.asset ? (
                    <SanityImage image={p.portrait} aspect={1.15} widths={[440, 660, 880]} sizes="(max-width: 640px) 100vw, 33vw" />
                  ) : (
                    <span aria-hidden="true">{initials(p.name)}</span>
                  )}
                </div>
                <h3>{p.name}</h3>
                {p.role && <p {...styleAttrs(p.roleStyle)}>{p.role}</p>}
                {p.email && <a href={`mailto:${p.email}`}>{p.email} ↗</a>}
              </article>
            ))}
          </section>
        </>
      )
    }
    {
      tab === 'team' && collaborators.length > 0 && (
        <>
          <h2 class="team-title">{t('about.collaborators')}</h2>
          <section class="team-grid">
            {collaborators.map((p: any) => (
              <article>
                <div class="team-portrait team-portrait--small">
                  {p.portrait?.asset ? (
                    <SanityImage image={p.portrait} aspect={1.15} widths={[440, 660, 880]} sizes="(max-width: 640px) 100vw, 33vw" />
                  ) : (
                    <span aria-hidden="true">{initials(p.name)}</span>
                  )}
                </div>
                <h3>{p.name}</h3>
                {p.role && <p {...styleAttrs(p.roleStyle)}>{p.role}</p>}
                {p.website && (
                  <a href={p.website} target="_blank" rel="noopener noreferrer">
                    {t('common.website')} ↗
                  </a>
                )}
              </article>
            ))}
          </section>
        </>
      )
    }
    {tab === 'team' && team.length === 0 && collaborators.length === 0 && <p class="empty">{t('about.peopleEmpty')}</p>}

    {/* ------------------------------------------------------------- press */}
    {
      tab === 'press' && (
        <div class="two-col press-cols">
          <section>
            {settings?.pressContacts?.length > 0 && (
              <>
                <h2 class="panel-title">{t('press.contacts')}</h2>
                <div class="body-24">
                  {settings.pressContacts.map((c: any) => (
                    <p>
                      {c.region && <strong {...styleAttrs(c.regionStyle)}>{c.region}</strong>}
                      {c.name && (
                        <>
                          <br />
                          {c.name}
                        </>
                      )}
                      {c.email && (
                        <>
                          <br />
                          <a class="text-link" href={`mailto:${c.email}`}>
                            {c.email}
                          </a>
                        </>
                      )}
                      {c.url && (
                        <>
                          <br />
                          <a class="text-link" href={c.url} target="_blank" rel="noopener noreferrer">
                            {t('common.website')} ↗
                          </a>
                        </>
                      )}
                      {c.instagram && (
                        <>
                          <br />
                          <a class="text-link" href={instagramUrl(c.instagram)} target="_blank" rel="noopener noreferrer">
                            {t('common.instagram')} ↗
                          </a>
                        </>
                      )}
                    </p>
                  ))}
                </div>
              </>
            )}
            {settings?.pressKitUrl && (
              <a class="pill dark" href={settings.pressKitUrl} target="_blank" rel="noopener noreferrer">
                {t('about.pressKit')} ↗
              </a>
            )}
            {settings?.pressEmail && (
              <p class="body-24">
                <a class="text-link" href={`mailto:${settings.pressEmail}`}>
                  {settings.pressEmail}
                </a>
              </p>
            )}
          </section>
          <section>
            <h2 class="panel-title">{t('press.clips')}</h2>
            {clips.length ? (
              years.map((year) => (
                <div class="body-24 year">
                  <strong class="year-label">{year}</strong>
                  {clips
                    .filter((c: any) => c.publishedAt?.slice(0, 4) === year)
                    .map((clip: any) => (
                      <p>
                        <strong>{clip.outlet}</strong>
                        <br />
                        {clip.url ? (
                          <a class="text-link" href={clip.url} target="_blank" rel="noopener noreferrer">
                            {clip.title} ↗
                          </a>
                        ) : (
                          clip.title
                        )}
                        <br />
                        <time datetime={clip.publishedAt}>{formatDate(clip.publishedAt, lang)}</time>
                        {clip.language && ` · ${clip.language.toUpperCase()}`}
                        {clip.pdfUrl && (
                          <>
                            {' · '}
                            <a class="text-link" href={clip.pdfUrl} target="_blank" rel="noopener noreferrer">
                              pdf ↓
                            </a>
                          </>
                        )}
                      </p>
                    ))}
                </div>
              ))
            ) : (
              <p class="empty">{t('press.empty')}</p>
            )}
          </section>
        </div>
      )
    }

    {/* ------------------------------------------------------------ images */}
    {
      tab === 'images' &&
        (editions.length ? (
          editions.map((e: any) => (
            <section class="gallery">
              <h2 class="panel-title">{e.title ?? `ceramic brussels ${e.year}`}</h2>
              <div class="strip photos">
                {e.images
                  .filter((img: any) => img?.asset)
                  .map((img: any) => (
                    <figure>
                      <SanityImage image={img} aspect={1.5} widths={[440, 660, 880]} sizes="(max-width: 700px) 100vw, 33vw" />
                      {captionOf(img) && (
                        <figcaption>
                          {img.caption}
                          {img.workTitle && (
                            <>
                              {img.caption ? ', ' : ''}
                              <em>{img.workTitle}</em>
                            </>
                          )}
                          {img.year && `, ${img.year}`}
                          {img.credit && <span class="credit"> © {img.credit}</span>}
                        </figcaption>
                      )}
                    </figure>
                  ))}
              </div>
            </section>
          ))
        ) : (
          <p class="empty">{t('about.imagesEmpty')}</p>
        ))
    }

    {/* ------------------------------ page text on the tabs that carry one */}
    {page && tab !== 'the-fair' && <PageSections lang={lang} sections={page.sections} />}
    {
      page?.body && (
        <div class="body-24 page-body">
          <PortableText value={page.body} fieldStyle={page.bodyStyle} />
        </div>
      )
    }
    {
      tab !== 'the-fair' && closingImages.length > 0 && (
        <div class="strip">
          {closingImages.map((img: any) => (
            <SanityImage image={img} aspect={1.5} widths={[440, 660, 880]} sizes="(max-width: 700px) 100vw, 33vw" />
          ))}
        </div>
      )
    }
  </div>
</Base>

<style>
  /* From the design's about page. */
  .about > .intro-large {
    margin-bottom: 60px;
  }
  .hero {
    grid-template-columns: 2fr 1fr;
    gap: 40px;
    display: grid;
  }
  .hero figure {
    margin: 0;
    position: relative;
  }
  .hero :global(img) {
    object-fit: cover;
    width: 100%;
    height: 605px;
  }
  .dots {
    gap: 14px;
    display: flex;
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translate(-50%);
  }
  .dots i {
    background: #fff;
    border-radius: 50%;
    width: 12px;
    height: 12px;
  }
  .copy {
    margin-top: 50px;
  }
  .strip {
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 60px;
    display: grid;
  }
  .strip :global(img) {
    aspect-ratio: 1.5;
    object-fit: cover;
    width: 100%;
  }
  .strip figure {
    margin: 0;
  }
  .strip figcaption {
    margin-top: 8px;
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .credit {
    color: var(--ink-3);
  }
  @media (width<=700px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero :global(img) {
      height: auto;
    }
    .strip {
      grid-template-columns: 1fr;
    }
  }

  /* From the design's advisory-board page. */
  .people {
    grid-template-columns: 1fr 1fr;
    gap: 70px 40px;
    margin-top: 55px;
    display: grid;
  }
  .group {
    margin-top: 80px;
  }
  @media (width<=800px) {
    .people {
      grid-template-columns: 1fr;
    }
  }

  /* From the design's team page (about/team/index.html, 2026-09-14 build). */
  .team-page {
    padding: 10px var(--gutter) 110px;
  }
  .team-page > .intro-large {
    max-width: 980px;
    line-height: 1.1;
  }
  .directors {
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 64px;
    display: grid;
  }
  .directors article {
    border-top: 1px solid;
    grid-template-columns: 210px 1fr;
    gap: 25px;
    padding-top: 12px;
    display: grid;
  }
  .team-portrait {
    aspect-ratio: 4 / 5;
    letter-spacing: -0.05em;
    background: linear-gradient(145deg, #fff350, #fff);
    place-items: center;
    width: 210px;
    font-size: 54px;
    display: grid;
    position: relative;
    overflow: hidden;
  }
  /* Laid over the box rather than sized by it, so the picture can never
     stretch the 4:5 frame to its own height. */
  .team-portrait :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .directors h2,
  .team-title {
    letter-spacing: -0.04em;
    font-size: 38px;
    font-weight: 600;
    line-height: 1;
  }
  .role {
    text-transform: uppercase;
    margin: 8px 0 22px;
  }
  .directors article > div:last-child :global(.rich-text) {
    font-size: 20px;
    line-height: 1.28;
  }
  .directors article > div:last-child :global(p + p) {
    margin-top: 1em;
  }
  .team-title {
    border-top: 1px solid;
    margin-top: 80px;
    padding-top: 12px;
  }
  .team-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 30px;
    display: grid;
  }
  .team-portrait--small {
    aspect-ratio: 1.15;
    width: 100%;
    font-size: 44px;
  }
  .team-grid h3 {
    margin-top: 12px;
    font-size: 28px;
    font-weight: 400;
    line-height: 1;
  }
  .team-grid p {
    margin-top: 5px;
    font-size: 20px;
  }
  .team-grid a {
    margin-top: 18px;
    font-size: 17px;
    text-decoration: underline;
    display: inline-block;
  }
  .team-page .empty {
    margin-top: 40px;
  }
  @media (width<=900px) {
    .directors {
      grid-template-columns: 1fr;
    }
    .team-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (width<=640px) {
    .team-page > .intro-large {
      font-size: 30px;
    }
    .directors article {
      grid-template-columns: 1fr;
    }
    .team-portrait {
      aspect-ratio: 1.2;
      width: 100%;
    }
    .team-grid {
      grid-template-columns: 1fr;
    }
  }

  /* press and images: the same panels. */
  .press-cols {
    margin-top: 40px;
  }
  .press-cols .pill.dark {
    color: #fff;
    background: #000;
    margin-top: 30px;
  }
  .year + .year {
    margin-top: 40px;
  }
  .year-label {
    display: block;
    margin-bottom: 16px;
  }
  .gallery + .gallery {
    margin-top: 80px;
  }
  .page-body {
    margin-top: 40px;
    max-width: 1160px;
  }
</style>
