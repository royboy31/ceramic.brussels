---
import Base from '../../layouts/Base.astro';
import HubNav from '../../components/HubNav.astro';
import PageSections from '../../components/PageSections.astro';
import SanityImage from '../../components/SanityImage.astro';
import PortableText from '../../components/PortableText.astro';
import Figure from '../../components/Figure.astro';
import VipCodeForm from '../../components/VipCodeForm.astro';
import VipRequestForm from '../../components/VipRequestForm.astro';
import type { LocaleId } from '../../lib/locales';
import { hasString, useTranslations, formatDay, formatTime } from '../../lib/i18n';
import { getHubPages, getProgramme, getVipSettings } from '../../lib/queries';
import { HUBS, hubTabPath, hubAltPaths, pageForTab } from '../../lib/hubs';
import { styleAttrs } from '../../lib/textStyle';
import { vipEnv, vipSetting } from '../../server/vip';

/**
 * The VIP hub (Figma VIP frames, docs/vip-access.md). Five tabs from one
 * component:
 *
 * - about: public. The tab's page - lead, cover, blocks, body, images -
 *   with the "enter your code" box beside the cover.
 * - programme, lounge, hotel-deal: locked. The Worker renders them once
 *   src/middleware.ts has seen a VIP session; the page's text as above,
 *   and on the programme tab the current edition's VIP events grouped by
 *   day behind an on-site / off-site filter. The hotel tab's `{code}` is
 *   filled from D1, so the hotel's code never sits in Sanity.
 * - access: the locked state the gate redirects to - "VIP already?" beside
 *   "not a VIP yet?" - public, noindex.
 *
 * A first working build of the frames; the markup is Lilanga's to bring
 * to the design.
 */
const { lang, tab } = Astro.props as { lang: LocaleId; tab: string };
const t = useTranslations(lang);

const hubTab = HUBS.vip.tabs.find((x) => x.slug === tab);
if (!hubTab) return Astro.rewrite('/404');
const locked = !!hubTab.locked;
const isAccess = tab === 'access';

const [pages, settings, events] = await Promise.all([
  getHubPages(lang, 'vip'),
  getVipSettings(lang),
  tab === 'programme' ? getProgramme(lang) : Promise.resolve([] as any[]),
]);
let page = pageForTab(pages, tab);
const tabLabel = page?.tabLabel ?? t(hubTab.label);

// The hotel's code, from the settings table the Worker can read: an editor
// writes `{code}` where it goes. Nothing to fill under `astro dev`.
if (tab === 'hotel-deal' && page) {
  const env = vipEnv(Astro.locals);
  const code = env ? await vipSetting(env.VIP_DB, 'hotel_code').catch(() => null) : null;
  if (code) page = JSON.parse(JSON.stringify(page).split('{code}').join(code.replace(/[\\"]/g, '')));
}

/* The programme tab: this edition's VIP events, by day. */
const listed = tab === 'programme' ? events.filter((e: any) => e.section === 'vip' && e.startsAt) : [];
const days = [...new Set(listed.map((e: any) => e.startsAt.slice(0, 10)))] as string[];
const onDay = (day: string) => listed.filter((e: any) => e.startsAt.startsWith(day));
const venues = [...new Set(listed.map((e: any) => e.venue).filter(Boolean))] as string[];
const venueLabel = (venue: string) => (hasString(`vip.venue.${venue}`) ? t(`vip.venue.${venue}` as any) : venue);
const lines = (s: string) => String(s ?? '').split(/\r?\n/);

const path = hubTabPath('vip', tab, lang);
const altPaths = hubAltPaths('vip', tab);
const closingImages = (page?.images ?? []).filter((img: any) => img?.asset);
---

<Base
  lang={lang}
  title={page?.seo?.title ?? `${t('nav.vip')} — ${tabLabel}`}
  description={page?.seo?.description ?? page?.intro}
  noIndex={locked || isAccess || page?.seo?.noIndex}
  image={page?.seo?.ogImage ?? page?.cover}
  path={path}
  altPaths={altPaths}
  editId={page?._id}
  editType={page?._type}
>
  <HubNav lang={lang} route="vip" active={tab} pages={pages} />

  <div class="content-wrap vip">
    {page?.intro && <p class="intro-large" {...styleAttrs(page.introStyle)}>{page.intro}</p>}

    {
      tab === 'about' ? (
        <div class="two-col about-top">
          {page?.cover?.asset ? (
            <SanityImage image={page.cover} loading="eager" aspect={3 / 2} widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 560px" />
          ) : (
            <div />
          )}
          {settings?.gateOpen !== false && <VipCodeForm lang={lang} contact={settings?.contact} />}
        </div>
      ) : (
        page?.cover?.asset && (
          <SanityImage
            image={page.cover}
            loading="eager"
            aspect={16 / 9}
            widths={[600, 900, 1200, 1600]}
            sizes="(max-width: 1440px) 100vw, 1380px"
            class="cover"
          />
        )
      )
    }

    {page && <PageSections lang={lang} sections={page.sections} />}

    {
      page?.body && (
        <div class="body-24 page-body">
          <PortableText value={page.body} fieldStyle={page.bodyStyle} />
        </div>
      )
    }

    {
      tab === 'programme' && days.length > 0 && (
        <section class="programme" data-vip-programme>
          {venues.length > 1 && (
            <nav class="venues" aria-label={t('tabs.vipProgramme')}>
              <button type="button" class="pill active" data-venue="">
                {t('vip.venue.all')}
              </button>
              {venues.map((venue) => (
                <button type="button" class="pill" data-venue={venue}>
                  {venueLabel(venue)}
                </button>
              ))}
            </nav>
          )}
          <div class="days">
            {days.map((day) => (
              <section class="day" data-day>
                <h2>{formatDay(day, lang)}</h2>
                <div class="events">
                  {onDay(day).map((e: any, j: number) => {
                    const copy = (
                      <div class="copy">
                        <time datetime={e.startsAt}>{formatTime(e.startsAt, lang)}</time>
                        <h3 {...styleAttrs(e.titleStyle)}>
                          {lines(e.title).map((line, k) => (
                            <>
                              {k > 0 && <br />}
                              {line}
                            </>
                          ))}
                        </h3>
                        {e.venue && <p class="venue-tag">{venueLabel(e.venue)}</p>}
                        {e.description && (
                          <div class="text">
                            <PortableText value={e.description} fieldStyle={e.descriptionStyle} />
                          </div>
                        )}
                        {e.speakersText && <p class="speakers">{e.speakersText}</p>}
                      </div>
                    );
                    const picture = (
                      <Figure image={e.image} pool="fair" seed={e.slug ?? e._id} aspect={460 / 289} sizes="(max-width: 700px) 100vw, 460px" widths={[460, 920]} />
                    );
                    return (
                      <article data-venue={e.venue ?? ''}>
                        {j % 2 === 0 ? copy : picture}
                        {j % 2 === 0 ? picture : copy}
                      </article>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>
        </section>
      )
    }

    {tab === 'programme' && days.length === 0 && !page && <p class="empty body-24">{t('vip.empty')}</p>}

    {
      closingImages.length > 0 && (
        <ul class="image-row">
          {closingImages.map((img: any) => (
            <li>
              <SanityImage image={img} aspect={3 / 2} sizes="(max-width: 640px) 100vw, 440px" widths={[440, 880]} />
            </li>
          ))}
        </ul>
      )
    }

    {
      isAccess && (
        <div class="two-col access">
          <VipCodeForm lang={lang} contact={settings?.contact} />
          <VipRequestForm lang={lang} settings={settings} />
        </div>
      )
    }

    {
      locked && (
        <form class="leave" method="post" action="/api/vip/leave/">
          <input type="hidden" name="lang" value={lang} />
          <button type="submit" class="text-link">{t('vip.leave')}</button>
        </form>
      )
    }
  </div>
</Base>

<script>
  // The on-site / off-site pills: hide the events of the other kind, and a
  // day that has none left.
  document.querySelectorAll<HTMLElement>('[data-vip-programme]').forEach((root) => {
    const pills = [...root.querySelectorAll<HTMLButtonElement>('[data-venue]')].filter((el) => el.tagName === 'BUTTON');
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const wanted = pill.dataset.venue ?? '';
        pills.forEach((p) => p.classList.toggle('active', p === pill));
        root.querySelectorAll<HTMLElement>('article[data-venue]').forEach((article) => {
          article.hidden = !!wanted && article.dataset.venue !== wanted;
        });
        root.querySelectorAll<HTMLElement>('[data-day]').forEach((day) => {
          day.hidden = ![...day.querySelectorAll<HTMLElement>('article')].some((a) => !a.hidden);
        });
      });
    });
  });
</script>

<style>
  :global(.cover) {
    width: 100%;
    margin: 40px 0;
  }
  .about-top {
    align-items: start;
    margin-top: 40px;
  }
  .page-body {
    max-width: 1160px;
    margin-top: 40px;
  }
  .image-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin: 90px 0 0;
    padding: 0;
    list-style: none;
  }
  .access {
    align-items: start;
    margin-top: 40px;
  }
  /* The programme, after the design's VIP programme frame: pills, then a
     ruled day heading and one row per event with the picture alternating. */
  .programme {
    margin-top: 52px;
  }
  .venues {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 32px;
  }
  .venues .pill {
    cursor: pointer;
    text-transform: lowercase;
  }
  .venues .pill.active {
    background: var(--color-acid);
  }
  .days {
    border-bottom: 1px solid;
  }
  .day {
    border-top: 1px solid;
    padding: 16px 0 40px;
  }
  .day h2 {
    letter-spacing: -0.04em;
    font-size: clamp(34px, 3.3vw, 48px);
    line-height: 1.15;
    margin-bottom: 24px;
  }
  .events {
    display: grid;
    gap: 36px;
  }
  .events article {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .events article:nth-child(2n) {
    grid-template-columns: 1fr 2fr;
  }
  .events :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 460 / 289;
    object-fit: cover;
  }
  .copy time {
    display: block;
    font-size: 30px;
    line-height: 1.1;
  }
  .copy h3 {
    border-top: 1px solid;
    margin-top: 6px;
    padding-top: 10px;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.2;
  }
  .venue-tag {
    margin-top: 10px;
    font-size: 18px;
    text-transform: lowercase;
    color: var(--ink-3, #6b6b6b);
  }
  .text {
    margin-top: 16px;
    font-size: 20px;
    line-height: 1.3;
    max-width: 62ch;
  }
  .speakers {
    margin-top: 12px;
    font-size: 20px;
    line-height: 1.3;
  }
  .empty {
    margin-top: 40px;
  }
  .leave {
    margin-top: 60px;
  }
  .leave button {
    cursor: pointer;
    font-size: 20px;
    background: none;
    border: 0;
    padding: 0;
    text-transform: lowercase;
  }
  @media (width<=900px) {
    .image-row {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-top: 40px;
    }
  }
  @media (width<=700px) {
    .events article,
    .events article:nth-child(2n) {
      grid-template-columns: 1fr;
    }
    .copy time,
    .copy h3 {
      font-size: 24px;
    }
    .text,
    .speakers {
      font-size: 18px;
    }
  }
</style>
