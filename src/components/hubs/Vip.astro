---
import Base from '../../layouts/Base.astro';
import HubNav from '../../components/HubNav.astro';
import PageSections from '../../components/PageSections.astro';
import SanityImage from '../../components/SanityImage.astro';
import PortableText from '../../components/PortableText.astro';
import Slideshow from '../../components/Slideshow.astro';
import LinkPill from '../../components/LinkPill.astro';
import VipShot from '../../components/VipShot.astro';
import VipCodeForm from '../../components/VipCodeForm.astro';
import VipRequestForm from '../../components/VipRequestForm.astro';
import type { LocaleId } from '../../lib/locales';
import { useTranslations, localePath, formatDayLong, formatTime } from '../../lib/i18n';
import { getHubPages, getProgramme, getPartners, getSettings, getVipSettings } from '../../lib/queries';
import { HUBS, hubTabPath, hubAltPaths, pageForTab } from '../../lib/hubs';
import { styleAttrs } from '../../lib/textStyle';
import { VIP_CONTENT, type VipLink, type VipRow } from '../vipContent';
import { vipEnv, vipSetting } from '../../server/vip';

/**
 * The VIP hub (Figma VIP frames of 2026-09-18, docs/vip-access.md). Five
 * tabs from one component:
 *
 * - **about**: public, on white. The lead, the picture, the grey "enter your
 *   code" box with the page's paragraph under it, then "programme overview"
 *   and the two closing columns.
 * - **programme, lounge, hotel-deal**: locked, and **black** - the design
 *   knocks these three out (`theme="dark"` on Base, which flips the tokens
 *   so the shared blocks come along). The Worker renders them once
 *   src/middleware.ts has seen a VIP session; `astro dev` has no Worker and
 *   opens them to anyone.
 * - **access**: the locked state the gate redirects to - "VIP already?"
 *   beside "not a VIP yet?" - public, noindex.
 *
 * **Sanity first, the frames second.** The hub is new and no `page` document
 * exists for any of its tabs, so a tab without one renders the frames' own
 * copy and pictures from `src/components/vipContent.ts` - `fromDesign` below is the
 * whole of it. Creating the tab's page in the Studio switches that tab over
 * for good; when all five are there, the flag, the fallbacks and that file
 * go together. Data the design needs and the model does not carry is logged
 * in docs/backend-requests.md (#14-#16).
 */
const { lang, tab } = Astro.props as { lang: LocaleId; tab: string };
const t = useTranslations(lang);

const hubTab = HUBS.vip.tabs.find((x) => x.slug === tab);
if (!hubTab) return Astro.rewrite('/404');
const locked = !!hubTab.locked;
const isAccess = tab === 'access';

const [pages, settings, site, partners, events] = await Promise.all([
  getHubPages(lang, 'vip'),
  getVipSettings(lang),
  getSettings(lang),
  getPartners(lang),
  tab === 'programme' ? getProgramme(lang) : Promise.resolve([] as any[]),
]);
let page = pageForTab(pages, tab);

const contact = settings?.contact || site?.contactEmail || 'vip@ceramic.brussels';

/**
 * The frames' links resolve here rather than in the content file, so no URL
 * is written down twice: a tab of this hub, a tab of another, or a partner's
 * own website from its document - which is why "discover Embelco" simply
 * does not appear while that partner has no URL. A booking pill writes to
 * the VIP team, the address the contact block gives for exactly that, until
 * the venues' own links arrive (request #14).
 */
const partnerUrl = (name: string) => partners.find((p: any) => p?.name === name)?.url ?? null;
function resolveVipLink(link: VipLink) {
  switch (link.kind) {
    case 'tab':
      return { href: localePath(lang, hubTabPath('vip', link.tab, lang)), label: link.label, external: false, caps: false };
    case 'hub':
      return { href: localePath(lang, hubTabPath(link.route, link.tab, lang)), label: link.label, external: false, caps: false };
    case 'partner': {
      const url = partnerUrl(link.partner);
      // "discover The Hoxton", "discover MAD Brussels": a name, so the pill
      // keeps its capitals where every other label is set lowercase.
      return url ? { href: url, label: link.label, external: true, caps: true } : null;
    }
    case 'booking':
      return { href: `mailto:${contact}`, label: link.label, external: true, caps: false };
    case 'email':
      return { href: `mailto:${contact}`, label: link.label ?? contact, external: true, caps: true };
  }
}
type Resolved = { href: string; label: string; external: boolean; caps: boolean };
const vipLinks = (links: readonly VipLink[] = []) => links.map(resolveVipLink).filter(Boolean) as Resolved[];

/**
 * The hotel's code, from the settings table the Worker can read: `{code}` is
 * filled wherever it appears, in the page or in the rate paragraph. Under
 * `astro dev`, and until the setting exists, the frame's own code stands in.
 */
const hotelCode =
  tab === 'hotel-deal'
    ? await vipEnv()
        .then((env) => (env ? vipSetting(env.VIP_DB, 'hotel_code') : null))
        .catch(() => null)
    : null;
if (hotelCode && page) {
  page = JSON.parse(JSON.stringify(page).split('{code}').join(String(hotelCode).replace(/[\\"]/g, '')));
}

/* The programme tab: this edition's VIP events, on-site then off-site. */
const listed = tab === 'programme' ? events.filter((e: any) => e.section === 'vip' && e.startsAt) : [];
const onSite = listed.filter((e: any) => e.venue === 'on-site');
const offSite = listed.filter((e: any) => e.venue !== 'on-site');
const days = [...new Set(offSite.map((e: any) => e.startsAt.slice(0, 10)))] as string[];
const onDay = (day: string) => offSite.filter((e: any) => e.startsAt.startsWith(day));
const lines = (s: string) => String(s ?? '').split(/\r?\n/);

const path = hubTabPath('vip', tab, lang);
const altPaths = hubAltPaths('vip', tab);
const tabLabel = page?.tabLabel ?? t(hubTab.label);
const closingImages = (page?.images ?? []).filter((img: any) => img?.asset);
const hasSections = (page?.sections ?? []).length > 0;
/**
 * **The one switch.** No `page` document for this tab yet, so the frames'
 * own copy and pictures stand in for all of it - including the programme,
 * where the two VIP events the 2026 import left behind are not the eight the
 * frame lists. The moment Kamindu creates the tab's page this flips and the
 * Studio is the only source again.
 */
const fromDesign = !page;
/** One `cover` today; the array is what request #12 asks for site-wide. */
const heroImages = page?.cover?.asset ? [page.cover] : [];

const C = VIP_CONTENT;
const intro =
  page?.intro ??
  (tab === 'about'
    ? C.about.intro
    : tab === 'lounge'
      ? C.lounge.intro
      : tab === 'hotel-deal'
        ? C.hotelDeal.intro
        : undefined);
const rate = {
  ...C.hotelDeal.rate,
  text: C.hotelDeal.rate.text.split('{code}').join(String(hotelCode || C.hotelDeal.rate.fallbackCode)),
};
---

<Base
  lang={lang}
  title={page?.seo?.title ?? `${t('nav.vip')} — ${tabLabel}`}
  description={page?.seo?.description ?? intro}
  noIndex={locked || isAccess || page?.seo?.noIndex}
  image={page?.seo?.ogImage ?? page?.cover}
  theme={locked ? 'dark' : 'default'}
  path={path}
  altPaths={altPaths}
  editId={page?._id}
  editType={page?._type}
>
  <HubNav lang={lang} route="vip" active={tab} pages={pages} class="vip-band" />

  <div class="content-wrap vip">
    {intro && <p class="intro-large" {...styleAttrs(page?.introStyle)}>{intro}</p>}

    {/* ------------------------------------------------------------ about */}
    {
      tab === 'about' && (
        <div class="split-8-4 about-top">
          <div>
            {heroImages.length > 0 ? (
              <Slideshow
                images={heroImages}
                aspect={3 / 2}
                id="vip-hero"
                label={tabLabel}
                sizes="(max-width: 900px) 100vw, 62vw"
                widths={[600, 900, 1200, 1600]}
              />
            ) : (
              <VipShot image={C.about.hero} aspect={3 / 2} loading="eager" sizes="(max-width: 900px) 100vw, 62vw" />
            )}
          </div>
          <aside>
            {settings?.gateOpen !== false && <VipCodeForm lang={lang} contact={contact} heading={false} arrow={false} />}
            <div class="body-20 gate-note">
              {page?.body ? (
                <PortableText value={page.body} fieldStyle={page.bodyStyle} />
              ) : (
                <p>
                  {C.about.note.split(C.about.noteLink.phrase)[0]}
                  <a
                    class="text-link"
                    href={localePath(lang, hubTabPath(C.about.noteLink.route, C.about.noteLink.tab, lang))}
                  >
                    {C.about.noteLink.phrase}
                  </a>
                  {C.about.note.split(C.about.noteLink.phrase)[1]}
                </p>
              )}
            </div>
          </aside>
        </div>
      )
    }

    {
      /* "programme overview" - the editor's section stack once there is one. */
      tab === 'about' && fromDesign && (
        <section class="group overview">
          <h2 class="group-title">{C.about.overview.title}</h2>
          {C.about.overview.groups.map((group) => (
            <div class="subgroup">
              <h3 class="subgroup-title">{group.title}</h3>
              {group.rows.map((row: VipRow) => (
                <article class="split-8-4 overview-row">
                  <div>
                    {row.eyebrow && <p class="eyebrow-strong">{row.eyebrow}</p>}
                    <p class="body-20">{row.text}</p>
                    {vipLinks(row.links).length > 0 && (
                      <p class="links">
                        {vipLinks(row.links).map((l) => (
                          <LinkPill lang={lang} href={l.href} label={l.label} external={l.external} preserveCase={l.caps} />
                        ))}
                      </p>
                    )}
                  </div>
                  <VipShot image={row.image} seed={row.eyebrow} aspect={3 / 2} sizes="(max-width: 900px) 100vw, 30vw" />
                </article>
              ))}
            </div>
          ))}
        </section>
      )
    }

    {
      tab === 'about' && fromDesign && (
        <section class="two-col closing">
          {C.about.closing.map((column: VipRow) => (
            <div>
              <h2 class="panel-title">{column.title}</h2>
              <p class="body-20">{column.text}</p>
              {vipLinks(column.links).length > 0 && (
                <p class="links">
                  {vipLinks(column.links).map((l) => (
                    <LinkPill
                      lang={lang}
                      href={l.href}
                      label={l.label}
                      external={l.external}
                      preserveCase={l.caps}
                      variant={l.href.startsWith('mailto:') ? 'text' : 'pill'}
                    />
                  ))}
                </p>
              )}
            </div>
          ))}
        </section>
      )
    }

    {/* ----------------------------------------------------------- lounge */}
    {
      tab === 'lounge' && (
        <div class="two-col lounge-top">
          {heroImages.length > 0 ? (
            <Slideshow
              images={heroImages}
              aspect={3 / 2}
              id="vip-cover"
              label={tabLabel}
              sizes="(max-width: 900px) 100vw, 46vw"
              widths={[600, 900, 1200]}
            />
          ) : (
            <VipShot image={C.lounge.cover} aspect={3 / 2} loading="eager" sizes="(max-width: 900px) 100vw, 46vw" />
          )}
          {fromDesign && (
            <div>
              <h2 class="panel-title">{C.lounge.scenography.title}</h2>
              <p class="body-20">{C.lounge.scenography.text}</p>
              {vipLinks(C.lounge.scenography.links).length > 0 && (
                <p class="links">
                  {vipLinks(C.lounge.scenography.links).map((l) => (
                    <LinkPill lang={lang} href={l.href} label={l.label} external={l.external} preserveCase={l.caps} />
                  ))}
                </p>
              )}
            </div>
          )}
        </div>
      )
    }

    {
      tab === 'lounge' && fromDesign && (
        <div class="two-col aperitivos">
          <div>
            <h2 class="panel-title">{C.lounge.aperitivos.title}</h2>
            <p class="event-when">{C.lounge.aperitivos.when}</p>
            <p class="body-20 event-text">{C.lounge.aperitivos.text}</p>
          </div>
          <VipShot image={C.lounge.aperitivos.image} aspect={3 / 2} sizes="(max-width: 900px) 100vw, 46vw" />
        </div>
      )
    }

    {
      tab === 'lounge' && fromDesign && (
        <section class="group agenda">
          <h2 class="group-title">{C.lounge.agenda.title}</h2>
          <div class="rows">
            {C.lounge.agenda.rows.map((row: VipRow) => (
              <article class="row row-image-first">
                <VipShot image={row.image} seed={row.title} aspect={3 / 2} sizes="(max-width: 900px) 100vw, 30vw" />
                <div class="row-copy">
                  <h3 class="event-title">{row.title}</h3>
                  <p class="event-when">{row.when}</p>
                  <p class="body-20 event-text">{row.text}</p>
                  {vipLinks(row.links).length > 0 && (
                    <p class="links">
                      {vipLinks(row.links).map((l) => (
                        <LinkPill lang={lang} href={l.href} label={l.label} external={l.external} preserveCase={l.caps} />
                      ))}
                    </p>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {/* ------------------------------------------------------- hotel deal */}
    {
      tab === 'hotel-deal' && (
        <div class="two-col hotel">
          {heroImages.length > 0 ? (
            <Slideshow
              images={heroImages}
              aspect={3 / 2}
              id="vip-hotel"
              label={tabLabel}
              sizes="(max-width: 900px) 100vw, 46vw"
              widths={[600, 900, 1200]}
            />
          ) : (
            <VipShot image={C.hotelDeal.cover} aspect={3 / 2} loading="eager" sizes="(max-width: 900px) 100vw, 46vw" />
          )}
          <div>
            {page?.body ? (
              <div class="body-20">
                <PortableText value={page.body} fieldStyle={page.bodyStyle} />
              </div>
            ) : (
              <>
                <h2 class="panel-title">{C.hotelDeal.hotel.title}</h2>
                <p class="body-20">{C.hotelDeal.hotel.text}</p>
                {vipLinks(C.hotelDeal.hotel.links).length > 0 && (
                  <p class="links">
                    {vipLinks(C.hotelDeal.hotel.links).map((l) => (
                      <LinkPill lang={lang} href={l.href} label={l.label} external={l.external} preserveCase={l.caps} />
                    ))}
                  </p>
                )}
              </>
            )}

            {/* BACKEND-REQUEST #16: the rate line and the paragraph want two
                fields on Site settings → Hotel deal; they are two here. */}
            <div class="rate">
              <p class="rate-label">{t('vip.specialRate')}</p>
              <h3 class="rate-heading">{rate.heading}</h3>
              <p class="rate-body body-20">{rate.text}</p>
              {vipLinks([rate.link]).map((l) => (
                <p class="rate-link">
                  <LinkPill lang={lang} href={l.href} label={l.label} external={l.external} preserveCase={l.caps} />
                </p>
              ))}
            </div>
          </div>
        </div>
      )
    }

    {/* -------------------------------------------------------- programme */}
    {
      tab === 'programme' && (
        <section class="group">
          <h2 class="group-title">{t('vip.venue.on-site')}</h2>
          <div class="rows">
            {!fromDesign
              ? onSite.map((e: any) => (
                  <article class="row row-half">
                    <Slideshow
                      images={e.image?.asset ? [e.image] : []}
                      aspect={3 / 2}
                      id={`vip-on-${e._id}`}
                      label={e.title}
                      sizes="(max-width: 900px) 100vw, 46vw"
                      widths={[600, 900, 1200]}
                    />
                    <div class="row-copy">
                      <h3 class="event-title ruled" {...styleAttrs(e.titleStyle)}>
                        {lines(e.title).map((line, k) => (
                          <>
                            {k > 0 && <br />}
                            {line}
                          </>
                        ))}
                      </h3>
                      {/* BACKEND-REQUEST #15: the frame dates this "everyday —
                          11:00 / 16:00"; one datetime cannot say that. */}
                      <p class="event-when">{formatTime(e.startsAt, lang)}</p>
                      {e.description && (
                        <div class="event-text body-20">
                          <PortableText value={e.description} fieldStyle={e.descriptionStyle} />
                        </div>
                      )}
                      {/* BACKEND-REQUEST #14: no link on programmeEvent, so no pill. */}
                    </div>
                  </article>
                ))
              : C.programme.onSite.rows.map((row: VipRow) => (
                  <article class="row row-half">
                    <VipShot
                      image={row.image}
                      seed={row.title}
                      aspect={3 / 2}
                      loading="eager"
                      sizes="(max-width: 900px) 100vw, 46vw"
                    />
                    <div class="row-copy">
                      <h3 class="event-title ruled">{row.title}</h3>
                      <p class="event-when">{row.when}</p>
                      <p class="body-20 event-text">{row.text}</p>
                      {row.note && <p class="event-note body-20">{row.note}</p>}
                      {vipLinks(row.links).length > 0 && (
                        <p class="links">
                          {vipLinks(row.links).map((l) => (
                            <LinkPill lang={lang} href={l.href} label={l.label} external={l.external} preserveCase={l.caps} />
                          ))}
                        </p>
                      )}
                    </div>
                  </article>
                ))}
          </div>
        </section>
      )
    }

    {
      tab === 'programme' && (
        <section class="group off-site">
          <h2 class="group-title">{t('vip.venue.off-site')}</h2>
          {!fromDesign
            ? days.map((day) => (
                <section class="day">
                  <h3 class="day-title">{formatDayLong(day, lang)}</h3>
                  <div class="rows">
                    {onDay(day).map((e: any) => (
                      <article class="row">
                        <div class="row-copy">
                          <h4 class="event-line" {...styleAttrs(e.titleStyle)}>
                            {lines(e.title).join(' ')} — {formatTime(e.startsAt, lang)}
                          </h4>
                          {e.description && (
                            <div class="event-text body-20">
                              <PortableText value={e.description} fieldStyle={e.descriptionStyle} />
                            </div>
                          )}
                          {/* BACKEND-REQUEST #14: the frame ends every row in
                              "book your visit ↗"; programmeEvent has no link. */}
                        </div>
                        <Slideshow
                          images={e.image?.asset ? [e.image] : []}
                          aspect={3 / 2}
                          id={`vip-off-${e._id}`}
                          label={e.title}
                          sizes="(max-width: 900px) 100vw, 30vw"
                          widths={[460, 920]}
                        />
                      </article>
                    ))}
                  </div>
                </section>
              ))
            : C.programme.offSite.days.map((day) => (
                <section class="day">
                  <h3 class="day-title">{day.title}</h3>
                  <div class="rows">
                    {day.rows.map((row: VipRow) => (
                      <article class="row">
                        <div class="row-copy">
                          <h4 class="event-line">
                            {row.title} — {row.when}
                          </h4>
                          <p class="body-20 event-text">{row.text}</p>
                          {vipLinks(row.links).length > 0 && (
                            <p class="links">
                              {vipLinks(row.links).map((l) => (
                                <LinkPill lang={lang} href={l.href} label={l.label} external={l.external} preserveCase={l.caps} />
                              ))}
                            </p>
                          )}
                        </div>
                        <VipShot
                          image={row.image}
                          seed={row.title}
                          aspect={3 / 2}
                          sizes="(max-width: 900px) 100vw, 30vw"
                        />
                      </article>
                    ))}
                  </div>
                </section>
              ))}
        </section>
      )
    }

    {/* The editor's own blocks, once a page carries them. */}
    {hasSections && <PageSections lang={lang} sections={page.sections} />}

    {
      page?.body && tab !== 'about' && tab !== 'hotel-deal' && (
        <div class="body-24 page-body">
          <PortableText value={page.body} fieldStyle={page.bodyStyle} />
        </div>
      )
    }

    {
      closingImages.length > 0 && (
        <ul class="image-row">
          {closingImages.map((img: any) => (
            <li>
              <SanityImage image={img} aspect={3 / 2} sizes="(max-width: 640px) 100vw, 440px" widths={[440, 880]} />
            </li>
          ))}
        </ul>
      )
    }

    {/* ----------------------------------------------------------- access */}
    {
      isAccess && (
        <div class="two-col access">
          <VipCodeForm lang={lang} contact={contact} />
          <VipRequestForm lang={lang} settings={settings} />
        </div>
      )
    }

    {
      locked && (
        <>
        <form class="leave" method="post" action="/api/vip/leave/">
          <input type="hidden" name="lang" value={lang} />
          <button type="submit" class="arrow-link">
            {t('vip.leave')} <span class="link-arrow" data-arrow="→" aria-hidden="true">→</span>
          </button>
        </form>
        <script is:inline>
          // Back after leaving can bring a locked tab back out of the
          // browser's page cache without asking the server; reload it so
          // the gate decides again (request #27).
          addEventListener('pageshow', (e) => {
            if (e.persisted) location.reload();
          });
        </script>
        </>
      )
    }
  </div>
</Base>

<style>
  /* The frames' body size: a step under .body-24, which the design keeps for
     the lead paragraphs. */
  /* The class kept its name, but since 2026-09-23 it is the site's body
     size, .body-24 (client feedback: the VIP text "feels smaller" than the
     rest of the website and than the text in its buttons). */
  .body-20 {
    font-size: var(--body-size);
    line-height: var(--body-lh);
    letter-spacing: var(--body-ls);
  }
  .body-20 :global(p + p) {
    margin-top: 1em;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
    margin-top: 18px;
  }

  /* The frames' recurring split: copy on two thirds, picture on a third. */
  .split-8-4 {
    display: grid;
    grid-template-columns: 8fr 4fr;
    gap: 30px;
    align-items: start;
  }
  .about-top {
    margin-top: 36px;
  }
  .gate-note {
    margin-top: 28px;
  }

  .group {
    margin-top: 56px;
  }
  /* "programme overview": the guest of honour's name style, "Marion
     Verboom" (client feedback, 2026-09-23). */
  /* 2px rules on every VIP title, as on the rest of the site (client
     feedback, 2026-09-24: the VIP ones read thinner). */
  .group-title {
    border-top: 2px solid;
    padding-top: 14px;
    letter-spacing: -0.06em;
    font-size: clamp(38px, 4.3vw, 62px);
    font-weight: 400;
    line-height: 1;
    text-transform: lowercase;
  }
  /* "at the fair", "beyond the fair": ruled under itself, over the copy
     column only, as the day headings of the programme frame are. */
  .subgroup {
    margin-top: 36px;
  }
  /* "at the fair", "beyond the fair": the food & drinks titles' style
     (client feedback, 2026-09-23). */
  .subgroup-title {
    border-bottom: 2px solid;
    padding-bottom: 6px;
    max-width: 66%;
    letter-spacing: -0.04em;
    font-size: clamp(26px, 2.5vw, 36px);
    font-weight: 600;
    line-height: 1.2;
  }
  .overview-row {
    margin-top: 30px;
  }
  /* "VIP LOUNGE", "DISCOVERY TOURS": the site's other bold capitals, the
     board and jury roles (client feedback, 2026-09-23). */
  .eyebrow-strong {
    margin-bottom: 10px;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
