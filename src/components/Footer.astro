---
/**
 * Site footer: the design's acid band with the copyright line on the left
 * and the social / newsletter pills on the right, each ending in "↗", plus
 * the cookie-settings pill. Markup and classes are the design's (html
 * pages, 2026-09-14 build); the rules live in src/styles/design.css.
 * Links are resolved by Base.astro from the editable footer menu.
 */
interface Props {
  siteName: string;
  links: { label: string; href: string; external?: boolean; arrow?: string }[];
  /** From Site settings; Base falls back to "© siteName, year". */
  copyright?: string;
  /** Label of the pill that reopens the cookie banner; absent when no tracker is in use. */
  consentLabel?: string;
  /**
   * A pill at the left of the band, before the credit (Léonie, Figma comment
   * 2026-09-28): "← back to 2027" on a previous-editions page, "previous
   * editions →" on the homepage. When it is there the credit moves to the
   * middle of the band rather than disappearing (Lilanga, 2026-09-30).
   */
  backLink?: { label: string; href: string; arrow?: string };
}

const { siteName, links, copyright, consentLabel, backLink } = Astro.props;
const line = copyright ?? `© ${siteName}, ${new Date().getFullYear()}`;
---

<footer
  class:list={[
    'site-footer acid-wash flex min-h-20 flex-wrap items-center justify-between gap-4 px-[clamp(16px,2vw,30px)] py-5',
    { 'has-back': !!backLink },
  ]}
>
  {
    backLink && (
      <a class="footer-pill footer-back" href={backLink.href}>
        {backLink.arrow === '←' && <span class="link-arrow" data-arrow="←">←</span>}
        {backLink.label}
        {backLink.arrow !== '←' && <span class="link-arrow">{backLink.arrow ?? '→'}</span>}
      </a>
    )
  }
  <p class="footer-credit">{line}</p>
  {
    (links.length > 0 || consentLabel) && (
      <nav class="footer-pills flex flex-wrap justify-end" aria-label={siteName}>
        {links.map((link) => (
          <a class="footer-pill" href={link.href} {...(link.external ? { rel: 'noopener noreferrer' } : {})}>
            {link.label} {link.arrow ?? '↗'}
          </a>
        ))}
        {consentLabel && (
          <button type="button" class="footer-pill" data-consent-open>
            {consentLabel}
          </button>
        )}
      </nav>
    )
  }
</footer>

<style>
  /* 2026-09-16 feedback: smaller pills with the stroke closer to the text and
     tighter letter-spacing, a smaller credit, and the cookie pill hovering
     black like the links (design.css only covers `footer a`). */
  .footer-credit {
    font-size: clamp(0.8125rem, 1.1vw, 1rem);
    letter-spacing: -0.02em;
  }
  .footer-pills {
    gap: 8px;
  }
  .footer-pill {
    border: 1px solid #050505;
    border-radius: 999px;
    padding: 1px 11px 0;
    font-size: clamp(0.8125rem, 1.1vw, 1rem);
    line-height: 1.5;
    letter-spacing: -0.02em;
    cursor: pointer;
    transition: color 0.18s, background-color 0.18s;
  }
  .footer-pill:hover,
  .footer-pill:focus-visible {
    color: #fff;
    background-color: #050505;
  }
  /* With a back pill on the left the credit is centred between the two
     groups rather than dropped (Lilanga, 2026-09-30). `flex: 1` on the
     credit and a matching basis on the pill groups keeps it on the band's
     centre line, not merely between its neighbours. */
  .site-footer.has-back .footer-credit {
    flex: 1;
    text-align: center;
  }
  .footer-back {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    white-space: nowrap;
  }
  @media (width<=700px) {
    /* Three groups do not sit on one line on a phone: the pill takes the
       first row, the credit and the links follow, all left-aligned. */
    .site-footer.has-back {
      justify-content: flex-start;
    }
    .site-footer.has-back .footer-credit {
      flex: 1 0 100%;
      text-align: left;
    }
  }
</style>
