---
import PortableText from '../PortableText.astro';
import ExhibitorsListing from '../ExhibitorsListing.astro';
import type { LocaleId } from '../../lib/locales';
import { getExhibitorsByYear, getAwards } from '../../lib/queries';

/**
 * A previous edition's galleries: that year's exhibitor list, as the
 * exhibitors tab of the section.
 *
 * It is the same `ExhibitorsListing` /exhibitors uses - the A-Z row, the
 * filters and the card grid are one implementation - with `inSection`, which
 * drops the component's own title band and year row because
 * PreviousEdition.astro has already drawn the year band and the pills.
 *
 * **The list used to live at `/exhibitors/<year>`**, the address the old site
 * gave its year lists, reached from this tab's pill as an external link. That
 * left two shapes of URL for one year's content, and so two sets of year links
 * on the same page (Kamindu, 2026-10-01). The old addresses 301 onto this one
 * from `scripts/legacy-redirects.mjs`; the galleries' own pages stay at
 * `/exhibitors/<year>/<slug>`.
 */
const { lang, year, edition, lead } = Astro.props as {
  lang: LocaleId;
  year: number;
  edition: any;
  lead?: any;
};

/** One request each, memoised by `run()`, so the year's other tabs pay nothing. */
const [exhibitors, awards] = await Promise.all([getExhibitorsByYear(lang, year), getAwards(lang)]);

/**
 * That year's fair-award winners, for the "awards" filter pill - the 2025 list
 * gets 2025's, as /exhibitors gets the landing year's.
 */
const awarded = new Set<string>(
  awards
    .filter((a: any) => a.family === 'fair' && a.year === year && a.gallery?._id)
    .map((a: any) => a.gallery._id),
);
---

{lead && (
  <div class="content-wrap">
    <div class="intro-large lead"><PortableText value={lead} /></div>
  </div>
)}

<ExhibitorsListing
  lang={lang}
  exhibitors={exhibitors}
  edition={edition}
  year={year}
  awarded={awarded}
  inSection
/>
