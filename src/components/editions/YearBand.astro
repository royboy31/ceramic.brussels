---
import type { LocaleId } from '../../lib/locales';
import { useTranslations, localePath } from '../../lib/i18n';
import { editionTabPath, editionBandLabel, type EditionSummary } from '../../lib/previousEditions';

/**
 * The band above the title on every previous-editions frame: one cell per past
 * edition, full width, equal widths, the one being read filled black -
 * `2026, THIRD EDITION | 2025, SECOND EDITION | 2024, FIRST EDITION`. Newest
 * first, which is the order `getPastEditionsIndex` returns.
 *
 * Each cell leads to that year's *overview*, not to the same tab in another
 * year: the tabs are not the same from one edition to the next (2024 has no
 * country focus), so carrying the reader's tab across would land them on a
 * pill that does not exist there.
 */
interface Props {
  lang: LocaleId;
  /** Every past edition, newest first. */
  editions: EditionSummary[];
  /** The year being read. */
  active: number;
}

const { lang, editions, active } = Astro.props;
const t = useTranslations(lang);
---

{
  editions.length > 1 && (
    <nav class="year-band" aria-label={t('prevEd.section')}>
      {editions.map((edition) => {
        const current = edition.year === active;
        return (
          <a
            class:list={['year-cell', { active: current }]}
            href={localePath(lang, editionTabPath(edition.year, undefined, lang))}
            aria-current={current ? 'page' : undefined}
          >
            {editionBandLabel(edition, lang, t)}
          </a>
        );
      })}
    </nav>
  )
}

<style>
  /* Full bleed, one row, equal cells, hairlines between and under. The band
     sits directly under the site header, so it carries its own top rule. */
  .year-band {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    border-top: 1px solid var(--color-ink, #050505);
    border-bottom: 1px solid var(--color-ink, #050505);
  }
  /* 53px tall on the frame, measured off the black cell. */
  .year-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 53px;
    padding: 6px 12px;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: 0.01em;
    /* The design sets these in small caps; the content is lowercase in the
       data ("2nd edition"), so the band does the casing. */
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    transition: color 0.18s, background-color 0.18s;
  }
  .year-cell + .year-cell {
    border-left: 1px solid var(--color-ink, #050505);
  }
  .year-cell.active {
    color: #fff;
    background: #050505;
  }
  .year-cell:hover,
  .year-cell:focus-visible {
    color: #050505;
    background: var(--ed-fill);
  }
  .year-cell.active:hover,
  .year-cell.active:focus-visible {
    color: #fff;
    background: #050505;
  }

  @media (width<=700px) {
    /* Three cells of "2025, SECOND EDITION" do not fit a phone in a row;
       they stack, and the rules between them become rules under them. */
    .year-band {
      grid-auto-flow: row;
      grid-auto-columns: auto;
    }
    .year-cell {
      justify-content: flex-start;
      min-height: 38px;
      padding-inline: var(--gutter);
      font-size: 14px;
    }
    .year-cell + .year-cell {
      border-top: 1px solid var(--color-ink, #050505);
      border-left: 0;
    }
  }
</style>

<style is:global>
  /**
   * The previous-editions title band, wherever it appears - on a tab of the
   * section and on `/exhibitors/<year>`, which is one of its tabs but a route
   * of its own. `.ed-band` goes on the `HubNav` in both places.
   *
   * **The pills are fixed in size here on purpose.** `body[data-scrolled]`
   * shrinks every other band's pills from 24px to 20px as the page scrolls;
   * this band is already at the frame's 20px, so following that rule made the
   * pills jump on the exhibitors page - larger at rest, smaller once moved.
   * They now read the same at any scroll position.
   *
   * The band carries **seven** pills where a hub carries three or four, which
   * is the other reason for the smaller size: measured off the frames, the
   * seven span x497-1408 beside a 333px "2nd edition".
   */
  :root {
    /* The fill behind the tab you are on, and behind any tab under the
       pointer. Sampled from the frames (#9f9f9f) and set to the designer's
       own value. Not the acid the hubs use. */
    --ed-fill: #a09f9f;
  }
  /**
   * The section's gutter is 30px where the rest of the site uses 45 - the
   * frames put every body element at x=30, including the exhibitors one.
   * Keyed off the year band so the exhibitors year list gets it too without
   * knowing anything about the section; the shared header keeps its own 45,
   * which is hard-coded in design.css and untouched. Desktop only: below
   * 900px design.css steps the gutter to 16 and then 10, and those stand.
   */
  @media (width>900px) {
    body:has(.year-band) {
      --gutter: 30px;
    }
  }
  .section-head.ed-band,
  body[data-scrolled] .section-head.ed-band {
    --band-pill: 20px;
    --band-pill-pad: 4px 13px;
  }
  .section-head.ed-band nav {
    gap: 17px;
  }
  .section-head.ed-band a {
    line-height: 26px;
  }
  /* design.css hovers every pill to white on black with `!important`, and
     fills the active one acid; this band does neither. The stroke stays
     black throughout, as the frames draw it. */
  .section-head.ed-band a.active,
  .section-head.ed-band a:hover,
  .section-head.ed-band a:focus-visible,
  .section-head.ed-band a.active:hover,
  .section-head.ed-band a.active:focus-visible {
    color: #050505 !important;
    background-color: var(--ed-fill) !important;
    border-color: #050505 !important;
  }
  /* Below about 1180 the row cannot hold the title and seven pills; they
     wrap under it rather than climbing over it. */
  @media (width<=1180px) {
    .section-head.ed-band {
      display: block;
    }
    .section-head.ed-band nav {
      justify-content: flex-start;
      flex-wrap: wrap;
      padding-top: 16px;
    }
  }
</style>
