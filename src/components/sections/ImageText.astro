---
import type { LocaleId } from '../../lib/locales';
import SanityImage from '../SanityImage.astro';
import PortableText from '../PortableText.astro';
import LinkPill from '../LinkPill.astro';
import { styleAttrs, bodyStyleAttrs } from '../../lib/textStyle';

/**
 * Image on eight columns, text on four - the unit at the top of the about
 * page (hero + "the fair"). `imageSide` flips it.
 *
 * `variant="vip"` turns it around for the VIP frames, whose rows put the
 * copy on eight columns and the picture on four at its right, with the
 * heading as the design's bold capitals rather than a panel title. The VIP
 * tabs render the same blocks as every other page; only these proportions
 * are theirs.
 */
interface Props {
  lang: LocaleId;
  section: any;
  variant?: 'default' | 'home' | 'vip' | 'vip-panel';
}

const { lang, section, variant = 'default' } = Astro.props;
const links = (section.links ?? []).filter(Boolean);
const hasImage = !!section.image?.asset;
---

<section
  class:list={[
    'page-grid',
    'image-text',
    {
      flip: section.imageSide === 'right',
      'no-image': !hasImage,
      vip: variant === 'vip' || variant === 'vip-panel',
      'vip-rows': variant === 'vip',
      'vip-panel': variant === 'vip-panel',
    },
  ]}
  id={section.anchor || undefined}
>
  {
    hasImage && (
      <figure class="shot">
        <SanityImage
          image={section.image}
          aspect={1.5}
          sizes="(max-width: 900px) 100vw, 66vw"
          widths={[600, 900, 1200, 1600]}
        />
      </figure>
    )
  }
  <div class="copy">
    {
      section.heading && (
        <h2 class="panel-title" {...styleAttrs(section.headingStyle)}>
          {section.heading}
        </h2>
      )
    }
    {
      section.body && (
        <div class="body-24 body" {...bodyStyleAttrs(section.bodyStyle)}>
          <PortableText value={section.body} fieldStyle={section.bodyStyle} />
        </div>
      )
    }
    {
      /* The label's capitals stand: these are names as often as not -
         "discover Puilaetco", "discover The Hoxton" (Léonie, 2026-09-30). */
      links.length > 0 && (
        <p class="links">
          {links.map((link: any) => (
            <LinkPill lang={lang} link={link} preserveCase />
          ))}
        </p>
      )
    }
  </div>
</section>

<style>
  .image-text {
    align-items: start;
    margin: 0 0 3rem;
  }
  .shot {
    grid-column: span 8;
    margin: 0;
  }
  .shot :global(img) {
    width: 100%;
  }
  .copy {
    grid-column: span 4;
    min-width: 0;
  }
  .flip .shot {
    order: 2;
  }
  .no-image .copy {
    grid-column: 1 / -1;
  }

  /* The VIP frames' row: copy on eight, picture on four at its right
     (`.split-8-4` in Vip.astro), and the heading in the site's bold
     capitals, as "DISCOVERY TOURS" and "VIP LOUNGE" are drawn. */
  .vip .shot {
    grid-column: span 4;
    order: 2;
  }
  .vip .copy {
    grid-column: span 8;
  }
  /* The about tab's "programme overview" rows: the heading is the design's
     bold capitals over the paragraph - "DISCOVERY TOURS", "VIP LOUNGE". */
  .vip-rows .panel-title {
    margin-bottom: 10px;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  /* The lounge and hotel frames head their blocks with a panel title instead,
     ruled and standing clear of the copy: the spacing `.aperitivos
     .panel-title` gives it in Vip.astro, which a block rendered from Sanity
     never sat inside (Félicie, 2026-10-01). The blocks are set apart the way
     `.aperitivos` is, too. */
  .vip-panel {
    margin-top: 56px;
  }
  /* Spacing only. The panel title's own 40px comes from design.css, and
     overriding it here with `inherit` took the lounge's headings down to
     body size (Félicie, 2026-10-01). */
  .vip-panel .panel-title {
    margin-bottom: 30px;
    padding-bottom: 5px;
  }
  .body :global(p) {
    margin: 0 0 1.25rem;
  }
  .body :global(p:last-child) {
    margin-bottom: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin: 1.75rem 0 0;
    font-size: clamp(1rem, 1.6vw, 1.4rem);
  }

  @media (max-width: 900px) {
    .shot,
    .copy {
      grid-column: 1 / -1;
    }
    .flip .shot,
    .vip .shot {
      order: 0;
    }
    .copy {
      margin-top: 1.5rem;
    }
  }
</style>
