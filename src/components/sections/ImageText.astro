---
import type { LocaleId } from '../../lib/locales';
import SanityImage from '../SanityImage.astro';
import FigureCaption from '../FigureCaption.astro';
import PortableText from '../PortableText.astro';
import LinkPill from '../LinkPill.astro';
import { styleAttrs, bodyStyleAttrs } from '../../lib/textStyle';

/**
 * Image on eight columns, text on four - the unit at the top of the about
 * page (hero + "the fair"). `imageSide` flips it.
 *
 * `variant="vip"` turns it around for the VIP frames, whose rows put the
 * copy on eight columns and the picture on four at its right, with the
 * heading as the design's bold capitals rather than a panel title. The VIP
 * tabs render the same blocks as every other page; only these proportions
 * are theirs.
 */
interface Props {
  lang: LocaleId;
  section: any;
  variant?: 'default' | 'home' | 'vip' | 'vip-panel';
}

const { lang, section, variant = 'default' } = Astro.props;
const links = (section.links ?? []).filter(Boolean);
const hasImage = !!section.image?.asset;
---

<section
  class:list={[
    'page-grid',
    'image-text',
    {
      flip: section.imageSide === 'right',
      'no-image': !hasImage,
      vip: variant === 'vip' || variant === 'vip-panel',
      'vip-rows': variant === 'vip',
      'vip-panel': variant === 'vip-panel',
    },
  ]}
  id={section.anchor || undefined}
>
  {
    hasImage && (
      <figure class="shot">
        <SanityImage
          image={section.image}
          aspect={1.5}
          sizes="(max-width: 900px) 100vw, 66vw"
          widths={[600, 900, 1200, 1600]}
        />
        <FigureCaption image={section.image} />
      </figure>
    )
  }
  <div class="copy">
    {
      section.heading && (
        <h2 class="panel-title" {...styleAttrs(section.headingStyle)}>
          {section.heading}
        </h2>
      )
    }
    {
      section.body && (
        <div class="body-24 body" {...bodyStyleAttrs(section.bodyStyle)}>
          <PortableText value={section.body} fieldStyle={section.bodyStyle} />
        </div>
      )
    }
    {
      /* The label's capitals stand: these are names as often as not -
         "discover Puilaetco", "discover The Hoxton" (Léonie, 2026-09-30). */
      links.length > 0 && (
        <p class="links">
          {links.map((link: any) => (
            <LinkPill lang={lang} link={link} preserveCase />
          ))}
        </p>
      )
    }
  </div>
</section>

<style>
  .image-text {
    align-items: start;
    margin: 0 0 3rem;
  }
  .shot {
    grid-column: span 8;
    margin: 0;
  }
  .shot :global(img) {
    width: 100%;
  }
  .copy {
    grid-column: span 4;
    min-width: 0;
  }
  .flip .shot {
    order: 2;
  }
  .no-image .copy {
    grid-column: 1 / -1;
  }

  /* The VIP frames' row: copy on eight, picture on four at its right
     (`.split-8-4` in Vip.astro), and the heading in the site's bold
     capitals, as "DISCOVERY TOURS" and "VIP LOUNGE" are drawn. */
  /* Width only. Which side the picture takes is the block's own Image side
     setting, through `.flip` - forcing it here put the lounge's agenda rows
     on the wrong side of their copy, against both the frame and what the
     editor had chosen (Kamindu, 2026-10-01). */
  .vip .shot {
    grid-column: span 4;
  }
  .vip .copy {
    grid-column: span 8;
  }
  /* The VIP tabs render these inside `.content-wrap`, which already pays
     the gutter; `page-grid` paying it again indented every row by a second
     45px against the section titles above ("aligned fully left" - Félicie,
     2026-10-01). */
  .image-text.vip {
    padding-inline: 0;
  }
  /* The about tab's "programme overview" rows: the heading is the design's
     bold capitals over the paragraph - "DISCOVERY TOURS", "VIP LOUNGE". */
  .vip-rows .panel-title {
    margin-bottom: 10px;
    /* Not ruled: the frame's row label is bold capitals alone, and the
       2px rule design.css gives every panel title read as an underline
       here (Félicie, 2026-10-01). */
    border-bottom: 0;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  /* The lounge and hotel frames head their blocks with a panel title instead,
     ruled and standing clear of the copy: the spacing `.aperitivos
     .panel-title` gives it in Vip.astro, which a block rendered from Sanity
     never sat inside (Félicie, 2026-10-01). The blocks are set apart the way
     `.aperitivos` is, too. */
  .vip-panel {
    margin-top: 56px;
  }
  /* Spacing only. The panel title's own 40px comes from design.css, and
     overriding it here with `inherit` took the lounge's headings down to
     body size (Félicie, 2026-10-01). */
  .vip-panel .panel-title {
    margin-bottom: 30px;
    padding-bottom: 5px;
  }
  .body :global(p) {
    margin: 0 0 1.25rem;
  }
  .body :global(p:last-child) {
    margin-bottom: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin: 1.75rem 0 0;
    font-size: clamp(1rem, 1.6vw, 1.4rem);
  }

  @media (max-width: 900px) {
    /* The .vip pairs too: their span rules are more specific than the two
       plain selectors and kept eight tracks alive in the four-column phone
       grid - the shot then centred on its tracks, not the screen (found
       2026-10-02, VIP about at 390px). */
    .shot,
    .copy,
    .vip .shot,
    .vip .copy {
      grid-column: 1 / -1;
    }
    .flip .shot {
      order: 0;
    }
    .copy {
      margin-top: 1.5rem;
    }
  }

  /* The picture to both screen edges on a phone (Léonie, 2026-10-01).
     Here rather than in site.css so the cascade is certain. The row
     renders at different depths - alone, or inside a content-wrap that
     adds a second gutter - so no constant knows the inset; the stack fix
     above leaves the grid area centred on the viewport, and the shot is
     recentred positionally: `left` with a transform, because WebKit does
     not honour a percentage MARGIN pull on a grid item (2026-10-03, the
     programme/visitors-info lesson), while positional offsets play no
     part in track sizing. */
  @media (max-width: 700px) {
    .shot {
      width: 100vw;
      max-width: none;
      position: relative;
      left: 50%;
      transform: translateX(-50%);
    }
    /* The picture goes to both edges; its caption does not follow it there
       (site.css draws the same line for every other bleeding figure). */
    .shot :global(figcaption) {
      padding-inline: var(--gutter);
    }
  }
</style>
