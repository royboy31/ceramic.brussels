---
import type { LocaleId } from '../../lib/locales';
import SanityImage from '../SanityImage.astro';
import FigureCaption from '../FigureCaption.astro';
import { styleAttrs } from '../../lib/textStyle';

/**
 * A grid of 3:2 images, two to four across, with the design's caption line.
 *
 * Every picture that carries a caption prints it. The block used to hide them
 * all behind a "Show captions" switch that was off by default, so an editor
 * who typed a caption into each image saw nothing and had no reason to suspect
 * a second control ("Tiphaine has put them in the CMS, but they don't show
 * under the photos" - Léonie, 2026-10-05). The switch is hidden in the schema
 * and its data left alone.
 */
interface Props {
  lang: LocaleId;
  section: any;
}

const { section } = Astro.props;
const images = (section.images ?? []).filter((img: any) => img?.asset);
const columns = [2, 3, 4].includes(section.columns) ? section.columns : 3;
---

{
  images.length > 0 && (
    <section class="gallery" id={section.anchor || undefined}>
      {section.heading && (
        <h2 class="panel-title" {...styleAttrs(section.headingStyle)}>
          {section.heading}
        </h2>
      )}
      <ul class="grid" style={`--cols: ${columns}`}>
        {images.map((img: any) => (
          <li>
            <figure>
              <SanityImage
                image={img}
                aspect={1.5}
                sizes={`(max-width: 640px) 100vw, (max-width: 900px) 50vw, ${Math.round(100 / columns)}vw`}
                widths={[400, 600, 900, 1200]}
              />
              <FigureCaption image={img} />
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .gallery {
    margin: 0 0 3rem;
  }
  /* The design's photo strip (`.strip`, `.photo-row`): 3:2 pictures, 40px apart. */
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    gap: 40px;
  }
  figure {
    margin: 0;
  }
  figure :global(img) {
    aspect-ratio: 1.5;
    object-fit: cover;
    width: 100%;
  }
  /* The caption line and its credit are FigureCaption's own. */

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
