---
import type { LocaleId } from '../../lib/locales';
import { localePath, useTranslations } from '../../lib/i18n';
import { styleAttrs } from '../../lib/textStyle';

/**
 * The gallery application form.
 *
 * On the old site this was a JotForm in a frame: last name, first name,
 * gallery, email, Send - the gate through which a gallery asks for the real
 * application pack. This is the same four fields as a page of the site, with
 * what the frame never had: inline validation, a visible success state, a
 * visible failure state that names the person to write to instead, and a
 * button that cannot be pressed twice.
 *
 * Drawn at the design's text scale (`.panel-title`, `.body-24`, `.pill` from
 * design.css, the `.two-col` split): a label and an underlined field per
 * column, the black pill of the site's calls to action to send.
 *
 * Whether the form is open, what it says when it is not, and where a sent
 * request lands (a thank-you page, or a line under the form) come from
 * Site settings → Applications (the `form` key the query resolves). The
 * submission goes to `/api/apply/` on the Worker (with the slash: every URL Pages serves ends in one, and the bare path is a 308 away) (src/server/routes/apply.ts),
 * which sends the two emails once Brevo is connected; until then it answers
 * 503 and the failure state shows.
 */
interface Props {
  lang: LocaleId;
  section: any;
}

const { lang, section } = Astro.props;
const t = useTranslations(lang);
const form = section.form ?? {};
const open = form.open !== false;
const contact = form.contact || 'info@ceramic.brussels';
const id = section.anchor || 'apply';
/** The thank-you page in this language (Site settings → Applications → Page shown after sending), or none. */
const successSlug = form.successSlugs?.[lang] ?? form.successSlugs?.en;
const successUrl = successSlug ? localePath(lang, successSlug) : undefined;
const fields = [
  { name: 'firstName', label: t('apply.firstName'), type: 'text', autocomplete: 'given-name', max: 120 },
  { name: 'lastName', label: t('apply.lastName'), type: 'text', autocomplete: 'family-name', max: 120 },
  { name: 'gallery', label: t('apply.gallery'), type: 'text', autocomplete: 'organization', max: 200 },
  { name: 'email', label: t('apply.email'), type: 'email', autocomplete: 'email', max: 254 },
];
---

<section class="apply" id={id}>
  {
    section.heading && (
      <h2 class="panel-title" {...styleAttrs(section.headingStyle)}>
        {section.heading}
      </h2>
    )
  }
  {
    section.note && (
      <p class="note body-24" {...styleAttrs(section.noteStyle)}>
        {section.note}
      </p>
    )
  }

  {
    !open ? (
      <p class="closed body-24">{form.closedMessage || t('apply.closed')}</p>
    ) : (
      <form
        class="form"
        method="post"
        action="/api/apply/"
        novalidate
        data-apply
        data-success={form.successMessage || t('apply.success')}
        data-success-url={successUrl}
        data-error={t('apply.error', { email: contact })}
        data-duplicate={t('apply.duplicate')}
        data-closed={form.closedMessage || t('apply.closed')}
        data-required={t('apply.required')}
        data-invalid-email={t('apply.invalidEmail')}
        data-sending={t('apply.sending')}
      >
        <input type="hidden" name="lang" value={lang} />
        {/* Bots fill every field; people never see this one. */}
        <div class="hp" aria-hidden="true">
          <label>
            website <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="two-col fields">
          {fields.map((f) => (
            <div class="field">
              <label class="body-24" for={`${id}-${f.name}`}>
                {f.label} <span class="req" aria-hidden="true">*</span>
              </label>
              <input
                id={`${id}-${f.name}`}
                name={f.name}
                type={f.type}
                required
                autocomplete={f.autocomplete}
                maxlength={f.max}
                inputmode={f.type === 'email' ? 'email' : undefined}
              />
              <p class="hint" data-hint aria-live="polite" />
            </div>
          ))}
        </div>

        <div class="actions">
          <button type="submit" class="pill dark" data-submit>
            {t('apply.submit')} <span class="link-arrow" aria-hidden="true">→</span>
          </button>
          <p class="status body-24" data-status role="status" aria-live="polite" />
        </div>
      </form>
    )
  }
</section>

<script>
  // Progressive: without JavaScript the form still posts to /api/apply, which
  // answers with a plain page. With it, the answer shows in place.
  document.querySelectorAll<HTMLFormElement>('form[data-apply]').forEach((form) => {
    const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const idle = button.innerHTML;
    const say = (text: string, kind: 'ok' | 'bad' | '') => {
      status.textContent = text;
      status.dataset.kind = kind;
    };

    const check = (input: HTMLInputElement): boolean => {
      const hint = input.parentElement?.querySelector<HTMLElement>('[data-hint]');
      let problem = '';
      if (input.required && !input.value.trim()) problem = form.dataset.required!;
      else if (input.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value.trim())) problem = form.dataset.invalidEmail!;
      input.setAttribute('aria-invalid', problem ? 'true' : 'false');
      if (hint) hint.textContent = problem;
      return !problem;
    };

    form.querySelectorAll<HTMLInputElement>('.field input').forEach((input) => {
      input.addEventListener('blur', () => check(input));
      input.addEventListener('input', () => {
        if (input.getAttribute('aria-invalid') === 'true') check(input);
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const inputs = [...form.querySelectorAll<HTMLInputElement>('.field input')];
      const bad = inputs.filter((input) => !check(input));
      if (bad.length) {
        bad[0].focus();
        return;
      }

      button.disabled = true;
      button.textContent = form.dataset.sending!;
      say('', '');

      const data: Record<string, string> = {};
      new FormData(form).forEach((value, key) => (data[key] = String(value)));

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const body = await response.json().catch(() => ({}));
        if (response.ok) {
          form.classList.add('sent');
          form.querySelectorAll<HTMLInputElement>('input, button').forEach((el) => (el.disabled = true));
          // The thank-you page when one is set; the line under the form otherwise.
          const next = form.dataset.successUrl;
          if (next) {
            say(form.dataset.sending!, '');
            location.assign(next);
            return;
          }
          say(form.dataset.success!, 'ok');
          return;
        }
        if (body?.error === 'duplicate') say(form.dataset.duplicate!, 'bad');
        else if (body?.error === 'closed') say(form.dataset.closed!, 'bad');
        else say(form.dataset.error!, 'bad');
      } catch {
        say(form.dataset.error!, 'bad');
      }
      button.disabled = false;
      button.innerHTML = idle;
    });
  });
</script>

<style>
  /* A centred block of its own, under a rule, so it reads as the one thing
     to do on the page rather than as more text running down the left. */
  .apply {
    max-width: 880px;
    margin: 56px auto 80px;
    padding-top: 40px;
    border-top: 2px solid;
  }
  .note {
    margin: 0 0 40px;
    max-width: 62ch;
  }
  .closed {
    padding: 28px 0;
    border-top: 2px solid;
    border-bottom: 1px solid;
    max-width: 62ch;
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  /* `.two-col` is the design's 1fr 1fr split with its 40px gutter. */
  .fields {
    row-gap: 40px;
  }
  .field {
    display: flex;
    flex-direction: column;
  }
  label {
    letter-spacing: -0.025em;
    text-transform: lowercase;
  }
  .req {
    color: var(--ink-3, #6b6b6b);
  }
  input {
    width: 100%;
    margin-top: 6px;
    padding: 8px 0 10px;
    border: 0;
    border-bottom: 1px solid currentColor;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font-size: 24px;
    line-height: 1.25;
    letter-spacing: -0.025em;
    transition:
      border-color 0.18s,
      box-shadow 0.18s;
  }
  input:focus-visible {
    outline: none;
    border-bottom-color: currentColor;
    box-shadow: inset 0 -2px 0 currentColor;
  }
  input[aria-invalid='true'] {
    border-bottom-color: #c8102e;
    box-shadow: inset 0 -2px 0 #c8102e;
  }
  .hint {
    margin: 8px 0 0;
    min-height: 1.4em;
    font-size: 18px;
    line-height: 1.3;
    color: #c8102e;
  }
  .actions {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 40px;
  }
  /* The black pill of the site's calls to action ("subscribe to our newsletter"). */
  .pill.dark {
    cursor: pointer;
    background: #050505;
    border-color: #050505;
    color: #fff;
    text-transform: lowercase;
  }
  .pill:disabled {
    cursor: default;
    opacity: 0.55;
  }
  .status {
    margin: 0;
    max-width: 62ch;
  }
  .status:empty {
    display: none;
  }
  .status[data-kind='ok'] {
    padding: 6px 14px;
    background: var(--color-acid);
    color: #050505;
  }
  .status[data-kind='bad'] {
    color: #c8102e;
  }
  .sent .fields {
    opacity: 0.45;
  }
  @media (width<=700px) {
    .apply {
      margin: 28px 0 50px;
    }
    .fields {
      row-gap: 28px;
    }
    input {
      font-size: 18px;
    }
    .hint {
      font-size: 15px;
    }
    .actions {
      margin-top: 28px;
    }
  }
</style>
