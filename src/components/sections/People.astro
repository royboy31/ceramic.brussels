---
import type { LocaleId } from '../../lib/locales';
import PersonCard from '../PersonCard.astro';
import { styleAttrs } from '../../lib/textStyle';

/** People two across, in the design's advisory-board grid, from a group or a hand-picked list. */
interface Props {
  lang: LocaleId;
  section: any;
}

const { lang, section } = Astro.props;
const people = (section.people ?? []).filter((p: any) => p?.name);
---

{
  people.length > 0 && (
    <section class="people-block" id={section.anchor || undefined}>
      {section.heading && (
        <h2 class="panel-title" {...styleAttrs(section.headingStyle)}>
          {section.heading}
        </h2>
      )}
      <div class="people">
        {people.map((p: any) => (
          <PersonCard lang={lang} person={p} />
        ))}
      </div>
    </section>
  )
}

<style>
  .people-block {
    margin: 0 0 80px;
  }
  /* From the design's advisory-board page. */
  .people {
    grid-template-columns: 1fr 1fr;
    gap: 70px 40px;
    margin-top: 55px;
    display: grid;
  }
  @media (width<=800px) {
    .people {
      grid-template-columns: 1fr;
    }
  }
</style>
