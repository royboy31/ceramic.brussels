---
import type { LocaleId } from '../../lib/locales';
import Figure from '../Figure.astro';
import SanityImage from '../SanityImage.astro';
import { resolveLink } from '../../lib/links';
import { styleAttrs } from '../../lib/textStyle';

/**
 * The feature block: kicker, headline and link beside a picture. `flip`
 * puts the picture first - PageSections alternates consecutive features,
 * as the design's homepage does (the news row, then the guest of honour).
 * The "home" variant is the design's markup verbatim (2026-09-14 build:
 * `.split.feature--news` copy left on a third, picture right; `--guest`
 * picture left, two equal halves); the default keeps the hub treatment.
 */
interface Props {
  lang: LocaleId;
  section: any;
  flip?: boolean;
  variant?: 'default' | 'home';
}

const { lang, section, flip = false, variant = 'default' } = Astro.props;
const link = resolveLink(lang, section.link);
const external = link?.external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
/** Headlines are written with line breaks in the Studio; keep them. */
const lines: string[] = String(section.headline ?? '').split(/\r?\n/);
const image = section.image?.asset ? section.image : null;
---

{
  variant === 'home' ? (
    <section class:list={['split', 'feature', flip ? 'feature--guest' : 'feature--news']} id={section.anchor || undefined}>
      {flip &&
        (image ? (
          <SanityImage image={image} widths={[600, 900, 1200, 1600]} sizes="(max-width: 640px) 100vw, 50vw" />
        ) : (
          <div class="feature-empty" />
        ))}
      <div class="feature__copy">
        {section.kicker && (
          <p class="kicker" {...styleAttrs(section.kickerStyle)}>
            {section.kicker}
          </p>
        )}
        {section.headline && (
          <h3 {...styleAttrs(section.headlineStyle)}>
            {lines.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))}
          </h3>
        )}
        {link && (
          <a class="arrow-link" href={link.href} {...external}>
            {link.label}{' '}
            <span class="link-arrow" data-arrow={link.arrow} aria-hidden="true">
              {link.arrow}
            </span>
          </a>
        )}
      </div>
      {!flip &&
        (image ? (
          <SanityImage image={image} widths={[600, 900, 1200, 1600]} sizes="(max-width: 640px) 100vw, 60vw" />
        ) : (
          <div class="feature-empty" />
        ))}
    </section>
  ) : (
    <section class:list={['page-grid', 'feature', { flip }]} id={section.anchor || undefined}>
      <div class="feature-copy">
        {section.kicker && (
          <p class="eyebrow-lg" {...styleAttrs(section.kickerStyle)}>
            {section.kicker}
          </p>
        )}
        {section.headline && <h3 {...styleAttrs(section.headlineStyle)}>{section.headline}</h3>}
        {link && (
          <a class="text-link" href={link.href} {...external}>
            {link.label} {link.arrow}
          </a>
        )}
      </div>
      <div class="feature-shot">
        <Figure image={section.image} sizes="(max-width: 640px) 100vw, 50vw" />
      </div>
    </section>
  )
}

<style>
  /* From the design's index.css (2026-09-14 build): the feature rows. */
  .split {
    grid-template-columns: minmax(0, 2fr) minmax(310px, 1fr);
    gap: 40px;
    margin: 30px var(--gutter);
    display: grid;
  }
  /* Copy and picture in two equal halves, 40px apart, both ways round
     (homepage frame: a 655px picture either side). */
  .split.feature {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    margin-top: 44px;
  }
  .split.feature > :global(img),
  .feature-empty {
    aspect-ratio: 638 / 428;
    object-fit: cover;
    width: 100%;
    background: #f0efed;
  }
  .feature__copy {
    padding-top: 4px;
  }
  /* The design writes its kickers in capitals ("ART PRIZE", "GUEST OF HONOUR"). */
  /* Tighter capitals (client feedback, 2026-09-16, homepage reference image). */
  .kicker {
    font-size: 36px;
    line-height: 1.15;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .split.feature h3 {
    letter-spacing: -0.04em;
    max-width: 590px;
    margin-top: 18px;
    font-size: 42px;
    font-weight: 400;
    line-height: 1.2;
  }
  /* Drawn underline that runs out right and back in from the left on hover (client feedback, 2026-09-15). */
  .arrow-link {
    align-items: center;
    letter-spacing: -0.03em;
    gap: 0.14em;
    margin-top: 38px;
    padding-bottom: 0.03em;
    font-size: 30px;
    line-height: 1;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-size: 100% 2px;
    background-position: 0 100%;
    display: inline-flex;
  }
  .arrow-link:hover {
    animation: underline-slide 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes underline-slide {
    0% {
      background-size: 100% 2px;
      background-position: 0 100%;
    }
    45% {
      background-size: 0 2px;
      background-position: 100% 100%;
    }
    50% {
      background-size: 0 2px;
      background-position: 0 100%;
    }
    100% {
      background-size: 100% 2px;
      background-position: 0 100%;
    }
  }
  .arrow-link span {
    transition: transform 0.25s;
    display: inline-block;
  }
  .arrow-link:hover span {
    transform: translate(10px);
  }
  .split.feature--guest {
    margin-top: 82px;
  }
  @media (width<=900px) {
    .split {
      gap: 20px;
    }
    .split.feature h3 {
      font-size: 32px;
    }
  }
  @media (width<=640px) {
    .split {
      flex-direction: column;
      margin: 15px var(--gutter) 40px;
      display: flex;
    }
    .feature--news > :global(img),
    .feature--news > .feature-empty {
      order: -1;
    }
    .kicker {
      font-size: 22px;
    }
    .split.feature h3 {
      font-size: 34px;
    }
    .arrow-link {
      font-size: 26px;
    }
    .split.feature--guest {
      margin-top: 50px;
    }
  }

  /* The hub treatment. */
  .feature {
    align-items: center;
    row-gap: 1.25rem;
    margin-top: 30px;
    padding-bottom: 2.5rem;
  }
  .feature-copy {
    grid-column: span 6;
    padding: 1.5rem 0;
  }
  .feature-shot {
    grid-column: span 6;
  }
  .feature-shot :global(img) {
    width: 100%;
    height: 31vw;
    min-height: 280px;
    object-fit: cover;
  }
  .feature.flip {
    align-items: start;
    padding: 1.5rem 0 0;
  }
  .feature.flip .feature-shot {
    order: -1;
  }
  .eyebrow-lg {
    margin: 0;
    text-transform: lowercase;
    font-size: clamp(1.25rem, 2.7vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }
  .feature-copy h3 {
    margin: 0.5rem 0 0;
    font-size: clamp(2rem, 3.6vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 400;
  }
  .feature-copy a {
    display: inline-block;
    margin-top: 2rem;
    font-size: clamp(1.3rem, 2.6vw, 2.5rem);
    letter-spacing: -0.05em;
  }
  @media (max-width: 640px) {
    .feature-copy,
    .feature-shot {
      grid-column: 1 / -1;
    }
    .feature-shot {
      order: -1;
    }
    .feature-shot :global(img) {
      height: 60vw;
      min-height: 220px;
    }
  }
</style>
