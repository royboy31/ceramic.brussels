---
import type { LocaleId } from '../../lib/locales';
import LinkPill from '../LinkPill.astro';

/** A row of links on their own: outline pills, solid pills or text links. */
interface Props {
  lang: LocaleId;
  section: any;
}

const { lang, section } = Astro.props;
const links = (section.links ?? []).filter(Boolean);
const variant = ['pill', 'solid', 'text'].includes(section.variant) ? section.variant : 'pill';
---

{
  links.length > 0 && (
    <p class:list={['links-row', `links-${variant}`]} id={section.anchor || undefined}>
      {links.map((link: any) => (
        <LinkPill lang={lang} link={link} variant={variant} />
      ))}
    </p>
  )
}

<style>
  .links-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin: 0 0 3rem;
    font-size: clamp(1rem, 1.6vw, 1.4rem);
  }
  .links-text {
    gap: 0.5rem 2rem;
    font-size: clamp(1.25rem, 2.2vw, 2rem);
    letter-spacing: -0.04em;
  }
</style>
