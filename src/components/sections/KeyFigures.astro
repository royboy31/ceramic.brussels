---
import type { LocaleId } from '../../lib/locales';
import { useTranslations } from '../../lib/i18n';
import { resolveLink } from '../../lib/links';
import { styleAttrs } from '../../lib/textStyle';

/**
 * The key figures table, from the most recent edition that has any. On the
 * homepage it is the design's "key 2026 figures" grid (2026-09-14 build): a
 * centred title over two columns of ruled cells, number and label on one
 * baseline, whose numbers count up as they scroll into view.
 */
interface Props {
  lang: LocaleId;
  section: any;
  variant?: 'default' | 'home';
}

const { lang, section, variant = 'default' } = Astro.props;
const t = useTranslations(lang);
const edition = section.edition;
const figures: any[] = edition?.keyFigures ?? [];
const link = resolveLink(lang, section.link);
const external = link?.external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
/** "19,200" → 19200; "200+" → 200 with a "+" suffix, for the count-up. */
const count = (value: string) => {
  const m = String(value ?? '').match(/^([\d.,\s]+)(.*)$/);
  if (!m) return null;
  const n = Number(m[1].replace(/[^\d]/g, ''));
  return Number.isFinite(n) ? { n, suffix: m[2].trim() } : null;
};
---

{
  figures.length > 0 &&
    (variant === 'home' ? (
      <section class="home-stats" id={section.anchor || undefined}>
        <h2>{t('home.keyFigures', { year: edition.year })}</h2>
        <div class="stats__grid">
          {figures.map((figure: any) => {
            const c = count(figure.value);
            return (
              <div>
                <strong data-count={c?.n} data-count-suffix={c?.suffix || undefined}>
                  {figure.value}
                </strong>
                <span {...styleAttrs(figure.labelStyle)}>{figure.label}</span>
              </div>
            );
          })}
        </div>
        {/* The design's grid ends with the figures; the block's link is kept for the hub treatment. */}
      </section>
    ) : (
      <section class="stats" id={section.anchor || undefined}>
        <p class="stats-title">{t('home.keyFigures', { year: edition.year })}</p>
        <div class="stats-table">
          {figures.map((figure: any) => (
            <div class="stat">
              <strong>{figure.value}</strong>
              <span {...styleAttrs(figure.labelStyle)}>{figure.label}</span>
            </div>
          ))}
        </div>
        {link && (
          <p class="stats-link">
            <a class="text-link" href={link.href} {...external}>
              {link.label} {link.arrow}
            </a>
          </p>
        )}
      </section>
    ))
}

<style>
  /* From the design's index.css (2026-09-14 build): `.stats`. */
  .home-stats {
    margin-top: 65px;
    /* Room before the footer when the grid ends the page. */
    margin-bottom: clamp(60px, 6.25vw, 90px);
  }
  .home-stats h2 {
    text-align: center;
    letter-spacing: -0.04em;
    margin-bottom: 42px;
    font-size: 58px;
    font-weight: 600;
    line-height: 1;
  }
  .stats__grid {
    border-top: 1px solid #000;
    grid-template-columns: repeat(2, 1fr);
    display: grid;
  }
  .stats__grid > div {
    border-bottom: 1px solid #000;
    align-items: baseline;
    gap: 22px;
    min-height: 116px;
    padding: 15px 45px;
    display: flex;
  }
  .stats__grid > div:nth-child(odd) {
    border-right: 1px solid #000;
  }
  .home-stats strong {
    letter-spacing: -0.055em;
    font-size: 72px;
    font-weight: 400;
    line-height: 1;
  }
  .home-stats span {
    font-size: 31px;
    line-height: 1;
  }
  .home-stats .stats-link {
    margin: 1.5rem 0 0;
    padding: 0 30px;
    font-size: clamp(1.25rem, 2.7vw, 2.5rem);
    letter-spacing: -0.05em;
  }
  @media (width<=900px) {
    .stats__grid > div {
      padding-inline: 18px;
    }
    .home-stats strong {
      font-size: 54px;
    }
    .home-stats span {
      font-size: 22px;
    }
  }
  @media (width<=640px) {
    .home-stats h2 {
      font-size: 42px;
    }
    .stats__grid {
      display: block;
    }
    .stats__grid > div:nth-child(odd) {
      border-right: 0;
    }
    .stats__grid > div {
      justify-content: space-between;
      min-height: 95px;
      padding: 14px 10px;
    }
    .home-stats strong {
      font-size: 50px;
    }
    .home-stats span {
      text-align: right;
      font-size: 22px;
    }
  }

  /* The hub treatment. */
  .stats {
    margin: 3.4rem 0 3rem;
  }
  .stats-title {
    margin: 0;
    padding: 0 30px;
    text-transform: lowercase;
    font-size: clamp(1.25rem, 2.75vw, 2.5rem);
    line-height: 2;
    letter-spacing: -0.05em;
  }
  .stats-table {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: clamp(105px, 10vw, 145px);
    border-top: 1px solid var(--ink);
  }
  .stats .stat {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border-bottom: 1px solid var(--ink);
  }
  .stats .stat:nth-child(odd) {
    padding-left: 30px;
    border-right: 1px solid var(--ink);
  }
  .stats .stat:nth-child(even) {
    justify-content: flex-end;
    padding-right: 30px;
  }
  .stats .stat strong {
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    line-height: 0.7;
    letter-spacing: -0.05em;
    font-weight: 400;
  }
  .stats .stat span {
    font-size: clamp(1.5rem, 3.4vw, 3.1rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .stats .stats-link {
    margin: 1.5rem 0 0;
    padding: 0 30px;
    font-size: clamp(1.25rem, 2.7vw, 2.5rem);
    letter-spacing: -0.05em;
  }
</style>
