---
import type { LocaleId } from '../../lib/locales';
import { styleAttrs } from '../../lib/textStyle';

/**
 * A map, a form, a ticket widget: an https address in a frame. The schema
 * only accepts an address, never markup, so nothing here is injected HTML.
 */
interface Props {
  lang: LocaleId;
  section: any;
}

const { section } = Astro.props;
const url = typeof section.url === 'string' && /^https:\/\//i.test(section.url) ? section.url : null;
const height = Math.min(Math.max(Number(section.height) || 600, 100), 3000);
---

{
  url && (
    <section class="embed" id={section.anchor || undefined}>
      {section.heading && (
        <h2 class="panel-title" {...styleAttrs(section.headingStyle)}>
          {section.heading}
        </h2>
      )}
      <iframe
        src={url}
        title={section.heading ?? url}
        style={`height: ${height}px`}
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        allow="fullscreen; geolocation; payment"
        sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox"
      />
    </section>
  )
}

<script>
  // An embedded viewer can write to the tab's history: FlipHTML5 pushes one
  // session-history entry per page flip, so after reading the guide, Back
  // from the next page steps through the book again - and Safari surfaces
  // the viewer's own URL as a full page (Tiphaine, 2026-10-23, screen
  // recording). A cross-origin frame's entries can neither be prevented
  // (tested: <object> embeds and removing the iframe both keep them) nor
  // read, only traversed. So leaving through a link rewinds first: the
  // entries added since this page loaded are stepped back over, then the
  // click's navigation truncates them from the stack. The count is a
  // heuristic - a visitor who un-flipped with the Back button makes it
  // overshoot - so the target is parked in sessionStorage and Base.astro
  // finishes the journey from whatever page a rewind lands on.
  const KEY = 'cb-embed-exit';
  let base = history.length;
  addEventListener('pageshow', (e) => {
    // After a bfcache restore the old count may include entries that are
    // now ahead of us; starting over can only undercount, which just means
    // a shorter rewind - never an overshoot.
    if ((e as PageTransitionEvent).persisted) base = history.length;
  });
  document.addEventListener('click', (e) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a = (e.target as Element).closest?.('a[href]') as HTMLAnchorElement | null;
    if (!a || a.target === '_blank' || a.hasAttribute('download')) return;
    if (!/^https?:$/.test(a.protocol)) return;
    // A same-document jump (an anchor on this page) adds its own entry
    // after ours and must not be rerouted.
    if (a.pathname === location.pathname && a.search === location.search && a.hash) return;
    const extra = history.length - base;
    if (extra <= 0) return;
    e.preventDefault();
    const href = a.href;
    sessionStorage.setItem(KEY, href);
    history.go(-extra);
    setTimeout(() => {
      // Still here with the flag unclaimed: the rewind stayed on this page
      // (the usual case) - navigate, truncating the viewer's entries. An
      // overshoot landed elsewhere and Base.astro consumed the flag; if this
      // page is ever revived from bfcache, the timer must then do nothing.
      if (sessionStorage.getItem(KEY) === href) {
        sessionStorage.removeItem(KEY);
        location.assign(href);
      }
    }, 180);
  });
</script>

<style>
  .embed {
    margin: 0 0 3rem;
  }
  iframe {
    display: block;
    width: 100%;
    border: 0;
    background: var(--surface);
  }
</style>
