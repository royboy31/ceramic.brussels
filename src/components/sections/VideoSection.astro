---
import type { LocaleId } from '../../lib/locales';
import { useTranslations } from '../../lib/i18n';
import VideoEmbed from '../VideoEmbed.astro';
import SanityImage from '../SanityImage.astro';
import { urlFor } from '../../sanity/image';
import { styleAttrs } from '../../lib/textStyle';

/**
 * The film. The query already falls back to the latest edition's film when
 * the block's own video is empty. On the homepage it is the design's
 * feature row (2026-09-14 build): the poster on two thirds, linking out to
 * the film, with its credit underneath, and the title as a kicker with a
 * "watch the video" arrow link beside it. Elsewhere the poster-and-play
 * embed.
 */
interface Props {
  lang: LocaleId;
  section: any;
  variant?: 'default' | 'home';
}

const { lang, section, variant = 'default' } = Astro.props;
const t = useTranslations(lang);
const video = section.video;
const poster = video?.poster?.asset
  ? urlFor(video.poster).width(1600).height(1066).fit('crop').auto('format').quality(78).url()
  : '/assets/video-still.webp';
const title: string = video?.title ?? t('home.watch');
/** Titles are written with line breaks in the Studio; keep them. */
const lines = title.split(/\r?\n/);
const credit = video?.poster?.credit;
---

{
  video?.url &&
    (variant === 'home' ? (
      <section class="split feature feature--video" id={section.anchor || undefined}>
        <div class="video-frame">
          <a href={video.url} target="_blank" rel="noopener noreferrer" aria-label={`${t('home.watchVideo')}: ${title}`}>
            {video.poster?.asset ? (
              <SanityImage image={video.poster} aspect={16 / 9} widths={[800, 1200, 1600, 2000]} sizes="(max-width: 640px) 100vw, 66vw" />
            ) : (
              <img src={poster} alt={title} width="1600" height="900" />
            )}
          </a>
          {credit && <small>{t('home.videoBy', { credit })}</small>}
        </div>
        <div class="feature__copy">
          <p class="kicker" {...styleAttrs(video.titleStyle)}>
            {lines.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))}
          </p>
          <a class="arrow-link" href={video.url} target="_blank" rel="noopener noreferrer">
            {t('home.watchVideo')}{' '}
            <span class="link-arrow" data-arrow="→" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      </section>
    ) : (
      <section class="video-block" id={section.anchor || undefined}>
        {section.heading && (
          <h2 class="panel-title" {...styleAttrs(section.headingStyle)}>
            {section.heading}
          </h2>
        )}
        <VideoEmbed class="film" url={video.url} poster={poster} label={video.title ?? t('home.watch')} />
      </section>
    ))
}

<style>
  /* From the design's index.css (2026-09-14 build): the film row. */
  .split {
    grid-template-columns: minmax(0, 2fr) minmax(310px, 1fr);
    gap: 40px;
    margin: 30px;
    display: grid;
  }
  .feature--video {
    align-items: start;
    margin-top: 80px;
  }
  .video-frame :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: #000;
  }
  .video-frame small {
    margin-top: 7px;
    display: block;
  }
  .feature__copy {
    padding-top: 4px;
  }
  .kicker {
    font-size: 34px;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .arrow-link {
    text-underline-offset: 0.12em;
    align-items: center;
    gap: 0.22em;
    margin-top: 38px;
    font-size: 30px;
    line-height: 1;
    text-decoration: underline;
    display: inline-flex;
  }
  .arrow-link span {
    transition: transform 0.25s;
    display: inline-block;
  }
  .arrow-link:hover span {
    transform: translate(10px);
  }
  @media (width<=900px) {
    .split {
      gap: 20px;
      margin-inline: 16px;
    }
  }
  @media (width<=640px) {
    .split {
      flex-direction: column;
      margin: 15px 10px 40px;
      display: flex;
    }
    .feature--video .feature__copy {
      order: -1;
    }
    .kicker {
      font-size: 22px;
    }
    .arrow-link {
      font-size: 26px;
    }
  }

  /* The hub treatment. */
  .video-block {
    margin: 0 0 3rem;
  }
  .film {
    margin-top: 0;
  }
</style>
