---
import type { LocaleId } from '../../lib/locales';
import { useTranslations } from '../../lib/i18n';
import VideoEmbed from '../VideoEmbed.astro';
import { urlFor } from '../../sanity/image';
import { styleAttrs } from '../../lib/textStyle';

/**
 * The film. The query already falls back to the latest edition's film when
 * the block's own video is empty. On the homepage it is the design's
 * feature row (2026-09-14 build): the poster on two thirds, linking out to
 * the film, with its credit underneath, and the title as a kicker with a
 * "watch the video" arrow link beside it. Elsewhere the poster-and-play
 * embed.
 */
interface Props {
  lang: LocaleId;
  section: any;
  variant?: 'default' | 'home';
}

const { lang, section, variant = 'default' } = Astro.props;
const t = useTranslations(lang);
const video = section.video;
const poster = video?.poster?.asset
  ? urlFor(video.poster).width(1600).height(1066).fit('crop').auto('format').quality(78).url()
  : '/assets/video-still.webp';
const title: string = video?.title ?? t('home.watch');
/** Titles are written with line breaks in the Studio; keep them. */
const lines = title.split(/\r?\n/);
const credit = video?.poster?.credit;
/** The block's own text (client feedback, 2026-09-16), line breaks kept. */
const textLines: string[] = section.text ? String(section.text).split(/\r?\n/) : [];
---

{
  video?.url &&
    (variant === 'home' ? (
      <section class="split feature feature--video" id={section.anchor || undefined}>
        <div class="video-frame">
          {/* The film plays in the frame itself: the build linked out to YouTube
              only because file:// pages cannot embed it (its README says so). */}
          <VideoEmbed class="film" url={video.url} poster={poster} label={title} quiet />
          {credit && <small>{t('home.videoBy', { credit })}</small>}
        </div>
        <div class="feature__copy">
          <p class="kicker" {...styleAttrs(video.titleStyle)}>
            {lines.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))}
          </p>
          {textLines.length > 0 && (
            <h3 {...styleAttrs(section.textStyle)}>
              {textLines.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </h3>
          )}
          <a class="arrow-link" href={video.url} target="_blank" rel="noopener noreferrer">
            {t('home.watchVideo')}{' '}
            <span class="link-arrow" data-arrow="→" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      </section>
    ) : (
      <section class="video-block" id={section.anchor || undefined}>
        {section.heading && (
          <h2 class="panel-title" {...styleAttrs(section.headingStyle)}>
            {section.heading}
          </h2>
        )}
        {section.text && (
          <p class="body-24 video-text" {...styleAttrs(section.textStyle)}>
            {section.text}
          </p>
        )}
        <VideoEmbed class="film" url={video.url} poster={poster} label={video.title ?? t('home.watch')} />
      </section>
    ))
}

<style>
  /* From the design's index.css (2026-09-14 build): the film row. */
  .split {
    grid-template-columns: minmax(0, 2fr) minmax(310px, 1fr);
    gap: 40px;
    margin: 30px var(--gutter);
    display: grid;
  }
  /* Picture 887px and copy 423px at the 1440 frame. */
  .feature--video {
    grid-template-columns: minmax(0, 887fr) minmax(310px, 423fr);
    align-items: start;
    margin-top: 80px;
  }
  .video-frame :global(.film) {
    margin: 0;
  }
  /* The homepage frame's picture is 887x574, not the full-width embed's
     height; only this row, the hub video block keeps its own. */
  .video-frame :global(.frame) {
    height: auto;
    aspect-ratio: 887 / 574;
  }
  .video-frame small {
    margin-top: 7px;
    display: block;
  }
  .feature__copy {
    padding-top: 4px;
  }
  /* The same size and tracking as the feature rows' kickers. */
  .kicker {
    font-size: 36px;
    line-height: 1.15;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  /* The news rows' text (Feature.astro `.split.feature h3`). */
  .feature__copy h3 {
    letter-spacing: -0.04em;
    max-width: 590px;
    margin-top: 18px;
    font-size: 42px;
    font-weight: 400;
    line-height: 1.2;
  }
  .video-text {
    max-width: var(--measure);
    margin-bottom: 24px;
    white-space: pre-line;
  }
  /* The underline and its hover are the shared `.arrow-link` rule in Base.astro. */
  .arrow-link {
    align-items: center;
    letter-spacing: -0.03em;
    gap: 0.14em;
    margin-top: 38px;
    font-size: 30px;
    line-height: 1;
    display: inline-flex;
  }
  @media (max-width: 900px) {
    .split {
      gap: 20px;
    }
    .feature__copy h3 {
      font-size: 32px;
    }
  }
  @media (max-width: 640px) {
    .split {
      flex-direction: column;
      margin: 15px var(--gutter) 40px;
      display: flex;
    }
    /* Stretched: the frame has no width of its own to shrink to. */
    .feature--video {
      align-items: stretch;
    }
    .feature--video .feature__copy {
      order: -1;
    }
    .kicker {
      font-size: 22px;
    }
    .feature__copy h3 {
      font-size: 34px;
    }
    .arrow-link {
      font-size: 26px;
    }
  }

  /* The hub treatment. */
  .video-block {
    margin: 0 0 3rem;
  }
  .film {
    margin-top: 0;
  }
</style>
