---
import type { LocaleId } from '../../lib/locales';
import { styleAttrs } from '../../lib/textStyle';

/**
 * A group title. On a hub page it sits over a full-width rule
 * ("institutions", "collaborators"); on the homepage it is the centred
 * "latest news" title of the design.
 */
interface Props {
  lang: LocaleId;
  section: any;
  variant?: 'default' | 'home';
}

const { section, variant = 'default' } = Astro.props;
---

{
  section.title &&
    (variant === 'home' ? (
      <h2 class="section-title" id={section.anchor || undefined} {...styleAttrs(section.titleStyle)}>
        {section.title}
      </h2>
    ) : (
      <h2 class="group-title" id={section.anchor || undefined} {...styleAttrs(section.titleStyle)}>
        {section.title}
      </h2>
    ))
}

<style>
  .group-title {
    margin: 3rem 0 1.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--ink);
    font-size: clamp(1.75rem, 4vw, 3.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.05em;
    text-transform: lowercase;
  }
  .group-title:first-child {
    margin-top: 0;
  }

  /* From the design's index.css (2026-09-14 build): the centred "latest news". */
  .section-title {
    text-align: center;
    letter-spacing: -0.045em;
    font-size: 62px;
    font-weight: 600;
    line-height: 1;
  }
  @media (width<=640px) {
    .section-title {
      font-size: 45px;
    }
  }
</style>
