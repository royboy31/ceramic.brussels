---
import type { LocaleId } from '../../lib/locales';
import { styleAttrs } from '../../lib/textStyle';

/**
 * A group title. On a hub page it sits over a full-width rule
 * ("institutions", "collaborators"); on the homepage it is the centred
 * "latest news" title of the design.
 */
interface Props {
  lang: LocaleId;
  section: any;
  variant?: 'default' | 'home' | 'vip' | 'vip-panel';
}

const { section, variant = 'default' } = Astro.props;
---

{
  section.title &&
    (variant === 'home' ? (
      <h2 class="section-title" id={section.anchor || undefined} {...styleAttrs(section.titleStyle)}>
        {section.title}
      </h2>
    ) : (
      <h2
        class:list={['group-title', { subgroup: section.level === 'subgroup', wide: variant === 'vip-panel' }]}
        id={section.anchor || undefined}
        {...styleAttrs(section.titleStyle)}
      >
        {section.title}
      </h2>
    ))
}

<style>
  .group-title {
    margin: 3rem 0 1.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--ink);
    font-size: clamp(1.75rem, 4vw, 3.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.05em;
    text-transform: lowercase;
  }
  .group-title:first-child {
    margin-top: 0;
  }

  /* The heading inside a part of the page - "at the fair", "beyond the
     fair" under "programme overview" - ruled under itself rather than over,
     and over the copy column only, as the VIP frame draws it (Léonie,
     2026-09-23). */
  /* The rule under it stood straight on whatever came next - the row's
     "DISCOVERY TOURS" on a desktop, the picture itself on a phone, where
     they touched: "there's a slight margin problem in between titles, I
     think they're missing space between each other. It's very noticeable on
     smartphone" (Léonie, 2026-11-09, with the Figma frame as the reference).
     The frame sets 34px from that rule to the next line, and this is all of
     it. It was 26px at first, counting on 8px from the row's own title -
     but that 8px was an editor's Space above on "discovery tours" alone, so
     "beyond the fair" came out at 26 (found against the frame, 2026-11-10).
     The lounge's "agenda" does not move: the rows under it already carry
     56px, which this collapses into. */
  .group-title.subgroup {
    margin: 2.25rem 0 2.125rem;
    padding: 0 0 0.1rem;
    border-top: 0;
    border-bottom: 2px solid var(--ink);
    max-width: 66%;
    font-size: clamp(1.625rem, 2.5vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.04em;
    text-transform: none;
  }
  /* On the VIP lounge the rows under "agenda" run the full width, and the
     rule now does too, out to the right margin (Léonie, 2026-10-21). */
  .group-title.subgroup.wide {
    max-width: none;
  }
  @media (max-width: 900px) {
    .group-title.subgroup {
      max-width: none;
    }
  }

  /* From the design's index.css (2026-09-14 build): the centred "latest news". */
  .section-title {
    text-align: center;
    letter-spacing: -0.045em;
    font-size: 72px;
    font-weight: 600;
    line-height: 1;
  }
  @media (max-width: 640px) {
    .section-title {
      font-size: 45px;
    }
  }
</style>
