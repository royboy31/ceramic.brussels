---
import type { LocaleId } from '../../lib/locales';
import { useTranslations } from '../../lib/i18n';
import { styleAttrs } from '../../lib/textStyle';
import PortableText from '../PortableText.astro';
import SanityImage from '../SanityImage.astro';

/**
 * Partners from a tier or a hand-picked list. "logos" is the design's
 * `section.partners` on the art prize about page: a `.panel-title`, then the
 * paragraph and the logo row side by side in `.two-col`. "list" is the names
 * with their text and website, as the institutions tab draws them. Each
 * partner links to its website.
 */
interface Props {
  lang: LocaleId;
  section: any;
}

const { lang, section } = Astro.props;
const t = useTranslations(lang);
const partners = (section.partners ?? []).filter((p: any) => p?.name);
const display = section.display === 'list' ? 'list' : 'logos';
/**
 * The logo row shows the partners that have a logo file: a name set as text
 * among the logos read as a broken image and pushed the row out of line.
 * Only when none has a logo yet do the names stand in, so the row is never
 * empty under its paragraph.
 */
const withLogo = partners.filter((p: any) => p.logo?.asset);
const logoRow = withLogo.length > 0 ? withLogo : partners;
---

{
  partners.length > 0 && (
    <section class="partners" id={section.anchor || undefined}>
      {section.heading && (
        <h2 class="panel-title" {...styleAttrs(section.headingStyle)}>
          {section.heading}
        </h2>
      )}
      {display === 'logos' ? (
        <div class="two-col logo-cols">
          {section.body && (
            <div class="body-24">
              <PortableText value={section.body} fieldStyle={section.bodyStyle} />
            </div>
          )}
          <div class="logos">
            {logoRow.map((p: any) =>
              p.url ? (
                <a href={p.url} rel="noopener noreferrer" target="_blank" aria-label={p.name}>
                  {p.logo?.asset ? (
                    <SanityImage image={p.logo} widths={[240, 480]} sizes="190px" loading="lazy" placeholder={false} />
                  ) : (
                    <span>{p.name}</span>
                  )}
                </a>
              ) : p.logo?.asset ? (
                <SanityImage image={p.logo} widths={[240, 480]} sizes="190px" loading="lazy" placeholder={false} />
              ) : (
                <span>{p.name}</span>
              ),
            )}
          </div>
        </div>
      ) : (
        <>
          {section.body && (
            <div class="body-24 partners-body">
              <PortableText value={section.body} fieldStyle={section.bodyStyle} />
            </div>
          )}
          <div class="institutions">
            {partners.map((p: any) => (
              <article>
                <h3>{p.name}</h3>
                {p.description && <PortableText value={p.description} fieldStyle={p.descriptionStyle} />}
                {p.url && (
                  <a class="pill" href={p.url} rel="noopener noreferrer" target="_blank">
                    {t('common.website')} ↗
                  </a>
                )}
              </article>
            ))}
          </div>
        </>
      )}
    </section>
  )
}

<style>
  /* From the design's art prize about page. */
  .partners {
    margin-top: 65px;
  }
  /* The logo row sits level with the middle of the paragraph beside it. */
  .logo-cols {
    align-items: center;
  }
  /*
   * The design's row is three logos spread with `space-around`. When the
   * names stand in for missing logos (see `logoRow`), the row wraps and keeps
   * a gap rather than letting two long names overlap where `space-around`
   * runs out of room.
   */
  .logos {
    flex-wrap: wrap;
    justify-content: space-around;
    align-items: center;
    gap: 30px 40px;
    display: flex;
  }
  .logos a {
    align-items: center;
    display: flex;
  }
  .logos :global(img) {
    object-fit: contain;
    width: auto;
    max-width: 190px;
    max-height: 100px;
  }
  .logos span {
    max-width: 190px;
    text-align: center;
    font-size: 24px;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  /* From the design's institutions page. */
  .partners-body {
    margin-bottom: 40px;
  }
  .institutions {
    grid-template-columns: 1fr 1fr;
    gap: 80px 40px;
    margin-top: 55px;
    display: grid;
  }
  /* Title rule as on the guest of honour page (client feedback, 2026-09-16). */
  .institutions h3 {
    border-bottom: 2px solid;
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.2;
  }
  .institutions article :global(p) {
    font-size: 24px;
    line-height: 1.22;
    letter-spacing: -0.03em;
    margin-top: 20px;
    white-space: pre-line;
  }
  /* Same slim pill as the partners tabs (client feedback of 2026-09-17:
     "make the website buttons less thick, harmonise everywhere"), with the
     footer pills as the reference. */
  .institutions .pill {
    margin-top: 24px;
    padding: 1px 13px 0;
    font-size: 20px;
    line-height: 1.5;
    letter-spacing: -0.02em;
  }
  @media (width<=700px) {
    .institutions {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .institutions h3 {
      font-size: 28px;
    }
    .institutions article :global(p) {
      font-size: 18px;
    }
    .institutions .pill {
      font-size: 16px;
    }
    .logos {
      flex-wrap: wrap;
      gap: 24px;
      justify-content: flex-start;
    }
  }
</style>
