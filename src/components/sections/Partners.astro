---
import type { LocaleId } from '../../lib/locales';
import { useTranslations } from '../../lib/i18n';
import { styleAttrs } from '../../lib/textStyle';
import PortableText from '../PortableText.astro';
import SanityImage from '../SanityImage.astro';

/**
 * Partners from a tier or a hand-picked list: a row of logos (the art prize
 * page's "partners", the main partner) or a list of names with their text
 * and website (the institutions tab). Each partner links to its website.
 */
interface Props {
  lang: LocaleId;
  section: any;
}

const { lang, section } = Astro.props;
const t = useTranslations(lang);
const partners = (section.partners ?? []).filter((p: any) => p?.name);
const display = section.display === 'list' ? 'list' : 'logos';
---

{
  partners.length > 0 && (
    <section class="partners-block" id={section.anchor || undefined}>
      {section.heading && (
        <h2 class="group-title" {...styleAttrs(section.headingStyle)}>
          {section.heading}
        </h2>
      )}
      {section.body && (
        <div class="partners-body">
          <PortableText value={section.body} fieldStyle={section.bodyStyle} />
        </div>
      )}
      {display === 'logos' ? (
        <ul class="logos">
          {partners.map((p: any) => (
            <li>
              {p.url ? (
                <a href={p.url} rel="noopener noreferrer" target="_blank" aria-label={p.name}>
                  {p.logo?.asset ? (
                    <SanityImage image={p.logo} widths={[240, 480]} sizes="240px" loading="lazy" class="logo" />
                  ) : (
                    <span class="logo-name">{p.name}</span>
                  )}
                </a>
              ) : p.logo?.asset ? (
                <SanityImage image={p.logo} widths={[240, 480]} sizes="240px" loading="lazy" class="logo" />
              ) : (
                <span class="logo-name">{p.name}</span>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <ul class="list">
          {partners.map((p: any) => (
            <li class="partner">
              <h3 class="partner-name" {...styleAttrs(p.subtitleStyle)}>
                {p.name}
              </h3>
              {p.description && <PortableText value={p.description} fieldStyle={p.descriptionStyle} />}
              {p.url && (
                <a class="partner-link" href={p.url} rel="noopener noreferrer" target="_blank">
                  {t('common.website')} ↗
                </a>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}

<style>
  .partners-block {
    margin: 0 0 3rem;
  }
  .group-title {
    margin: 0 0 1.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--ink);
    font-size: clamp(1.5rem, 2.6vw, 2.4rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .partners-body {
    max-width: var(--measure);
    margin: 0 0 2rem;
  }
  .logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .logos :global(.logo) {
    display: block;
    width: auto;
    max-width: 200px;
    max-height: 90px;
    object-fit: contain;
  }
  .logo-name {
    font-size: 1.25rem;
    letter-spacing: -0.03em;
  }
  .list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 30px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .partner-name {
    margin: 0 0 0.5rem;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    letter-spacing: -0.03em;
  }
  .partner-link {
    display: inline-block;
    margin-top: 0.5rem;
  }
  @media (max-width: 700px) {
    .list {
      grid-template-columns: 1fr;
    }
  }
</style>
