---
import { LOCALES, type LocaleId } from '../lib/locales';
import { localePath, useTranslations } from '../lib/i18n';
import { urlFor } from '../sanity/image';
import SanityImage from './SanityImage.astro';

/**
 * Site header, as the 2026-09-14 build draws it: the dates mark on the
 * left, the wordmark centred over the row, the main partner's lockup and
 * the menu button on the right. The language switcher is a drop-down to
 * the right of the menu button since the client feedback of 2026-09-23:
 * the current language, with the other two under it when opened. Markup and
 * classes are the design's (html pages); the rules live in
 * src/styles/design.css. The wordmark is brand artwork; the dates mark
 * comes from the current edition and the partner lockup from the main
 * partner's "Header lockup" field (one wide image), each with the shipped
 * file as the fallback, and the lockup links to the partner's site when
 * Sanity names one.
 */
interface Props {
  lang: LocaleId;
  siteName: string;
  /** Locale-less path, so the language switcher stays on the current page. */
  path?: string;
  altPaths?: Partial<Record<LocaleId, string>>;
  /** The current edition's dates mark from Sanity; the shipped PNG is the fallback. */
  datesMark?: any;
  /** The partner of tier "main", for the lockup's link, name and artwork. */
  mainPartner?: { name?: string; url?: string; headerLockup?: any } | null;
}

const { lang, siteName, path = '', altPaths, datesMark, mainPartner } = Astro.props;
const t = useTranslations(lang);
const datesSrc = datesMark?.asset
  ? urlFor(datesMark).width(600).auto('format').quality(85).url()
  : '/assets/date-logo.png';
const home = localePath(lang);
const partnerName = mainPartner?.name ?? 'Puilaetco';
const Lockup = mainPartner?.url ? 'a' : 'div';
const current = LOCALES.find((l) => l.id === lang)!;
const others = LOCALES.filter((l) => l.id !== lang);
---

<header class="site-header acid-wash">
  <div class="site-header__inner">
    <div class="site-header__left">
      <a href={home} aria-label={`${siteName} homepage`} class="site-date">
        <img src={datesSrc} alt={datesMark?.alt ?? ''} width="252" height="61" />
      </a>
    </div>
    <a href={home} class="site-wordmark" aria-label={`${siteName} homepage`}>
      <img src="/assets/wordmark.svg" alt={siteName} width="144" height="75" />
    </a>
    <div class="site-header__right">
      <Lockup
        class="site-partner"
        aria-label={`${t('partners.main')} ${partnerName}`}
        {...(mainPartner?.url ? { href: mainPartner.url, target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        <span>{t('partners.main')}</span>
        {
          mainPartner?.headerLockup?.asset ? (
            /* The partner's own lockup from Sanity: one wide image, fitted to the design's 29px row. */
            <SanityImage
              image={mainPartner.headerLockup}
              widths={[322, 483, 644]}
              sizes="161px"
              loading="eager"
              placeholder={false}
              class="partner-lockup partner-lockup--image"
            />
          ) : (
            /* The design's lockup: the mark, then the name over the tagline. Its files are named the other way round; kept as the build pairs them. */
            <div class="partner-lockup" aria-hidden="true">
              <img class="partner-mark" src="/assets/puilaetco-mark.svg" alt="" width="26" height="27" />
              <div>
                <img class="partner-name" src="/assets/puilaetco-tagline.svg" alt="" width="128" height="11" />
                <img class="partner-tagline" src="/assets/puilaetco-name.svg" alt="" width="116" height="5" />
              </div>
            </div>
          )
        }
      </Lockup>
      <button
        type="button"
        data-menu-open
        aria-label={t('nav.openMenu')}
        aria-controls="site-menu"
        aria-expanded="false"
        class="site-menu-button"
      >
        <img src="/assets/menu.svg" alt="" width="56" height="37" />
      </button>
      <div class="site-lang" data-lang>
        <button
          type="button"
          class="site-lang__current"
          aria-expanded="false"
          aria-controls="site-lang-list"
          aria-label={`${t('common.language')}: ${current.title}`}
          data-lang-toggle
        >
          {current.id.toUpperCase()}<span aria-hidden="true" class="site-lang__caret">▾</span>
        </button>
        <ul id="site-lang-list" class="site-lang__list" hidden>
          {
            others.map((l) => (
              <li>
                <a href={localePath(l.id, altPaths?.[l.id] ?? path)} hreflang={l.id} lang={l.id} aria-label={l.title}>
                  {l.id.toUpperCase()}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</header>

<script>
  // The language drop-down: opens on its button, closes on a choice, on
  // Escape, or on a click anywhere else.
  document.querySelectorAll<HTMLElement>('[data-lang]').forEach((box) => {
    const toggle = box.querySelector<HTMLButtonElement>('[data-lang-toggle]');
    const list = box.querySelector<HTMLElement>('.site-lang__list');
    if (!toggle || !list) return;
    const set = (open: boolean) => {
      list.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => set(list.hidden));
    document.addEventListener('click', (e) => {
      if (!box.contains(e.target as Node)) set(false);
    });
    box.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !list.hidden) {
        set(false);
        toggle.focus();
      }
    });
    box.addEventListener('focusout', (e) => {
      if (!box.contains(e.relatedTarget as Node)) set(false);
    });
  });
</script>

<style>
  /* The wordmark keeps its own proportions whatever its box does - the box
     shrinks on scroll and between breakpoints, and a squashed logo is what
     the client saw on a phone (feedback, 2026-09-25). */
  .site-wordmark img {
    object-fit: contain;
  }
  /* The drop-down in the header's type (the old "EN / FR / NL" line: 22px,
     tight tracking), its list hanging under it on the page's ground. */
  .site-lang {
    position: relative;
    letter-spacing: -0.05em;
    font-size: 22px;
    line-height: 35px;
  }
  .site-lang__current {
    display: flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    transition: opacity 0.18s;
  }
  .site-lang__caret {
    font-size: 0.6em;
    transition: transform 0.18s;
  }
  .site-lang__current[aria-expanded='true'] .site-lang__caret {
    transform: rotate(180deg);
  }
  @media (hover: hover) and (pointer: fine) {
    .site-lang__current:hover {
      opacity: 0.65;
    }
  }
  .site-lang__list {
    position: absolute;
    top: calc(100% + 6px);
    right: -11px;
    z-index: 5;
    min-width: calc(100% + 22px);
    /* No padding: the acid hover runs right up to the stroke, above FR and
       below NL (client feedback, 2026-09-24). The rows carry the room. */
    padding: 0;
    border: 1px solid currentColor;
    background: var(--ground);
  }
  .site-lang__list a {
    display: block;
    padding: 3px 11px;
  }
  .site-lang__list a:hover,
  .site-lang__list a:focus-visible {
    background: var(--color-acid);
    color: #050505;
  }
  :global(body[data-scrolled]) .site-lang {
    font-size: 18px;
    line-height: 28px;
  }
  @media (width<=1000px) {
    .site-lang {
      font-size: 18px;
    }
  }
  @media (width<=640px) {
    .site-lang {
      font-size: 15px;
      line-height: 24px;
    }
  }
  /* A Sanity lockup is one image in the design's 161 × 29 slot (design.css
     sizes the three-file version), fitted whatever its shape. */
  :global(.partner-lockup--image) {
    display: block;
    width: auto;
    max-width: 161px;
    height: 29px;
    object-fit: contain;
    object-position: left center;
  }
</style>
