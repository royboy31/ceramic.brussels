---
import { LOCALES, type LocaleId } from '../lib/locales';
import { localePath, useTranslations } from '../lib/i18n';
import { urlFor } from '../sanity/image';

/**
 * Site header - dates mark left, wordmark centred, language switcher and
 * menu button right. Markup and classes are the design's (html pages);
 * the rules live in src/styles/design.css. The two lockups are brand
 * artwork; the dates mark comes from the current edition when it has one.
 */
interface Props {
  lang: LocaleId;
  siteName: string;
  /** Locale-less path, so the language switcher stays on the current page. */
  path?: string;
  altPaths?: Partial<Record<LocaleId, string>>;
  /** The current edition's dates mark from Sanity; the shipped PNG is the fallback. */
  datesMark?: any;
}

const { lang, siteName, path = '', altPaths, datesMark } = Astro.props;
const t = useTranslations(lang);
const datesSrc = datesMark?.asset
  ? urlFor(datesMark).width(600).auto('format').quality(85).url()
  : '/assets/date-logo.png';
const home = localePath(lang);
---

<header class="site-header acid-wash relative z-40 h-[clamp(92px,11vw,159px)]">
  <div class="page-grid h-full items-center">
    <a href={home} aria-label={`${siteName} homepage`} class="site-date col-span-3 w-[clamp(130px,20vw,291px)]">
      <img src={datesSrc} alt={datesMark?.alt ?? ''} class="h-auto w-full" width="291" height="70" />
    </a>
    <a href={home} class="site-wordmark col-span-6 flex justify-center" aria-label={`${siteName} homepage`}>
      <img src="/assets/wordmark.svg" alt={siteName} class="h-[clamp(40px,5.2vw,75px)] w-[clamp(76px,10vw,144px)]" width="144" height="75" />
    </a>
    <div class="site-actions col-span-3 flex items-center justify-end gap-[clamp(12px,2vw,34px)]">
      <nav aria-label={t('common.language')} class="hidden text-[clamp(12px,1.65vw,24px)] tracking-[-.05em] sm:block">
        {
          LOCALES.map((l, i) => (
            <>
              {i > 0 && ' / '}
              <a href={localePath(l.id, altPaths?.[l.id] ?? path)} hreflang={l.id} aria-current={l.id === lang ? 'true' : undefined}>
                {l.id.toUpperCase()}
              </a>
            </>
          ))
        }
      </nav>
      <button
        type="button"
        data-menu-open
        aria-label={t('nav.openMenu')}
        aria-controls="site-menu"
        aria-expanded="false"
        class="h-[30px] w-[46px] cursor-pointer md:h-[37px] md:w-[56px]"
      >
        <img src="/assets/menu.svg" alt="" class="h-full w-full" width="56" height="37" />
      </button>
    </div>
  </div>
</header>
