---
import type { LocaleId } from '../lib/locales';
import { useTranslations, localePath } from '../lib/i18n';

/**
 * The title band of the exhibitor pages, as the design's exhibitors pages
 * draw it (2026-09-14 build): "exhibitors" on the left, the four bordered
 * tabs on the right - galleries, artists, catalogue, awards - and under
 * them the A–Z row. Galleries is the edition's list, artists the
 * artist index, catalogue the edition's PDF (shown only when there is one),
 * awards the fair's exhibitor awards.
 *
 * The letters are buttons on a list page, where the page's own script
 * filters the list by initial (a `#A` in the address pre-selects a letter,
 * and clicking the chosen letter again clears it), and links back to the
 * list on a detail page, where the exhibitor's own initial is marked and
 * links to the whole list. There is no ALL button (client feedback,
 * 2026-09-16, confirmed 2026-09-17): deselecting the letter is how you get
 * back.
 */
interface Props {
  lang: LocaleId;
  active: 'galleries' | 'artists' | 'awards';
  /** The edition, for the catalogue tab. */
  edition?: any;
  /** A past edition's list or exhibitor: the year joins the title and the galleries tab points at that year. */
  year?: number;
  /** Draw the A–Z row. */
  alphabet?: boolean;
  /** The letter to mark: none on a list, the exhibitor's initial on a detail page. */
  activeLetter?: string;
  /** On a detail page, the list the letters link back to ('exhibitors', 'exhibitors/2025'). */
  letterHref?: string;
}

const { lang, active, edition, year, alphabet = false, activeLetter = '', letterHref } = Astro.props;
const t = useTranslations(lang);

const LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const listPath = year ? `exhibitors/${year}` : 'exhibitors';
const tabs = [
  { key: 'galleries', label: t('exhibitors.galleries'), href: localePath(lang, listPath) },
  { key: 'artists', label: t('nav.artists').toLowerCase(), href: localePath(lang, 'artists') },
  edition?.catalogueUrl && { key: 'catalogue', label: t('home.catalogue').toLowerCase(), href: edition.catalogueUrl, external: true },
  { key: 'awards', label: t('nav.awards').toLowerCase(), href: localePath(lang, 'exhibitors/awards') },
].filter(Boolean) as { key: string; label: string; href: string; external?: boolean }[];
const mark = activeLetter.toUpperCase();
---

<header class="exhibitor-head title-band">
  <div class="exhibitor-head__top">
    <h1>
      {t('nav.exhibitors').toLowerCase()}
      {year && ` ${year}`}
    </h1>
    <nav aria-label={t('nav.exhibitors')}>
      {
        tabs.map((tab) => (
          <a
            class:list={[{ active: tab.key === active }]}
            href={tab.href}
            aria-current={tab.key === active ? 'page' : undefined}
            {...(tab.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {tab.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
{
  /* The letters sit under the band, outside it, so only the band stays pinned. */
  alphabet && (
      <nav class="alphabet" aria-label={t('exhibitors.byLetter')} data-alphabet>
        {LETTERS.map((letter, i) => [
          /* A real separator between the letters, so a wide letter pushes it along. */
          i > 0 && (
            <span class="sep" aria-hidden="true">
              -
            </span>
          ),
          letterHref ? (
            <a
              data-glyph={letter}
              class:list={[{ active: letter === mark }]}
              href={localePath(lang, letterHref) + (letter === mark ? '' : `#${letter}`)}
              aria-current={letter === mark ? 'true' : undefined}
            >
              {letter}
            </a>
          ) : (
            <button
              type="button"
              data-glyph={letter}
              class:list={[{ active: letter === mark }]}
              data-letter={letter}
              aria-pressed={letter === mark ? 'true' : 'false'}
            >
              {letter}
            </button>
          ),
        ])}
      </nav>
    )
}

<style>
  /* From the design's exhibitors pages (2026-09-14 build). The letter row
     holds buttons on a list page and links on a detail page; the rules
     address both. */
  .exhibitor-head {
    /* Room under the header before the title band (client feedback,
       2026-09-15), a little less since 2026-09-16 ("a bit higher up"); the
       band itself stays pinned while scrolling (.title-band, Base.astro). */
    padding: var(--band-pad-top, 36px) var(--gutter) var(--band-pad-bottom, 20px);
  }
  .exhibitor-head__top {
    justify-content: space-between;
    align-items: end;
    gap: 32px;
    display: flex;
  }
  h1 {
    letter-spacing: -0.055em;
    font-size: var(--band-h1, 70px);
    font-weight: 600;
    line-height: 0.9;
  }
  nav {
    flex-wrap: wrap;
    gap: 28px;
    display: flex;
  }
  .alphabet {
    flex-wrap: nowrap;
  }
  /* 50px tall, 28px apart, as in the Figma exhibitors frames. */
  .exhibitor-head__top a {
    text-align: center;
    border: 1px solid #000;
    min-width: 135px;
    padding: var(--band-pill-pad, 10px 24px);
    font-size: var(--band-pill, 28px);
    line-height: 1;
    transition:
      color 0.18s,
      background-color 0.18s;
  }
  .exhibitor-head__top a.active {
    background: var(--color-acid);
  }
  /* Hover is the acid fill with the outline kept (client feedback, 2026-09-16). */
  .exhibitor-head__top a:hover,
  .exhibitor-head__top a:focus-visible {
    color: #050505;
    background: var(--color-acid);
  }
  /* The letters spread over the whole row, gutter to gutter; hover and the chosen letter are
     Black and underlined (client feedback, 2026-09-16). Each letter is as wide as its
     Black cut (the hidden ::after), so the heavier weight does not push its
     neighbours; the dashes between them are real text, so a wide letter
     (m, w) keeps its distance instead of running into one. */
  .alphabet {
    align-items: center;
    justify-content: space-between;
    gap: 0;
    margin-top: 22px;
    padding-inline: var(--gutter);
    font-size: 34px;
    line-height: 1;
  }
  .alphabet > :is(a, button) {
    cursor: pointer;
    flex: 0 0 auto;
    padding: 6px 1px;
    text-align: center;
    /* The letters are lowercase in the design. */
    text-transform: lowercase;
    text-underline-offset: 0.14em;
    text-decoration-thickness: 2px;
  }
  .alphabet > :is(a, button)::after {
    content: attr(data-glyph);
    display: block;
    height: 0;
    overflow: hidden;
    visibility: hidden;
    font-weight: 900;
  }
  .alphabet .sep {
    flex: 0 0 auto;
    padding-inline: 0.18em;
    font-weight: 400;
  }
  .alphabet > .active,
  .alphabet > :is(a, button):hover,
  .alphabet > :is(a, button):focus-visible {
    font-weight: 900;
    text-decoration-line: underline;
  }
  @media (width<=900px) {
    .exhibitor-head {
      padding-top: 24px;
    }
    .exhibitor-head__top {
      flex-direction: column;
      align-items: start;
    }
    .exhibitor-head__top nav {
      gap: 8px;
    }
    .exhibitor-head__top a {
      min-width: auto;
      padding: 7px 14px;
      font-size: 20px;
    }
    .alphabet {
      flex-wrap: nowrap;
      margin-top: 16px;
      overflow: auto;
    }
    .alphabet {
      justify-content: flex-start;
    }
    .alphabet {
      font-size: 26px;
    }
  }
  @media (width<=640px) {
    .exhibitor-head {
      padding-top: 18px;
    }
    h1 {
      font-size: 48px;
    }
    .exhibitor-head__top {
      gap: 22px;
    }
  }
</style>
