---
import type { LocaleId } from '../lib/locales';
import { useTranslations, localePath } from '../lib/i18n';
import { HUBS, hubTabHref } from '../lib/hubs';

/**
 * The title band of a hub page, as the design draws it on every hub frame:
 * the hub name on five columns, the tabs right-aligned on the other seven
 * as bordered buttons, the current one filled acid (or black on the acid
 * art prize pages, `dark`). Markup and rules are the `.section-head` block
 * Lilanga's build repeats on each page.
 *
 * Tabs come from HUBS; a `page` document with the same English slug can
 * override a tab's label. A tab with a `link` leads to another hub.
 */
interface Props {
  lang: LocaleId;
  route: string;
  active: string;
  /** Hub pages from getHubPages, for label overrides. */
  pages?: any[];
  /** The acid pages fill the active tab black instead of acid. */
  dark?: boolean;
  class?: string;
}

const { lang, route, active, pages = [], dark = false, class: className } = Astro.props;
const t = useTranslations(lang);
const hub = HUBS[route];

// Only the tabs in hubs.ts: they are the ones with a route. A pill for any
// other page of the hub led to a 404.
const tabs = hub.tabs.map((tab) => {
  const page = tab.link ? null : pages.find((p) => p?.slugs?.en === tab.slug);
  return { slug: tab.slug, label: page?.tabLabel ?? t(tab.label), href: hubTabHref(route, tab), link: !!tab.link };
});
---

<div class:list={['section-head', 'page-grid', className]}>
  <h1>{t(hub.title)}</h1>
  {
    tabs.length > 1 && (
      <nav aria-label={t(hub.title)}>
        {tabs.map((tab) => {
          const current = !tab.link && tab.slug === active;
          return (
            <a
              class:list={[{ active: current, dark: current && dark }]}
              href={localePath(lang, tab.href)}
              aria-current={current ? 'page' : undefined}
            >
              {tab.label}
            </a>
          );
        })}
      </nav>
    )
  }
</div>

<style>
  /* The design's .section-head, identical on every hub page. */
  .section-head {
    align-items: center;
    padding-top: 5px;
    padding-bottom: 28px;
  }
  .section-head h1 {
    text-transform: lowercase;
    letter-spacing: -0.04em;
    grid-column: span 5;
    font-size: 70px;
    font-weight: 600;
    line-height: 1;
  }
  .section-head nav {
    grid-column: span 7;
    justify-content: flex-end;
    align-items: center;
    gap: 20px;
    display: flex;
  }
  .section-head a {
    white-space: nowrap;
    border: 1px solid #000;
    padding: 8px 20px;
    font-size: 28px;
    line-height: 34px;
  }
  .section-head a.active {
    background: #fff350;
  }
  .section-head a.active.dark {
    color: #fff;
    background: #000;
  }
  @media (width<=900px) {
    .section-head h1,
    .section-head nav {
      grid-column: 1 / -1;
    }
    .section-head nav {
      justify-content: flex-start;
      padding-top: 18px;
      overflow-x: auto;
    }
    .section-head h1 {
      font-size: 48px;
    }
    .section-head a {
      padding: 5px 12px;
      font-size: 20px;
      line-height: 26px;
    }
  }
</style>
