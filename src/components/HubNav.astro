---
import type { LocaleId } from '../lib/locales';
import { useTranslations, localePath } from '../lib/i18n';
import { HUBS, hubTabHref } from '../lib/hubs';

/**
 * The title band of a hub page, as the design draws it on every hub frame:
 * the hub name on four columns, the tabs right-aligned on the other eight
 * as bordered buttons, the current one filled acid (or black on the acid
 * art prize pages, `dark`). Markup and rules are the `.section-head` block
 * Lilanga's build repeats on each page (2026-09-14 build: smaller pills).
 *
 * Tabs come from HUBS; a `page` document with the same English slug can
 * override a tab's label through its Tab label field. A tab with a `link`
 * leads to another hub; a `hidden` one has a page but no pill.
 */
interface Props {
  lang: LocaleId;
  route: string;
  active: string;
  /** Hub pages from getHubPages, for label overrides. */
  pages?: any[];
  /** The acid pages fill the active tab black instead of acid. */
  dark?: boolean;
  class?: string;
  /**
   * A band of its own inside a hub tab: a title and pills that are not the
   * hub's. About → press & media draws its four views this way until they
   * are tabs of their own (BACKEND-REQUEST #19); `href` is used as given.
   */
  title?: string;
  items?: { slug: string; label: string; href: string }[];
}

const { lang, route, active, pages = [], dark = false, class: className, title, items } = Astro.props;
const t = useTranslations(lang);
const hub = HUBS[route];

// Only the tabs in hubs.ts: they are the ones with a route. A pill for any
// other page of the hub led to a 404.
// A hidden tab (press, images, the VIP access page) has a route but no pill;
// a locked one is not for crawlers to follow (docs/vip-access.md).
// `tabLabel` is the editor's own label in this language or nothing (request
// #6), so the translated label is what a pill reads unless one was set.
const tabs = items
  ? items.map((item) => ({ ...item, link: false, locked: false, own: true }))
  : hub.tabs
      .filter((tab) => !tab.hidden)
      .map((tab) => {
        const page = tab.link ? null : pages.find((p) => p?.slugs?.en === tab.slug);
        return { slug: tab.slug, label: page?.tabLabel ?? t(tab.label), href: hubTabHref(route, tab, lang), link: !!tab.link, locked: !!tab.locked, own: false };
      });
---

<div class:list={['section-head', 'page-grid', 'title-band', className]}>
  <h1>{title ?? t(hub.title)}</h1>
  {
    tabs.length > 1 && (
      <nav aria-label={title ?? t(hub.title)}>
        {tabs.map((tab) => {
          const current = !tab.link && tab.slug === active;
          return (
            <a
              class:list={[{ active: current, dark: current && dark }]}
              href={tab.own ? tab.href : localePath(lang, tab.href)}
              data-view={tab.own ? tab.slug : undefined}
              aria-current={current ? 'page' : undefined}
              rel={tab.locked ? 'nofollow' : undefined}
            >
              {tab.label}
            </a>
          );
        })}
      </nav>
    )
  }
</div>

<style>
  /* The design's .section-head, identical on every hub page. */
  .section-head {
    align-items: center;
    /* Room under the header before the title band (client feedback,
       2026-09-15), a little less since 2026-09-16 ("a bit higher up"). */
    padding-top: var(--band-pad-top, 26px);
    padding-bottom: var(--band-pad-bottom, 22px);
  }
  .section-head h1 {
    text-transform: lowercase;
    letter-spacing: -0.04em;
    white-space: nowrap;
    grid-column: span 4;
    font-size: var(--band-h1, 70px);
    font-weight: 600;
    line-height: 1;
  }
  /* VIP is an initialism, not a word: the band lowercases every other hub
     title, and `vip-band` (passed by the VIP hub) keeps its capitals. */
  .section-head.vip-band h1 {
    text-transform: uppercase;
  }
  .section-head nav {
    grid-column: span 8;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    display: flex;
  }
  .section-head a {
    white-space: nowrap;
    /* currentColor, not #000: the tab follows the page's ink, so the pills
       come out white on the black VIP tabs without a second rule. */
    border: 1px solid currentColor;
    padding: var(--band-pill-pad, 7px 15px);
    font-size: var(--band-pill, 24px);
    line-height: 30px;
  }
  .section-head a.active {
    background: var(--color-acid);
  }
  .section-head a.active.dark {
    color: #fff;
    background: #000;
  }
  @media (width<=900px) {
    .section-head h1,
    .section-head nav {
      grid-column: 1 / -1;
    }
    .section-head nav {
      justify-content: flex-start;
      padding-top: 18px;
      overflow-x: auto;
    }
    .section-head h1 {
      white-space: normal;
      font-size: 48px;
    }
    .section-head a {
      padding: 5px 12px;
      font-size: 20px;
      line-height: 26px;
    }
  }
</style>
