---
import type { LocaleId } from '../lib/locales';
import { useTranslations, localePath } from '../lib/i18n';
import { HUBS, hubTabPath } from '../lib/hubs';

/**
 * The title band of a hub page: the hub name on the left and its pill tabs on
 * the right, as in the design (the `.section-head` + `.tabs .pill` system of
 * the partners and programme frames). Tabs come from HUBS; a `page` document
 * with the same English slug can override a tab's label, and any extra hub
 * page an editor adds becomes an additional tab.
 *
 * The active pill is acid on a white page and black on an acid page - the
 * layout marks the body `acid-page`, so nothing has to be passed down.
 */
interface Props {
  lang: LocaleId;
  route: string;
  active: string;
  /** Hub pages from getHubPages, for label overrides and extra tabs. */
  pages?: any[];
  class?: string;
}

const { lang, route, active, pages = [], class: className } = Astro.props;
const t = useTranslations(lang);
const hub = HUBS[route];

const known = new Set(hub.tabs.map((tab) => tab.slug));
const tabs = [
  ...hub.tabs.map((tab) => {
    const page = pages.find((p) => p?.slugs?.en === tab.slug);
    return { slug: tab.slug, label: page?.tabLabel ?? t(tab.label) };
  }),
  ...pages
    .filter((p) => p?.slugs?.en && !known.has(p.slugs.en))
    .map((p) => ({ slug: p.slugs.en as string, label: p.tabLabel ?? p.title })),
];
---

<div class:list={['section-head', className]}>
  <h1 class="section-title">{t(hub.title)}</h1>

  {
    tabs.length > 1 && (
      <nav class="tabs" aria-label={t(hub.title)}>
        {tabs.map((tab) => (
          <a
            class="pill"
            href={localePath(lang, hubTabPath(route, tab.slug))}
            aria-current={tab.slug === active ? 'page' : undefined}
          >
            {tab.label}
          </a>
        ))}
      </nav>
    )
  }
</div>

<style>
  /* Base.astro carries two .section-head rules; this is the frame's version. */
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 0;
    margin: 0;
    padding: 0 0 1.75rem;
  }
  .section-title {
    margin: 0;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .pill {
    text-transform: lowercase;
    text-decoration: none;
    color: var(--ink);
  }
  .pill:hover {
    background: var(--acid);
  }
  .pill[aria-current] {
    background: var(--acid);
  }

  /* On the acid pages the yellow pill would vanish, so the active tab goes black. */
  :global(body.acid-page) .pill:hover,
  :global(body.acid-page) .pill[aria-current] {
    background: var(--ink);
    color: var(--ground);
    border-color: var(--ink);
  }
</style>
