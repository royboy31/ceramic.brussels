---
import { useTranslations } from '../lib/i18n';
import type { LocaleId } from '../lib/locales';

/**
 * The menu overlay of the design: a panel sliding in from the right, one
 * acid "sheet" per menu row, and a `+` on the rows that have sub-items,
 * which open as an accordion (on hover with a mouse, on the button
 * otherwise). Markup, classes and behaviour are Lilanga's build of the
 * Figma menu frame (the index.html files under html pages); the rules for the
 * classes live in src/styles/design.css. Items come from the resolved Sanity navigation
 * that Base.astro builds, children included.
 */
interface Child {
  label: string;
  href: string;
  external?: boolean;
}
interface Item extends Child {
  children?: Child[];
}

interface Props {
  lang: LocaleId;
  items: Item[];
  siteName?: string;
  newsletterUrl?: string;
}

const { lang, items, siteName = 'ceramic brussels' } = Astro.props;
const t = useTranslations(lang);
const rel = (external?: boolean) => (external ? { rel: 'noopener noreferrer' } : {});
---

<dialog id="site-menu" data-menu aria-label={t('nav.menu')}>
  <div class="menu-panel">
    <div class="menu-top">
      <span>{siteName}</span>
      <button data-menu-close autofocus>{t('nav.close').toLowerCase()} <span aria-hidden="true">×</span></button>
    </div>
    <nav aria-label={t('nav.menu')} class="menu-stack">
      {
        items.map((item, i) => {
          const children = item.children ?? [];
          return (
            <section class="menu-row" style={`--row:${i}`}>
              <div class="menu-sheet">
                <div class="menu-heading">
                  <a href={item.href} {...rel(item.external)}>
                    {item.label}
                  </a>
                  {children.length > 0 && (
                    <button
                      class="submenu-toggle"
                      aria-label={`${t('nav.expand')} ${item.label}`}
                      aria-expanded="false"
                      aria-controls={`submenu-${i}`}
                    >
                      <span aria-hidden="true">+</span>
                    </button>
                  )}
                </div>
                {children.length > 0 && (
                  <div class="submenu" id={`submenu-${i}`} inert>
                    <div>
                      {children.map((c) => (
                        <a href={c.href} {...rel(c.external)}>
                          {c.label}
                          <span aria-hidden="true"> ↗</span>
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </section>
          );
        })
      }
    </nav>
  </div>
</dialog>

<script>
  // The design's menu behaviour, as built: open as a modal, slide in on the
  // next frame, expand a row on mouse hover or on its + button, close on the
  // button, on Escape, or on a click outside the panel.
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openers = document.querySelectorAll<HTMLButtonElement>('[data-menu-open]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  let lastOpener: HTMLElement | null = null;
  let closing = false;
  let savedOverflow = '';

  const expand = (row: Element, open: boolean) => {
    row.classList.toggle('expanded', open);
    row.querySelector('button')?.setAttribute('aria-expanded', String(open));
    const sub = row.querySelector<HTMLElement>('.submenu');
    if (sub) sub.inert = !open;
  };

  const close = () => {
    if (!dialog?.open || closing) return;
    closing = true;
    dialog.classList.remove('is-open');
    window.setTimeout(() => dialog.close(), reduced.matches ? 0 : 680);
  };

  openers.forEach((btn) =>
    btn.addEventListener('click', () => {
      if (!dialog || dialog.open) return;
      lastOpener = btn;
      savedOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
      openers.forEach((b) => b.setAttribute('aria-expanded', 'true'));
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          if (!closing && dialog.open) dialog.classList.add('is-open');
        }),
      );
    }),
  );

  dialog?.querySelector('[data-menu-close]')?.addEventListener('click', close);
  dialog?.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });
  dialog?.addEventListener('close', () => {
    closing = false;
    dialog.classList.remove('is-open');
    document.documentElement.style.overflow = savedOverflow;
    openers.forEach((b) => b.setAttribute('aria-expanded', 'false'));
    dialog.querySelectorAll('.menu-row').forEach((row) => expand(row, false));
    lastOpener?.focus({ preventScroll: true });
  });

  dialog?.querySelectorAll('.menu-row').forEach((row) => {
    row.addEventListener('pointerenter', (e) => {
      if ((e as PointerEvent).pointerType === 'mouse' && !closing) expand(row, true);
    });
    row.addEventListener('pointerleave', () => {
      if (!row.contains(document.activeElement)) expand(row, false);
    });
    row.addEventListener('focusout', (e) => {
      const to = (e as FocusEvent).relatedTarget as Node | null;
      if (!row.contains(to) && !row.matches(':hover')) expand(row, false);
    });
    row.querySelector('button')?.addEventListener('click', () => expand(row, !row.classList.contains('expanded')));
  });
</script>
