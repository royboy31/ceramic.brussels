---
import { useTranslations } from '../lib/i18n';
import type { LocaleId } from '../lib/locales';

/**
 * The menu overlay: the design's panel sliding in from the right with a
 * white top bar holding only the ×, and inside it the live site's stacked
 * rows - one acid-banded sheet per menu item, each collapsed to its top
 * strip under the next sheet, growing to show its sub-links when hovered
 * or focused (the rules at the foot of this file). Panel, bar and sheet
 * markup are Lilanga's build of the Figma menu frame (the index.html files
 * under html pages, 2026-09-14 build); their rules live in
 * src/styles/design.css. Items come from the resolved Sanity navigation
 * that Base.astro builds, children included; a row without children is
 * `no-links` and stands taller.
 */
interface Child {
  label: string;
  href: string;
  external?: boolean;
}
interface Item extends Child {
  children?: Child[];
}

interface Props {
  lang: LocaleId;
  items: Item[];
  siteName?: string;
  newsletterUrl?: string;
}

const { lang, items } = Astro.props;
const t = useTranslations(lang);
const rel = (external?: boolean) => (external ? { rel: 'noopener noreferrer' } : {});
---

<dialog id="site-menu" data-menu aria-label={t('nav.menu')}>
  <div class="menu-panel">
    <div class="menu-top">
      <span aria-hidden="true"></span>
      <button data-menu-close aria-label={t('nav.closeMenu')}><span aria-hidden="true">×</span></button>
    </div>
    <nav aria-label={t('nav.menu')} class="menu-stack">
      {
        items.map((item, i) => {
          const children = item.children ?? [];
          return (
            <section class:list={['menu-row', { 'no-links': children.length === 0 }]} style={`--row:${i}`}>
              <div class="menu-sheet">
                <div class="menu-heading">
                  <a href={item.href} {...rel(item.external)}>
                    {item.label}
                  </a>
                </div>
                {children.length > 0 && (
                  <div class="submenu" id={`submenu-${i}`}>
                    <div>
                      {children.map((c) => (
                        <a href={c.href} {...rel(c.external)}>
                          {c.label}
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </section>
          );
        })
      }
    </nav>
  </div>
</dialog>

<script>
  // The design's menu behaviour, as built: open as a modal, slide in on the
  // next frame, nudge a row while a mouse is over it, close on the button,
  // on Escape, or on a click outside the panel.
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openers = document.querySelectorAll<HTMLButtonElement>('[data-menu-open]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  let lastOpener: HTMLElement | null = null;
  let closing = false;
  let savedOverflow = '';

  const expand = (row: Element, open: boolean) => row.classList.toggle('expanded', open);
  const panel = dialog?.querySelector<HTMLElement>('.menu-panel');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-menu-close]');
  // The panel scrolls up and down only; nothing may shift it sideways.
  panel?.addEventListener('scroll', () => {
    if (panel.scrollLeft) panel.scrollLeft = 0;
  });

  // The rows are collapsed sheets, as on the live site: each shows only its
  // top strip, the next sheet lying over the rest. A row grows to its full
  // height when hovered or focused, so the height it grows to is measured
  // once the panel is on screen.
  const measure = () =>
    dialog?.querySelectorAll<HTMLElement>('.menu-row').forEach((row) => {
      const sheet = row.querySelector<HTMLElement>('.menu-sheet');
      if (sheet) row.style.setProperty('--full', `${sheet.scrollHeight}px`);
    });

  // The rows leave as they came, one after the other: the dialog closes
  // once the last one is out.
  const rows = dialog?.querySelectorAll('.menu-row').length ?? 0;
  dialog?.style.setProperty('--rows', String(rows));
  const close = () => {
    if (!dialog?.open || closing) return;
    closing = true;
    dialog.classList.remove('is-open');
    dialog.classList.add('is-closing');
    window.setTimeout(() => dialog.close(), reduced.matches ? 0 : 300 + (rows + 1) * 22);
  };

  openers.forEach((btn) =>
    btn.addEventListener('click', () => {
      if (!dialog || dialog.open) return;
      lastOpener = btn;
      savedOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
      // Focus the × without scrolling to it: it is still off to the right
      // while the rows slide in, and scrolling it into view dragged the whole
      // panel sideways - the rows landed out of place or all at once,
      // differently per browser (client feedback, 2026-09-23).
      panel && (panel.scrollLeft = 0);
      closeButton?.focus({ preventScroll: true });
      openers.forEach((b) => b.setAttribute('aria-expanded', 'true'));
      measure();
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          if (!closing && dialog.open) dialog.classList.add('is-open');
        }),
      );
    }),
  );

  dialog?.querySelector('[data-menu-close]')?.addEventListener('click', close);
  dialog?.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });
  dialog?.addEventListener('close', () => {
    closing = false;
    dialog.classList.remove('is-open', 'is-closing');
    document.documentElement.style.overflow = savedOverflow;
    openers.forEach((b) => b.setAttribute('aria-expanded', 'false'));
    dialog.querySelectorAll('.menu-row').forEach((row) => expand(row, false));
    lastOpener?.focus({ preventScroll: true });
  });

  dialog?.querySelectorAll('.menu-row').forEach((row) => {
    row.addEventListener('pointerenter', (e) => {
      if ((e as PointerEvent).pointerType === 'mouse' && !closing) expand(row, true);
    });
    row.addEventListener('pointerleave', () => {
      if (!row.contains(document.activeElement)) expand(row, false);
    });
    row.addEventListener('focusin', () => expand(row, true));
    row.addEventListener('focusout', (e) => {
      const to = (e as FocusEvent).relatedTarget as Node | null;
      if (!row.contains(to) && !row.matches(':hover')) expand(row, false);
    });
  });
  addEventListener('resize', () => dialog?.open && measure());
</script>

<style>
  /*
   * The live site's stacked menu (www.ceramic.brussels): every row is a
   * sheet with an acid band along its top, and the rows lie over each other
   * so a collapsed row shows only that band with the top of its title, the
   * lower part hidden under the next sheet. Hovering (or tabbing into) a row
   * grows it to its full height - title and sub-links - and the rows below
   * slide down. The last row has nothing over it and stays whole. The panel,
   * its slide-in and the top bar are the design's, from design.css.
   */
  /* The "sliding stairs" (client feedback, 2026-09-23): the top bar, then
     each sheet in turn, slides in from the right, a beat after the one above
     it, and they leave the same way. Keyframe animations rather than
     transitions: an animation starts the moment the dialog opens, where a
     transition needed a frame with the closed state painted first, which
     Safari and Chrome did not agree on - the menu "just appeared". The
     panel itself stays put; only its shadow fades in. */
  .menu-panel {
    transform: none;
    transition: none;
  }
  :global(dialog[open]) .menu-panel {
    animation: menu-shadow-in 0.45s ease both;
  }
  .menu-stack .menu-sheet,
  .menu-panel .menu-top {
    transform: none;
    transition:
      translate 0.22s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.22s;
  }
  :global(dialog[open]) .menu-top,
  :global(dialog[open]) .menu-sheet {
    animation: menu-stair-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc((var(--row, -1) + 1) * 45ms);
  }
  :global(dialog.is-closing) .menu-top,
  :global(dialog.is-closing) .menu-sheet {
    animation: menu-stair-out 0.3s cubic-bezier(0.55, 0, 0.8, 0.2) both;
    animation-delay: calc((var(--row, -1) + 1) * 22ms);
  }
  :global(dialog.is-closing) .menu-panel {
    animation: menu-shadow-out 0.3s ease both;
    animation-delay: calc(var(--rows, 10) * 22ms);
  }
  @keyframes menu-stair-in {
    from {
      transform: translateX(101%);
    }
    to {
      transform: none;
    }
  }
  @keyframes menu-stair-out {
    from {
      transform: none;
    }
    to {
      transform: translateX(101%);
    }
  }
  @keyframes menu-shadow-in {
    from {
      box-shadow: -16px 0 42px #0000;
    }
  }
  @keyframes menu-shadow-out {
    to {
      box-shadow: -16px 0 42px #0000;
    }
  }
  .menu-row {
    /* The title sits centred in its strip; only its descenders go under the
       next sheet. 58px since 2026-09-23 ("each tab a tiny bit thicker"). */
    --strip: 58px;
    /* How far an open row rides up over the one above it (client feedback, 2026-09-15: like the live site). */
    --lift: 24px;
    /* A block, not the design's grid: the sheet keeps its full height and
       hangs out of the row, under the next sheet. */
    display: block;
    height: var(--strip);
    overflow: visible;
    transition: height 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* The last row has no sheet over it, so it used to stand open. It is
     collapsed like the others (client feedback, 2026-09-16): its own sheet
     is cut to the strip and grows to its measured height. */
  .menu-row:last-child {
    height: auto;
  }
  .menu-row:last-child .menu-sheet {
    max-height: var(--strip);
    transition:
      max-height 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      translate 0.22s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.22s;
  }
  .menu-row:last-child.expanded .menu-sheet {
    max-height: var(--full, 100vh);
  }
  .menu-row.expanded {
    height: calc(var(--full, 0px) - var(--lift));
  }
  .menu-row:last-child.expanded {
    height: auto;
  }
  /* A gradual acid band, closer to the live site's menu (client feedback,
     2026-09-16), reaching white higher up since 2026-09-23 ("leave more
     white in the gradients"). */
  /* 2026-09-24: "not enough yellow" - back towards acid, about 70/30 over
     the strip: solid for the first third, still mostly acid at two thirds,
     white only by the foot of the strip. */
  /* The 1px acid edge above each sheet closes the hairline seam between two
     sheets that showed the page through in some browsers and zoom levels
     (client video, 2026-09-24): a sheet's top is acid, so the edge is
     invisible where the sheets meet cleanly. */
  .menu-sheet {
    background: linear-gradient(
      var(--color-acid) 0,
      var(--color-acid) 1.1rem,
      color-mix(in srgb, var(--color-acid) 70%, #fff) 2.2rem,
      #fff 3.6rem
    );
    box-shadow: 0 -1px 0 var(--color-acid);
  }
  :global(.menu-heading) {
    min-height: calc(var(--strip) + 3px);
  }
  /* Tighter sub-links and heavier underlines (client feedback, 2026-09-16). */
  .submenu a {
    letter-spacing: -0.03em;
  }
  /* The underline close under the letters (client feedback, 2026-09-23). */
  @media (hover: hover) {
    .menu-heading > a:hover,
    .submenu a:hover {
      text-underline-offset: 0.07em;
      text-decoration-thickness: 2px;
    }
    .menu-heading > a:hover {
      text-decoration-thickness: 3px;
    }
  }
  .menu-heading > a:focus-visible,
  .submenu a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.07em;
    text-decoration-thickness: 2px;
  }
  /* Up over the previous sheet, not off to the left (client feedback): the
     design's -16px nudge and its acid edge are dropped. */
  .menu-row.expanded .menu-sheet {
    translate: 0 calc(-1 * var(--lift));
    box-shadow:
      0 -1px 0 var(--color-acid),
      0 -6px 18px #00000014;
  }
  /* A row without sub-links is the design's taller strip, which put its
     title under the next sheet; only the last row, with nothing over it,
     keeps that height. */
  .menu-row.no-links:not(:last-child) :global(.menu-heading) {
    min-height: var(--strip);
  }
  /* A row without sub-links has nothing to show: it neither grows nor rides
     up over the row above (it used to cover that row's title on hover). */
  .menu-row.no-links.expanded:not(:last-child) {
    height: var(--strip);
  }
  .menu-row.no-links.expanded .menu-sheet {
    translate: 0;
    box-shadow: 0 -1px 0 var(--color-acid);
  }
  /* Nothing above the first row to ride over: it only grows. */
  .menu-row:first-child.expanded {
    height: var(--full, auto);
  }
  .menu-row:first-child.expanded .menu-sheet {
    translate: 0;
  }
  @media (width<=640px) {
    .menu-row {
      --strip: 52px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-row {
      transition: none;
    }
    :global(dialog[open]) :is(.menu-panel, .menu-top, .menu-sheet),
    :global(dialog.is-closing) :is(.menu-panel, .menu-top, .menu-sheet) {
      animation: none;
    }
  }
</style>
