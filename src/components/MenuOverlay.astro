---
import { useTranslations } from '../lib/i18n';
import type { LocaleId } from '../lib/locales';

/**
 * The menu overlay: the design's panel sliding in from the right with a
 * white top bar holding only the ×, and inside it the live site's stacked
 * rows - one acid-banded sheet per menu item, each collapsed to its top
 * strip under the next sheet, growing to show its sub-links when hovered
 * or focused (the rules at the foot of this file). Panel, bar and sheet
 * markup are Lilanga's build of the Figma menu frame (the index.html files
 * under html pages, 2026-09-14 build); their rules live in
 * src/styles/design.css. Items come from the resolved Sanity navigation
 * that Base.astro builds, children included; a row without children is
 * `no-links` and stands taller.
 */
interface Child {
  label: string;
  href: string;
  external?: boolean;
}
interface Item extends Child {
  children?: Child[];
}

interface Props {
  lang: LocaleId;
  items: Item[];
  siteName?: string;
  newsletterUrl?: string;
}

const { lang, items } = Astro.props;
const t = useTranslations(lang);
const rel = (external?: boolean) => (external ? { rel: 'noopener noreferrer' } : {});
---

<dialog id="site-menu" data-menu aria-label={t('nav.menu')}>
  <div class="menu-panel">
    <div class="menu-top">
      <span aria-hidden="true"></span>
      <button data-menu-close autofocus aria-label={t('nav.closeMenu')}><span aria-hidden="true">×</span></button>
    </div>
    <nav aria-label={t('nav.menu')} class="menu-stack">
      {
        items.map((item, i) => {
          const children = item.children ?? [];
          return (
            <section class:list={['menu-row', { 'no-links': children.length === 0 }]} style={`--row:${i}`}>
              <div class="menu-sheet">
                <div class="menu-heading">
                  <a href={item.href} {...rel(item.external)}>
                    {item.label}
                  </a>
                </div>
                {children.length > 0 && (
                  <div class="submenu" id={`submenu-${i}`}>
                    <div>
                      {children.map((c) => (
                        <a href={c.href} {...rel(c.external)}>
                          {c.label}
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </section>
          );
        })
      }
    </nav>
  </div>
</dialog>

<script>
  // The design's menu behaviour, as built: open as a modal, slide in on the
  // next frame, nudge a row while a mouse is over it, close on the button,
  // on Escape, or on a click outside the panel.
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openers = document.querySelectorAll<HTMLButtonElement>('[data-menu-open]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  let lastOpener: HTMLElement | null = null;
  let closing = false;
  let savedOverflow = '';

  const expand = (row: Element, open: boolean) => row.classList.toggle('expanded', open);

  // The rows are collapsed sheets, as on the live site: each shows only its
  // top strip, the next sheet lying over the rest. A row grows to its full
  // height when hovered or focused, so the height it grows to is measured
  // once the panel is on screen.
  const measure = () =>
    dialog?.querySelectorAll<HTMLElement>('.menu-row').forEach((row) => {
      const sheet = row.querySelector<HTMLElement>('.menu-sheet');
      if (sheet) row.style.setProperty('--full', `${sheet.scrollHeight}px`);
    });

  const close = () => {
    if (!dialog?.open || closing) return;
    closing = true;
    dialog.classList.remove('is-open');
    window.setTimeout(() => dialog.close(), reduced.matches ? 0 : 760);
  };

  openers.forEach((btn) =>
    btn.addEventListener('click', () => {
      if (!dialog || dialog.open) return;
      lastOpener = btn;
      savedOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
      openers.forEach((b) => b.setAttribute('aria-expanded', 'true'));
      measure();
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          if (!closing && dialog.open) dialog.classList.add('is-open');
        }),
      );
    }),
  );

  dialog?.querySelector('[data-menu-close]')?.addEventListener('click', close);
  dialog?.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });
  dialog?.addEventListener('close', () => {
    closing = false;
    dialog.classList.remove('is-open');
    document.documentElement.style.overflow = savedOverflow;
    openers.forEach((b) => b.setAttribute('aria-expanded', 'false'));
    dialog.querySelectorAll('.menu-row').forEach((row) => expand(row, false));
    lastOpener?.focus({ preventScroll: true });
  });

  dialog?.querySelectorAll('.menu-row').forEach((row) => {
    row.addEventListener('pointerenter', (e) => {
      if ((e as PointerEvent).pointerType === 'mouse' && !closing) expand(row, true);
    });
    row.addEventListener('pointerleave', () => {
      if (!row.contains(document.activeElement)) expand(row, false);
    });
    row.addEventListener('focusin', () => expand(row, true));
    row.addEventListener('focusout', (e) => {
      const to = (e as FocusEvent).relatedTarget as Node | null;
      if (!row.contains(to) && !row.matches(':hover')) expand(row, false);
    });
  });
  addEventListener('resize', () => dialog?.open && measure());
</script>

<style>
  /*
   * The live site's stacked menu (www.ceramic.brussels): every row is a
   * sheet with an acid band along its top, and the rows lie over each other
   * so a collapsed row shows only that band with the top of its title, the
   * lower part hidden under the next sheet. Hovering (or tabbing into) a row
   * grows it to its full height - title and sub-links - and the rows below
   * slide down. The last row has nothing over it and stays whole. The panel,
   * its slide-in and the top bar are the design's, from design.css.
   */
  .menu-row {
    /* The title sits centred in its 55px strip; this leaves its lower few pixels under the next sheet, as the live site does. */
    --strip: 46px;
    /* How far an open row rides up over the one above it (client feedback, 2026-09-15: like the live site). */
    --lift: 24px;
    /* A block, not the design's grid: the sheet keeps its full height and
       hangs out of the row, under the next sheet. */
    display: block;
    height: var(--strip);
    overflow: visible;
    transition: height 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .menu-row:last-child {
    height: auto;
  }
  .menu-row.expanded {
    height: calc(var(--full, 0px) - var(--lift));
  }
  .menu-row:last-child.expanded {
    height: auto;
  }
  .menu-sheet {
    background: linear-gradient(#fff350 0, #fff999 1rem, #fff 2rem);
  }
  /* Up over the previous sheet, not off to the left (client feedback): the
     design's -16px nudge and its acid edge are dropped. */
  .menu-row.expanded .menu-sheet {
    translate: 0 calc(-1 * var(--lift));
    box-shadow: 0 -6px 18px #00000014;
  }
  /* Nothing above the first row to ride over: it only grows. */
  .menu-row:first-child.expanded {
    height: var(--full, auto);
  }
  .menu-row:first-child.expanded .menu-sheet {
    translate: 0;
  }
  @media (width<=640px) {
    .menu-row {
      --strip: 42px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-row {
      transition: none;
    }
  }
</style>
