---
import ExhibitorCard from './ExhibitorCard.astro';
import ExhibitorHead from './ExhibitorHead.astro';
import PageSections from './PageSections.astro';
import YearBand from './editions/YearBand.astro';
import HubNav from './HubNav.astro';
import type { LocaleId } from '../lib/locales';
import { useTranslations, localePath } from '../lib/i18n';
import { tabsFor, tabLabel, editionTabHref, type EditionSummary } from '../lib/previousEditions';
import { countryCode, countryName } from '../lib/countries';
import { styleAttrs } from '../lib/textStyle';

/**
 * One edition's exhibitors, as the design's exhibitors/index.html draws it
 * (2026-09-14 build): the title band with its tabs and the A–Z row,
 * the FILTERS row (search by country, solo show, awards, country focus,
 * jury prize, publishers) and the three-column card grid. The letters, the
 * country and the pills all filter the rendered list in place, so the page
 * is complete without JavaScript and costs nothing until clicked.
 *
 * The current edition's list is /exhibitors, wrapped in the Exhibitors main
 * page's lead and blocks. A past edition's is /exhibitors/<year>, the address
 * the old site gave its year lists, with a way back to this year's.
 */
interface Props {
  lang: LocaleId;
  exhibitors: any[];
  /** The edition the list belongs to: its focus names a filter, its year dates the jury prize, its catalogue is a tab. */
  edition: any;
  /** The Exhibitors main page - the current edition's list only. */
  page?: any;
  /** Set on a past edition's list. */
  year?: number;
  currentYear?: number;
  /**
   * Every edition with exhibitors, newest first, for the year row the old
   * site had ("→ 2026 → 2025 → 2024"): the list being read is a filled pill,
   * the others link to their year, this year's to /exhibitors (client
   * feedback, 2026-09-25: 2026 was only reachable through the artists).
   */
  years?: { year: number; current: boolean }[];
  /** `_id`s of the exhibitors that won one of the fair's awards, for the "awards" filter. */
  awarded?: Set<string>;
  /**
   * Every past edition, newest first (getPastEditionsIndex). Set on a past
   * year's list, which the design draws as the exhibitors tab of the
   * previous-editions section: it wears that section's year band and pills in
   * place of its own title band (Figma, Léonie 2026-09-28).
   */
  pastEditions?: EditionSummary[];
}

const { lang, exhibitors, edition, page, year, currentYear, years = [], awarded = new Set<string>(), pastEditions = [] } = Astro.props;
const t = useTranslations(lang);

/** First letter of the sort name, folded so "Éclat" files under E. */
const initial = (ex: any) =>
  (ex.sortName ?? ex.name ?? '')
    .normalize('NFD')
    .replace(/\p{M}/gu, '')
    .trim()
    .charAt(0)
    .toUpperCase();

/**
 * In the client's order (2026-09-16): awards right after solo show,
 * publishers last. A past year's list follows the previous-editions frame
 * instead (Léonie, 2026-09-28), which puts the focus third, publishers
 * fourth, the jury prize fifth and awards last.
 */
const FILTERS = {
  'solo-show': { label: t('exhibitors.soloShow'), has: (ex: any) => ex.soloShow },
  awards: { label: t('nav.awards').toLowerCase(), has: (ex: any) => awarded.has(ex._id) },
  'country-focus': { label: edition?.countryFocus ?? t('exhibitors.countryFocus'), has: (ex: any) => ex.inCountryFocus },
  'jury-prize': {
    label: `${t('exhibitors.juryPrize')}${edition?.year ? ` ${edition.year - 1}` : ''}`,
    has: (ex: any) => ex.kind === 'jury-prize',
  },
  publishers: { label: t('exhibitors.publishers'), has: (ex: any) => ex.kind === 'publisher' },
} as const;
const FILTER_ORDER = year
  ? (['solo-show', 'country-focus', 'publishers', 'jury-prize', 'awards'] as const)
  : (['solo-show', 'awards', 'country-focus', 'jury-prize', 'publishers'] as const);
const filters = FILTER_ORDER.map((id) => ({ id, ...FILTERS[id] })).filter((f) => exhibitors.some(f.has));

/** The countries in the list for the "search by country" menu: filtered by code, named in full, A–Z by name. */
const codeOf = (ex: any) => countryCode(ex.countryCode ?? ex.country);
const countries = ([...new Set(exhibitors.map(codeOf).filter(Boolean))] as string[])
  .map((code) => ({ code, name: countryName(code, lang) }))
  .sort((a, b) => a.name.localeCompare(b.name, lang));

/**
 * The edition's overview and floor plan - on this year's list only. A past
 * year's list shows neither (client feedback, 2026-09-25, on 2026's).
 */
const links = (year ? [] : [
  edition?.overviewUrl && { href: edition.overviewUrl, label: t('editions.overview') },
  edition?.fairMapUrl && { href: edition.fairMapUrl, label: t('tabs.floorPlan') },
]).filter(Boolean) as { href: string; label: string }[];

/**
 * A past year's list is the previous-editions section's exhibitors tab, so it
 * takes that section's chrome: the year band and the edition's pills, with
 * "exhibitors" filled. `summary` is this year's row of the index.
 */
const summary = pastEditions.find((e) => e.year === year);
const inSection = !!year && !!summary && pastEditions.length > 0;
const sectionTabs = summary ? tabsFor(summary) : [];
const sectionItems = sectionTabs.map((x) => ({
  slug: x.slug,
  label: tabLabel(x, summary as EditionSummary, t),
  href: localePath(lang, editionTabHref(year as number, x, lang)),
}));

/**
 * The year row: only when there is more than one year to choose from - and
 * never inside the section, where the year band already does that job.
 */
const viewedYear = year ?? edition?.year;
const yearRow = years.length > 1 && !inSection ? years : [];
---

{inSection && <YearBand lang={lang} editions={pastEditions} active={year as number} />}
{inSection && <HubNav lang={lang} active="exhibitors" title={summary?.ordinal ?? String(year)} items={sectionItems} />}

<ExhibitorHead
  lang={lang}
  active="galleries"
  edition={edition}
  year={year}
  alphabet={exhibitors.length > 0}
  bandless={inSection}
/>

{
  (page?.intro || links.length > 0 || yearRow.length > 0 || (year && currentYear && !inSection)) && (
    <div class="exhibitor-intro">
      {page?.intro && (
        <p class="intro-large" {...styleAttrs(page.introStyle)}>
          {page.intro}
        </p>
      )}
      {(links.length > 0 || yearRow.length > 0 || (year && currentYear && !inSection)) && (
        <p class="edition-links">
          {yearRow.map((y) =>
            y.year === viewedYear ? (
              <span class="edition-links__year" aria-current="page">
                {y.year}
              </span>
            ) : (
              <a href={localePath(lang, y.current ? 'exhibitors' : `exhibitors/${y.year}`)}>{y.year} →</a>
            ),
          )}
          {yearRow.length === 0 && year && currentYear && !inSection && (
            <a href={localePath(lang, 'exhibitors')}>
              {t('nav.exhibitors').toLowerCase()} {currentYear} →
            </a>
          )}
          {links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer">
              {l.label} ↗
            </a>
          ))}
        </p>
      )}
    </div>
  )
}

{
  exhibitors.length ? (
    <>
      <div class="filters" id="exhibitor-filters">
        <span>{t('exhibitors.filters')}:</span>
        {countries.length > 1 && (
          <select data-country aria-label={t('exhibitors.searchByCountry')}>
            <option value="">{t('exhibitors.searchByCountry')} ↓</option>
            {countries.map((c) => (
              <option value={c.code}>{c.name}</option>
            ))}
          </select>
        )}
        {filters.map((f) => (
          <button type="button" data-filter={f.id} aria-pressed="false">
            {f.label}
          </button>
        ))}
      </div>

      <p class="empty" id="no-match" hidden>
        {t('exhibitors.noneMatch')}
      </p>

      <div class="gallery-grid" id="exhibitor-list" data-exhibitor-grid>
        {exhibitors.map((ex: any, i: number) => {
          const letter = initial(ex);
          const first = i === 0 || initial(exhibitors[i - 1]) !== letter;
          return (
            <ExhibitorCard
              lang={lang}
              exhibitor={ex}
              code={codeOf(ex)}
              id={first ? `letter-${letter}` : undefined}
              awarded={awarded.has(ex._id)}
            />
          );
        })}
      </div>
    </>
  ) : (
    <p class="empty">{t('exhibitors.empty')}</p>
  )
}
{/* The main page's own blocks, under the list. */}
{
  (page?.sections?.length ?? 0) > 0 && (
    <div class="content-wrap">
      <PageSections lang={lang} sections={page.sections} />
    </div>
  )
}

<style>
  /* From the design's exhibitors/index.html (2026-09-14 build). */
  .exhibitor-intro {
    padding: 40px var(--gutter) 0;
  }
  .filters {
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding: 36px var(--gutter) 63px;
    display: flex;
  }
  /* "FILTERS:" at the frame's size, a line of its own weight beside the pills. */
  .filters span {
    margin-right: 6px;
    text-transform: uppercase;
    font-size: 26px;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  /* Thin like the footer pills - the stroke close to the text, tighter
     letter-spacing, the text size unchanged (client feedback, 2026-09-16). */
  .filters button,
  .filters select {
    border: 1px solid;
    border-radius: 999px;
    padding: 1px 12px 0;
    font-size: 18px;
    line-height: 1.5;
    letter-spacing: -0.02em;
    background: #fff;
    cursor: pointer;
    transition:
      color 0.18s,
      background-color 0.18s;
  }
  /* The country menu is the one square-cornered control in the row. */
  .filters select {
    appearance: none;
    -webkit-appearance: none;
    border-radius: 0;
  }
  /* A chosen pill says it can be undone: a × before its label. */
  .filters button[aria-pressed='true']::before {
    content: '×';
    margin-right: 0.3em;
  }
  .filters button.active,
  .filters button[aria-pressed='true'],
  .filters button:hover,
  .filters select:hover,
  .filters select.active {
    color: #fff;
    background: #000;
  }
  .gallery-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 36px 42px;
    padding: 0 var(--gutter) 100px;
    display: grid;
  }
  .gallery-grid :global(article[hidden]) {
    display: none;
  }
  .empty {
    margin: 0 var(--gutter) 2rem;
  }
  .edition-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
    margin-top: 18px;
    font-size: clamp(1rem, 2vw, 1.75rem);
  }
  .edition-links a,
  .edition-links__year {
    border: 1px solid;
    border-radius: 999px;
    padding: 3px 18px;
    text-decoration: none;
  }
  /* The year being read: filled like the active tab above it. */
  .edition-links__year {
    background: var(--color-acid);
  }
  @media (width<=900px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 36px 24px;
    }
    .filters {
      padding-block: 28px 36px;
    }
    .filters span {
      font-size: 20px;
    }
  }
  @media (width<=560px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // The letters, the country menu and the pills all work on the rendered
  // list: a card stays visible when it matches the chosen letter, the
  // chosen country and every active pill. `#A` in the address pre-selects a
  // letter, which is how a detail page's letter row links back here.
  const head = document.querySelector<HTMLElement>('[data-alphabet]');
  const bar = document.getElementById('exhibitor-filters');
  const list = document.getElementById('exhibitor-list');
  const noMatch = document.getElementById('no-match');

  if (list && noMatch) {
    const letters = Array.from(head?.querySelectorAll<HTMLButtonElement>('button[data-letter]') ?? []);
    const buttons = Array.from(bar?.querySelectorAll<HTMLButtonElement>('button[data-filter]') ?? []);
    const country = bar?.querySelector<HTMLSelectElement>('select[data-country]') ?? null;
    const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-name]'));
    // '' is no letter chosen: the whole list.
    let letter = '';

    const apply = () => {
      const active = buttons.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.dataset.filter!);
      const code = country?.value ?? '';
      let visible = 0;
      for (const card of cards) {
        const has = (card.dataset.filters ?? '').split(' ');
        const match =
          (!letter || card.dataset.name === letter) &&
          (!code || card.dataset.country === code) &&
          active.every((f) => has.includes(f));
        card.hidden = !match;
        if (match) visible++;
      }
      noMatch.hidden = visible > 0;
      country?.classList.toggle('active', !!code);
      for (const b of letters) {
        const on = b.dataset.letter === letter;
        b.classList.toggle('active', on);
        b.setAttribute('aria-pressed', String(on));
      }
    };

    for (const b of letters) {
      b.addEventListener('click', () => {
        // Clicking the chosen letter again clears it.
        letter = b.dataset.letter === letter ? '' : (b.dataset.letter ?? '');
        if (letter) history.replaceState(null, '', `#${letter}`);
        else history.replaceState(null, '', location.pathname + location.search);
        apply();
      });
    }
    for (const b of buttons) {
      b.addEventListener('click', () => {
        b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        apply();
      });
    }
    country?.addEventListener('change', apply);

    const fromHash = () => {
      const m = location.hash.match(/^#([A-Za-z])$/);
      letter = m ? m[1].toUpperCase() : '';
      apply();
    };
    window.addEventListener('hashchange', fromHash);
    if (/^#[A-Za-z]$/.test(location.hash)) fromHash();
  }
</script>
