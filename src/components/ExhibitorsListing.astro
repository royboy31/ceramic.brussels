---
import ExhibitorCard from './ExhibitorCard.astro';
import ExhibitorHead from './ExhibitorHead.astro';
import PageSections from './PageSections.astro';
import type { LocaleId } from '../lib/locales';
import { useTranslations, localePath } from '../lib/i18n';
import { countryCode } from '../lib/countries';
import { styleAttrs } from '../lib/textStyle';

/**
 * One edition's exhibitors, as the design's exhibitors/index.html draws it
 * (2026-09-14 build): the title band with its tabs and the ALL + A–Z row,
 * the FILTERS row (search by country, solo show, country focus, publishers,
 * jury prize, awards) and the three-column card grid. The letters, the
 * country and the pills all filter the rendered list in place, so the page
 * is complete without JavaScript and costs nothing until clicked.
 *
 * The current edition's list is /exhibitors, wrapped in the Exhibitors main
 * page's lead and blocks. A past edition's is /exhibitors/<year>, the address
 * the old site gave its year lists, with a way back to this year's.
 */
interface Props {
  lang: LocaleId;
  exhibitors: any[];
  /** The edition the list belongs to: its focus names a filter, its year dates the jury prize, its catalogue is a tab. */
  edition: any;
  /** The Exhibitors main page - the current edition's list only. */
  page?: any;
  /** Set on a past edition's list. */
  year?: number;
  currentYear?: number;
  /** `_id`s of the exhibitors that won one of the fair's awards, for the "awards" filter. */
  awarded?: Set<string>;
}

const { lang, exhibitors, edition, page, year, currentYear, awarded = new Set<string>() } = Astro.props;
const t = useTranslations(lang);

/** First letter of the sort name, folded so "Éclat" files under E. */
const initial = (ex: any) =>
  (ex.sortName ?? ex.name ?? '')
    .normalize('NFD')
    .replace(/\p{M}/gu, '')
    .trim()
    .charAt(0)
    .toUpperCase();

const filters = [
  { id: 'solo-show', label: t('exhibitors.soloShow'), has: (ex: any) => ex.soloShow },
  { id: 'country-focus', label: edition?.countryFocus ?? t('exhibitors.countryFocus'), has: (ex: any) => ex.inCountryFocus },
  { id: 'publishers', label: t('exhibitors.publishers'), has: (ex: any) => ex.kind === 'publisher' },
  {
    id: 'jury-prize',
    label: `${t('exhibitors.juryPrize')}${edition?.year ? ` ${edition.year - 1}` : ''}`,
    has: (ex: any) => ex.kind === 'jury-prize',
  },
  { id: 'awards', label: t('nav.awards').toLowerCase(), has: (ex: any) => awarded.has(ex._id) },
].filter((f) => exhibitors.some(f.has));

/** The countries in the list, by code, for the "search by country" menu. */
const codeOf = (ex: any) => countryCode(ex.countryCode ?? ex.country);
const countries = [...new Set(exhibitors.map(codeOf).filter(Boolean))].sort() as string[];

/** The edition's overview and floor plan, as the old site's year pages linked them. */
const links = [
  edition?.overviewUrl && { href: edition.overviewUrl, label: t('editions.overview') },
  edition?.fairMapUrl && { href: edition.fairMapUrl, label: t('tabs.floorPlan') },
].filter(Boolean) as { href: string; label: string }[];
---

<ExhibitorHead lang={lang} active="galleries" edition={edition} year={year} alphabet={exhibitors.length > 0} />

{
  (page?.intro || links.length > 0 || (year && currentYear)) && (
    <div class="exhibitor-intro">
      {page?.intro && (
        <p class="intro-large" {...styleAttrs(page.introStyle)}>
          {page.intro}
        </p>
      )}
      {(links.length > 0 || (year && currentYear)) && (
        <p class="edition-links">
          {year && currentYear && (
            <a href={localePath(lang, 'exhibitors')}>
              {t('nav.exhibitors').toLowerCase()} {currentYear} →
            </a>
          )}
          {links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer">
              {l.label} ↗
            </a>
          ))}
        </p>
      )}
    </div>
  )
}

{
  exhibitors.length ? (
    <>
      <div class="filters" id="exhibitor-filters">
        <span>{t('exhibitors.filters')}:</span>
        {countries.length > 1 && (
          <select data-country aria-label={t('exhibitors.searchByCountry')}>
            <option value="">{t('exhibitors.searchByCountry')} ↓</option>
            {countries.map((c) => (
              <option value={c}>{c}</option>
            ))}
          </select>
        )}
        {filters.map((f) => (
          <button type="button" data-filter={f.id} aria-pressed="false">
            {f.label}
          </button>
        ))}
      </div>

      <p class="empty" id="no-match" hidden>
        {t('exhibitors.noneMatch')}
      </p>

      <div class="gallery-grid" id="exhibitor-list" data-exhibitor-grid>
        {exhibitors.map((ex: any, i: number) => {
          const letter = initial(ex);
          const first = i === 0 || initial(exhibitors[i - 1]) !== letter;
          return (
            <ExhibitorCard
              lang={lang}
              exhibitor={ex}
              code={codeOf(ex)}
              id={first ? `letter-${letter}` : undefined}
              awarded={awarded.has(ex._id)}
            />
          );
        })}
      </div>
    </>
  ) : (
    <p class="empty">{t('exhibitors.empty')}</p>
  )
}
{/* The main page's own blocks, under the list. */}
{
  (page?.sections?.length ?? 0) > 0 && (
    <div class="content-wrap">
      <PageSections lang={lang} sections={page.sections} />
    </div>
  )
}

<style>
  /* From the design's exhibitors/index.html (2026-09-14 build). */
  .exhibitor-intro {
    padding: 40px var(--gutter) 0;
  }
  .filters {
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding: 32px var(--gutter);
    display: flex;
  }
  .filters span {
    margin-right: 8px;
    text-transform: uppercase;
  }
  .filters button,
  .filters select {
    border: 1px solid;
    border-radius: 999px;
    padding: 5px 16px;
    font-size: 18px;
    background: #fff;
    cursor: pointer;
    transition:
      color 0.18s,
      background-color 0.18s;
  }
  .filters select {
    appearance: none;
    -webkit-appearance: none;
  }
  .filters button.active,
  .filters button[aria-pressed='true'],
  .filters button:hover,
  .filters select:hover,
  .filters select.active {
    color: #fff;
    background: #000;
  }
  .gallery-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 42px 30px;
    padding: 0 var(--gutter) 100px;
    display: grid;
  }
  .gallery-grid :global(article[hidden]) {
    display: none;
  }
  .empty {
    margin: 0 var(--gutter) 2rem;
  }
  .edition-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
    margin-top: 18px;
    font-size: clamp(1rem, 2vw, 1.75rem);
  }
  .edition-links a {
    border: 1px solid;
    border-radius: 999px;
    padding: 3px 18px;
    text-decoration: none;
  }
  @media (width<=900px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (width<=560px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // The letters, the country menu and the pills all work on the rendered
  // list: a card stays visible when it matches the chosen letter, the
  // chosen country and every active pill. `#A` in the address pre-selects a
  // letter, which is how a detail page's letter row links back here.
  const head = document.querySelector<HTMLElement>('[data-alphabet]');
  const bar = document.getElementById('exhibitor-filters');
  const list = document.getElementById('exhibitor-list');
  const noMatch = document.getElementById('no-match');

  if (list && noMatch) {
    const letters = Array.from(head?.querySelectorAll<HTMLButtonElement>('button[data-letter]') ?? []);
    const buttons = Array.from(bar?.querySelectorAll<HTMLButtonElement>('button[data-filter]') ?? []);
    const country = bar?.querySelector<HTMLSelectElement>('select[data-country]') ?? null;
    const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-name]'));
    let letter = 'ALL';

    const apply = () => {
      const active = buttons.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.dataset.filter!);
      const code = country?.value ?? '';
      let visible = 0;
      for (const card of cards) {
        const has = (card.dataset.filters ?? '').split(' ');
        const match =
          (letter === 'ALL' || card.dataset.name === letter) &&
          (!code || card.dataset.country === code) &&
          active.every((f) => has.includes(f));
        card.hidden = !match;
        if (match) visible++;
      }
      noMatch.hidden = visible > 0;
      country?.classList.toggle('active', !!code);
      for (const b of letters) {
        const on = (b.dataset.letter ?? 'ALL') === letter;
        b.classList.toggle('active', on);
        b.setAttribute('aria-pressed', String(on));
      }
    };

    for (const b of letters) {
      b.addEventListener('click', () => {
        letter = b.dataset.letter ?? 'ALL';
        if (letter !== 'ALL') history.replaceState(null, '', `#${letter}`);
        else history.replaceState(null, '', location.pathname + location.search);
        apply();
      });
    }
    for (const b of buttons) {
      b.addEventListener('click', () => {
        b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        apply();
      });
    }
    country?.addEventListener('change', apply);

    const fromHash = () => {
      const m = location.hash.match(/^#([A-Za-z])$/);
      letter = m ? m[1].toUpperCase() : 'ALL';
      apply();
    };
    window.addEventListener('hashchange', fromHash);
    if (/^#[A-Za-z]$/.test(location.hash)) fromHash();
  }
</script>
