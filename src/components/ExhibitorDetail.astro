---
import ExhibitorHead from './ExhibitorHead.astro';
import Slideshow from './Slideshow.astro';
import PortableText from './PortableText.astro';
import type { LocaleId } from '../lib/locales';
import { useTranslations, localePath } from '../lib/i18n';
import { countryCode } from '../lib/countries';
import { instagramUrl } from '../lib/links';
import { styleAttrs } from '../lib/textStyle';

/**
 * One exhibitor, as the design's exhibitors/analora/index.html draws it
 * (2026-09-14 build): the title band with the exhibitor's own initial
 * marked in the A–Z row; the artwork slideshow with its dots and
 * "1/3 · Artist, Title" caption on the left; on the right a ruled profile -
 * the name beside the round "solo show" badge and the booth, then the city
 * with the instagram / website pills next to "presenting" and the artists,
 * then the description in two columns. The previous / next pager that
 * walked the edition's list was removed on the client's feedback of
 * 2026-09-16; the letter row is the way back to the list.
 *
 * Used for the current edition (/exhibitors/<slug>) and past ones
 * (/exhibitors/<year>/<slug>); `listPath` is that edition's list.
 */
interface Props {
  lang: LocaleId;
  exhibitor: any;
  /** The edition's list page: 'exhibitors' or 'exhibitors/2025'. */
  listPath: string;
  /** Past editions put their year after the heading. */
  year?: number;
  /** The edition, for the catalogue tab. */
  edition?: any;
}

const { lang, exhibitor, listPath, year, edition } = Astro.props;
const t = useTranslations(lang);

const images: any[] = (exhibitor.images ?? []).filter((i: any) => i?.asset);

const code = countryCode(exhibitor.countryCode ?? exhibitor.country);
const place = [exhibitor.city, code && `(${code})`].filter(Boolean).join(' ');
/** The written list wins over the references: the design names every artist, not only the ones with a page. */
const presenting = !exhibitor.artistsText && exhibitor.artists?.length ? exhibitor.artists : null;
const badge = exhibitor.kind === 'jury-prize' ? t('exhibitors.juryPrize') : exhibitor.soloShow ? t('exhibitors.soloShow') : null;

/** "solo show" → "solo<br>show", the two-line badge of the design. */
const twoLines = (s: string) => {
  const words = String(s).trim().split(/\s+/);
  if (words.length < 2) return [s];
  const mid = Math.ceil(words.length / 2);
  return [words.slice(0, mid).join(' '), words.slice(mid).join(' ')];
};

/** First letter of the sort name, folded so "Éclat" files under E. */
const initial = (exhibitor.sortName ?? exhibitor.name ?? '')
  .normalize('NFD')
  .replace(/\p{M}/gu, '')
  .trim()
  .charAt(0)
  .toUpperCase();

/** The description runs in two columns: the first half of its paragraphs left, the rest right. */
const bio: any[] = exhibitor.bio ?? [];
const split = Math.ceil(bio.length / 2);
const bioLeft = bio.slice(0, split);
const bioRight = bio.slice(split);
---

<ExhibitorHead lang={lang} active="galleries" edition={edition} year={year} alphabet activeLetter={initial} letterHref={listPath} />

<article class="detail">
  <figure>
    <div class="artwork">
      {
        images.length ? (
          <Slideshow
            images={images}
            aspect={433 / 541}
            widths={[440, 660, 880, 1320]}
            sizes="(max-width: 900px) 100vw, 433px"
            label={exhibitor.name}
            id="artwork"
          />
        ) : (
          <div class="artwork-empty" />
        )
      }
    </div>
  </figure>

  <div class="profile">
    <header>
      <div class="title-row">
        <h2 {...styleAttrs(exhibitor.nameStyle)}>{exhibitor.name}</h2>
        {
          (badge || exhibitor.booth) && (
            <div class="booth">
              {badge && (
                <span>
                  {twoLines(badge).map((l, i) => (
                    <>
                      {i > 0 && <br />}
                      {l}
                    </>
                  ))}
                </span>
              )}
              {exhibitor.booth && <b>{exhibitor.booth} ●</b>}
            </div>
          )
        }
      </div>
      <div class="profile-meta">
        <div>
          {place && <p>{place}</p>}
          {
            (exhibitor.instagram || exhibitor.website) && (
              <nav>
                {exhibitor.instagram && (
                  <a href={instagramUrl(exhibitor.instagram)} target="_blank" rel="noopener noreferrer">
                    {t('common.instagram')} ↗
                  </a>
                )}
                {exhibitor.website && (
                  <a href={exhibitor.website} target="_blank" rel="noopener noreferrer">
                    {t('common.website')} ↗
                  </a>
                )}
              </nav>
            )
          }
        </div>
        {
          (presenting || exhibitor.artistsText) && (
            <div>
              <small>{t('exhibitors.presenting')}</small>
              <h3>
                {presenting
                  ? presenting.map((a: any, i: number) => (
                      <>
                        {i > 0 && ', '}
                        {a.slug ? <a href={localePath(lang, `artists/${a.slug}`)}>{a.name}</a> : a.name}
                      </>
                    ))
                  : exhibitor.artistsText}
              </h3>
            </div>
          )
        }
      </div>
    </header>

    {
      bio.length > 0 && (
        <div class="copy">
          <div>
            <PortableText value={bioLeft} fieldStyle={exhibitor.bioStyle} />
          </div>
          {bioRight.length > 0 && (
            <div>
              <PortableText value={bioRight} fieldStyle={exhibitor.bioStyle} />
            </div>
          )}
        </div>
      )
    }
  </div>

</article>

<style>
  /* From the design's exhibitors/analora/index.html (2026-09-14 build).
     Client feedback, 2026-09-16: every text on the page is black (the block
     used to be `.meta`, which Base.astro's global rule greyed), and the city,
     "presenting …" and booth lines are set tighter. */
  .detail {
    grid-template-columns: 433px minmax(0, 1fr);
    gap: 40px;
    padding: 48px var(--gutter) 105px;
    display: grid;
  }
  .detail figure {
    margin: 0;
  }
  .artwork {
    position: relative;
  }
  .artwork :global(img),
  .artwork-empty {
    object-fit: cover;
    width: 100%;
    aspect-ratio: 433 / 541;
    background: #f5f5f5;
  }
  .artwork :global(figcaption) {
    margin-top: 3px;
    font-size: 15px;
  }
  .profile {
    border-top: 1px solid;
    padding-top: 10px;
  }
  .title-row {
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    display: flex;
  }
  .title-row h2 {
    letter-spacing: -0.05em;
    font-size: 58px;
    font-weight: 400;
    line-height: 1;
  }
  .booth {
    align-items: center;
    flex: none;
    gap: 45px;
    display: flex;
  }
  .booth span {
    color: #fff;
    text-align: center;
    background: #000;
    border-radius: 50%;
    place-items: center;
    width: 60px;
    height: 60px;
    font-size: 13px;
    line-height: 0.85;
    display: grid;
  }
  .booth b {
    font-size: 38px;
    font-weight: 400;
    letter-spacing: -0.04em;
  }
  .profile-meta {
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 12px;
    display: grid;
  }
  .profile-meta p,
  .profile-meta h3 {
    font-size: 38px;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  .profile-meta nav {
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 28px;
    display: flex;
  }
  .profile-meta nav a {
    border: 1px solid;
    border-radius: 999px;
    padding: 4px 15px;
    font-size: 19px;
    transition:
      color 0.18s,
      background-color 0.18s;
  }
  .profile-meta nav a:hover {
    color: #fff;
    background: #050505;
  }
  .profile-meta small {
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  .artwork :global(.credit) {
    color: inherit;
  }
  .copy {
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 50px;
    font-size: 22px;
    line-height: 1.25;
    letter-spacing: -0.03em;
    display: grid;
  }
  .copy :global(p + p) {
    margin-top: 32px;
  }
  @media (width<=900px) {
    .detail {
      grid-template-columns: 1fr;
    }
    .profile {
      margin-top: 20px;
    }
  }
  @media (width<=640px) {
    .detail {
      padding: 30px var(--gutter) 70px;
    }
    .title-row {
      align-items: start;
    }
    .title-row h2 {
      font-size: 42px;
    }
    .booth {
      gap: 8px;
    }
    .booth b {
      font-size: 24px;
    }
    .booth span {
      width: 50px;
      height: 50px;
      font-size: 13px;
    }
    .profile-meta,
    .copy {
      grid-template-columns: 1fr;
    }
    .profile-meta p,
    .profile-meta h3 {
      font-size: 30px;
    }
    .copy {
      font-size: 18px;
    }
  }
</style>
