---
import SanityImage from './SanityImage.astro';
import Slideshow from './Slideshow.astro';
import PortableText from './PortableText.astro';
import type { LocaleId } from '../lib/locales';
import { useTranslations, localePath } from '../lib/i18n';
import { countryCode } from '../lib/countries';
import { instagramUrl, exhibitorPath } from '../lib/links';
import { styleAttrs } from '../lib/textStyle';

/**
 * One exhibitor, as the design's exhibitors/chaxartxrtm/index.html draws
 * it: the artwork slideshow with its dots and "1/6 · Artist, Title, year"
 * caption on the left; on the right a ruled header with the name,
 * "City (CC) ● booth", the instagram / website pills and "presenting" with
 * the artists, then the description in two columns; previous / next along
 * the bottom, walking the same alphabetical list as the edition's index.
 *
 * Used for the current edition (/exhibitors/<slug>) and past ones
 * (/exhibitors/<year>/<slug>); `list` and `listPath` are that edition's.
 */
interface Props {
  lang: LocaleId;
  exhibitor: any;
  /** The edition's exhibitors, in list order, for previous / next. */
  list: any[];
  /** The edition's list page: 'exhibitors' or 'exhibitors/2025'. */
  listPath: string;
  /** Past editions put their year after the heading. */
  year?: number;
}

const { lang, exhibitor, list, listPath, year } = Astro.props;
const t = useTranslations(lang);

const images: any[] = (exhibitor.images ?? []).filter((i: any) => i?.asset);

const index = list.findIndex((ex: any) => ex._id === exhibitor._id);
const previous = index > 0 ? list[index - 1] : null;
const next = index >= 0 && index < list.length - 1 ? list[index + 1] : null;

const code = countryCode(exhibitor.countryCode ?? exhibitor.country);
const place = [exhibitor.city, code && `(${code})`].filter(Boolean).join(' ');
/** The written list wins over the references: the design names every artist, not only the ones with a page. */
const presenting = !exhibitor.artistsText && exhibitor.artists?.length ? exhibitor.artists : null;

/** The description runs in two columns: the first half of its paragraphs left, the rest right. */
const bio: any[] = exhibitor.bio ?? [];
const split = Math.ceil(bio.length / 2);
const bioLeft = bio.slice(0, split);
const bioRight = bio.slice(split);
---

<div class="page-grid py-2 md:py-4">
  <h1 class="col-span-full text-[clamp(2rem,4.8vw,4.4rem)] font-semibold leading-none tracking-[-.04em]">
    {t('nav.exhibitors').toLowerCase()}{year && ` ${year}`}
  </h1>
</div>
<article class="page-grid exhibitor-detail">
  <div class="artwork">
    <div class="relative">
      {
        images.length ? (
          <Slideshow
            images={images}
            aspect={433 / 541}
            widths={[440, 660, 880, 1320, 1760]}
            sizes="(max-width: 1000px) 100vw, calc((100vw - 390px) / 3 + 90px)"
            label={exhibitor.name}
            id="artwork"
          />
        ) : (
          <div class="artwork-empty" />
        )
      }
      {
        (exhibitor.soloShow || exhibitor.kind === 'jury-prize') && (
          <span class="absolute right-3 top-3 grid h-16 w-16 place-items-center rounded-full bg-black text-center text-sm leading-[.9] text-white">
            {exhibitor.kind === 'jury-prize' ? t('exhibitors.juryPrize') : t('exhibitors.soloShow')}
          </span>
        )
      }
    </div>
  </div>

  <div class="profile">
    <header>
      <div>
        <h2 {...styleAttrs(exhibitor.nameStyle)}>{exhibitor.name}</h2>
        {
          (place || exhibitor.booth) && (
            <p>
              {place}
              {place && exhibitor.booth && <br />}
              {exhibitor.booth && <>● {exhibitor.booth}</>}
            </p>
          )
        }
        {
          (exhibitor.instagram || exhibitor.website) && (
            <nav>
              {exhibitor.instagram && (
                <a href={instagramUrl(exhibitor.instagram)} target="_blank" rel="noopener noreferrer">
                  {t('common.instagram')} ↗
                </a>
              )}
              {exhibitor.website && (
                <a href={exhibitor.website} target="_blank" rel="noopener noreferrer">
                  {t('common.website')} ↗
                </a>
              )}
            </nav>
          )
        }
      </div>
      {
        (presenting || exhibitor.artistsText) && (
          <div>
            <small>{t('exhibitors.presenting')}</small>
            <h3>
              {presenting
                ? presenting.map((a: any, i: number) => (
                    <>
                      {i > 0 && ', '}
                      {a.slug ? <a href={localePath(lang, `artists/${a.slug}`)}>{a.name}</a> : a.name}
                    </>
                  ))
                : exhibitor.artistsText}
            </h3>
          </div>
        )
      }
    </header>

    {
      bio.length > 0 && (
        <div class="copy">
          <div>
            <PortableText value={bioLeft} fieldStyle={exhibitor.bioStyle} />
          </div>
          {bioRight.length > 0 && (
            <div>
              <PortableText value={bioRight} fieldStyle={exhibitor.bioStyle} />
            </div>
          )}
        </div>
      )
    }
  </div>

  <nav class="pager" aria-label={t('nav.exhibitors')}>
    {
      previous ? (
        <a href={localePath(lang, exhibitorPath(previous))}>
          ← <span>{t('exhibitors.previous')}</span>
        </a>
      ) : (
        <a href={localePath(lang, listPath)}>
          ← <span>{t('exhibitors.backToAll')}</span>
        </a>
      )
    }
    {
      next ? (
        <a href={localePath(lang, exhibitorPath(next))}>
          <span>{t('exhibitors.next')}</span> →
        </a>
      ) : (
        <a href={localePath(lang, listPath)}>
          <span>{t('exhibitors.backToAll')}</span> →
        </a>
      )
    }
  </nav>
</article>

<style>
  /*
   * From the design's exhibitors pages. The frame measures the two columns as
   * 433px and 907px, which is columns 1-4 and 5-12 of the 12-column page-grid
   * at the 1440px frame width; analora/index.html draws the same two columns
   * as `col-span-4` and `col-span-8`. Taking them from the grid rather than
   * pinning the pixels is what lets the page fill a wider window, and the type
   * is clamped so it grows with it (the clamps are analora's, capped at the
   * pixel sizes the chaxartxrtm frame measures).
   */
  .exhibitor-detail {
    min-height: 1009px;
    padding-top: 14px;
    /* Room for the pager, which is pinned to the bottom of the frame. */
    padding-bottom: 100px;
    position: relative;
  }
  .artwork {
    grid-column: span 4;
    margin: 0;
  }
  .artwork-empty {
    aspect-ratio: 433 / 541;
    width: 100%;
    background: #f5f5f5;
  }
  .profile {
    grid-column: span 8;
  }
  /* 434px + 40px + 433px inside the frame's 907px: two equal columns. */
  .profile header {
    border-top: 2px solid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
    padding-top: 12px;
    display: grid;
  }
  .profile h2 {
    letter-spacing: -0.05em;
    font-size: clamp(2rem, 4vw, 3.75rem);
    line-height: 1;
  }
  .profile header p,
  .profile h3 {
    letter-spacing: -0.04em;
    font-size: clamp(1.35rem, 2.7vw, 2.5rem);
    line-height: 1.05;
  }
  .profile header p {
    margin-top: 12px;
  }
  .profile small {
    font-size: clamp(1rem, 1.7vw, 1.5rem);
  }
  .profile nav {
    flex-wrap: wrap;
    gap: 40px;
    margin-top: 26px;
    display: flex;
  }
  .profile nav a {
    border: 1px solid;
    border-radius: 999px;
    padding: 3px 18px;
    font-size: clamp(1.1rem, 2vw, 1.75rem);
    line-height: 1.28;
  }
  .copy {
    letter-spacing: -0.03em;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
    margin-top: 37px;
    font-size: clamp(1.05rem, 1.7vw, 1.5rem);
    line-height: 1.25;
    display: grid;
  }
  .copy :global(p + p) {
    margin-top: 28px;
  }
  .pager {
    justify-content: space-between;
    font-size: clamp(1.75rem, 3.5vw, 3.125rem);
    display: flex;
    position: absolute;
    bottom: 20px;
    left: 30px;
    right: 30px;
  }
  .pager span {
    font-size: clamp(1.4rem, 2.8vw, 2.5rem);
  }
  /* Below the frame the two columns stack, whether the grid has 12 or 4. */
  @media (width<=1000px) {
    .exhibitor-detail {
      min-height: 0;
      padding-bottom: 0;
    }
    .artwork,
    .profile,
    .pager {
      grid-column: 1 / -1;
    }
    .profile {
      margin-top: 32px;
    }
    .profile header,
    .copy {
      grid-template-columns: minmax(0, 1fr);
    }
    .profile h2 {
      font-size: clamp(2rem, 6vw, 2.625rem);
    }
    .profile header p,
    .profile h3 {
      font-size: clamp(1.35rem, 4vw, 1.75rem);
    }
    .copy {
      font-size: clamp(1.05rem, 2.4vw, 1.125rem);
      line-height: 1.3;
    }
    .pager {
      margin-top: 60px;
      position: static;
    }
    .pager,
    .pager span {
      font-size: clamp(1.4rem, 4vw, 1.75rem);
    }
  }
</style>
