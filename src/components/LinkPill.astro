---
import type { LocaleId } from '../lib/locales';
import { resolveLink, type ResolvedLink } from '../lib/links';

/**
 * The design's link treatments: an outline pill ("instagram ↗", "website ↗"),
 * the black solid pill of the calls to action ("book your tickets ↗") and an
 * underlined text link. The arrow is "→" for internal links and "↗" for
 * external ones. Pass either a Sanity `link` object or a plain href + label.
 */
interface Props {
  lang: LocaleId;
  link?: any;
  href?: string;
  label?: string;
  external?: boolean;
  variant?: 'pill' | 'text' | 'solid';
  /**
   * Keep the label's own capitals. The design sets pill labels lowercase,
   * but not where the label is a name - "discover The Hoxton ↗", "discover
   * MAD Brussels ↗" on the VIP frames.
   *
   * **Defaults to whether the label is the editor's.** A `link` object's
   * label is typed in the Studio, so it keeps its capitals; a `label` passed
   * by a component is one of ours from `STRINGS`, written with a capital
   * ("Website", "View all") and lowercased by the design. Félicie could not
   * capitalise "discover Puilaetco" or "discover MAD Brussels" because every
   * pill was forced down (client, 2026-09-30). Pass it explicitly to
   * override either way.
   */
  preserveCase?: boolean;
  class?: string;
}

const { lang, link, href, label, external, variant = 'pill', preserveCase, class: className } = Astro.props;
/** The editor's text keeps its case; ours takes the design's lowercase. */
const keepCase = preserveCase ?? !!link;

const resolved: ResolvedLink | null = link
  ? resolveLink(lang, link)
  : href
    ? { href, label: label ?? href, external: external ?? /^https?:\/\//.test(href), arrow: external ?? /^https?:\/\//.test(href) ? '↗' : '→' }
    : null;
---

{
  resolved && (
    <a
      class:list={['link', variant, { caps: keepCase }, className]}
      href={resolved.href}
      {...(resolved.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >
      {resolved.label}&nbsp;<span class="arrow" aria-hidden="true">{resolved.arrow}</span>
    </a>
  )
}

<style>
  .link {
    display: inline-block;
    color: var(--ink);
    line-height: 1.3;
  }

  /* Outline pill, as on the exhibitor, artist and partner pages. The design
     sets these labels lowercase; some callers pass title-case strings that
     double as headings elsewhere. */
  .pill,
  .solid {
    border: 1px solid currentColor;
    border-radius: 999px;
    /* The site's one pill size (Base.astro, client feedback 2026-09-23). */
    padding: var(--pill-pad);
    font-size: var(--pill-size);
    line-height: var(--pill-lh);
    letter-spacing: var(--pill-ls);
    text-transform: lowercase;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .caps {
    text-transform: none;
  }
  .pill:hover,
  .pill:focus-visible {
    background: var(--acid);
  }

  /* The black call-to-action pill: "book your tickets ↗", "discover the hotel ↗". */
  .solid {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--ground);
  }
  .solid:hover,
  .solid:focus-visible {
    background: var(--acid);
    border-color: var(--acid);
    color: var(--ink);
  }

  .text {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  @media (prefers-reduced-motion: reduce) {
    .pill,
    .solid {
      transition: none;
    }
  }
</style>
