---
import type { LocaleId } from '../lib/locales';
import PortableText from './PortableText.astro';
import SanityImage from './SanityImage.astro';
import LinkPill from './LinkPill.astro';
import { styleAttrs } from '../lib/textStyle';

/**
 * Renders a list of `contentSection` objects the way the design draws a hub
 * text block (art prize "the prize", about "the fair"): a lowercase
 * `.panel-title` over a 2px rule, then `.body-24` copy, an optional row of
 * images and a row of pill links. Classes and sizes are the design's
 * (`.panel-title`, `.body-24` and `.two-col` live in design.css).
 *
 * `columns` is how many sections share a row - the design's `.two-col`
 * ("the prize" beside "applications"). `textColumns` is how the copy flows
 * inside one section: 2 runs it in two CSS columns, 1 keeps a single one.
 * `statementFirst` renders the first paragraph at the design's 40px
 * `.statement` size, as the art prize about page does.
 */
interface Props {
  lang: LocaleId;
  sections: any[] | undefined;
  columns?: 1 | 2;
  textColumns?: 1 | 2;
  statementFirst?: boolean;
  class?: string;
}

const { lang, sections = [], columns = 1, statementFirst = false, class: className } = Astro.props;
const textColumns = Astro.props.textColumns ?? 1;
const list = (sections ?? []).filter(Boolean);
---

{
  list.length > 0 && (
    <div class:list={['sections', { 'two-col': columns === 2, 'text-2': textColumns === 2, statement: statementFirst }, className]}>
      {list.map((section: any) => {
        const images = (section.images ?? []).filter((img: any) => img?.asset);
        const links = (section.links ?? []).filter(Boolean);
        return (
          <section id={section.anchor || undefined}>
            {section.heading && (
              <h2 class="panel-title" {...styleAttrs(section.headingStyle)}>
                {section.heading}
              </h2>
            )}
            {section.body && (
              <div class="body-24 cs-body" {...styleAttrs(section.bodyStyle)}>
                <PortableText value={section.body} fieldStyle={section.bodyStyle} />
              </div>
            )}
            {images.length > 0 && (
              <ul class="cs-images" data-count={Math.min(images.length, 3)}>
                {images.map((img: any) => (
                  <li>
                    <SanityImage image={img} aspect={1.5} sizes="(max-width: 640px) 100vw, (max-width: 900px) 50vw, 33vw" widths={[400, 600, 900, 1200]} />
                  </li>
                ))}
              </ul>
            )}
            {links.length > 0 && (
              <p class="cs-links">
                {links.map((link: any) => (
                  <LinkPill lang={lang} link={link} />
                ))}
              </p>
            )}
          </section>
        );
      })}
    </div>
  )
}

<style>
  .sections {
    display: grid;
    gap: 55px 40px;
  }
  .sections section {
    min-width: 0;
  }
  .text-2 .cs-body {
    columns: 2;
    column-gap: 40px;
  }
  .cs-body :global(p) {
    break-inside: avoid;
  }
  /* The design's .statement: the opening line at 40px. */
  .statement .cs-body :global(.rich-text > p:first-child) {
    font-size: 40px;
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin-bottom: 28px;
  }
  .cs-body :global(h2),
  .cs-body :global(h3),
  .cs-body :global(h4) {
    margin: 1.5rem 0 0.5rem;
    font-size: 1em;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .cs-body :global(a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }
  /* Bulleted lines carry the design's "↘" instead of a disc. */
  .cs-body :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
  }
  .cs-body :global(ul li) {
    padding-left: 1.5em;
    text-indent: -1.5em;
    break-inside: avoid;
  }
  .cs-body :global(ul li::before) {
    content: '↘';
    display: inline-block;
    width: 1.5em;
    text-indent: 0;
  }
  .cs-body :global(ol) {
    padding-left: 1.5em;
    margin: 0 0 28px;
  }
  .cs-images {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
  }
  .cs-images[data-count='1'] {
    grid-template-columns: 1fr;
  }
  .cs-images[data-count='2'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .cs-images :global(img) {
    width: 100%;
  }
  .cs-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 28px 0 0;
  }
  @media (width<=900px) {
    .text-2 .cs-body {
      columns: 1;
    }
    .cs-images,
    .cs-images[data-count='2'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }
  @media (width<=700px) {
    .sections {
      gap: 40px 28px;
    }
    .statement .cs-body :global(.rich-text > p:first-child) {
      font-size: 28px;
    }
    .cs-images,
    .cs-images[data-count='2'] {
      grid-template-columns: 1fr;
    }
  }
</style>
