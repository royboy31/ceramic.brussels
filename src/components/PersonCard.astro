---
import type { LocaleId } from '../lib/locales';
import { useTranslations } from '../lib/i18n';
import { instagramUrl } from '../lib/links';
import PortableText from './PortableText.astro';
import SanityImage from './SanityImage.astro';
import { styleAttrs } from '../lib/textStyle';

/**
 * One person of the advisory board, the team or the jury, as the design's
 * advisory-board page draws it: the name over a rule, the portrait (with
 * its credit) on the left, the role in capitals, the biography, then the
 * instagram / website pills. Lives inside a `.people` grid (the page or
 * People.astro).
 *
 * The design's contact page draws two more shapes:
 * - `contact` (the directors): the same card, with the e-mail as an
 *   underlined link and the phone as a line of text under the biography.
 * - `team` (the rest of the team): no title rule - the name in capitals
 *   heads the text column, then the role, e-mail and phone; no biography.
 */
interface Props {
  lang: LocaleId;
  person: any;
  variant?: 'board' | 'contact' | 'team';
  class?: string;
}

const { lang, person, variant = 'board', class: className } = Astro.props;
const t = useTranslations(lang);
const board = variant === 'board';
const team = variant === 'team';
const credit = person.portrait?.asset ? person.portrait.credit : null;
const pills = person.instagram || person.website || (board && (person.email || person.phone));
const contactLines = !board && (person.email || person.phone);
---

<article class:list={[className, `is-${variant}`]}>
  {!team && <h2>{person.name}</h2>}
  <div>
    <figure>
      {
        person.portrait?.asset ? (
          <SanityImage
            image={person.portrait}
            widths={[200, 400]}
            sizes="197px"
            aspect={board ? undefined : 197 / 270}
          />
        ) : (
          <div class="no-portrait" aria-hidden="true" />
        )
      }
      {credit && <figcaption>© {credit}</figcaption>}
    </figure>
    <section>
      {team && <h3>{person.name}</h3>}
      {
        person.role && (
          <p class="role" {...styleAttrs(person.roleStyle)}>
            {person.role}
          </p>
        )
      }
      {!team && person.bio && <PortableText value={person.bio} fieldStyle={person.bioStyle} />}
      {
        contactLines && (
          <p class="contact">
            {person.email && (
              <a class="text-link" href={`mailto:${person.email}`}>
                {`${person.email}\u00a0↗`}
              </a>
            )}
            {person.phone && <span>{person.phone}</span>}
          </p>
        )
      }
      {
        pills && (
          <p class="links">
            {person.instagram && (
              <a class="pill" href={instagramUrl(person.instagram)} target="_blank" rel="noopener noreferrer">
                {t('common.instagram')} ↗
              </a>
            )}
            {person.website && (
              <a class="pill" href={person.website} target="_blank" rel="noopener noreferrer">
                {t('common.website')} ↗
              </a>
            )}
            {board && person.email && (
              <a class="pill" href={`mailto:${person.email}`}>
                {person.email}
              </a>
            )}
            {board && person.phone && (
              <a class="pill" href={`tel:${person.phone.replace(/[\s.]+/g, '')}`}>
                {person.phone}
              </a>
            )}
          </p>
        )
      }
    </section>
  </div>
</article>

<style>
  /* From the design's advisory-board page (`.people article`). */
  /* Title rule as on the guest of honour page (client feedback, 2026-09-16). */
  h2 {
    letter-spacing: -0.04em;
    border-bottom: 2px solid;
    font-size: 36px;
    font-weight: 600;
    line-height: 1.2;
  }
  article > div {
    grid-template-columns: 197px 1fr;
    gap: 40px;
    margin-top: 32px;
    display: grid;
  }
  figure {
    margin: 0;
  }
  article :global(img),
  .no-portrait {
    object-fit: cover;
    width: 197px;
    max-height: 270px;
  }
  .no-portrait {
    height: 270px;
    background: var(--surface-2);
  }
  /* "© Somebody's Name" under the portrait. */
  figcaption {
    margin-top: 6px;
    font-size: 16px;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  section {
    font-size: 24px;
    line-height: 1.25;
    letter-spacing: -0.03em;
  }
  /* Two capital lines ("PRESIDENT / LES AMIS DU MUSÉE…"): an editor's line
     break in the role is kept. */
  .role {
    white-space: pre-line;
    text-transform: uppercase;
    letter-spacing: 0;
    font-size: 24px;
    font-weight: 600;
    line-height: 30px;
    margin-bottom: 13px;
  }
  section :global(.rich-text p + p) {
    margin-top: 30px;
  }
  /* The small "website ↗" pill of the design, not the 24px site pill. */
  .links {
    flex-wrap: wrap;
    gap: 10px 14px;
    margin-top: 32px;
    display: flex;
  }
  .links .pill {
    padding: 2px 14px;
    font-size: 18px;
    line-height: 25px;
  }
  /* Contact page: e-mail link ↗ and phone, a line each. */
  .contact {
    margin-top: 30px;
    line-height: 35px;
  }
  .contact > * {
    display: block;
  }
  .contact a {
    width: fit-content;
  }
  .role:first-child + .contact {
    margin-top: 18px;
  }
  .contact + .links {
    margin-top: 20px;
  }

  /* The contact page's directors: every portrait the same 197×270 box. */
  .is-contact :global(img),
  .is-team :global(img) {
    height: 270px;
  }

  /* The contact page's team: no title rule, the name heads the text. */
  .is-team > div {
    margin-top: 0;
  }
  .is-team h3 {
    text-transform: uppercase;
    letter-spacing: 0;
    font-size: 24px;
    font-weight: 600;
    line-height: 30px;
  }
  .is-team .role {
    text-transform: none;
    letter-spacing: -0.03em;
    font-weight: 400;
    margin: 9px 0 0;
  }
  .is-team .contact {
    margin-top: 26px;
  }
  @media (width<=800px) {
    article > div {
      grid-template-columns: 120px 1fr;
      gap: 18px;
    }
    article :global(img),
    .no-portrait {
      width: 120px;
    }
    .is-contact :global(img),
    .is-team :global(img),
    .no-portrait {
      height: 164px;
    }
    h2 {
      font-size: 28px;
    }
    figcaption {
      font-size: 13px;
    }
    section {
      font-size: 18px;
    }
    section :global(.rich-text p + p) {
      margin-top: 1em;
    }
    .role,
    .is-team h3 {
      font-size: 17px;
      line-height: 1.35;
    }
    .is-team .role {
      font-size: 18px;
    }
    .contact {
      line-height: 1.5;
      overflow-wrap: anywhere;
    }
  }
</style>
