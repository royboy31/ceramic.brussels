---
import type { LocaleId } from '../lib/locales';
import { useTranslations } from '../lib/i18n';
import { instagramUrl } from '../lib/links';
import PortableText from './PortableText.astro';
import SanityImage from './SanityImage.astro';
import { styleAttrs } from '../lib/textStyle';

/**
 * One person of the advisory board, the team or the jury, as the design's
 * advisory-board page draws it: the name over a rule, the portrait on the
 * left, the role in bold, the biography, then the instagram / website
 * pills. Lives inside a `.people` grid (the page or People.astro).
 */
interface Props {
  lang: LocaleId;
  person: any;
  class?: string;
}

const { lang, person, class: className } = Astro.props;
const t = useTranslations(lang);
const hasLinks = person.instagram || person.website || person.email || person.phone;
---

<article class={className}>
  <h2>{person.name}</h2>
  <div>
    {
      person.portrait?.asset ? (
        <SanityImage image={person.portrait} widths={[200, 400]} sizes="197px" />
      ) : (
        <div class="no-portrait" aria-hidden="true" />
      )
    }
    <section>
      {person.role && <strong {...styleAttrs(person.roleStyle)}>{person.role}</strong>}
      {person.bio && <PortableText value={person.bio} fieldStyle={person.bioStyle} />}
      {
        hasLinks && (
          <p class="links">
            {person.instagram && (
              <a class="pill" href={instagramUrl(person.instagram)} target="_blank" rel="noopener noreferrer">
                {t('common.instagram')} ↗
              </a>
            )}
            {person.website && (
              <a class="pill" href={person.website} target="_blank" rel="noopener noreferrer">
                {t('common.website')} ↗
              </a>
            )}
            {person.email && (
              <a class="pill" href={`mailto:${person.email}`}>
                {person.email}
              </a>
            )}
            {person.phone && (
              <a class="pill" href={`tel:${person.phone.replace(/[\s.]+/g, '')}`}>
                {person.phone}
              </a>
            )}
          </p>
        )
      }
    </section>
  </div>
</article>

<style>
  /* From the design's advisory-board page (`.people article`). */
  h2 {
    letter-spacing: -0.04em;
    border-bottom: 1px solid;
    font-size: 36px;
    font-weight: 600;
  }
  article > div {
    grid-template-columns: 197px 1fr;
    gap: 40px;
    margin-top: 28px;
    display: grid;
  }
  article :global(img),
  .no-portrait {
    object-fit: cover;
    width: 197px;
    max-height: 270px;
  }
  .no-portrait {
    height: 270px;
    background: #f0efed;
  }
  section {
    font-size: 24px;
    line-height: 1.22;
  }
  section :global(p) {
    margin-top: 16px;
  }
  .links {
    gap: 14px;
    display: flex;
  }
  @media (width<=800px) {
    article > div {
      grid-template-columns: 120px 1fr;
      gap: 18px;
    }
    article :global(img),
    .no-portrait {
      width: 120px;
    }
    h2 {
      font-size: 28px;
    }
  }
</style>
