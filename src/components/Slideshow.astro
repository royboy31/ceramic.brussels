---
import SanityImage from './SanityImage.astro';

/**
 * The design's image carousel: one frame, dots on the picture, and a caption
 * line underneath with the counter ("1/5") at the left and the caption
 * ("Artist, *Title*, 2024 © credit") at the right.
 *
 * Works without JavaScript as a scroll-snap row - swipe, scroll, or use the
 * dots, which are plain anchors to each slide. Each slide carries its own
 * counter and caption, so they always match what is in view. The script only
 * smooths the dot clicks and keeps the active dot in step with scrolling,
 * and - with a mouse - turns the pointer into the big Noi Grotesk arrow of
 * the client's feedback (2026-09-16): ← over the left half of the picture,
 * → over the right, and a click moves one picture that way.
 */
interface Props {
  images: any[] | undefined;
  aspect?: number;
  /**
   * 'cover' (default) crops every picture to `aspect`. 'contain' keeps the
   * frame at `aspect` but draws each picture whole, in its own shape, hung
   * from the frame's top edge: portrait stays portrait, landscape stays
   * landscape (Tiphaine, 2026-09-25), nothing is cropped and blown up, and
   * every slide starts at the same height (client, 2026-09-30).
   */
  fit?: 'cover' | 'contain';
  /**
   * Milliseconds between slides for a slideshow that moves by itself
   * (homepage features, Tiphaine 2026-09-24). It waits while the pointer or
   * focus is on it or it is off screen, and never runs for reduced motion.
   */
  autoplay?: number;
  sizes?: string;
  widths?: number[];
  /** Accessible name for the dots group - usually the document's title. */
  label?: string;
  /** Prefix for the slide ids the dots link to. One slideshow per page needs no change. */
  id?: string;
  /**
   * Below 700px the picture runs to both screen edges, out through
   * `.content-wrap`'s gutter (client, 2026-09-30: "make these
   * photos/slideshows the whole width of the page"). On by default: a
   * slideshow is always an editorial photograph. The one exception the
   * client named - jury and advisory board - draws its portraits with
   * `PersonCard`, not this, so it needs no opt-out. `bleed={false}` is
   * there for a slideshow that must keep the gutter.
   */
  bleed?: boolean;
  class?: string;
}

const {
  images = [],
  aspect,
  fit = 'cover',
  autoplay,
  sizes = '(max-width: 640px) 100vw, 33vw',
  widths = [400, 600, 900, 1200],
  label,
  id = 'slideshow',
  bleed = true,
  class: className,
} = Astro.props;

const slides = (images ?? []).filter((img) => img?.asset);
const slideId = (i: number) => `${id}-${i + 1}`;
const contain = fit === 'contain' && !!aspect;
---

{
  slides.length > 0 ? (
    <div
      class:list={['slideshow', className, { 'no-aspect': !aspect, contain, 'bleed-m': bleed }]}
      id={id}
      data-slides={slides.length}
      data-autoplay={autoplay && slides.length > 1 ? autoplay : undefined}
      style={aspect ? `--aspect: ${aspect}` : undefined}
    >
      <div class="track" data-track tabindex={slides.length > 1 ? 0 : undefined}>
        {slides.map((img, i) => (
          <figure class="slide" id={slideId(i)} data-slide>
            {contain ? (
              <div class="frame">
                <SanityImage
                  image={img}
                  sizes={sizes}
                  widths={widths}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  placeholder={false}
                />
              </div>
            ) : (
              <SanityImage
                image={img}
                aspect={aspect}
                sizes={sizes}
                widths={widths}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            )}
            <figcaption>
              <span class="counter">
                {i + 1}/{slides.length}
              </span>
              <span class="caption">
                {img.caption}
                {img.workTitle && (
                  <>
                    {img.caption ? ', ' : ''}
                    <em>{img.workTitle}</em>
                  </>
                )}
                {img.year && `, ${img.year}`}
                {img.credit && <span class="credit"> © {img.credit}</span>}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>

      {slides.length > 1 && (
        <span class="cursor-arrow" data-cursor aria-hidden="true" hidden />
      )}
      {slides.length > 1 && (
        <div class="dots" role="group" aria-label={label}>
          {slides.map((_, i) => (
            <a
              href={`#${slideId(i)}`}
              data-dot
              aria-label={`${i + 1} / ${slides.length}`}
              aria-current={i === 0 ? 'true' : undefined}
            />
          ))}
        </div>
      )}
    </div>
  ) : null
  /* No pictures, nothing drawn: the stand-in pools went on 2026-09-22 (see Figure.astro). */
}

<style>
  .slideshow {
    position: relative;
  }

  /* The frame: one slide wide, snapping, no visible scrollbar. */
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .slide {
    flex: 0 0 100%;
    min-width: 0;
    margin: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .slide :global(img) {
    width: 100%;
  }
  /* fit="contain": every frame the same box, the picture whole inside it. */
  .frame {
    aspect-ratio: var(--aspect);
  }
  /* Top, not bottom: "can you align the pictures on the galleries pages so
     that they align 'to the top' and not to the bottom? So that when you go
     through the slideshow they all start at the same place?" (client,
     2026-09-30). This reverses Tiphaine's 2026-09-25 note, which asked for
     the frame's bottom edge - the pictures still keep their own shape and
     are still never cropped, they just hang from the top now. */
  .frame :global(img) {
    height: 100%;
    object-fit: contain;
    object-position: center top;
  }

  /* Counter left, caption right - the line under the picture in the design. */
  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    /* Close under the picture (client feedback, 2026-09-16), but not
       touching it: 2026-09-23 found the counter too close, everywhere. */
    margin-top: 8px;
    font-size: 0.875rem;
    line-height: 1.3;
    /* Tighter captions, everywhere (client feedback, 2026-09-24). */
    letter-spacing: -0.025em;
  }
  /* The counter at the frames' size (22px), the caption line beside it
     unchanged. Proportional figures: each slide has its own counter, so
     nothing jumps, and tabular ones spread "1/1" apart. */
  .counter {
    flex: 0 0 auto;
    font-size: 22px;
    line-height: 1;
  }
  /* One picture is not a carousel: the frames only ever print the counter
     where there is something to count, and "1/1" reads as a mistake. */
  .slideshow[data-slides='1'] .counter {
    display: none;
  }
  .caption {
    text-align: right;
  }
  .credit {
    color: var(--ink-3);
  }

  /* The dots sit on the picture. A box with the same aspect as the image,
     laid over the top of the slideshow, puts them at the picture's bottom
     edge without knowing how tall the caption below it is. */
  .dots {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    aspect-ratio: var(--aspect);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 17px;
    padding-bottom: 16px;
    pointer-events: none;
  }
  .no-aspect .dots {
    position: static;
    aspect-ratio: auto;
    padding: 0.5rem 0 0;
  }
  /* White dots as the frames draw them: the current one solid, the others
     see-through. */
  .dots a {
    pointer-events: auto;
    width: 12px;
    height: 12px;
    padding: 0;
    border-radius: 50%;
    background: var(--color-white);
    opacity: 0.45;
    transition: opacity 0.18s;
  }
  .dots a[aria-current],
  .dots a:hover {
    opacity: 1;
  }
  /* Without an aspect the dots sit under the picture, on the page: ink. */
  .no-aspect .dots a {
    background: var(--ink);
  }
  .dots a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  /* The arrow that stands in for the pointer over the pictures. It follows
     the mouse, centred on it, and never takes a click itself. */
  .cursor-arrow {
    position: absolute;
    z-index: 3;
    top: 0;
    left: 0;
    translate: -50% -50%;
    pointer-events: none;
    font-family: var(--font-sans, 'Noi Grotesk', sans-serif);
    /* Smaller than it was (client feedback, 2026-09-23). */
    font-size: clamp(40px, 3.8vw, 58px);
    font-weight: 400;
    line-height: 1;
    color: var(--ink);
  }
  .slideshow.arrow-cursor .track {
    cursor: none;
  }

  /* Tighter to the picture on a phone. The caption and mark *sizes* are set
     once in src/styles/site.css - parents reach into this component's
     figcaption with higher specificity, so they cannot live here. */
  @media (width <= 700px) {
    figcaption {
      margin-top: 6px;
    }
  }

  /* One caption at a time. The track scrolls horizontally, so during a swipe
     the next slide's caption used to arrive beside the current one and the
     two read as a single run-on line. Both rules hang off
     `[data-one-caption]`, which the script sets only once it has marked a
     slide - so with no JavaScript nothing is hidden. */
  .slideshow[data-one-caption] .slide figcaption {
    transition: opacity 0.18s ease;
  }
  .slideshow[data-one-caption] .slide:not([data-current]) figcaption {
    opacity: 0;
  }
</style>

<script>
  // Progressive enhancement: smooth the dot clicks and keep the active dot in
  // step when someone swipes. Without this, the dots are anchors and the row
  // still scrolls.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('.slideshow[data-slides]').forEach((show) => {
    const track = show.querySelector<HTMLElement>('[data-track]');
    const slides = [...show.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...show.querySelectorAll<HTMLAnchorElement>('[data-dot]')];
    if (!track || slides.length < 2) return;

    /* Marks the dot **and the slide**. Each slide carries its own caption, so
       mid-swipe two of them were on screen at once and read as one run-on
       line - "when scrolling right & left in the slideshows, it appears the
       captions are sticking to each other ... it happens everywhere on the
       website" (client, 2026-09-30). Only the slide in view shows its
       caption now; the CSS fades the others. */
    const mark = (index: number) => {
      dots.forEach((dot, i) =>
        i === index ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current'),
      );
      slides.forEach((slide, i) =>
        i === index ? slide.setAttribute('data-current', '') : slide.removeAttribute('data-current'),
      );
    };
    /* Only now does the one-caption rule apply: the CSS is gated on this
       attribute, so if the script never runs every caption stays visible
       rather than all of them disappearing. */
    mark(Math.round(track.scrollLeft / Math.max(track.clientWidth, 1)) || 0);
    show.setAttribute('data-one-caption', '');

    dots.forEach((dot, i) =>
      dot.addEventListener('click', (event) => {
        event.preventDefault();
        track.scrollTo({ left: i * track.clientWidth, behavior: reduced ? 'auto' : 'smooth' });
        mark(i);
      }),
    );

    // The arrow pointer, for a mouse only: touch keeps swiping.
    const arrow = show.querySelector<HTMLElement>('[data-cursor]');
    if (arrow && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      show.classList.add('arrow-cursor');
      let dir = 1;
      const current = () => Math.round(track.scrollLeft / track.clientWidth);
      track.addEventListener('pointermove', (event) => {
        const frame = track.getBoundingClientRect();
        const box = show.getBoundingClientRect();
        dir = event.clientX - frame.left < frame.width / 2 ? -1 : 1;
        arrow.textContent = dir < 0 ? '←' : '→';
        arrow.style.left = `${event.clientX - box.left}px`;
        arrow.style.top = `${event.clientY - box.top}px`;
        arrow.hidden = false;
      });
      track.addEventListener('pointerleave', () => (arrow.hidden = true));
      track.addEventListener('click', () => {
        const next = (current() + dir + slides.length) % slides.length;
        track.scrollTo({ left: next * track.clientWidth, behavior: reduced ? 'auto' : 'smooth' });
        mark(next);
      });
    }

    // Autoplay: one step at a time, back to the first after the last. Held
    // while someone is looking at it closely (pointer or focus inside) and
    // while it is off screen, so it never moves under a reader or unseen.
    const every = Number(show.dataset.autoplay);
    if (every > 0 && !reduced) {
      let held = false;
      let visible = true;
      /* Focus holds it, the pointer does not: "when hovering over the
         autoplay slideshows, the slideshow autoplay continues rather than
         stopping" (client, 2026-09-30). Focus stays held so a keyboard user
         tabbing through the dots does not have the track move under them,
         and `prefers-reduced-motion` still turns the whole thing off. */
      const hold = (on: boolean) => () => (held = on);
      show.addEventListener('focusin', hold(true));
      show.addEventListener('focusout', hold(false));
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(show);
      }
      window.setInterval(() => {
        if (held || !visible || document.hidden) return;
        const next = (Math.round(track.scrollLeft / track.clientWidth) + 1) % slides.length;
        track.scrollTo({ left: next * track.clientWidth, behavior: 'smooth' });
        mark(next);
      }, every);
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) mark(slides.indexOf(entry.target as HTMLElement));
          }
        },
        { root: track, threshold: 0.6 },
      );
      slides.forEach((slide) => observer.observe(slide));
    }
  });
</script>
