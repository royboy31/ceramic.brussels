---
import { urlFor } from '../sanity/image';

/**
 * Responsive Sanity image. Emits a real srcset ladder, lets the CDN pick the
 * format, and always sets width/height so nothing shifts while loading.
 */
interface Props {
  image: any;
  widths?: number[];
  sizes?: string;
  aspect?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
  /**
   * Paint the blurred LQIP behind the image while it loads. Turn it off for
   * anything with transparency - a logo shows the blur through its own
   * see-through pixels, which reads as a grey smudge around it and never
   * goes away, because the background stays behind the loaded PNG.
   */
  placeholder?: boolean;
}

const {
  image,
  widths = [400, 600, 900, 1200, 1600],
  sizes = '(max-width: 700px) 100vw, 700px',
  aspect,
  loading = 'lazy',
  class: className,
  placeholder = true,
} = Astro.props;

const hasAsset = !!image?.asset;

const build = (w: number) => {
  let b = urlFor(image).width(w).auto('format').quality(78);
  if (aspect) b = b.height(Math.round(w / aspect)).fit('crop');
  return b.url();
};

const dims = image?.dimensions;

/**
 * The ladder a caller passes is tuned to its box at 1x. A Retina screen
 * needs twice that, and most ladders stopped short of it (Léonie,
 * 2026-09-23: "the photos appear low resolution, mainly on photos &
 * videos"), so the top step is doubled here, capped at 2560 - the widest
 * the old site ever served, and above the 2500 the imports hold. And no
 * step asks for more than the file has: the CDN upscales a crop request
 * rather than refuse it, which is bandwidth for a blur.
 */
const RETINA_CAP = 2560;
const top = Math.max(...widths);
let ladder = [...widths, Math.min(top * 2, RETINA_CAP)];
const native = dims?.width
  ? aspect && dims.height
    ? Math.min(dims.width, Math.floor(dims.height * aspect))
    : dims.width
  : undefined;
if (native) {
  const fits = ladder.filter((w) => w <= native);
  // The file's own width as the top step, unless a step already comes within 5% of it.
  if (fits.length < ladder.length && native > (fits[fits.length - 1] ?? 0) * 1.05) fits.push(native);
  ladder = fits;
}
ladder = [...new Set(ladder)].filter((w) => w > 0).sort((a, b) => a - b);
const width = ladder[ladder.length - 1];
const height = aspect
  ? Math.round(width / aspect)
  : dims?.aspectRatio
    ? Math.round(width / dims.aspectRatio)
    : undefined;

const srcset = hasAsset ? ladder.map((w) => `${build(w)} ${w}w`).join(', ') : '';
const lqip = placeholder ? image?.lqip : undefined;
// Set only in a preview render (previewImages.ts): tells the editing overlay which field this is.
const editAttr = typeof image?._sanity === 'string' ? image._sanity : undefined;
---

{
  hasAsset ? (
    <img
      src={build(width)}
      srcset={srcset}
      sizes={sizes}
      width={width}
      height={height}
      alt={image.alt ?? ''}
      loading={loading}
      decoding="async"
      class={className}
      data-sanity={editAttr}
      style={lqip ? `background-image:url(${lqip});background-size:cover;background-position:center;` : undefined}
    />
  ) : (
    <div class:list={['img-placeholder', className]} aria-hidden="true" />
  )
}

<style>
  .img-placeholder {
    background: var(--surface-2);
    aspect-ratio: 4 / 3;
    width: 100%;
  }
</style>
