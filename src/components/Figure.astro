---
import SanityImage from './SanityImage.astro';

/**
 * One image slot. Renders the Sanity image when the document has one, and
 * otherwise an empty box of the slot's aspect - never a picture of someone
 * or something else.
 *
 * It used to draw a stand-in from the design hand-off (`src/lib/placeholders.ts`,
 * `/assets/ph/`) so demo pages looked finished. That put another artist's
 * face on an artist made without a portrait, which the client caught on
 * 2026-09-22; the pools went with it. An empty slot now looks empty.
 */
interface Props {
  image?: any;
  aspect?: number;
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { image, aspect, sizes = '100vw', widths, loading = 'lazy', class: className } = Astro.props;
---

{
  image?.asset ? (
    <SanityImage image={image} aspect={aspect} sizes={sizes} widths={widths} loading={loading} class={className} />
  ) : (
    <div class:list={['empty-slot', className]} aria-hidden="true" style={aspect ? `aspect-ratio: ${aspect}` : undefined} />
  )
}

<style>
  .empty-slot {
    width: 100%;
    background: var(--surface-2, #eee);
  }
</style>
