---
import type { LocaleId } from '../lib/locales';
import { useTranslations, localePath } from '../lib/i18n';
import SanityImage from './SanityImage.astro';

/**
 * A card in the exhibitor grid, as the design's exhibitors/index.html draws
 * it: the picture in a 3:2 frame with the round black "solo show" badge and
 * the "focus …" tag, then the name with the country code as a superscript.
 * `data-*` attributes carry what the client-side filters need, and `id`
 * lets the A–Z row jump to the first card of a letter.
 */
interface Props {
  lang: LocaleId;
  exhibitor: any;
  /** Two-letter country code, resolved by the route. */
  code?: string;
  /** Anchor for the A–Z row, set on the first card of each letter. */
  id?: string;
}

const { lang, exhibitor: ex, code, id } = Astro.props;
const t = useTranslations(lang);

/** First letter of the sort name, folded so "Éclat" files under E. */
const letter = (ex.sortName ?? ex.name ?? '')
  .normalize('NFD')
  .replace(/\p{M}/gu, '')
  .trim()
  .charAt(0)
  .toLowerCase();

const filters = [
  ex.soloShow && 'solo-show',
  ex.inCountryFocus && 'country-focus',
  ex.kind === 'publisher' && 'publishers',
  ex.kind === 'jury-prize' && 'jury-prize',
]
  .filter(Boolean)
  .join(' ');

/** "solo show" → "solo<br>show", the two-line badge of the design. */
const twoLines = (s: string) => {
  const words = String(s).trim().split(/\s+/);
  if (words.length < 2) return [s];
  const mid = Math.ceil(words.length / 2);
  return [words.slice(0, mid).join(' '), words.slice(mid).join(' ')];
};
const focusLabel = ex.countryFocusLabel ?? t('exhibitors.countryFocus');
---

<article
  class="col-span-4 max-md:col-span-6 max-sm:col-span-full"
  id={id}
  data-letter={letter}
  data-filters={filters}
  data-tags={filters}
>
  <a href={localePath(lang, `exhibitors/${ex.slug}`)} class="group block">
    <div class="relative aspect-[1.5] overflow-hidden bg-neutral-100">
      {
        ex.image?.asset && (
          <SanityImage
            image={ex.image}
            aspect={1.5}
            widths={[400, 600, 900, 1200]}
            sizes="(max-width: 640px) 100vw, (max-width: 900px) 50vw, 33vw"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.025]"
          />
        )
      }
      {
        (ex.soloShow || ex.kind === 'jury-prize') && (
          <span class="absolute right-3 top-3 grid h-14 w-14 place-items-center rounded-full bg-black text-center text-sm leading-[.9] text-white">
            {twoLines(ex.kind === 'jury-prize' ? t('exhibitors.juryPrize') : t('exhibitors.soloShow')).map((l, i) => (
              <>
                {i > 0 && <br />}
                {l}
              </>
            ))}
          </span>
        )
      }
      {
        ex.inCountryFocus && (
          <span class="absolute right-20 top-3 text-center text-sm leading-[.9]">
            {twoLines(focusLabel).map((l, i) => (
              <>
                {i > 0 && <br />}
                {l}
              </>
            ))}
          </span>
        )
      }
    </div>
    <h2 class="mt-2 text-[clamp(1.5rem,2.8vw,2.5rem)] leading-[.95] tracking-[-.045em]">
      {ex.name} {code && <sup class="text-[.45em] tracking-normal">{code}</sup>}
    </h2>
  </a>
</article>
