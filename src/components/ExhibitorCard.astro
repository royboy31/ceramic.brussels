---
import type { LocaleId } from '../lib/locales';
import { useTranslations, localePath } from '../lib/i18n';
import SanityImage from './SanityImage.astro';
import { exhibitorPath } from '../lib/links';
import { focusLockup, juryPrizeLockup, SOLO_SHOW_LOCKUP } from './exhibitorBadges';

/**
 * A card in the exhibitor grid, as the design's exhibitors/index.html draws
 * it (2026-09-14 build): the picture in a 3:2 frame with the round black
 * "solo show" badge and the two-line "focus …" words, then the name with
 * the country code as a superscript. `data-*` attributes carry what the
 * client-side filters need: the initial, the tags, the country.
 */
interface Props {
  lang: LocaleId;
  exhibitor: any;
  /** Two-letter country code, resolved by the route. */
  code?: string;
  /** Anchor for the A–Z row, set on the first card of each letter. */
  id?: string;
  /** The exhibitor won one of the fair's awards this edition. */
  awarded?: boolean;
}

const { lang, exhibitor: ex, code, id, awarded = false } = Astro.props;
const t = useTranslations(lang);

/** First letter of the sort name, folded so "Éclat" files under E. */
const letter = (ex.sortName ?? ex.name ?? '')
  .normalize('NFD')
  .replace(/\p{M}/gu, '')
  .trim()
  .charAt(0)
  .toUpperCase();

const filters = [
  ex.soloShow && 'solo-show',
  ex.inCountryFocus && 'country-focus',
  ex.kind === 'publisher' && 'publishers',
  ex.kind === 'jury-prize' && 'jury-prize',
  awarded && 'awards',
]
  .filter(Boolean)
  .join(' ');

/** "solo show" → "solo<br>show", the two-line badge of the design. */
const twoLines = (s: string) => {
  const words = String(s).trim().split(/\s+/);
  if (words.length < 2) return [s];
  const mid = Math.ceil(words.length / 2);
  return [words.slice(0, mid).join(' '), words.slice(mid).join(' ')];
};
const focusLabel = ex.countryFocusLabel ?? t('exhibitors.countryFocus');
/** The designer's lockups, from `exhibitorBadges.ts`: the solo show disc, the
 *  focus words with their country's outline, and the jury prize oval for the
 *  year this card belongs to. Anything without artwork keeps its words. */
const SOLO_LOGO = SOLO_SHOW_LOCKUP;
const focusLogo = focusLockup(focusLabel);
const juryLogo = ex.kind === 'jury-prize' ? juryPrizeLockup(ex.year) : null;
---

<article id={id} data-name={letter} data-letter={letter} data-filters={filters} data-tags={filters} data-country={code}>
  <a href={localePath(lang, exhibitorPath(ex))}>
    {/* `bleed-m`: edge to edge below 700px (client, 2026-09-30, "same in the
        galleries list"). On the container, not the picture, so the hover veil
        and the badges laid over it move with it. */}
    <div class="gallery-image bleed-m">
      {
        ex.image?.asset && (
          <SanityImage
            image={ex.image}
            aspect={1.5}
            widths={[400, 600, 900, 1200]}
            sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 33vw"
          />
        )
      }
      {/* The hover (client feedback, 2026-09-16): a light white veil over the
          picture with "discover the gallery →". Before the badges, so they
          stay on top of it. */}
      <span class="veil" aria-hidden="true">
        <span class="veil__label">
          {t('exhibitors.discoverGallery')} <span class="link-arrow" aria-hidden="true">→</span>
        </span>
      </span>
      {
        ex.soloShow && ex.kind !== 'jury-prize' && (
          <img class="badge badge--logo" src={SOLO_LOGO} alt={t('exhibitors.soloShow')} width="60" height="60" />
        )
      }
      {
        ex.kind === 'jury-prize' &&
          (juryLogo ? (
            <img
              class="badge badge--oval"
              src={juryLogo}
              alt={`${t('exhibitors.juryPrize')} ${ex.year}`}
              width="120"
              height="56"
            />
          ) : (
            <span class="badge badge--black">
              {twoLines(t('exhibitors.juryPrize')).map((l, i) => (
                <>
                  {i > 0 && <br />}
                  {l}
                </>
              ))}
            </span>
          ))
      }
      {
        ex.inCountryFocus && (
          focusLogo ? (
            <img
              class:list={['focus-logo', { 'focus--beside': ex.soloShow || ex.kind === 'jury-prize' }]}
              src={focusLogo}
              alt={focusLabel}
              width="260"
              height="149"
            />
          ) : (
            <span class:list={['focus', { 'focus--beside': ex.soloShow || ex.kind === 'jury-prize' }]}>
              {twoLines(focusLabel).map((l) => (
                <span>{l}</span>
              ))}
            </span>
          )
        )
      }
    </div>
    <h2>
      {ex.name} {code && <sup>{code}</sup>}
    </h2>
  </a>
</article>

<style>
  /* From the design's exhibitors/index.html (2026-09-14 build), sizes
     checked against the Figma galleries frame (2026-09-17). */
  .gallery-image {
    aspect-ratio: 1.5;
    background: #eee;
    position: relative;
    overflow: hidden;
  }
  .gallery-image :global(img) {
    object-fit: cover;
    width: 100%;
    height: 100%;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  article:hover :global(img) {
    transform: scale(1.025);
  }
  .veil {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(255 255 255 / 0.2);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  /* "Could we try making it not changing the white background colour inside
     the pill shape to transparent, so only keep the stroke around it and
     make the text and the stroke white (so that it feels less present on
     the photo)" - client, 2026-09-30. The 20% white veil under it is what
     keeps the words legible on a dark photograph now that the pill itself
     carries no fill. */
  .veil__label {
    padding: 3px 18px;
    border: 1px solid #fff;
    border-radius: 999px;
    background: transparent;
    color: #fff;
    font-size: 24px;
    line-height: 34px;
    letter-spacing: -0.03em;
    white-space: nowrap;
    translate: 0 6px;
    transition: translate 0.25s var(--motion-ease, ease);
  }
  a:hover .veil,
  a:focus-visible .veil {
    opacity: 1;
  }
  a:hover .veil__label,
  a:focus-visible .veil__label {
    translate: 0 0;
  }
  a:hover .veil .link-arrow {
    transform: translate(0.22em);
  }
  @media (hover: none) {
    .veil {
      display: none;
    }
  }
  /* The gallery name, and the site's "name" size (tokens in Base.astro):
     the Stories titles are set from the same ones. */
  h2 {
    letter-spacing: var(--name-ls);
    margin-top: 16px;
    font-size: var(--name-size);
    font-weight: 400;
    line-height: var(--name-lh);
  }
  /* Bigger, and hung from the top of the capitals rather than raised off
     the baseline (client feedback, 2026-09-16). */
  sup {
    letter-spacing: 0;
    font-size: 0.5em;
    line-height: 1;
    vertical-align: top;
    position: relative;
    top: 0.01em;
  }
  /* The round "solo show" badge: the words nearly fill the circle. */
  .badge {
    text-align: center;
    border-radius: 50%;
    place-items: center;
    width: 60px;
    height: 60px;
    font-size: 19px;
    line-height: 0.85;
    letter-spacing: -0.03em;
    display: grid;
    position: absolute;
    top: 12px;
    right: 12px;
  }
  .badge--black {
    color: #fff;
    background: #000;
  }
  /* The card's photo rules (cover, full size, the hover zoom) are for the
     photo only; the marks keep their own size and stay still. */
  .gallery-image > img.badge--logo,
  .gallery-image > img.focus-logo {
    object-fit: contain;
    height: auto;
    transform: none;
  }
  .gallery-image > img.badge--logo {
    width: 60px;
    height: 60px;
  }
  /* The jury prize oval is wider than it is tall, so it keeps its own shape
     rather than the 60px disc the other badges share. Its year is printed on
     the artwork, which is why there is one file per edition. */
  .gallery-image > img.badge--oval {
    border-radius: 0;
    width: 104px;
    height: auto;
  }
  .gallery-image > img.focus-logo {
    width: 96px;
  }
  /* The "focus España" lockup: the words with the country's outline, black
     on the picture as the words were, about their size. */
  .focus-logo {
    position: absolute;
    top: 12px;
    right: 14px;
    width: 96px;
    height: auto;
  }
  .focus-logo.focus--beside {
    top: 12px;
    right: 84px;
  }
  /* The country focus is words only, no circle: the first line to the left,
     the second stepped in to the right. Beside a badge it moves left of it. */
  .focus {
    display: grid;
    position: absolute;
    top: 12px;
    right: 22px;
    font-size: 22px;
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .focus > :last-child {
    justify-self: end;
    padding-left: 0.9em;
  }
  .focus--beside {
    top: 18px;
    right: 90px;
  }
  /* `h2` keeps the token, which steps to 32 below 900. */
</style>
