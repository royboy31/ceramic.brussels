---
import type { LocaleId } from '../lib/locales';
import { useTranslations, localePath } from '../lib/i18n';
import Figure from './Figure.astro';

/**
 * A card in the exhibitor grid: picture with the solo show / country focus /
 * jury prize badges, then the name with the country code as a superscript.
 * `data-*` attributes carry what the client-side filters need, and `id` lets
 * the A–Z row jump to the first card of a letter - so both work on an
 * already-rendered list.
 */
interface Props {
  lang: LocaleId;
  exhibitor: any;
  /** Anchor for the A–Z row, set on the first card of each letter. */
  id?: string;
}

const { lang, exhibitor: ex, id } = Astro.props;
const t = useTranslations(lang);

/** First letter of the sort name, folded so "Éclat" files under E. */
const letter = (ex.sortName ?? ex.name ?? '')
  .normalize('NFD')
  .replace(/\p{M}/gu, '')
  .trim()
  .charAt(0)
  .toLowerCase();

const filters = [
  ex.soloShow && 'solo-show',
  ex.inCountryFocus && 'country-focus',
  ex.kind === 'publisher' && 'publishers',
  ex.kind === 'jury-prize' && 'jury-prize',
]
  .filter(Boolean)
  .join(' ');

const hasBadges = ex.soloShow || ex.inCountryFocus || ex.kind === 'jury-prize';
---

<li
  class="card"
  id={id}
  data-letter={letter}
  data-filters={filters}
  data-search={[ex.name, ex.country, ex.city, ex.booth].filter(Boolean).join(' ').toLowerCase()}
>
  <a class="card-link" href={localePath(lang, `exhibitors/${ex.slug}`)}>
    <div class="thumb">
      <Figure
        image={ex.image}
        pool="exhibitor"
        seed={ex.slug}
        aspect={1.5}
        sizes="(max-width: 640px) 100vw, (max-width: 900px) 50vw, 33vw"
        widths={[400, 600, 900, 1200]}
      />
      {hasBadges && (
        <span class="badges">
          {ex.soloShow && <span class="badge">{t('exhibitors.soloShow')}</span>}
          {ex.inCountryFocus && <span class="badge focus">{ex.countryFocusLabel ?? t('exhibitors.countryFocus')}</span>}
          {ex.kind === 'jury-prize' && <span class="badge">{t('exhibitors.juryPrize')}</span>}
        </span>
      )}
    </div>

    <h2>
      {ex.name}
      {ex.countryCode && <sup>{ex.countryCode}</sup>}
    </h2>
  </a>
</li>

<style>
  .card {
    grid-column: span 4;
    scroll-margin-top: 1.5rem;
  }
  .card[hidden] {
    display: none;
  }
  .card a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .thumb {
    position: relative;
    overflow: hidden;
  }
  .thumb :global(img) {
    width: 100%;
    transition: transform 0.5s ease;
  }
  .card a:hover .thumb :global(img) {
    transform: scale(1.025);
  }

  .badges {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .badge {
    display: inline-block;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--ground);
    font-size: clamp(0.75rem, 1vw, 0.95rem);
    line-height: 1.3;
    text-transform: lowercase;
    white-space: nowrap;
  }
  .badge.focus {
    background: var(--acid);
    color: var(--ink);
  }

  .card h2 {
    margin: 0.5rem 0 0;
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-weight: 400;
  }
  .card sup {
    font-size: 0.45em;
    letter-spacing: normal;
    margin-left: 0.15em;
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb :global(img),
    .card a:hover .thumb :global(img) {
      transition: none;
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .card {
      grid-column: span 6;
    }
  }

  @media (max-width: 640px) {
    .card {
      grid-column: 1 / -1;
    }
  }
</style>
