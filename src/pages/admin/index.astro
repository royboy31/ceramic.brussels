---
/**
 * The admin panel.
 *
 * A single client-rendered page talking to /api/*. It deliberately does not
 * use Base.astro: this is a tool, not a page of the site, and it should not
 * inherit the site header, footer or brand styling.
 *
 * Nothing secret is here. The Sanity write token lives only in the Functions;
 * this page can do exactly what the API lets the signed-in user do.
 *
 * The type list is baked in at build time from the same whitelist the API
 * enforces, so the navigation cannot offer something the server would refuse.
 */
import { EDITABLE_TYPES } from '../../server/editable';
import { LOCALES } from '../../lib/locales';

const types = EDITABLE_TYPES.map((t) => ({ name: t.name, label: t.label, plural: t.plural }));
const locales = LOCALES.map((l) => ({ id: l.id, title: l.title }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>ceramic.brussels — content admin</title>
  </head>
  <body>
    <div id="app" data-loading>
      <p class="boot">Loading…</p>
    </div>

    <script
      id="admin-config"
      type="application/json"
      set:html={JSON.stringify({ types, locales })}
    />

    <script>
      const config = JSON.parse(document.getElementById('admin-config').textContent);
      const app = document.getElementById('app');

      let state = { user: null, view: null, type: null, doc: null, fields: [], busy: false };

      /* ---------- api ---------- */

      async function api(path, options = {}) {
        const response = await fetch(path, {
          ...options,
          headers: {
            'content-type': 'application/json',
            // Cross-origin pages cannot set this without a preflight the API
            // never answers, which is what makes CSRF a non-issue here.
            'x-admin-request': '1',
            ...(options.headers || {}),
          },
          credentials: 'same-origin',
        });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) {
          const error = new Error(body.error || `Request failed (${response.status})`);
          error.status = response.status;
          error.body = body;
          throw error;
        }
        return body;
      }

      /* ---------- dom helpers ---------- */

      function el(tag, attrs = {}, ...children) {
        const node = document.createElement(tag);
        for (const [key, value] of Object.entries(attrs)) {
          if (key === 'class') node.className = value;
          else if (key === 'html') node.innerHTML = value;
          else if (key.startsWith('on')) node.addEventListener(key.slice(2), value);
          else if (value !== null && value !== undefined && value !== false)
            node.setAttribute(key, value === true ? '' : String(value));
        }
        for (const child of children.flat()) {
          if (child === null || child === undefined || child === false) continue;
          node.append(child instanceof Node ? child : document.createTextNode(String(child)));
        }
        return node;
      }

      function notify(message, kind = 'info') {
        const bar = document.querySelector('.notice');
        if (bar) bar.remove();
        if (!message) return;
        const node = el('div', { class: `notice notice-${kind}`, role: 'status' }, message);
        app.prepend(node);
        if (kind !== 'error') setTimeout(() => node.remove(), 6000);
      }

      const fmtDate = (value) =>
        value ? new Date(value).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : '—';

      /* ---------- login ---------- */

      function renderLogin() {
        app.replaceChildren(
          el(
            'div',
            { class: 'gate' },
            el(
              'form',
              {
                class: 'card',
                onsubmit: async (event) => {
                  event.preventDefault();
                  const form = event.target;
                  form.querySelector('button').disabled = true;
                  try {
                    const { user } = await api('/api/auth/login', {
                      method: 'POST',
                      body: JSON.stringify({
                        email: form.email.value,
                        password: form.password.value,
                      }),
                    });
                    state.user = user;
                    start();
                  } catch (error) {
                    notify(error.message, 'error');
                    form.querySelector('button').disabled = false;
                  }
                },
              },
              el('h1', {}, 'ceramic.brussels'),
              el('p', { class: 'muted' }, 'Content admin'),
              el('label', {}, 'Email', el('input', { name: 'email', type: 'email', required: true, autocomplete: 'username' })),
              el('label', {}, 'Password', el('input', { name: 'password', type: 'password', required: true, autocomplete: 'current-password' })),
              el('button', { type: 'submit' }, 'Sign in'),
            ),
          ),
        );
      }

      function renderPasswordChange(forced) {
        const form = el(
          'form',
          {
            class: 'card',
            onsubmit: async (event) => {
              event.preventDefault();
              const f = event.target;
              if (f.newPassword.value !== f.confirm.value) return notify('Passwords do not match.', 'error');
              f.querySelector('button').disabled = true;
              try {
                await api('/api/auth/password', {
                  method: 'POST',
                  body: JSON.stringify({
                    currentPassword: f.currentPassword.value,
                    newPassword: f.newPassword.value,
                  }),
                });
                state.user.mustChangePassword = false;
                notify('Password changed.', 'ok');
                start();
              } catch (error) {
                notify(error.message, 'error');
                f.querySelector('button').disabled = false;
              }
            },
          },
          el('h1', {}, forced ? 'Choose a password' : 'Change password'),
          forced && el('p', { class: 'muted' }, 'Your account was created with a temporary password. Pick your own to continue.'),
          el('label', {}, 'Current password', el('input', { name: 'currentPassword', type: 'password', required: true, autocomplete: 'current-password' })),
          el('label', {}, 'New password', el('input', { name: 'newPassword', type: 'password', required: true, minlength: 12, autocomplete: 'new-password' })),
          el('label', {}, 'Repeat new password', el('input', { name: 'confirm', type: 'password', required: true, minlength: 12, autocomplete: 'new-password' })),
          el('p', { class: 'muted small' }, 'At least 12 characters. A passphrase of a few words is stronger than a short password with symbols.'),
          el('button', { type: 'submit' }, 'Save password'),
          !forced && el('button', { type: 'button', class: 'link', onclick: () => start() }, 'Cancel'),
        );
        app.replaceChildren(el('div', { class: 'gate' }, form));
      }

      /* ---------- shell ---------- */

      function renderShell(main) {
        const nav = el(
          'nav',
          { class: 'sidebar' },
          el('div', { class: 'brand' }, 'ceramic.brussels'),
          el('p', { class: 'nav-label' }, 'Content'),
          ...config.types.map((type) =>
            el(
              'button',
              {
                class: state.view === 'content' && state.type === type.name ? 'nav-item active' : 'nav-item',
                onclick: () => openType(type.name),
              },
              type.plural,
            ),
          ),
          state.user.role === 'admin' && el('p', { class: 'nav-label' }, 'Admin'),
          state.user.role === 'admin' &&
            el('button', { class: state.view === 'users' ? 'nav-item active' : 'nav-item', onclick: openUsers }, 'Users'),
          state.user.role === 'admin' &&
            el('button', { class: state.view === 'audit' ? 'nav-item active' : 'nav-item', onclick: openAudit }, 'Activity'),
        );

        const header = el(
          'header',
          { class: 'topbar' },
          el('div', { class: 'who' }, el('strong', {}, state.user.name), el('span', { class: 'role' }, state.user.role)),
          el('div', { class: 'actions' },
            el('button', { class: 'primary', onclick: rebuild }, 'Update live site'),
            el('button', { class: 'link', onclick: () => renderPasswordChange(false) }, 'Password'),
            el('button', {
              class: 'link',
              onclick: async () => {
                await api('/api/auth/logout', { method: 'POST' });
                state.user = null;
                renderLogin();
              },
            }, 'Sign out'),
          ),
        );

        app.replaceChildren(el('div', { class: 'layout' }, nav, el('div', { class: 'panel' }, header, main)));
      }

      async function rebuild(event) {
        const button = event.target;
        button.disabled = true;
        button.textContent = 'Starting…';
        try {
          const result = await api('/api/site/rebuild', { method: 'POST' });
          notify(result.message, result.started ? 'ok' : 'info');
        } catch (error) {
          notify(error.message, 'error');
        }
        button.disabled = false;
        button.textContent = 'Update live site';
      }

      /* ---------- content ---------- */

      async function openType(typeName, search = '') {
        state.view = 'content';
        state.type = typeName;
        state.doc = null;
        renderShell(el('div', { class: 'main' }, el('p', { class: 'muted' }, 'Loading…')));
        try {
          const url = `/api/content/${encodeURIComponent(typeName)}${search ? `?q=${encodeURIComponent(search)}` : ''}`;
          const data = await api(url);
          renderList(data, search);
        } catch (error) {
          notify(error.message, 'error');
        }
      }

      function renderList(data, search) {
        const rows = data.items.length
          ? data.items.map((item) =>
              el(
                'button',
                { class: 'row', onclick: () => openDocument(data.type, item._id) },
                el('span', { class: 'row-title' }, item.title || '(untitled)'),
                el('span', { class: 'row-sub' }, item.subtitle || ''),
                el('span', { class: 'row-date' }, fmtDate(item._updatedAt)),
              ),
            )
          : [el('p', { class: 'muted' }, search ? 'Nothing matches that search.' : 'Nothing here yet.')];

        renderShell(
          el(
            'div',
            { class: 'main' },
            el('div', { class: 'main-head' },
              el('h1', {}, data.plural),
              el('form', {
                class: 'search',
                onsubmit: (event) => {
                  event.preventDefault();
                  openType(data.type, event.target.q.value);
                },
              }, el('input', { name: 'q', type: 'search', placeholder: 'Search…', value: search }), el('button', {}, 'Search')),
            ),
            el('p', { class: 'muted small' }, `${data.items.length} published ${data.items.length === 1 ? 'item' : 'items'}. New documents and images are created in the Studio.`),
            el('div', { class: 'rows' }, ...rows),
          ),
        );
      }

      async function openDocument(typeName, id) {
        renderShell(el('div', { class: 'main' }, el('p', { class: 'muted' }, 'Loading…')));
        try {
          const data = await api(`/api/content/${encodeURIComponent(typeName)}/${encodeURIComponent(id)}`);
          state.doc = data.document;
          state.fields = data.type.fields;
          renderEditor(typeName, data.type.label);
        } catch (error) {
          notify(error.message, 'error');
        }
      }

      function fieldInput(field, value) {
        const id = `f-${field.name}`;

        if (field.kind === 'localeString' || field.kind === 'localeText') {
          const current = value && typeof value === 'object' ? value : {};
          return el(
            'div',
            { class: 'locale-group' },
            ...config.locales.map((locale) =>
              el(
                'label',
                { class: 'locale' },
                el('span', { class: 'locale-tag' }, locale.id.toUpperCase()),
                field.kind === 'localeText'
                  ? el('textarea', { name: `${field.name}.${locale.id}`, rows: 3 }, current[locale.id] || '')
                  : el('input', { name: `${field.name}.${locale.id}`, type: 'text', value: current[locale.id] || '' }),
              ),
            ),
          );
        }

        if (field.kind === 'boolean') {
          return el('input', { id, name: field.name, type: 'checkbox', checked: value === true });
        }

        if (field.kind === 'select') {
          return el(
            'select',
            { id, name: field.name },
            el('option', { value: '' }, '—'),
            ...(field.options || []).map((option) =>
              el('option', { value: option.value, selected: option.value === value }, option.title),
            ),
          );
        }

        if (field.kind === 'text') {
          return el('textarea', { id, name: field.name, rows: 4 }, value ?? '');
        }

        const typeAttr =
          field.kind === 'number' ? 'number'
          : field.kind === 'url' ? 'url'
          : field.kind === 'email' ? 'email'
          : field.kind === 'date' ? 'date'
          : field.kind === 'datetime' ? 'datetime-local'
          : 'text';

        let shown = value ?? '';
        // datetime-local wants no timezone and no seconds.
        if (field.kind === 'datetime' && shown) shown = new Date(shown).toISOString().slice(0, 16);

        return el('input', { id, name: field.name, type: typeAttr, value: shown });
      }

      function collectValues(form) {
        const values = {};
        for (const field of state.fields) {
          if (field.kind === 'localeString' || field.kind === 'localeText') {
            const bag = {};
            for (const locale of config.locales) {
              bag[locale.id] = form.elements[`${field.name}.${locale.id}`]?.value ?? '';
            }
            values[field.name] = bag;
          } else if (field.kind === 'boolean') {
            values[field.name] = !!form.elements[field.name]?.checked;
          } else {
            values[field.name] = form.elements[field.name]?.value ?? '';
          }
        }
        return values;
      }

      function renderEditor(typeName, typeLabel) {
        const doc = state.doc;
        const title = doc[state.fields[0].name];
        const shownTitle = typeof title === 'object' && title ? title.en : title;

        const form = el(
          'form',
          {
            class: 'form',
            onsubmit: async (event) => {
              event.preventDefault();
              const button = event.target.querySelector('button[type=submit]');
              button.disabled = true;
              button.textContent = 'Saving…';
              try {
                const result = await api(
                  `/api/content/${encodeURIComponent(typeName)}/${encodeURIComponent(doc._id)}`,
                  { method: 'PATCH', body: JSON.stringify({ values: collectValues(event.target), rev: doc._rev }) },
                );
                state.doc = result.document;
                notify('Saved. Use "Update live site" when you want it published.', 'ok');
                renderEditor(typeName, typeLabel);
              } catch (error) {
                notify(
                  error.status === 409
                    ? `${error.message}`
                    : error.message,
                  'error',
                );
                button.disabled = false;
                button.textContent = 'Save';
              }
            },
          },
          ...state.fields.map((field) =>
            el(
              'div',
              { class: 'field' },
              el('label', { class: 'field-label', for: `f-${field.name}` }, field.label, field.required ? el('span', { class: 'req' }, '*') : null),
              fieldInput(field, doc[field.name]),
              field.help ? el('p', { class: 'help' }, field.help) : null,
            ),
          ),
          el('div', { class: 'form-actions' },
            el('button', { type: 'submit', class: 'primary' }, 'Save'),
            el('button', { type: 'button', class: 'link', onclick: () => openType(typeName) }, 'Back to list'),
          ),
        );

        renderShell(
          el(
            'div',
            { class: 'main' },
            el('div', { class: 'main-head' },
              el('h1', {}, shownTitle || '(untitled)'),
              el('span', { class: 'muted small' }, `${typeLabel} · updated ${fmtDate(doc._updatedAt)}`),
            ),
            form,
          ),
        );
      }

      /* ---------- users ---------- */

      async function openUsers() {
        state.view = 'users';
        renderShell(el('div', { class: 'main' }, el('p', { class: 'muted' }, 'Loading…')));
        try {
          const { users } = await api('/api/users');
          renderUsers(users);
        } catch (error) {
          notify(error.message, 'error');
        }
      }

      function renderUsers(users) {
        const rows = users.map((user) =>
          el(
            'div',
            { class: user.isActive ? 'user-row' : 'user-row inactive' },
            el('div', { class: 'user-main' },
              el('strong', {}, user.name),
              el('span', { class: 'muted' }, user.email),
              el('span', { class: `tag tag-${user.role}` }, user.role),
              !user.isActive && el('span', { class: 'tag tag-off' }, 'deactivated'),
              user.mustChangePassword && el('span', { class: 'tag' }, 'must set password'),
            ),
            el('div', { class: 'user-meta muted small' }, `last sign-in ${fmtDate(user.lastLoginAt)}`),
            el('div', { class: 'user-actions' },
              el('button', {
                class: 'link',
                onclick: async () => {
                  const role = user.role === 'admin' ? 'editor' : 'admin';
                  if (!confirm(`Make ${user.name} ${role === 'admin' ? 'an admin' : 'an editor'}?`)) return;
                  await guard(() => api(`/api/users/${user.id}`, { method: 'PATCH', body: JSON.stringify({ role }) }));
                },
              }, user.role === 'admin' ? 'Make editor' : 'Make admin'),
              el('button', {
                class: 'link',
                onclick: async () => {
                  const password = prompt(`New temporary password for ${user.name} (at least 12 characters). They will be asked to change it.`);
                  if (!password) return;
                  await guard(() => api(`/api/users/${user.id}`, { method: 'POST', body: JSON.stringify({ password }) }), 'Password reset.');
                },
              }, 'Reset password'),
              el('button', {
                class: 'link',
                onclick: async () => {
                  await guard(() => api(`/api/users/${user.id}`, { method: 'PATCH', body: JSON.stringify({ isActive: !user.isActive }) }));
                },
              }, user.isActive ? 'Deactivate' : 'Reactivate'),
              el('button', {
                class: 'link danger',
                onclick: async () => {
                  if (!confirm(`Delete ${user.name}? Their entries in the activity log are kept.`)) return;
                  await guard(() => api(`/api/users/${user.id}`, { method: 'DELETE' }), 'User deleted.');
                },
              }, 'Delete'),
            ),
          ),
        );

        const createForm = el(
          'form',
          {
            class: 'card inline',
            onsubmit: async (event) => {
              event.preventDefault();
              const f = event.target;
              await guard(
                () => api('/api/users', {
                  method: 'POST',
                  body: JSON.stringify({
                    email: f.email.value,
                    name: f.name.value,
                    role: f.role.value,
                    password: f.password.value,
                  }),
                }),
                'User created.',
              );
            },
          },
          el('h2', {}, 'Add a user'),
          el('div', { class: 'grid' },
            el('label', {}, 'Name', el('input', { name: 'name', required: true })),
            el('label', {}, 'Email', el('input', { name: 'email', type: 'email', required: true })),
            el('label', {}, 'Role', el('select', { name: 'role' }, el('option', { value: 'editor' }, 'Editor'), el('option', { value: 'admin' }, 'Admin'))),
            el('label', {}, 'Temporary password', el('input', { name: 'password', type: 'text', minlength: 12, required: true })),
          ),
          el('p', { class: 'help' }, 'They will be required to choose their own password the first time they sign in.'),
          el('button', { type: 'submit', class: 'primary' }, 'Create user'),
        );

        renderShell(
          el('div', { class: 'main' },
            el('div', { class: 'main-head' }, el('h1', {}, 'Users')),
            el('p', { class: 'muted small' }, 'These accounts are for this panel only. They are not Sanity logins and cost no Sanity seat.'),
            el('div', { class: 'users' }, ...rows),
            createForm,
          ),
        );
      }

      /** Runs a mutation, reports the outcome, and refreshes the user list. */
      async function guard(action, okMessage) {
        try {
          await action();
          if (okMessage) notify(okMessage, 'ok');
          await openUsers();
        } catch (error) {
          notify(error.message, 'error');
        }
      }

      /* ---------- activity ---------- */

      async function openAudit() {
        state.view = 'audit';
        renderShell(el('div', { class: 'main' }, el('p', { class: 'muted' }, 'Loading…')));
        try {
          const { entries } = await api('/api/audit?limit=200');
          renderShell(
            el('div', { class: 'main' },
              el('div', { class: 'main-head' }, el('h1', {}, 'Activity')),
              el('p', { class: 'muted small' }, 'Every change made through this panel. Sanity records all of them under one token, so this is the only place the person is recorded.'),
              el('div', { class: 'rows' },
                ...entries.map((entry) =>
                  el('div', { class: 'audit' },
                    el('span', { class: 'audit-at muted small' }, fmtDate(entry.at)),
                    el('span', { class: 'audit-user' }, entry.user),
                    el('span', { class: 'tag' }, entry.action),
                    el('span', { class: 'muted small' }, entry.docType ? `${entry.docType} ${entry.docId ?? ''}` : ''),
                    entry.changes ? el('code', { class: 'audit-changes' }, Object.keys(entry.changes).join(', ')) : null,
                  ),
                ),
              ),
            ),
          );
        } catch (error) {
          notify(error.message, 'error');
        }
      }

      /* ---------- boot ---------- */

      function start() {
        if (!state.user) return renderLogin();
        if (state.user.mustChangePassword) return renderPasswordChange(true);
        openType(config.types[0].name);
      }

      (async function boot() {
        try {
          const { user } = await api('/api/auth/session');
          state.user = user;
        } catch {
          state.user = null;
        }
        app.removeAttribute('data-loading');
        start();
      })();
    </script>

    <style is:global>
      :root {
        --bg: #f7f7f6;
        --card: #ffffff;
        --line: #e2e0dd;
        --text: #16150f;
        --dim: #6b6862;
        --accent: #1f4ed8;
        --danger: #b3261e;
        --ok: #1b7f4b;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font: 15px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }
      .boot { padding: 3rem; color: var(--dim); }

      .gate { display: grid; place-items: center; min-height: 100dvh; padding: 1.5rem; }
      .card {
        background: var(--card); border: 1px solid var(--line); border-radius: 10px;
        padding: 1.75rem; width: 100%; max-width: 420px; display: grid; gap: 0.85rem;
      }
      .card.inline { max-width: none; margin-top: 2rem; }
      .card h1 { margin: 0; font-size: 1.3rem; }
      .card h2 { margin: 0; font-size: 1.05rem; }

      label { display: grid; gap: 0.3rem; font-size: 0.85rem; color: var(--dim); }
      input, select, textarea {
        font: inherit; padding: 0.55rem 0.65rem; border: 1px solid var(--line);
        border-radius: 6px; background: #fff; color: var(--text); width: 100%;
      }
      input[type='checkbox'] { width: auto; }
      input:focus, select:focus, textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
      textarea { resize: vertical; }

      button {
        font: inherit; cursor: pointer; border-radius: 6px; padding: 0.5rem 0.9rem;
        border: 1px solid var(--line); background: #fff; color: var(--text);
      }
      button:disabled { opacity: 0.5; cursor: default; }
      button.primary { background: var(--text); color: #fff; border-color: var(--text); }
      button.link { border: none; background: none; color: var(--accent); padding: 0.35rem 0.4rem; }
      button.link.danger { color: var(--danger); }

      .layout { display: grid; grid-template-columns: 220px 1fr; min-height: 100dvh; }
      .sidebar { background: #fff; border-right: 1px solid var(--line); padding: 1.1rem 0.8rem; }
      .brand { font-weight: 700; padding: 0 0.5rem 1rem; }
      .nav-label { margin: 1rem 0 0.35rem; padding: 0 0.5rem; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--dim); }
      .nav-item { display: block; width: 100%; text-align: left; border: none; background: none; padding: 0.45rem 0.5rem; border-radius: 6px; }
      .nav-item:hover { background: var(--bg); }
      .nav-item.active { background: var(--text); color: #fff; }

      .panel { display: flex; flex-direction: column; min-width: 0; }
      .topbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.8rem 1.5rem; border-bottom: 1px solid var(--line); background: #fff; }
      .who { display: flex; align-items: baseline; gap: 0.5rem; }
      .role { font-size: 0.75rem; color: var(--dim); }
      .actions { display: flex; align-items: center; gap: 0.4rem; }

      .main { padding: 1.5rem; max-width: 900px; }
      .main-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
      .main-head h1 { margin: 0 0 0.4rem; font-size: 1.4rem; }
      .search { display: flex; gap: 0.4rem; }
      .muted { color: var(--dim); }
      .small { font-size: 0.85rem; }

      .rows { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; margin-top: 1rem; }
      .row { display: grid; grid-template-columns: 1fr auto auto; gap: 1rem; align-items: baseline; text-align: left; background: #fff; border: none; border-radius: 0; padding: 0.7rem 0.9rem; }
      .row:hover { background: #fbfbfa; }
      .row-title { font-weight: 500; }
      .row-sub, .row-date { color: var(--dim); font-size: 0.85rem; }

      .form { display: grid; gap: 1.1rem; margin-top: 1.5rem; }
      .field { display: grid; gap: 0.35rem; }
      .field-label { font-weight: 500; color: var(--text); font-size: 0.9rem; }
      .req { color: var(--danger); margin-left: 0.15rem; }
      .help { margin: 0; font-size: 0.8rem; color: var(--dim); }
      .locale-group { display: grid; gap: 0.4rem; }
      .locale { display: grid; grid-template-columns: 2.5rem 1fr; align-items: start; gap: 0.5rem; }
      .locale-tag { font-size: 0.7rem; color: var(--dim); padding-top: 0.6rem; letter-spacing: 0.06em; }
      .form-actions { display: flex; gap: 0.5rem; align-items: center; padding-top: 0.5rem; }

      .users { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; margin-top: 1rem; }
      .user-row { background: #fff; padding: 0.8rem 0.9rem; display: grid; gap: 0.35rem; }
      .user-row.inactive { opacity: 0.6; }
      .user-main { display: flex; gap: 0.6rem; align-items: baseline; flex-wrap: wrap; }
      .user-actions { display: flex; gap: 0.2rem; flex-wrap: wrap; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; }

      .tag { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.1rem 0.4rem; border: 1px solid var(--line); border-radius: 4px; color: var(--dim); }
      .tag-admin { border-color: var(--accent); color: var(--accent); }
      .tag-off { border-color: var(--danger); color: var(--danger); }

      .audit { background: #fff; padding: 0.6rem 0.9rem; display: flex; gap: 0.7rem; align-items: baseline; flex-wrap: wrap; }
      .audit-changes { font-size: 0.78rem; color: var(--dim); }

      .notice { position: fixed; top: 0; left: 0; right: 0; z-index: 10; padding: 0.7rem 1.2rem; font-size: 0.9rem; color: #fff; background: var(--text); }
      .notice-error { background: var(--danger); }
      .notice-ok { background: var(--ok); }

      @media (max-width: 720px) {
        .layout { grid-template-columns: 1fr; }
        .sidebar { border-right: none; border-bottom: 1px solid var(--line); }
        .row { grid-template-columns: 1fr; gap: 0.15rem; }
      }
    </style>
  </body>
</html>
