---
import Base from '../../../layouts/Base.astro';
import HubNav from '../../../components/HubNav.astro';
import Sections from '../../../components/Sections.astro';
import Slideshow from '../../../components/Slideshow.astro';
import Figure from '../../../components/Figure.astro';
import SanityImage from '../../../components/SanityImage.astro';
import PortableText from '../../../components/PortableText.astro';
import LinkPill from '../../../components/LinkPill.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations } from '../../../lib/i18n';
import { getHubPages, getPartners } from '../../../lib/queries';
import { HUBS, PARTNER_TABS, hubTabParams, hubTabPath, pageForTab } from '../../../lib/hubs';
import { instagramUrl } from '../../../lib/links';
import { styleAttrs } from '../../../lib/textStyle';

/**
 * Partners by tab. Each tab lists one or more tiers under a full-width rule
 * and the tab's name. Most tiers are a two-column grid of entries (name +
 * rule + text + logo + website pill); the hotel is one entry with a
 * slideshow beside the text; media partners are a logo wall.
 */
export function getStaticPaths() {
  return hubTabParams('partners', LOCALE_IDS);
}

const lang = Astro.params.lang as LocaleId;
const tab = (Astro.params.tab as string | undefined) ?? HUBS.partners.tabs[0].slug;
const t = useTranslations(lang);

const [pages, partners] = await Promise.all([getHubPages(lang, 'partners'), getPartners(lang)]);
const page = pageForTab(pages, tab);
const hubTab = HUBS.partners.tabs.find((x) => x.slug === tab);
const tabLabel = page?.tabLabel ?? (hubTab ? t(hubTab.label) : tab);

const tiers = PARTNER_TABS[tab] ?? [];
const listed = partners.filter((p: any) => tiers.includes(p.tier));
const logoWall = tab === 'media';
const featured = tab === 'hotel';
const path = hubTabPath('partners', tab);
---

<Base
  lang={lang}
  title={`${t('nav.partners')} — ${tabLabel}`}
  description={page?.seo?.description ?? page?.intro}
  image={page?.seo?.ogImage ?? page?.cover}
  path={path}
  editId={page?._id}
  editType={page?._type}
>
  <HubNav lang={lang} route="partners" active={tab} pages={pages} />

  {page?.intro && <p class="intro-large" {...styleAttrs(page.introStyle)}>{page.intro}</p>}
  {page && <Sections lang={lang} sections={page.sections} />}
  {
    page?.body && (
      <div class="body-24 page-body">
        <PortableText value={page.body} fieldStyle={page.bodyStyle} />
      </div>
    )
  }

  <section class="tier">
    <h2 class="tier-title">{tabLabel}</h2>

    {
      listed.length === 0 ? (
        <p class="empty">{t('partners.empty')}</p>
      ) : logoWall ? (
        <ul class="logos">
          {listed.map((p: any) => (
            <li>
              {p.url ? (
                <a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.name}>
                  {p.logo?.asset ? <SanityImage image={p.logo} sizes="220px" widths={[220, 440, 660]} class="wall-logo" /> : <span class="logo-name" {...styleAttrs(p.nameStyle)}>{p.name}</span>}
                </a>
              ) : p.logo?.asset ? (
                <SanityImage image={p.logo} sizes="220px" widths={[220, 440, 660]} class="wall-logo" />
              ) : (
                <span class="logo-name" {...styleAttrs(p.nameStyle)}>{p.name}</span>
              )}
            </li>
          ))}
        </ul>
      ) : featured ? (
        listed.map((p: any) => (
          <article class="feature">
            <div class="feature-media">
              {p.images?.length > 0 ? (
                <Slideshow images={p.images} aspect={3 / 2} sizes="(max-width: 900px) 100vw, 670px" />
              ) : (
                <Figure pool="fair" seed={p._id} aspect={3 / 2} sizes="(max-width: 900px) 100vw, 670px" widths={[670, 1000, 1340]} alt="" />
              )}
            </div>
            <div class="feature-text">
              <h3 class="name" {...styleAttrs(p.nameStyle)}>{p.name}</h3>
              {p.subtitle && <p class="subtitle" {...styleAttrs(p.subtitleStyle)}>{p.subtitle}</p>}
              {p.description && (
                <div class="body-24 text">
                  <PortableText value={p.description} fieldStyle={p.descriptionStyle} />
                </div>
              )}
              <div class="foot">
                <p class="pills">
                  {p.url && <LinkPill lang={lang} href={p.url} label={t('common.website')} />}
                  {p.instagram && <LinkPill lang={lang} href={instagramUrl(p.instagram)} label={t('common.instagram')} />}
                </p>
                {p.logo?.asset && <SanityImage image={p.logo} sizes="240px" widths={[240, 480]} class="logo" />}
              </div>
            </div>
          </article>
        ))
      ) : (
        <div class="partners">
          {listed.map((p: any) => (
            <article class="partner">
              <h3 class="name" {...styleAttrs(p.nameStyle)}>{p.name}</h3>
              {p.subtitle && <p class="subtitle" {...styleAttrs(p.subtitleStyle)}>{p.subtitle}</p>}
              {p.currentExhibition && <p class="exhibition" {...styleAttrs(p.currentExhibitionStyle)}>{p.currentExhibition}</p>}
              {p.images?.length > 0 && <Slideshow images={p.images} aspect={3 / 2} sizes="(max-width: 900px) 100vw, 670px" class="partner-slides" />}
              {p.description && (
                <div class="body-24 text">
                  <PortableText value={p.description} fieldStyle={p.descriptionStyle} />
                </div>
              )}
              <div class="foot">
                <p class="pills">
                  {p.url && <LinkPill lang={lang} href={p.url} label={t('common.website')} />}
                  {p.instagram && <LinkPill lang={lang} href={instagramUrl(p.instagram)} label={t('common.instagram')} />}
                </p>
                {p.logo?.asset && <SanityImage image={p.logo} sizes="240px" widths={[240, 480]} class="logo" />}
              </div>
            </article>
          ))}
        </div>
      )
    }
  </section>

  {
    page?.images?.length > 0 && (
      <ul class="image-row">
        {page.images.map((img: any) => (
          <li>
            <SanityImage image={img} aspect={3 / 2} sizes="(max-width: 640px) 100vw, 440px" widths={[440, 880]} />
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .page-body :global(h2) {
    text-transform: lowercase;
    border-bottom: 2px solid var(--ink);
    margin: 3rem 0 1.25rem;
    padding-bottom: 0.2rem;
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
    font-weight: 600;
  }
  .page-body :global(p) {
    margin: 0 0 1.5rem;
    max-width: 62ch;
  }

  /* Full-width rule + the tab's name, 60px regular in the design. */
  .tier {
    margin-top: 1rem;
  }
  .tier-title {
    text-transform: lowercase;
    border-top: 1px solid var(--ink);
    padding-top: 0.75rem;
    margin: 0 0 2rem;
    font-size: clamp(1.75rem, 4.2vw, 3.75rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    font-weight: 400;
  }

  /* Two-column list of entries. */
  .partners {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3.5rem 30px;
  }
  .partner {
    display: flex;
    flex-direction: column;
  }

  /* One entry: name over a rule, the text, then pills left / logo right. */
  .name {
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.4rem;
    margin: 0 0 1.1rem;
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
    font-weight: 600;
  }
  .subtitle {
    margin: -0.5rem 0 1rem;
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    letter-spacing: -0.01em;
    color: var(--ink-2);
  }
  .exhibition {
    margin: 0 0 1rem;
    font-weight: 600;
    font-size: clamp(1rem, 1.5vw, 1.5rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
  }
  .text {
    margin: 0 0 1.5rem;
  }
  .text :global(p) {
    margin: 0 0 1em;
  }
  .text :global(p:last-child) {
    margin-bottom: 0;
  }
  .partner :global(.partner-slides) {
    margin: 0 0 1.25rem;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: auto;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
  }
  .pills:empty {
    display: none;
  }
  .foot :global(.logo) {
    max-width: 240px;
    max-height: 120px;
    width: auto;
    height: auto;
    object-fit: contain;
    margin-left: auto;
  }

  /* The hotel: slideshow left, text right. */
  .feature {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 30px;
    align-items: start;
    margin-bottom: 3.5rem;
  }
  .feature-media :global(.slideshow),
  .feature-media :global(img) {
    width: 100%;
  }
  .feature-text {
    display: flex;
    flex-direction: column;
  }

  /* Media partners: a logo wall. */
  .logos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 3rem 30px;
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: center;
  }
  .logos li,
  .logos a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 120px;
    text-decoration: none;
  }
  .logos :global(.wall-logo) {
    max-width: 220px;
    max-height: 100px;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .logo-name {
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-align: center;
  }

  .image-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
  }

  @media (max-width: 900px) {
    .partners,
    .feature,
    .logos {
      gap: 2.5rem 16px;
    }
    .image-row {
      gap: 16px;
    }
  }

  @media (max-width: 800px) {
    .partners,
    .feature {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .image-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .logos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
