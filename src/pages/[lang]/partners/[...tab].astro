---
import Base from '../../../layouts/Base.astro';
import HubNav from '../../../components/HubNav.astro';
import Sections from '../../../components/Sections.astro';
import Slideshow from '../../../components/Slideshow.astro';
import SanityImage from '../../../components/SanityImage.astro';
import PortableText from '../../../components/PortableText.astro';
import LinkPill from '../../../components/LinkPill.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations } from '../../../lib/i18n';
import { getHubPages, getPartners } from '../../../lib/queries';
import { HUBS, PARTNER_TABS, hubTabParams, hubTabPath, pageForTab } from '../../../lib/hubs';
import { instagramUrl } from '../../../lib/links';

/**
 * Partners by tab. Each tab lists one or more tiers; media partners are a
 * logo wall, the others get name + rule + text + logo/slideshow + website.
 */
export function getStaticPaths() {
  return hubTabParams('partners', LOCALE_IDS);
}

const lang = Astro.params.lang as LocaleId;
const tab = (Astro.params.tab as string | undefined) ?? HUBS.partners.tabs[0].slug;
const t = useTranslations(lang);

const [pages, partners] = await Promise.all([getHubPages(lang, 'partners'), getPartners(lang)]);
const page = pageForTab(pages, tab);
const tiers = PARTNER_TABS[tab] ?? [];
const listed = partners.filter((p: any) => tiers.includes(p.tier));
const logoWall = tab === 'media';
const path = hubTabPath('partners', tab);
---

<Base lang={lang} title={`${t('nav.partners')} — ${page?.tabLabel ?? tab}`} description={page?.intro} path={path} editId={page?._id} editType={page?._type}>
  <HubNav lang={lang} route="partners" active={tab} pages={pages} />

  {page?.intro && <p class="lede">{page.intro}</p>}
  {page && <Sections lang={lang} sections={page.sections} />}

  {
    listed.length ? (
      logoWall ? (
        <ul class="logos">
          {listed.map((p: any) => (
            <li>
              <a href={p.url ?? '#'} target="_blank" rel="noopener noreferrer">
                {p.logo?.asset ? <SanityImage image={p.logo} sizes="200px" widths={[200, 400]} /> : p.name}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="two-col">
          {listed.map((p: any) => (
            <article class="partner">
              <h2>{p.name}</h2>
              {p.subtitle && <p class="meta">{p.subtitle}</p>}
              {p.images?.length > 0 && <Slideshow images={p.images} aspect={3 / 2} />}
              {p.description && (
                <div class="prose">
                  <PortableText value={p.description} />
                </div>
              )}
              {p.logo?.asset && <SanityImage image={p.logo} sizes="240px" widths={[240, 480]} class="logo" />}
              <p class="pills">
                {p.url && <LinkPill lang={lang} href={p.url} label={t('common.website')} />}
                {p.instagram && <LinkPill lang={lang} href={instagramUrl(p.instagram)} label={t('common.instagram')} />}
              </p>
            </article>
          ))}
        </div>
      )
    ) : (
      <p class="empty">{t('partners.empty')}</p>
    )
  }
</Base>

<style>
  .partner h2 {
    border-top: 1px solid var(--ink);
    padding-top: 0.5rem;
    margin-top: 0;
    font-weight: 600;
  }
  .partner :global(.logo) {
    max-width: 240px;
    margin: 1rem 0;
  }
  .logos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 2rem;
    list-style: none;
    padding: 0;
    align-items: center;
  }
</style>
