---
import Base from '../../../layouts/Base.astro';
import HubNav from '../../../components/HubNav.astro';
import Sections from '../../../components/Sections.astro';
import PageSections from '../../../components/PageSections.astro';
import SanityImage from '../../../components/SanityImage.astro';
import PortableText from '../../../components/PortableText.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations, localePath } from '../../../lib/i18n';
import { getHubPages, getLaureates, getAwards, getPeople } from '../../../lib/queries';
import { HUBS, hubTabParams, hubTabPath, pageForTab } from '../../../lib/hubs';
import { instagramUrl } from '../../../lib/links';
import { styleAttrs } from '../../../lib/textStyle';

/**
 * The art prize hub on its acid ground, as the design's three art prize
 * pages draw it. About: the cover with its counter, dots and caption beside
 * the intro, the text sections two across, the partners row, the closing
 * images. Laureates: one row per laureate, picture and text alternating
 * sides. Awards: the intro line and a two-column masonry of award blocks.
 * Jury (no design page): the advisory-board article treatment.
 */
export function getStaticPaths() {
  return hubTabParams('art-prize', LOCALE_IDS);
}

const lang = Astro.params.lang as LocaleId;
const hub = HUBS['art-prize'];
const tab = (Astro.params.tab as string | undefined) ?? hub.tabs[0].slug;
const t = useTranslations(lang);

const pages = await getHubPages(lang, 'art-prize');
const page = pageForTab(pages, tab);

// The current edition's laureates; the latest edition with any when the
// current one has none yet.
const laureateYears = tab === 'laureates' ? await getLaureates(lang) : [];
const laureates: any[] = (laureateYears.find((y: any) => y.isCurrent) ?? laureateYears[0])?.laureates ?? [];

// The newest edition's art prize awards - the design lists one edition.
const allAwards = tab === 'awards' ? (await getAwards(lang)).filter((a: any) => a.family === 'art-prize' && a.year) : [];
const awardYear = allAwards[0]?.year;
const awards = allAwards.filter((a: any) => a.year === awardYear);

const jury = tab === 'jury' ? await getPeople(lang, 'jury') : [];

const path = hubTabPath('art-prize', tab);
const tabKey = hub.tabs.find((x) => x.slug === tab)?.label;
const tabLabel = page?.tabLabel ?? (tabKey ? t(tabKey) : tab);

const textSections: any[] = (page?.sections ?? []).filter((s: any) => s?._type === 'contentSection');
const otherSections: any[] = (page?.sections ?? []).filter((s: any) => s?._type !== 'contentSection');
const closing: any[] = (page?.images ?? []).filter((img: any) => img?.asset);

/** "A and B", "A, B and C" - the design writes "and". */
const joiner = (i: number, n: number) => (i === 0 ? '' : i === n - 1 ? ` ${t('common.and')} ` : ', ');
/** "Artist, *Title*, year" as the design captions a picture. */
const captionOf = (img: any, fallback?: string) => ({
  who: img?.caption ?? fallback,
  title: img?.workTitle,
  year: img?.year,
});
---

<Base
  lang={lang}
  title={`${t('nav.artPrize')} — ${tabLabel}`}
  description={page?.seo?.description ?? page?.intro}
  path={path}
  theme="acid"
  image={page?.seo?.ogImage ?? page?.cover}
  editId={page?._id}
  editType={page?._type}
>
  <HubNav lang={lang} route="art-prize" active={tab} pages={pages} dark />

  {
    tab === 'about' && (
      <div class="content-wrap prize-about">
        <div class="hero">
          {page?.cover?.asset ? (
            <figure>
              <SanityImage image={page.cover} loading="eager" sizes="(max-width: 700px) 100vw, 66vw" widths={[600, 900, 1200, 1800]} />
              <span class="dots" aria-hidden="true">
                <i />
              </span>
              <figcaption>
                <b>1/1</b>
                {(page.cover.caption || page.cover.workTitle) && (
                  <span>
                    {captionOf(page.cover).who}
                    {captionOf(page.cover).title && (
                      <>
                        {captionOf(page.cover).who ? ', ' : ''}
                        <em>{captionOf(page.cover).title}</em>
                      </>
                    )}
                    {captionOf(page.cover).year && `, ${captionOf(page.cover).year}`}
                  </span>
                )}
              </figcaption>
            </figure>
          ) : (
            <div />
          )}
          {page?.intro && <p {...styleAttrs(page.introStyle)}>{page.intro}</p>}
        </div>

        {textSections.length > 0 && <Sections lang={lang} sections={textSections} columns={2} statementFirst class="blocks" />}

        {page?.body && (
          <div class="body-24 blocks">
            <PortableText value={page.body} fieldStyle={page.bodyStyle} />
          </div>
        )}

        {otherSections.length > 0 && <PageSections lang={lang} sections={otherSections} />}

        {closing.length > 0 && (
          <div class="gallery">
            {closing.map((img: any) => (
              <SanityImage image={img} aspect={1.5} sizes="(max-width: 700px) 100vw, 33vw" widths={[400, 600, 900, 1200]} />
            ))}
          </div>
        )}
      </div>
    )
  }

  {
    tab === 'laureates' && (
      <div class="content-wrap laureates">
        {page?.intro && <p class="intro-large" {...styleAttrs(page.introStyle)}>{page.intro}</p>}
        {laureates.length ? (
          laureates.map((l: any, i: number) => {
            const artist = l.artist ?? {};
            const images = (l.images ?? []).filter((img: any) => img?.asset);
            const first = images[0] ?? (artist.portrait?.asset ? artist.portrait : null);
            const cap = captionOf(first, artist.name);
            return (
              <article class:list={[{ reverse: i % 2 === 1 }]}>
                <figure>
                  {first ? (
                    <SanityImage image={first} sizes="(max-width: 700px) 100vw, 433px" widths={[433, 866, 1300]} />
                  ) : (
                    <div class="placeholder" />
                  )}
                  {images.length > 0 && (
                    <span class="dots" aria-hidden="true">
                      {images.map(() => (
                        <i />
                      ))}
                    </span>
                  )}
                  <figcaption>
                    <b>1/{Math.max(images.length, 1)}</b>
                    {(cap.who || cap.title) && (
                      <span>
                        {cap.who}
                        {cap.title && `, ${cap.title}`}
                        {cap.year && `, ${cap.year}`}
                      </span>
                    )}
                  </figcaption>
                </figure>
                <section>
                  <div class="name">
                    <h2 {...styleAttrs(artist.nameStyle)}>
                      {artist.slug ? <a href={localePath(lang, `artists/${artist.slug}`)}>{artist.name}</a> : artist.name}
                    </h2>
                    {artist.instagram && (
                      <a class="pill" href={instagramUrl(artist.instagram)} target="_blank" rel="noopener noreferrer">
                        {t('common.instagram')} ↗
                      </a>
                    )}
                  </div>
                  {(artist.birthYear || artist.basedIn) && (
                    <p class="bio">
                      {artist.birthYear && <>°{artist.birthYear}</>}
                      {artist.birthYear && artist.basedIn && <br />}
                      {artist.basedIn && (
                        <>
                          {t('artists.basedIn')} {artist.basedIn}
                        </>
                      )}
                    </p>
                  )}
                  {(l.statement ?? artist.bio) && (
                    <div class="two-col body-24 text">
                      <PortableText value={l.statement ?? artist.bio} fieldStyle={l.statement ? l.statementStyle : artist.bioStyle} />
                    </div>
                  )}
                </section>
              </article>
            );
          })
        ) : (
          <p class="empty">{t('artPrize.noLaureates')}</p>
        )}
      </div>
    )
  }

  {
    tab === 'awards' && (
      <div class="content-wrap awards-page">
        {page?.intro && <p class="intro-large" {...styleAttrs(page.introStyle)}>{page.intro}</p>}
        {awards.length ? (
          <div class="award-grid">
            {awards.map((a: any) => (
              <article>
                <h2 {...styleAttrs(a.nameStyle)}>{a.name}</h2>
                {(a.laureates?.length > 0 || a.outcome) && (
                  <p class="award">
                    →{' '}
                    <u>
                      {(a.laureates ?? []).map((l: any, i: number) => (
                        <>
                          {joiner(i, a.laureates.length)}
                          {l.slug ? <a href={localePath(lang, `artists/${l.slug}`)}>{l.name}</a> : l.name}
                        </>
                      ))}
                      {a.laureates?.length > 0 && a.outcome && ' '}
                      {a.outcome}
                    </u>
                  </p>
                )}
                {a.description && (
                  <div class="body">
                    <PortableText value={a.description} fieldStyle={a.descriptionStyle} />
                  </div>
                )}
                {a.image?.asset && <SanityImage image={a.image} sizes="(max-width: 700px) 100vw, 50vw" widths={[500, 800, 1200]} />}
              </article>
            ))}
          </div>
        ) : (
          <p class="empty">{t('awards.empty')}</p>
        )}
      </div>
    )
  }

  {
    tab === 'jury' && (
      <div class="content-wrap">
        {page?.intro && <p class="intro-large" {...styleAttrs(page.introStyle)}>{page.intro}</p>}
        {jury.length ? (
          <div class="people">
            {jury.map((p: any) => (
              <article>
                <h2>{p.name}</h2>
                <div>
                  {p.portrait?.asset ? <SanityImage image={p.portrait} sizes="197px" widths={[197, 394, 600]} /> : <div class="placeholder" />}
                  <section>
                    {p.role && <strong {...styleAttrs(p.roleStyle)}>{p.role}</strong>}
                    {p.bio && <PortableText value={p.bio} fieldStyle={p.bioStyle} />}
                    {(p.instagram || p.website) && (
                      <p class="links">
                        {p.instagram && (
                          <a class="pill" href={instagramUrl(p.instagram)} target="_blank" rel="noopener noreferrer">
                            {t('common.instagram')} ↗
                          </a>
                        )}
                        {p.website && (
                          <a class="pill" href={p.website} target="_blank" rel="noopener noreferrer">
                            {t('common.website')} ↗
                          </a>
                        )}
                      </p>
                    )}
                  </section>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty">{t('artPrize.noJury')}</p>
        )}
      </div>
    )
  }
</Base>

<style>
  /* From the design's art prize pages. */
  .hero {
    grid-template-columns: 2fr 1fr;
    gap: 40px;
    display: grid;
  }
  .hero figure {
    margin: 0;
    position: relative;
  }
  .hero :global(img) {
    width: 100%;
  }
  .dots {
    gap: 14px;
    display: flex;
    position: absolute;
    bottom: 42px;
    left: 50%;
    transform: translate(-50%);
  }
  .dots i {
    background: #fff;
    border-radius: 50%;
    width: 12px;
    height: 12px;
  }
  figcaption {
    justify-content: space-between;
    padding-top: 6px;
    display: flex;
  }
  .hero > p {
    letter-spacing: -0.04em;
    font-size: 50px;
    line-height: 1.1;
  }
  /* `blocks` is passed to Sections, whose markup carries no scope attribute. */
  :global(.blocks) {
    margin-top: 55px;
  }
  .gallery {
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 55px;
    display: grid;
  }
  .gallery :global(img) {
    aspect-ratio: 1.5;
    object-fit: cover;
    width: 100%;
  }

  .laureates .intro-large {
    margin-bottom: 55px;
  }
  .laureates article {
    grid-template-columns: 433px 1fr;
    gap: 40px;
    margin-bottom: 90px;
    display: grid;
  }
  .laureates article.reverse {
    grid-template-columns: 1fr 433px;
  }
  .laureates figure {
    margin: 0;
    position: relative;
  }
  .reverse figure {
    order: 2;
  }
  .laureates :global(img),
  .laureates .placeholder {
    object-fit: cover;
    width: 433px;
    height: 541px;
    background: #f0efed;
  }
  .laureates .dots {
    bottom: 40px;
  }
  .laureates .dots i {
    width: 10px;
    height: 10px;
  }
  .laureates figcaption {
    padding-top: 5px;
    font-size: 14px;
  }
  .name {
    border-top: 2px solid;
    justify-content: space-between;
    padding-top: 8px;
    display: flex;
  }
  .name h2 {
    font-size: 60px;
    line-height: 1;
  }
  .bio {
    margin: 18px 0 36px;
    font-size: 40px;
    line-height: 1.15;
  }
  /* The design splits the bio's paragraphs across the two columns; the rich
     text arrives in one wrapper, so CSS columns do the same split. */
  .laureates .text {
    display: block;
    columns: 2;
    column-gap: 40px;
  }
  .text :global(p) {
    break-inside: avoid;
  }
  .text :global(p + p) {
    margin-top: 28px;
  }

  .awards-page .intro-large {
    margin-bottom: 0;
  }
  .award-grid {
    columns: 2;
    column-gap: 40px;
    margin-top: 50px;
  }
  .award-grid article {
    break-inside: avoid;
    margin-bottom: 60px;
  }
  .award-grid h2 {
    border-bottom: 2px solid;
    padding-bottom: 8px;
    font-size: 36px;
    font-weight: 600;
  }
  .award {
    margin-top: 25px;
    font-size: 34px;
    line-height: 1.15;
  }
  .body {
    white-space: pre-line;
    margin-top: 28px;
    font-size: 20px;
    line-height: 1.25;
  }
  .body :global(p + p) {
    margin-top: 1.25em;
  }
  .award-grid :global(img) {
    width: 100%;
    margin-top: 36px;
  }

  /* The advisory-board treatment, for the jury. */
  .people {
    grid-template-columns: 1fr 1fr;
    gap: 70px 40px;
    margin-top: 55px;
    display: grid;
  }
  .people h2 {
    letter-spacing: -0.04em;
    border-bottom: 1px solid;
    font-size: 36px;
    font-weight: 600;
  }
  .people article > div {
    grid-template-columns: 197px 1fr;
    gap: 40px;
    margin-top: 28px;
    display: grid;
  }
  .people :global(img),
  .people .placeholder {
    object-fit: cover;
    width: 197px;
    max-height: 270px;
    background: #f0efed;
  }
  .people section {
    font-size: 24px;
    line-height: 1.22;
  }
  .people section :global(p) {
    margin-top: 16px;
  }
  .links {
    gap: 14px;
    display: flex;
  }
  .empty {
    padding-top: 40px;
    font-size: 24px;
  }

  @media (width<=800px) {
    .people {
      grid-template-columns: 1fr;
    }
    .people article > div {
      grid-template-columns: 120px 1fr;
      gap: 18px;
    }
    .people :global(img),
    .people .placeholder {
      width: 120px;
    }
    .people h2 {
      font-size: 28px;
    }
  }
  @media (width<=700px) {
    .hero,
    .gallery {
      grid-template-columns: 1fr;
    }
    .hero > p {
      font-size: 34px;
    }
    figcaption span {
      display: none;
    }
    .laureates article,
    .laureates article.reverse {
      grid-template-columns: 1fr;
    }
    .reverse figure {
      order: 0;
    }
    .laureates :global(img),
    .laureates .placeholder {
      width: 100%;
      height: auto;
    }
    .name h2 {
      font-size: 40px;
    }
    .bio {
      font-size: 28px;
    }
    .laureates .text {
      columns: 1;
    }
    .award-grid {
      columns: 1;
    }
    .award {
      font-size: 28px;
    }
  }
</style>
