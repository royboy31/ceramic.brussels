---
import Base from '../../layouts/Base.astro';
import PortableText from '../../components/PortableText.astro';
import { LOCALE_IDS, type LocaleId } from '../../lib/locales';
import { useTranslations, localePath, formatDate, formatTime } from '../../lib/i18n';
import { getProgramme } from '../../lib/queries';

export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);
const events = await getProgramme(lang);

// Group by calendar day so the schedule reads like a schedule.
const byDay = new Map<string, any[]>();
for (const event of events) {
  const day = event.startsAt?.slice(0, 10) ?? 'tbc';
  if (!byDay.has(day)) byDay.set(day, []);
  byDay.get(day)!.push(event);
}
const days = [...byDay.entries()].sort(([a], [b]) => a.localeCompare(b));
---

<Base lang={lang} title={t('nav.programme')} path="programme">
  <h1>{t('nav.programme')}</h1>

  {
    days.length ? (
      days.map(([day, items]) => (
        <section class="day">
          <h2>{formatDate(day, lang)}</h2>
          <ul class="schedule">
            {items.map((event: any) => (
              <li>
                <div class="time">
                  <time datetime={event.startsAt}>{formatTime(event.startsAt, lang)}</time>
                  {event.endsAt && <span class="meta">&ndash;{formatTime(event.endsAt, lang)}</span>}
                </div>
                <div>
                  <h3>{event.title}</h3>
                  <p class="meta">
                    {[event.kind, event.location].filter(Boolean).join(' · ')}
                  </p>
                  {event.speakers?.length > 0 && (
                    <p class="meta">
                      {t('programme.speakers')}{' '}
                      {event.speakers.map((s: any, i: number) => (
                        <>
                          {i > 0 && ', '}
                          <a href={localePath(lang, `artists/${s.slug}`)}>{s.name}</a>
                        </>
                      ))}
                    </p>
                  )}
                  {event.description && (
                    <div class="prose desc">
                      <PortableText value={event.description} />
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    ) : (
      <p class="empty">
        {t('programme.empty')} Add talks in <a href="/studio">the Studio</a>.
      </p>
    )
  }
</Base>

<style>
  .day h2 {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.4rem;
  }
  .schedule {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .schedule li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .time {
    font-variant-numeric: tabular-nums;
    font-size: 0.92rem;
  }
  .schedule h3 {
    margin: 0 0 0.2rem;
    font-size: 1.02rem;
  }
  .desc {
    margin-top: 0.5rem;
    font-size: 0.94rem;
  }
  @media (max-width: 600px) {
    .schedule li {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
