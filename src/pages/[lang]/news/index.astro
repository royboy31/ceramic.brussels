---
import Base from '../../../layouts/Base.astro';
import SanityImage from '../../../components/SanityImage.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations, localePath, formatDate } from '../../../lib/i18n';
import { getNews } from '../../../lib/queries';

export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);
const news = await getNews(lang);

const [lead, ...rest] = news;
---

<Base lang={lang} title={t('nav.news')} path="news">
  <h1 class="section-title">{t('nav.news')}</h1>

  {
    news.length ? (
      <>
        <a class="lead" href={localePath(lang, `news/${lead.slug}`)}>
          <div class="shot">
            {lead.cover?.asset ? (
              <SanityImage
                image={lead.cover}
                aspect={1.6}
                loading="eager"
                sizes="(max-width: 900px) 100vw, 60vw"
                widths={[600, 900, 1200, 1600]}
              />
            ) : (
              <div class="shot-empty" />
            )}
          </div>

          <div class="lead-text">
            <p class="meta">
              <time datetime={lead.publishedAt}>{formatDate(lead.publishedAt, lang)}</time>
              {lead.category && <span class="cat">{lead.category}</span>}
            </p>
            <h2>{lead.title}</h2>
            {lead.excerpt && <p class="excerpt">{lead.excerpt}</p>}
            <span class="more text-link">{t('news.readMore')} →</span>
          </div>
        </a>

        {rest.length > 0 && (
          <ul class="page-grid feed">
            {rest.map((item: any) => (
              <li class="entry">
                <a href={localePath(lang, `news/${item.slug}`)}>
                  <div class="shot">
                    {item.cover?.asset ? (
                      <SanityImage
                        image={item.cover}
                        aspect={1.5}
                        sizes="(max-width: 640px) 100vw, 33vw"
                        widths={[400, 600, 900]}
                      />
                    ) : (
                      <div class="shot-empty" />
                    )}
                  </div>

                  <p class="meta">
                    <time datetime={item.publishedAt}>{formatDate(item.publishedAt, lang)}</time>
                    {item.category && <span class="cat">{item.category}</span>}
                  </p>
                  <h3>{item.title}</h3>
                  {item.excerpt && <p class="excerpt">{item.excerpt}</p>}
                </a>
              </li>
            ))}
          </ul>
        )}
      </>
    ) : (
      <p class="empty">
        {t('news.empty')} Add posts in <a href="/studio">the Studio</a>.
      </p>
    )
  }
</Base>

<style>
  .shot-empty {
    aspect-ratio: 1.5;
    background: var(--surface-2);
  }
  .shot {
    overflow: hidden;
  }
  .shot :global(img) {
    width: 100%;
    transition: transform 0.5s ease;
  }
  a:hover .shot :global(img) {
    transform: scale(1.025);
  }

  .lead {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 2.5rem;
    align-items: center;
    text-decoration: none;
    border-top: 1px solid var(--ink);
    padding-top: 1.75rem;
    margin-bottom: 3.5rem;
  }
  .lead .shot-empty {
    aspect-ratio: 1.6;
  }
  .lead h2 {
    margin: 0.5rem 0 1rem;
    font-size: clamp(1.75rem, 3.4vw, 3rem);
    line-height: 1;
    letter-spacing: -0.045em;
    font-weight: 400;
  }
  .lead .excerpt {
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    line-height: 1.35;
    margin-bottom: 1.25rem;
  }

  .feed {
    list-style: none;
    margin: 0;
    padding-inline: 0;
    row-gap: 2.5rem;
  }
  .entry {
    grid-column: span 4;
  }
  .entry a {
    display: block;
    text-decoration: none;
  }
  .entry h3 {
    margin: 0.35rem 0 0.5rem;
    font-size: clamp(1.15rem, 1.9vw, 1.6rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 400;
  }
  .entry .excerpt {
    font-size: 0.95rem;
    line-height: 1.35;
    margin: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 0.6rem 0 0;
  }
  .cat {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.05rem 0.7rem;
    font-size: 0.78rem;
    text-transform: lowercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .shot :global(img),
    a:hover .shot :global(img) {
      transition: none;
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .lead {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .entry {
      grid-column: span 6;
    }
  }

  @media (max-width: 640px) {
    .entry {
      grid-column: 1 / -1;
    }
  }
</style>
