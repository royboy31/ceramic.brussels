---
import Base from '../../../layouts/Base.astro';
import SanityImage from '../../../components/SanityImage.astro';
import PortableText from '../../../components/PortableText.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations, localePath, formatDate } from '../../../lib/i18n';
import { getNewsItem, getNewsSlugs } from '../../../lib/queries';

/**
 * One post: date and category, a big title, the excerpt as the lead, the
 * cover, then the body at 24px. Design by Lilanga.
 */
export async function getStaticPaths() {
  const slugs = await getNewsSlugs();
  return LOCALE_IDS.flatMap((lang) => slugs.map(({ slug }) => ({ params: { lang, slug } })));
}

const lang = Astro.params.lang as LocaleId;
const slug = Astro.params.slug as string;
const t = useTranslations(lang);

const item = await getNewsItem(lang, slug);
if (!item) return Astro.rewrite('/404');

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: item.title,
  datePublished: item.publishedAt,
  ...(item.excerpt ? { description: item.excerpt } : {}),
  publisher: { '@type': 'Organization', name: 'Ceramic Brussels' },
};
---

<Base
  lang={lang}
  title={item.seo?.title ?? item.title}
  description={item.seo?.description ?? item.excerpt}
  noIndex={item.seo?.noIndex}
  image={item.seo?.ogImage ?? item.cover}
  path={`news/${slug}`}
  editId={item._id}
  editType={item._type}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

  <article class="post">
    <p class="meta">
      <time datetime={item.publishedAt}>{formatDate(item.publishedAt, lang)}</time>
      {item.category && <span class="cat">{item.category}</span>}
    </p>

    <h1 class="title">{item.title}</h1>
    {item.excerpt && <p class="intro-large">{item.excerpt}</p>}

    {
      item.cover?.asset && (
        <SanityImage
          image={item.cover}
          loading="eager"
          aspect={16 / 9}
          widths={[600, 900, 1200, 1600]}
          sizes="(max-width: 1160px) 100vw, 1160px"
          class="cover"
        />
      )
    }

    {
      item.body && (
        <div class="body-24 post-body">
          <PortableText value={item.body} />
        </div>
      )
    }

    <p class="back-row">
      <a class="text-link" href={localePath(lang, 'news')}>← {t('common.backTo')} {t('nav.news')}</a>
    </p>
  </article>
</Base>

<style>
  .post {
    max-width: 1160px;
  }
  .post .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
  }
  .cat {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.05rem 0.7rem;
    font-size: 0.78rem;
    text-transform: lowercase;
  }
  .title {
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 600;
    margin: 0 0 1.25rem;
  }
  .cover {
    margin: 0 0 2.5rem;
    width: 100%;
  }
  .post-body :global(p) {
    margin: 0 0 1.5rem;
    max-width: 62ch;
  }
  .post-body :global(h2) {
    text-transform: lowercase;
    border-bottom: 2px solid var(--ink);
    margin: 2.5rem 0 1.25rem;
    padding-bottom: 0.2rem;
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    letter-spacing: -0.04em;
    font-weight: 600;
  }
  .back-row {
    margin: 3.5rem 0 0;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
  }
</style>
