---
import Base from '../../../layouts/Base.astro';
import ExhibitorHead from '../../../components/ExhibitorHead.astro';
import PageSections from '../../../components/PageSections.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations, localePath } from '../../../lib/i18n';
import { getArtists, getMainPage, getCurrentEdition } from '../../../lib/queries';
import { styleAttrs } from '../../../lib/textStyle';

/**
 * Every artist, A–Z, as the design's exhibitors/artists/index.html draws it
 * (2026-09-14 build): the exhibitors title band with the artists tab
 * active and the ALL + A–Z row, then the letter sections flowing down two
 * columns: a big initial beside a ruled list, one row per artist with the
 * country code raised after the name and the booth at the right. The
 * letters filter the sections in place; the page is complete without
 * JavaScript. Design by Lilanga.
 */
export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);
// The main page document (Studio → Artists → Artists page): lead, SEO and
// blocks around the list. The list itself never comes from it.
const [artists, page, edition] = await Promise.all([getArtists(lang), getMainPage(lang, 'artists'), getCurrentEdition(lang)]);

/** Files an artist under the first letter of their name, accents folded. */
const initial = (name: string) =>
  (name ?? '')
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .trim()
    .charAt(0)
    .toUpperCase();

const letters = [...new Set(artists.map((a: any) => initial(a.name)))].sort() as string[];
const byLetter = (letter: string) => artists.filter((a: any) => initial(a.name) === letter);
/** The booth of the exhibitor presenting the artist, when one has been given. */
const boothOf = (a: any): string | undefined => a.exhibitors?.find((ex: any) => ex.booth)?.booth;
---

<Base
  lang={lang}
  title={page?.seo?.title ?? page?.title ?? t('nav.artists')}
  description={page?.seo?.description ?? page?.intro}
  noIndex={page?.seo?.noIndex}
  image={page?.seo?.ogImage ?? page?.cover}
  path="artists"
  editId={page?._id}
  editType={page?._type}
>
  <ExhibitorHead lang={lang} active="artists" edition={edition} alphabet={artists.length > 0} />

  {
    page?.intro && (
      <div class="artists-intro">
        <p class="intro-large" {...styleAttrs(page.introStyle)}>
          {page.intro}
        </p>
      </div>
    )
  }

  {
    artists.length ? (
      <>
        <p class="empty" id="no-match" hidden>
          {t('artists.noneMatch')}
        </p>
        <div class="artist-list" id="artist-list">
          {letters.map((letter) => (
            <section id={letter} data-name={letter}>
              <h2>{letter}</h2>
              <ul>
                {byLetter(letter).map((a: any) => {
                  const booth = boothOf(a);
                  return (
                    <li>
                      <a href={localePath(lang, `artists/${a.slug}`)}>
                        <span class="name">
                          {a.name}
                          {a.countryCode && <sup>{a.countryCode}</sup>}
                        </span>
                        {/* BACKEND-REQUEST #1: the round "solo show" badge, before the booth */}
                        {booth && <span class="booth">{booth} ●</span>}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      </>
    ) : (
      <p class="empty">{t('artists.empty')}</p>
    )
  }
  {/* The main page's own blocks, under the list. */}
  {
    (page?.sections?.length ?? 0) > 0 && (
      <div class="content-wrap">
        <PageSections lang={lang} sections={page.sections} />
      </div>
    )
  }
</Base>

<style>
  /* The artists list as the design's exhibitors/artists frame draws it
     (2026-09-15 mock-up): letter sections in two columns, ruled rows. */
  .artists-intro {
    padding: 40px var(--gutter) 0;
  }
  .artist-list {
    columns: 2;
    column-gap: clamp(30px, 4vw, 60px);
    padding: 40px var(--gutter) 100px;
  }
  .artist-list section {
    break-inside: avoid;
    grid-template-columns: 30% 1fr;
    margin-bottom: clamp(40px, 4.5vw, 64px);
    display: grid;
    position: relative;
  }
  /* The rule starts a little in from the letter, which sits over its end. */
  .artist-list section::before {
    content: '';
    border-top: 1px solid;
    position: absolute;
    top: 0;
    left: 12%;
    right: 0;
  }
  .artist-list section[hidden] {
    display: none;
  }
  /* The top of the capital sits on the rule: the box is trimmed to the cap
     height, or pulled up by Noi Grotesk's space above it where trimming is
     not supported. */
  .artist-list h2 {
    font-size: clamp(48px, 5vw, 72px);
    font-weight: 400;
    line-height: 1;
    text-box: trim-both cap alphabetic;
  }
  @supports not (text-box: trim-both cap alphabetic) {
    .artist-list h2 {
      margin-top: -0.135em;
    }
  }
  .artist-list ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .artist-list li {
    border-bottom: 1px solid;
  }
  .artist-list a {
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 0.42em 0;
    font-size: clamp(18px, 1.8vw, 26px);
    line-height: 1.15;
    display: flex;
  }
  .artist-list a:hover .name {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .artist-list sup {
    margin-left: 0.3em;
    font-size: 0.5em;
  }
  .booth {
    flex: none;
    font-size: 0.72em;
    white-space: nowrap;
  }
  .empty {
    margin: 40px var(--gutter) 0;
  }
  @media (width<=900px) {
    .artist-list {
      columns: 1;
    }
  }
  @media (width<=640px) {
    .artist-list section {
      grid-template-columns: 56px 1fr;
    }
    .artist-list section::before {
      left: 24px;
    }
    .artist-list h2 {
      font-size: 42px;
    }
  }
</style>

<script>
  // The letter row filters the sections in place; `#A` in the address
  // pre-selects a letter.
  const head = document.querySelector<HTMLElement>('[data-alphabet]');
  const list = document.getElementById('artist-list');
  const noMatch = document.getElementById('no-match');

  if (head && list && noMatch) {
    const buttons = Array.from(head.querySelectorAll<HTMLButtonElement>('button[data-letter]'));
    const sections = Array.from(list.querySelectorAll<HTMLElement>('section[data-name]'));
    let letter = 'ALL';

    const apply = () => {
      let visible = 0;
      for (const section of sections) {
        const match = letter === 'ALL' || section.dataset.name === letter;
        section.hidden = !match;
        if (match) visible++;
      }
      noMatch.hidden = visible > 0;
      for (const b of buttons) {
        const on = (b.dataset.letter ?? 'ALL') === letter;
        b.classList.toggle('active', on);
        b.setAttribute('aria-pressed', String(on));
      }
    };

    for (const b of buttons) {
      b.addEventListener('click', () => {
        letter = b.dataset.letter ?? 'ALL';
        history.replaceState(null, '', letter === 'ALL' ? location.pathname + location.search : `#${letter}`);
        apply();
      });
    }
    if (/^#[A-Za-z]$/.test(location.hash)) {
      letter = location.hash.slice(1).toUpperCase();
      apply();
    }
  }
</script>
