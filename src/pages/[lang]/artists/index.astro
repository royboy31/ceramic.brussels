---
import Base from '../../../layouts/Base.astro';
import ExhibitorHead from '../../../components/ExhibitorHead.astro';
import PageSections from '../../../components/PageSections.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations, localePath } from '../../../lib/i18n';
import { getArtists, getMainPage, getCurrentEdition } from '../../../lib/queries';
import { artistHref } from '../../../lib/links';
import { styleAttrs } from '../../../lib/textStyle';

/**
 * Every artist, A–Z, as the design's exhibitors/artists/index.html draws it
 * (2026-09-14 build): the exhibitors title band with the artists tab
 * active, the A–Z row and the FILTERS row, then the letter sections dealt
 * into two balanced columns: a big initial beside a ruled list, one row per
 * artist with the country code raised after the name and the booth at the
 * right. The
 * letters and pills filter the list in place; the page is complete without
 * JavaScript. Design by Lilanga.
 */
export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);
// The main page document (Studio → Artists → Artists page): lead, SEO and
// blocks around the list. The list itself never comes from it.
const [artists, page, edition] = await Promise.all([getArtists(lang), getMainPage(lang, 'artists'), getCurrentEdition(lang)]);

/** Files an artist under the first letter of their name, accents folded. */
const initial = (name: string) =>
  (name ?? '')
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .trim()
    .charAt(0)
    .toUpperCase();

const letters = [...new Set(artists.map((a: any) => initial(a.name)))].sort() as string[];
const byLetter = (letter: string) => artists.filter((a: any) => initial(a.name) === letter);
/**
 * The exhibitor presenting the artist at this edition - for the booth and the
 * solo-show badge. Past editions' exhibitors are linked too, so without the
 * `current` flag the list could show an old booth (backend request #1).
 */
const showingNow = (a: any) => a.exhibitors?.find((ex: any) => ex.current);

/**
 * The FILTERS row of the frame: solo show, focus, publishers, jury prize,
 * awards. Only the solo show can be told from what `getArtists` returns.
 * BACKEND-REQUEST #4: `exhibitors[]` needs `_id`, `kind` and `inCountryFocus`
 * for the focus, publishers, jury prize and awards pills; until then they are
 * left out rather than guessed.
 */
const rowFilters = (a: any) => [showingNow(a)?.soloShow && 'solo-show'].filter(Boolean).join(' ');
const filters = [{ id: 'solo-show', label: t('exhibitors.soloShow'), has: (a: any) => showingNow(a)?.soloShow }].filter((f) =>
  artists.some(f.has),
);

/**
 * The letters flow into two columns the way the frame stacks them: each letter
 * goes to whichever column is shorter so far, measured in rows plus the room a
 * letter's heading takes. The script re-deals them when a filter hides rows;
 * on a narrow screen the columns dissolve and `order` keeps A–Z.
 */
const HEADING_ROWS = 1.5;
const columns: string[][] = [[], []];
const heights = [0, 0];
for (const letter of letters) {
  const col = heights[0] <= heights[1] ? 0 : 1;
  columns[col].push(letter);
  heights[col] += byLetter(letter).length + HEADING_ROWS;
}
---

<Base
  lang={lang}
  title={page?.seo?.title ?? page?.title ?? t('nav.artists')}
  description={page?.seo?.description ?? page?.intro}
  noIndex={page?.seo?.noIndex}
  image={page?.seo?.ogImage ?? page?.cover}
  path="artists"
  editId={page?._id}
  editType={page?._type}
>
  <ExhibitorHead lang={lang} active="artists" edition={edition} alphabet={artists.length > 0} />

  {
    page?.intro && (
      <div class="artists-intro">
        <p class="intro-large" {...styleAttrs(page.introStyle)}>
          {page.intro}
        </p>
      </div>
    )
  }

  {
    artists.length ? (
      <>
        {filters.length > 0 && (
          <div class="filters" id="artist-filters">
            <span>{t('exhibitors.filters')}:</span>
            {filters.map((f) => (
              <button type="button" data-filter={f.id} aria-pressed="false">
                {f.label}
              </button>
            ))}
          </div>
        )}
        <p class="empty" id="no-match" hidden>
          {t('artists.noneMatch')}
        </p>
        <div class="artist-list" id="artist-list">
          {columns.map((column) => (
            <div class="artist-column" data-column>
              {column.map((letter) => (
                <section id={letter} data-name={letter} style={`order: ${letters.indexOf(letter)}`}>
                  <h2>{letter}</h2>
                  <ul>
                    {byLetter(letter).map((a: any) => {
                      const ex = showingNow(a);
                      return (
                        <li data-filters={rowFilters(a)}>
                          {/* The name leads to the gallery presenting the artist (client, 2026-09-22);
                              an artist no gallery lists is a plain row. */}
                          <a href={artistHref(lang, a)}>
                            <span class="name">
                              {a.name}
                              {a.countryCode && <sup>{a.countryCode}</sup>}
                            </span>
                            {(ex?.soloShow || ex?.booth) && (
                              <span class="tail">
                                {ex.soloShow && (
                                  <img class="solo" src="/assets/exhibitors/solo-show.png" alt={t('exhibitors.soloShow')} width="30" height="30" />
                                )}
                                {ex.booth && <span class="booth">{ex.booth} ●</span>}
                              </span>
                            )}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </section>
              ))}
            </div>
          ))}
        </div>
      </>
    ) : (
      <p class="empty">{t('artists.empty')}</p>
    )
  }
  {/* The main page's own blocks, under the list. */}
  {
    (page?.sections?.length ?? 0) > 0 && (
      <div class="content-wrap">
        <PageSections lang={lang} sections={page.sections} />
      </div>
    )
  }
</Base>

<style>
  /* The artists list as the design's exhibitors/artists frame draws it
     (2026-09-15 mock-up): letter sections in two columns, ruled rows. */
  .artists-intro {
    padding: 40px var(--gutter) 0;
  }
  /* The FILTERS row, as on the galleries list (ExhibitorsListing.astro). */
  .filters {
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding: 30px var(--gutter) 0;
    display: flex;
  }
  .filters span {
    margin-right: 6px;
    text-transform: uppercase;
    font-size: 26px;
    line-height: 1;
    letter-spacing: -0.05em;
  }
  /* Thin like the footer pills (client feedback, 2026-09-16). */
  .filters button {
    border: 1px solid;
    border-radius: 999px;
    padding: 1px 12px 0;
    font-size: 18px;
    line-height: 1.5;
    letter-spacing: -0.02em;
    background: #fff;
    cursor: pointer;
    transition:
      color 0.18s,
      background-color 0.18s;
  }
  /* A chosen pill says it can be undone: a × before its label. */
  .filters button[aria-pressed='true']::before {
    content: '×';
    margin-right: 0.3em;
  }
  .filters button[aria-pressed='true'],
  .filters button:hover {
    color: #fff;
    background: #000;
  }
  /* Two columns 42px apart, each a stack of letters (see the frontmatter). */
  .artist-list {
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 42px;
    padding: 54px var(--gutter) 100px;
    display: grid;
  }
  .artist-column {
    min-width: 0;
  }
  .artist-list section {
    grid-template-columns: 35% 1fr;
    margin-bottom: clamp(40px, 4.5vw, 64px);
    display: grid;
    position: relative;
  }
  /* The rule starts a little in from the letter, which sits over its end. */
  /* A heavier rule beside the letter (client feedback, 2026-09-16), eased
     back from 3px on 2026-09-23 ("line less thick here"). */
  .artist-list section::before {
    content: '';
    border-top: 2px solid;
    position: absolute;
    top: 0;
    left: 12%;
    right: 0;
  }
  .artist-list section[hidden],
  .artist-list li[hidden] {
    display: none;
  }
  /* The top of the capital sits on the rule: the box is trimmed to the cap
     height, or pulled up by Noi Grotesk's space above it where trimming is
     not supported. */
  .artist-list h2 {
    font-size: clamp(48px, 6.5vw, 94px);
    font-weight: 400;
    line-height: 1;
    text-box: trim-both cap alphabetic;
  }
  @supports not (text-box: trim-both cap alphabetic) {
    .artist-list h2 {
      margin-top: -0.135em;
    }
  }
  .artist-list ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .artist-list li {
    border-bottom: 1px solid;
  }
  /* Client feedback, 2026-09-16: tighter names, the country code bigger and
     hung from the top of the capitals as on the exhibitor cards, and the
     whole row turning acid on hover instead of an underline. Rows are 56px
     apart at full size, as in the frame. */
  .artist-list a {
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 0.48em 0;
    font-size: clamp(18px, 1.8vw, 26px);
    line-height: 1.15;
    letter-spacing: -0.04em;
    display: flex;
    transition: background-color 0.18s;
  }
  .artist-list a:hover,
  .artist-list a:focus-visible {
    background: var(--color-acid);
  }
  /* Bigger than it was (client feedback, 2026-09-23). */
  .artist-list sup {
    margin-left: 0.3em;
    font-size: 0.62em;
    letter-spacing: 0;
    line-height: 1;
    vertical-align: top;
    position: relative;
    top: 0.12em;
  }
  .tail {
    flex: none;
    align-items: center;
    gap: 10px;
    display: inline-flex;
  }
  .booth {
    font-size: 0.72em;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  /* The round black "solo show" badge of the exhibitor cards, at list size:
     30px across - no taller than the name, so the row keeps its pitch - with
     the two words still readable. */
  /* The designer's solo show disc (2026-09-24). */
  .solo {
    flex: none;
    width: 30px;
    height: 30px;
  }
  .empty {
    margin: 40px var(--gutter) 0;
  }
  /* One column: the two stacks dissolve and each letter's `order` keeps A–Z. */
  @media (width<=900px) {
    .artist-list {
      grid-template-columns: 1fr;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .artist-column {
      display: contents;
    }
  }
  @media (width<=640px) {
    .artist-list section {
      grid-template-columns: 56px 1fr;
    }
    .artist-list section::before {
      left: 24px;
    }
    .artist-list h2 {
      font-size: 42px;
    }
    .filters span {
      font-size: 20px;
    }
  }
</style>

<script>
  // The letter row and the pills filter the list in place; `#A` in the
  // address pre-selects a letter, and clicking the chosen letter again clears
  // it. After each change the letters still showing are dealt into the two
  // columns again, each to the shorter one, so a filtered list stays balanced.
  const head = document.querySelector<HTMLElement>('[data-alphabet]');
  const bar = document.getElementById('artist-filters');
  const list = document.getElementById('artist-list');
  const noMatch = document.getElementById('no-match');

  if (list && noMatch) {
    const letters = Array.from(head?.querySelectorAll<HTMLButtonElement>('button[data-letter]') ?? []);
    const pills = Array.from(bar?.querySelectorAll<HTMLButtonElement>('button[data-filter]') ?? []);
    const columns = Array.from(list.querySelectorAll<HTMLElement>('[data-column]'));
    // A–Z, whichever column each starts in.
    const sections = Array.from(list.querySelectorAll<HTMLElement>('section[data-name]')).sort((a, b) =>
      (a.dataset.name ?? '').localeCompare(b.dataset.name ?? ''),
    );
    // '' is no letter chosen: every section.
    let letter = '';

    const deal = () => {
      const heights = columns.map(() => 0);
      for (const section of sections) {
        if (section.hidden) continue;
        const col = heights[0] <= heights[1] ? 0 : 1;
        columns[col].append(section);
        heights[col] += section.querySelectorAll('li:not([hidden])').length + 1.5;
      }
    };

    const apply = () => {
      const active = pills.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.dataset.filter!);
      let visible = 0;
      for (const section of sections) {
        let rows = 0;
        for (const li of section.querySelectorAll<HTMLElement>('li')) {
          const has = (li.dataset.filters ?? '').split(' ');
          li.hidden = !active.every((f) => has.includes(f));
          if (!li.hidden) rows++;
        }
        section.hidden = rows === 0 || (!!letter && section.dataset.name !== letter);
        if (!section.hidden) visible++;
      }
      noMatch.hidden = visible > 0;
      for (const b of letters) {
        const on = b.dataset.letter === letter;
        b.classList.toggle('active', on);
        b.setAttribute('aria-pressed', String(on));
      }
      if (columns.length === 2) deal();
    };

    for (const b of letters) {
      b.addEventListener('click', () => {
        letter = b.dataset.letter === letter ? '' : (b.dataset.letter ?? '');
        history.replaceState(null, '', letter ? `#${letter}` : location.pathname + location.search);
        apply();
      });
    }
    for (const b of pills) {
      b.addEventListener('click', () => {
        b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        apply();
      });
    }
    if (/^#[A-Za-z]$/.test(location.hash)) {
      letter = location.hash.slice(1).toUpperCase();
      apply();
    }
  }
</script>
