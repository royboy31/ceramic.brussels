---
import Base from '../../../layouts/Base.astro';
import Figure from '../../../components/Figure.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations, localePath } from '../../../lib/i18n';
import { getArtists } from '../../../lib/queries';
import { styleAttrs } from '../../../lib/textStyle';

/**
 * Every artist, A–Z: the letter index filters the card grid in place, the
 * page is complete without JavaScript. Design by Lilanga.
 */
export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);
const artists = await getArtists(lang);

const LETTERS = 'abcdefghijklmnopqrstuvwxyz'.split('');

/** Files an artist under the first letter of their name, accents folded. */
const initial = (name: string) =>
  (name ?? '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .trim()
    .charAt(0)
    .toLowerCase();

const used = new Set(artists.map((a: any) => initial(a.name)));
---

<Base lang={lang} title={t('nav.artists')} path="artists">
  <h1 class="section-title">{t('nav.artists')}</h1>

  {
    artists.length ? (
      <>
        <nav class="alphabet" aria-label={t('exhibitors.byLetter')}>
          {LETTERS.map((letter, i) => (
            <>
              {i > 0 && (
                <span class="dash" aria-hidden="true">
                  –
                </span>
              )}
              {used.has(letter) ? (
                <button type="button" data-letter={letter} aria-pressed="false">
                  {letter}
                </button>
              ) : (
                <span class="letter-off">{letter}</span>
              )}
            </>
          ))}
        </nav>

        <p class="empty" id="no-match" hidden>
          {t('exhibitors.noneMatch')}
        </p>

        <ul class="page-grid cards" id="artist-list">
          {artists.map((a: any) => (
            <li class="card" data-letter={initial(a.name)}>
              <a href={localePath(lang, `artists/${a.slug}`)}>
                <div class="thumb">
                  <Figure
                    image={a.portrait}
                    pool="portrait"
                    seed={a.slug}
                    aspect={0.8}
                    sizes="(max-width: 640px) 50vw, (max-width: 900px) 33vw, 25vw"
                    widths={[300, 500, 700, 900]}
                  />
                  {a.isGuestOfHonour && <span class="badge">{t('artists.guestOfHonour')}</span>}
                </div>

                <h2>
                  {a.name}
                  {a.birthYear && <sup>°{a.birthYear}</sup>}
                </h2>
                {a.nationality && <p class="meta" {...styleAttrs(a.nationalityStyle)}>{a.nationality}</p>}
              </a>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <p class="empty">
        {t('artists.empty')} Add them in <a href="/studio">the Studio</a>.
      </p>
    )
  }
</Base>

<style>
  .section-title {
    margin-bottom: 1.25rem;
  }

  .alphabet {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.35em;
    font-size: clamp(1.25rem, 3.2vw, 2.6rem);
    letter-spacing: -0.04em;
  }
  .alphabet button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .alphabet button:hover,
  .alphabet button[aria-pressed='true'] {
    background: var(--acid);
  }
  .letter-off,
  .dash {
    color: var(--ink-3);
  }

  .cards {
    list-style: none;
    margin: 2rem 0 0;
    row-gap: 1.75rem;
    padding-inline: 0;
  }
  .card {
    grid-column: span 3;
  }
  .card[hidden] {
    display: none;
  }
  .card a {
    display: block;
    text-decoration: none;
  }

  .thumb {
    position: relative;
    overflow: hidden;
  }
  .thumb :global(img) {
    width: 100%;
    transition: transform 0.5s ease;
  }
  .card a:hover .thumb :global(img) {
    transform: scale(1.025);
  }

  .badge {
    position: absolute;
    right: 0.6rem;
    top: 0.6rem;
    background: var(--ink);
    color: var(--ground);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    font-size: 0.72rem;
    line-height: 1.1;
    max-width: 5.5rem;
    text-align: center;
    text-transform: lowercase;
  }

  .card h2 {
    margin: 0.5rem 0 0;
    font-size: clamp(1.15rem, 2vw, 1.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 400;
  }
  .card sup {
    font-size: 0.5em;
    letter-spacing: normal;
    margin-left: 0.2em;
  }
  .card .meta {
    margin: 0.25rem 0 0;
  }

  #no-match {
    margin-top: 2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb :global(img),
    .card a:hover .thumb :global(img) {
      transition: none;
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .card {
      grid-column: span 4;
    }
  }

  @media (max-width: 640px) {
    .card {
      grid-column: span 2;
    }
  }
</style>

<script>
  const list = document.getElementById('artist-list');
  const noMatch = document.getElementById('no-match');

  if (list && noMatch) {
    const cards = [...list.querySelectorAll<HTMLLIElement>('li.card')];
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-letter][aria-pressed]')];
    let letter = '';

    for (const button of buttons) {
      button.addEventListener('click', () => {
        letter = button.dataset.letter === letter ? '' : (button.dataset.letter ?? '');

        let visible = 0;
        for (const card of cards) {
          const match = !letter || card.dataset.letter === letter;
          card.hidden = !match;
          if (match) visible++;
        }

        noMatch.hidden = visible > 0;
        for (const other of buttons) {
          other.setAttribute('aria-pressed', String(other.dataset.letter === letter));
        }
      });
    }
  }
</script>
