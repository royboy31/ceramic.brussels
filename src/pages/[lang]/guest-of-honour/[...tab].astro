---
import Base from '../../../layouts/Base.astro';
import SanityImage from '../../../components/SanityImage.astro';
import PortableText from '../../../components/PortableText.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations, localePath } from '../../../lib/i18n';
import { getGuestOfHonour, getHubPages } from '../../../lib/queries';
import { HUBS, hubTabParams, hubTabPath, hubTabHref } from '../../../lib/hubs';
import { urlFor } from '../../../sanity/image';
import { styleAttrs } from '../../../lib/textStyle';

/**
 * The current edition's guest of honour, as the design's guest-of-honour
 * page draws it: the `.subnav` band (title, about / interview), the portrait
 * on four columns beside the intro (name and "°1983, France" on a rule, the
 * lead, the biography in two columns), two works with their captions, the
 * "sculptural practice" section on the right eight columns, and the film
 * still with its play button. The interview tab shows the interview text in
 * the intro column instead of the biography. Everything comes from the artist
 * document the edition points at: `intro`, the `sections` stack (biography,
 * sculptural practice), `works`, `video`, `interview`.
 */
export function getStaticPaths() {
  return hubTabParams('guest-of-honour', LOCALE_IDS);
}

const lang = Astro.params.lang as LocaleId;
const hub = HUBS['guest-of-honour'];
const tab = (Astro.params.tab as string | undefined) ?? hub.tabs[0].slug;
const t = useTranslations(lang);

const [data, pages] = await Promise.all([getGuestOfHonour(lang), getHubPages(lang, 'guest-of-honour')]);
const artist = data?.artist;
const path = hubTabPath('guest-of-honour', tab);

const origin = [artist?.birthYear && `°${artist.birthYear}`, artist?.nationality].filter(Boolean).join(', ');
const sections: any[] = (artist?.sections ?? []).filter((s: any) => s?._type === 'contentSection' && s.body);
// The Biography field first, where an editor looks for it. A guest whose
// biography is still the first text block of the stack (how the 2027 one was
// seeded) keeps it from there.
const biography = artist?.bio ? null : sections[0];
const rest = artist?.bio ? sections : sections.slice(1);
const works: any[] = (artist?.works ?? []).filter((w: any) => w?.image?.asset);
const video = artist?.video?.url ? artist.video : null;
const poster = video?.poster?.asset ? video.poster : null;
const posterSrc = poster ? urlFor(poster).width(1814).height(1208).fit('crop').auto('format').quality(80).url() : null;

const tabs = hub.tabs.map((x) => {
  const page = pages.find((p: any) => p?.slugs?.en === x.slug);
  return { slug: x.slug, label: page?.tabLabel ?? t(x.label), href: localePath(lang, hubTabHref('guest-of-honour', x)) };
});
/** "Artist, *Title*, year" under a work. */
const caption = (img: any, work: any) => [img.caption ?? artist?.name, img.workTitle ?? work.title, img.year ?? work.year].filter(Boolean);
---

<Base
  lang={lang}
  title={artist?.seo?.title ?? (artist?.name ? `${t('nav.guestOfHonour')} — ${artist.name}` : t('nav.guestOfHonour'))}
  description={artist?.seo?.description}
  noIndex={artist?.seo?.noIndex}
  path={path}
  image={artist?.seo?.ogImage ?? artist?.portrait}
  editId={artist?._id}
  editType={artist?._type}
>
  <header class="subnav page-grid">
    <h1>{t(hub.title)}</h1>
    <nav>
      {
        tabs.map((x) => (
          <a class:list={[{ active: x.slug === tab }]} href={x.href} aria-current={x.slug === tab ? 'page' : undefined}>
            {x.label}
          </a>
        ))
      }
    </nav>
  </header>

  {
    !artist ? (
      <p class="empty content-wrap">{t('artists.empty')}</p>
    ) : (
      <div id={tab} class="guest-page page-grid">
        {artist.portrait?.asset ? (
          <SanityImage
            image={artist.portrait}
            class="portrait"
            loading="eager"
            sizes="(max-width: 700px) 100vw, 33vw"
            widths={[500, 800, 1000, 1400]}
          />
        ) : (
          <div class="portrait bg-neutral-100" />
        )}

        <section class="intro">
          <div class="title-row">
            <h2 {...styleAttrs(artist.nameStyle)}>{artist.name}</h2>
            {origin && <p>{origin}</p>}
          </div>

          {tab === 'interview' ? (
            artist.interview ? (
              <div class="lead interview">
                <PortableText value={artist.interview} fieldStyle={artist.interviewStyle} />
              </div>
            ) : (
              <p class="lead">{t('artists.interviewSoon')}</p>
            )
          ) : (
            <>
              {artist.intro && (
                <div class="lead">
                  <PortableText value={artist.intro} fieldStyle={artist.introStyle} />
                </div>
              )}
              {biography ? (
                <>
                  <h3 {...styleAttrs(biography.headingStyle)}>{biography.heading ?? t('artists.biography')}</h3>
                  <div class="columns body-copy">
                    <PortableText value={biography.body} fieldStyle={biography.bodyStyle} />
                  </div>
                </>
              ) : (
                artist.bio && (
                  <>
                    <h3>{t('artists.biography')}</h3>
                    <div class="columns body-copy">
                      <PortableText value={artist.bio} fieldStyle={artist.bioStyle} />
                    </div>
                  </>
                )
              )}
            </>
          )}
        </section>

        {tab !== 'interview' && works.length > 0 && (
          <section class="gallery col-span-full">
            {works.slice(0, 2).map((w: any) => (
              <figure>
                <SanityImage image={w.image} widths={[670, 1000, 1340]} sizes="(max-width: 700px) 100vw, 670px" />
                <figcaption>{caption(w.image, w).join(', ')}</figcaption>
              </figure>
            ))}
          </section>
        )}

        {tab !== 'interview' &&
          rest.map((s: any) => (
            <section class="practice col-start-5 col-span-8" id={s.anchor || undefined}>
              <h3 {...styleAttrs(s.headingStyle)}>{s.heading}</h3>
              <div class="columns body-copy">
                <PortableText value={s.body} fieldStyle={s.bodyStyle} />
              </div>
            </section>
          ))}

        {video && (
          <a id="interview-film" class="video col-span-8" href={video.url} target="_blank" rel="noreferrer">
            {posterSrc && (
              <img src={posterSrc} alt={poster.alt ?? video.title ?? `${artist.name} — ${t('common.video')}`} width="1814" height="1208" />
            )}
            <span aria-hidden="true">▶</span>
          </a>
        )}
      </div>
    )
  }
</Base>

<style>
  /* From the design's guest-of-honour.css. */
  .subnav {
    align-items: center;
    height: 115px;
  }
  .subnav h1 {
    text-transform: lowercase;
    letter-spacing: -0.03em;
    grid-column: span 7;
    font-size: 70px;
    font-weight: 600;
    line-height: 65px;
  }
  .subnav nav {
    grid-column: span 5;
    justify-content: flex-end;
    gap: 20px;
    display: flex;
  }
  .subnav a {
    border: 1px solid;
    padding: 4px 20px;
    font-size: 28px;
  }
  .subnav a.active {
    background: #fff350;
  }
  .guest-page {
    padding-top: 22px;
    padding-bottom: 100px;
  }
  /* The portrait is a SanityImage, whose <img> carries no scope attribute. */
  :global(.portrait) {
    object-fit: cover;
    grid-column: span 4;
    width: 100%;
    height: 607px;
  }
  .intro {
    grid-column: span 8;
  }
  .title-row {
    border-top: 2px solid;
    justify-content: space-between;
    padding-top: 6px;
    display: flex;
  }
  .title-row h2 {
    letter-spacing: -0.05em;
    font-size: 60px;
    line-height: 60px;
  }
  .title-row p {
    letter-spacing: -0.04em;
    font-size: 40px;
    line-height: 42px;
  }
  .lead {
    letter-spacing: -0.04em;
    margin-top: 28px;
    font-size: 40px;
    line-height: 50px;
  }
  .lead :global(p + p) {
    margin-top: 28px;
  }
  .intro h3,
  .practice h3 {
    letter-spacing: -0.04em;
    border-bottom: 2px solid;
    margin-top: 82px;
    font-size: 40px;
    font-weight: 600;
    line-height: 48px;
  }
  .columns {
    columns: 2;
    column-gap: 40px;
  }
  .body-copy {
    letter-spacing: -0.03em;
    padding-top: 28px;
    font-size: 24px;
    line-height: 30px;
  }
  .body-copy :global(p) {
    break-inside: avoid;
  }
  .body-copy :global(p + p) {
    margin-top: 30px;
  }
  .gallery {
    grid-template-columns: 670px 670px;
    gap: 40px;
    margin-top: 109px;
    display: grid;
    overflow: hidden;
  }
  .gallery :global(img) {
    object-fit: cover;
    width: 670px;
    height: 447px;
  }
  .gallery figcaption {
    text-align: center;
    font-size: 16px;
    line-height: 30px;
  }
  .practice {
    margin-top: 50px;
  }
  .practice h3 {
    margin-top: 0;
  }
  .video {
    margin-top: 56px;
    position: relative;
  }
  .video img {
    aspect-ratio: 907 / 604;
    object-fit: cover;
    width: 100%;
  }
  .video span {
    background: #fff;
    border-radius: 33px;
    place-items: center;
    width: 187px;
    height: 162px;
    padding-left: 12px;
    font-size: 90px;
    display: grid;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  .empty {
    padding-top: 40px;
  }
  @media (width<=700px) {
    .subnav {
      height: auto;
      padding-block: 16px;
    }
    .subnav h1 {
      grid-column: 1 / -1;
      font-size: 42px;
      line-height: 1;
    }
    .subnav nav {
      grid-column: 1 / -1;
      justify-content: flex-start;
      margin-top: 15px;
    }
    .subnav a {
      font-size: 20px;
    }
    :global(.portrait),
    .intro,
    .practice,
    .video {
      grid-column: 1 / -1;
    }
    :global(.portrait) {
      height: auto;
    }
    .intro {
      padding-top: 20px;
    }
    .title-row h2 {
      font-size: 38px;
      line-height: 1;
    }
    .title-row p {
      font-size: 22px;
      line-height: 1;
    }
    .lead {
      font-size: 27px;
      line-height: 1.1;
    }
    .intro h3,
    .practice h3 {
      margin-top: 48px;
      font-size: 30px;
    }
    .columns {
      columns: 1;
    }
    .body-copy {
      font-size: 18px;
      line-height: 1.3;
    }
    .gallery {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-top: 60px;
    }
    .gallery :global(img) {
      width: 100%;
      height: auto;
    }
    .video span {
      border-radius: 18px;
      width: 90px;
      height: 78px;
      font-size: 40px;
    }
  }
</style>
