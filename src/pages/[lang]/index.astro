---
import Base from '../../layouts/Base.astro';
import SanityImage from '../../components/SanityImage.astro';
import { LOCALE_IDS, type LocaleId } from '../../lib/locales';
import { useTranslations, localePath, formatDate, formatDateRange } from '../../lib/i18n';
import { getCurrentEdition, getNews, getArtists, getPartners, getSettings } from '../../lib/queries';

export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);

const [edition, news, artists, partners, settings] = await Promise.all([
  getCurrentEdition(lang),
  getNews(lang),
  getArtists(lang),
  getPartners(lang),
  getSettings(lang),
]);

const latest = news.slice(0, 3);
const guest = artists.find((a: any) => a.isGuestOfHonour);
// The spotlight is whichever main partner is ordered first in the Studio.
const spotlight = partners.find((p: any) => p.tier === 'main');

const headline = settings?.tagline ?? edition?.title ?? settings?.siteName;

const eventSchema = edition
  ? {
      '@context': 'https://schema.org',
      '@type': 'ExhibitionEvent',
      name: edition.title ?? `Ceramic Brussels ${edition.year}`,
      startDate: edition.startDate,
      endDate: edition.endDate,
      eventStatus: 'https://schema.org/EventScheduled',
      location: { '@type': 'Place', name: edition.venue, address: 'Brussels, Belgium' },
      organizer: { '@type': 'Organization', name: 'Ceramic Brussels' },
      ...(edition.ticketsUrl ? { offers: { '@type': 'Offer', url: edition.ticketsUrl } } : {}),
    }
  : null;
---

<Base
  lang={lang}
  title={settings?.siteName ?? 'Ceramic Brussels'}
  description={settings?.tagline ?? edition?.title}
  image={edition?.cover}
>
  {eventSchema && <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} slot="head" />}

  <section class="page-grid hero">
    <div class="hero-shot">
      {
        edition?.cover?.asset ? (
          <SanityImage
            image={edition.cover}
            aspect={1.4}
            loading="eager"
            sizes="(max-width: 640px) 100vw, 66vw"
            widths={[600, 900, 1200, 1600, 2000]}
          />
        ) : (
          <div class="hero-empty" />
        )
      }
    </div>

    <div class="hero-text">
      <h1 class="display">{headline}</h1>

      {
        edition && (
          <p class="hero-dates">
            {formatDateRange(edition.startDate, edition.endDate, lang)}
            {edition.venue && <> · {edition.venue}</>}
          </p>
        )
      }

      <p class="hero-links">
        {edition?.ticketsUrl && (
          <a class="text-link" href={edition.ticketsUrl}>
            {t('home.tickets')} →
          </a>
        )}
      </p>
    </div>
  </section>

  <nav class="quicklinks" aria-label={settings?.siteName ?? 'Ceramic Brussels'}>
    <a href={localePath(lang, 'exhibitors')}>{t('nav.exhibitors')}</a>
    <a href={localePath(lang, 'awards')}>{t('nav.awards')}</a>
    <a href={localePath(lang, 'programme')}>{t('nav.programme')}</a>
    {edition?.catalogueUrl && <a href={edition.catalogueUrl}>{t('home.catalogue')}</a>}
  </nav>

  {
    guest && (
      <section class="page-grid feature">
        <div class="feature-text">
          <p class="eyebrow">{t('artists.guestOfHonour')}</p>
          <h2>{guest.name}</h2>
          {guest.nationality && <p class="feature-meta">{guest.nationality}</p>}
          <a class="text-link feature-link" href={localePath(lang, 'guest-of-honour')}>
            {t('home.discover')} →
          </a>
        </div>

        <div class="feature-shot">
          {guest.portrait?.asset ? (
            <SanityImage image={guest.portrait} aspect={1.2} sizes="(max-width: 640px) 100vw, 50vw" widths={[500, 800, 1200]} />
          ) : (
            <div class="feature-empty" />
          )}
        </div>
      </section>
    )
  }

  {
    latest.length > 0 && (
      <section class="news">
        <div class="section-head">
          <h2 class="section-title">{t('home.latestNews')}</h2>
          <a class="text-link" href={localePath(lang, 'news')}>
            {t('home.viewAll')} →
          </a>
        </div>

        <ul class="page-grid feed">
          {latest.map((item: any) => (
            <li class="entry">
              <a href={localePath(lang, `news/${item.slug}`)}>
                <div class="shot">
                  {item.cover?.asset ? (
                    <SanityImage image={item.cover} aspect={1.5} sizes="(max-width: 640px) 100vw, 33vw" widths={[400, 600, 900]} />
                  ) : (
                    <div class="shot-empty" />
                  )}
                </div>
                <p class="meta">
                  <time datetime={item.publishedAt}>{formatDate(item.publishedAt, lang)}</time>
                </p>
                <h3>{item.title}</h3>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    spotlight && (
      <section class="page-grid feature reverse">
        <div class="feature-shot">
          {spotlight.logo?.asset ? (
            <SanityImage image={spotlight.logo} sizes="(max-width: 640px) 100vw, 50vw" widths={[400, 700, 1000]} />
          ) : (
            <div class="feature-empty" />
          )}
        </div>

        <div class="feature-text">
          <p class="eyebrow">{t('home.partnerSpotlight')}</p>
          <h2>{spotlight.name}</h2>
          <a class="text-link feature-link" href={localePath(lang, 'partners')}>
            {t('nav.partners')} →
          </a>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    align-items: stretch;
    row-gap: 1.5rem;
  }
  .hero-shot {
    grid-column: span 8;
  }
  .hero-empty {
    aspect-ratio: 1.4;
    background: var(--surface-2);
  }
  .hero-text {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1rem 0;
  }
  .hero-text h1 {
    margin: 0;
    font-size: clamp(2rem, 3.6vw, 4.5rem);
    font-weight: 400;
  }
  .hero-dates {
    margin: 1.5rem 0 0;
    font-size: clamp(1rem, 1.5vw, 1.35rem);
  }
  .hero-links {
    margin: 2rem 0 0;
    font-size: clamp(1.15rem, 2.2vw, 2rem);
  }

  .quicklinks {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2.5rem;
    margin: 3.5rem 0;
    padding: 1rem 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    font-size: clamp(1.15rem, 2.6vw, 2.25rem);
    letter-spacing: -0.04em;
    text-transform: lowercase;
  }
  .quicklinks a {
    text-decoration: none;
  }
  .quicklinks a:hover {
    background: var(--acid);
  }

  .feature {
    align-items: center;
    row-gap: 1.5rem;
    margin: 3.5rem 0;
  }
  .feature-text {
    grid-column: span 6;
  }
  .feature-shot {
    grid-column: span 6;
  }
  .reverse .feature-shot {
    order: -1;
  }
  .feature-empty {
    aspect-ratio: 1.2;
    background: var(--surface-2);
  }
  .feature-text h2 {
    margin: 0.5rem 0 0;
    font-size: clamp(2rem, 3.6vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 400;
  }
  .feature-meta {
    margin: 0.5rem 0 0;
    font-size: clamp(1rem, 1.5vw, 1.3rem);
    color: var(--ink-2);
  }
  .feature-link {
    display: inline-block;
    margin-top: 2rem;
    font-size: clamp(1.15rem, 2.2vw, 2rem);
  }

  .news {
    margin-top: 4rem;
  }
  .feed {
    list-style: none;
    margin: 0;
    padding-inline: 0;
    row-gap: 2rem;
  }
  .entry {
    grid-column: span 4;
  }
  .entry a {
    display: block;
    text-decoration: none;
  }
  .shot {
    overflow: hidden;
  }
  .shot-empty {
    aspect-ratio: 1.5;
    background: var(--surface-2);
  }
  .shot :global(img) {
    width: 100%;
    transition: transform 0.5s ease;
  }
  .entry a:hover .shot :global(img) {
    transform: scale(1.025);
  }
  .entry h3 {
    margin: 0.3rem 0 0;
    font-size: clamp(1.15rem, 1.9vw, 1.6rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 400;
  }
  .entry .meta {
    margin: 0.6rem 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .shot :global(img),
    .entry a:hover .shot :global(img) {
      transition: none;
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .entry {
      grid-column: span 6;
    }
  }

  @media (max-width: 640px) {
    .hero-shot,
    .hero-text,
    .feature-text,
    .feature-shot,
    .entry {
      grid-column: 1 / -1;
    }
    .reverse .feature-shot {
      order: 0;
    }
  }
</style>
