---
import Base from '../../layouts/Base.astro';
import SanityImage from '../../components/SanityImage.astro';
import PageSections from '../../components/PageSections.astro';
import { LOCALE_IDS, type LocaleId } from '../../lib/locales';
import { useTranslations } from '../../lib/i18n';
import { getHomepage, getCurrentEdition, getEditions, getNews } from '../../lib/queries';
import { resolveLink, type ResolvedLink } from '../../lib/links';
import { styleAttrs } from '../../lib/textStyle';

/**
 * The homepage, as the design's index.html draws it: the hero (picture on
 * eight columns, statement and link on four), the four acid quick links,
 * then the `homepage` document's section stack rendered in its "home"
 * variant - "latest news", the features, the image link bands, the film,
 * the key figures - in the order the editor set.
 *
 * Markup and classes are Lilanga's build of the Figma homepage; every slot
 * reads from Sanity.
 */
export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);

const [home, edition] = await Promise.all([getHomepage(lang), getCurrentEdition(lang)]);

const headline: string = home?.heroText ?? edition?.title ?? 'ceramic brussels';
const headlineStyle = home?.heroText ? home?.heroTextStyle : null;
const heroLink = resolveLink(lang, home?.heroLink);
/** The statement is written with line breaks in the Studio; keep them. */
const lines = headline.split(/\r?\n/);

const quickLinks: ResolvedLink[] = (home?.quickLinks ?? [])
  .map((link: any) => resolveLink(lang, link))
  .filter(Boolean);

/**
 * A homepage with no sections yet - a fresh dataset, or an editor who
 * cleared the stack - still shows the design's shape: latest news, the
 * film, the key figures, built from the same data the blocks would get.
 */
let sections: any[] = home?.sections ?? [];
if (sections.length === 0) {
  const [editions, news] = await Promise.all([getEditions(lang), getNews(lang)]);
  const figuresEdition = editions.find((e: any) => e.keyFigures?.length) ?? null;
  sections = [
    { _key: 'fallback-news', _type: 'newsSection', count: 2, items: news },
    { _key: 'fallback-video', _type: 'videoSection', video: edition?.film },
    { _key: 'fallback-figures', _type: 'keyFiguresSection', edition: figuresEdition },
  ];
}

const eventSchema = edition
  ? {
      '@context': 'https://schema.org',
      '@type': 'ExhibitionEvent',
      name: edition.title ?? `ceramic brussels ${edition.year}`,
      startDate: edition.startDate,
      endDate: edition.endDate,
      eventStatus: 'https://schema.org/EventScheduled',
      location: { '@type': 'Place', name: edition.venue, address: 'Brussels, Belgium' },
      organizer: { '@type': 'Organization', name: 'ceramic brussels' },
      ...(edition.ticketsUrl ? { offers: { '@type': 'Offer', url: edition.ticketsUrl } } : {}),
    }
  : null;

const external = (link: ResolvedLink | null) =>
  link?.external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Base
  lang={lang}
  title={home?.seo?.title ?? 'ceramic brussels'}
  description={home?.seo?.description ?? home?.heroText ?? edition?.title}
  noIndex={home?.seo?.noIndex}
  image={home?.seo?.ogImage?.asset ? home.seo.ogImage : home?.heroImage}
  editId="homepage"
  editType="homepage"
>
  {eventSchema && <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} slot="head" />}

  <section class="page-grid items-stretch">
    {
      home?.heroImage?.asset ? (
        <SanityImage
          image={home.heroImage}
          widths={[800, 1200, 1600, 2000]}
          sizes="(max-width: 640px) 100vw, 66vw"
          loading="eager"
          class="col-span-8 h-[43vw] max-h-[625px] min-h-[320px] w-full object-cover max-sm:col-span-full"
        />
      ) : (
        <img
          src="/assets/home-hero-1600.webp"
          alt=""
          width="1600"
          height="1067"
          class="col-span-8 h-[43vw] max-h-[625px] min-h-[320px] w-full object-cover max-sm:col-span-full"
        />
      )
    }
    <div class="col-span-4 flex flex-col justify-center py-8 max-sm:col-span-full">
      <h1 class="display text-[clamp(3rem,5vw,4.5rem)]" {...styleAttrs(headlineStyle)}>
        {lines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </h1>
      {
        heroLink && (
          <a class="text-link mt-8 text-[clamp(1.25rem,2.7vw,2.5rem)]" href={heroLink.href} {...external(heroLink)}>
            {heroLink.label} {heroLink.arrow}
          </a>
        )
      }
    </div>
  </section>

  {
    quickLinks.length > 0 && (
      <nav class="home-quicklinks" aria-label={t('nav.menu')}>
        {quickLinks.map((link) => (
          <a href={link.href} {...external(link)}>
            {link.label}
          </a>
        ))}
      </nav>
    )
  }

  <PageSections lang={lang} sections={sections} variant="home" />
</Base>

<style>
  /* From the design's index.css (html pages/_astro/index.*.css). */
  .home-quicklinks {
    grid-template-columns: repeat(4, 1fr);
    gap: 21px;
    height: 69px;
    margin: 27px 30px 0;
    display: grid;
  }
  .home-quicklinks a {
    letter-spacing: -0.05em;
    background: #fff350;
    place-items: center;
    font-size: 40px;
    line-height: 1;
    display: grid;
  }
  .home-quicklinks a:last-child {
    border: 1px solid #000;
  }
  @media (width>=701px) and (width<=1439px) {
    .home-quicklinks {
      gap: 1.4583vw;
      height: 4.7917vw;
      margin: 1.875vw 2.0833vw 0;
    }
    .home-quicklinks a {
      font-size: 2.7778vw;
    }
  }
  @media (width<=700px) {
    .home-quicklinks {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      height: auto;
      margin: 14px 10px 0;
    }
    .home-quicklinks a {
      min-height: 52px;
      font-size: 24px;
    }
  }
</style>
