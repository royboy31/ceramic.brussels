---
import Base from '../../layouts/Base.astro';
import SanityImage from '../../components/SanityImage.astro';
import { LOCALE_IDS, type LocaleId } from '../../lib/locales';
import { useTranslations, localePath, formatDateRange } from '../../lib/i18n';
import {
  getCurrentEdition,
  getNews,
  getArtists,
  getExhibitors,
  getPartners,
  getPressClips,
  getSettings,
} from '../../lib/queries';

export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);

const [edition, news, artists, exhibitors, partners, clips, settings] = await Promise.all([
  getCurrentEdition(lang),
  getNews(lang),
  getArtists(lang),
  getExhibitors(lang),
  getPartners(lang),
  getPressClips(),
  getSettings(lang),
]);

const lead = news[0];
const spotlight = partners.find((p: any) => p.tier === 'main');
const headline = settings?.tagline ?? edition?.title ?? settings?.siteName;

/**
 * The frame shows five figures. Visitors and VIP numbers are not recorded
 * anywhere in the schema, so only the three that can be counted are shown -
 * they stay true on their own as content is added.
 */
const figures = [
  { value: exhibitors.length, label: t('exhibitors.count') },
  { value: artists.length, label: t('home.artists') },
  { value: clips.length, label: t('home.pressClips') },
].filter((figure) => figure.value > 0);

const eventSchema = edition
  ? {
      '@context': 'https://schema.org',
      '@type': 'ExhibitionEvent',
      name: edition.title ?? `Ceramic Brussels ${edition.year}`,
      startDate: edition.startDate,
      endDate: edition.endDate,
      eventStatus: 'https://schema.org/EventScheduled',
      location: { '@type': 'Place', name: edition.venue, address: 'Brussels, Belgium' },
      organizer: { '@type': 'Organization', name: 'Ceramic Brussels' },
      ...(edition.ticketsUrl ? { offers: { '@type': 'Offer', url: edition.ticketsUrl } } : {}),
    }
  : null;
---

<Base
  lang={lang}
  title={settings?.siteName ?? 'Ceramic Brussels'}
  description={settings?.tagline ?? edition?.title}
  image={edition?.cover}
>
  {eventSchema && <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} slot="head" />}

  <section class="hero">
    {
      edition?.cover?.asset ? (
        <SanityImage
          image={edition.cover}
          aspect={1.5}
          loading="eager"
          sizes="(max-width: 700px) 100vw, 65vw"
          widths={[600, 900, 1200, 1600, 2000]}
        />
      ) : (
        <div class="hero-empty" />
      )
    }

    <div class="hero-copy">
      <h1 class="display">{headline}</h1>
      {
        edition && (
          <p class="hero-dates">
            {formatDateRange(edition.startDate, edition.endDate, lang)}
            {edition.venue && <> · {edition.venue}</>}
          </p>
        )
      }
      <a class="text-link" href={localePath(lang, 'about')}>{t('home.moreOnFair')} →</a>
    </div>
  </section>

  <nav class="quicklinks" aria-label={settings?.siteName ?? 'Ceramic Brussels'}>
    <a href={localePath(lang, 'exhibitors')}>{t('nav.exhibitors')}</a>
    <a href={localePath(lang, 'awards')}>{t('nav.awards')}</a>
    <a href={localePath(lang, 'programme')}>{t('nav.programme')}</a>
    {
      edition?.ticketsUrl && (
        <a class="outline" href={edition.ticketsUrl}>
          {t('home.tickets')}
        </a>
      )
    }
  </nav>

  {
    lead && (
      <>
        <h2 class="latest">{t('home.latestNews')}</h2>

        <section class="feature">
          <div class="feature-copy">
            {lead.category && <p class="eyebrow-lg">{lead.category}</p>}
            <h3>{lead.title}</h3>
            <a class="text-link" href={localePath(lang, `news/${lead.slug}`)}>
              {t('news.readMore')} →
            </a>
          </div>

          {lead.cover?.asset ? (
            <SanityImage image={lead.cover} aspect={1.5} sizes="(max-width: 700px) 100vw, 33vw" widths={[400, 700, 1100]} />
          ) : (
            <div class="feature-empty" />
          )}
        </section>
      </>
    )
  }

  {
    spotlight && (
      <section class="feature partner">
        {spotlight.logo?.asset ? (
          <SanityImage image={spotlight.logo} aspect={1.5} sizes="(max-width: 700px) 100vw, 65vw" widths={[600, 1000, 1400]} />
        ) : (
          <div class="feature-empty" />
        )}

        <div class="feature-copy">
          <p class="eyebrow-lg">{t('home.partnerSpotlight')}</p>
          <h3>{spotlight.name}</h3>
          <a class="text-link" href={localePath(lang, 'partners')}>{t('nav.partners')} →</a>
        </div>
      </section>
    )
  }

  {
    figures.length > 0 && (
      <section class="stats">
        <p class="stats-title">
          {t('home.keyFigures')} {edition?.year}
        </p>

        <div class="stats-table">
          {figures.map((figure) => (
            <div class="stat">
              <strong>{figure.value}</strong>
              <span>{figure.label}</span>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <a class="final-cta" href={localePath(lang, 'exhibitors')}>
    {t('nav.exhibitors')} →
  </a>
</Base>

<style>
  /* The frame runs the homepage full-bleed; main's gutter is cancelled here. */
  .hero,
  .quicklinks,
  .feature,
  .stats,
  .final-cta {
    margin-inline: -30px;
  }

  .hero {
    display: grid;
    grid-template-columns: 65% 35%;
    align-items: stretch;
  }
  .hero :global(img),
  .hero-empty {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-empty {
    aspect-ratio: 1.5;
    background: var(--surface-2);
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 2rem 0 2.5rem;
  }
  .hero-copy h1 {
    margin: 0;
    font-size: clamp(2rem, 4.85vw, 4.4rem);
    font-weight: 400;
  }
  .hero-dates {
    margin: 1.25rem 0 0;
    font-size: clamp(0.95rem, 1.4vw, 1.3rem);
  }
  .hero-copy a {
    display: inline-block;
    margin-top: 1.75rem;
    font-size: clamp(1.15rem, 2.75vw, 2.5rem);
    letter-spacing: -0.05em;
  }

  .quicklinks {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 21px;
    margin-top: 27px;
    padding-inline: 30px;
  }
  .quicklinks a {
    display: grid;
    place-items: center;
    min-height: clamp(52px, 4.8vw, 69px);
    background: var(--acid);
    text-align: center;
    text-decoration: none;
    text-transform: lowercase;
    padding: 0.4rem 0.6rem;
    font-size: clamp(1.1rem, 2.75vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .quicklinks a.outline {
    background: none;
    border: 1px solid var(--ink);
  }
  .quicklinks a:hover {
    background: var(--ink);
    color: var(--ground);
  }

  .latest {
    margin: 2.5rem 0 0;
    text-align: center;
    text-transform: lowercase;
    font-size: clamp(2.4rem, 4.85vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-weight: 600;
  }

  .feature {
    display: grid;
    grid-template-columns: 65.7% 31.4%;
    gap: 2.9%;
    align-items: center;
    margin-top: 30px;
    padding-inline: 30px;
  }
  /* Guest/news feature puts copy first; the partner block mirrors it. */
  .feature .feature-copy {
    order: -1;
  }
  .feature.partner .feature-copy {
    order: 0;
  }
  .feature :global(img),
  .feature-empty {
    width: 100%;
  }
  .feature-empty {
    aspect-ratio: 1.5;
    background: var(--surface-2);
  }
  .eyebrow-lg {
    margin: 0;
    text-transform: lowercase;
    font-size: clamp(1.15rem, 2.75vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }
  .feature-copy h3 {
    margin: 0.5rem 0 0;
    font-size: clamp(1.5rem, 2.75vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 400;
  }
  .feature-copy a {
    display: inline-block;
    margin-top: 2rem;
    font-size: clamp(1.15rem, 2.75vw, 2.5rem);
    letter-spacing: -0.05em;
  }

  .stats {
    margin-top: 3.4rem;
  }
  .stats-title {
    margin: 0;
    padding: 0 30px;
    text-transform: lowercase;
    font-size: clamp(1.25rem, 2.75vw, 2.5rem);
    line-height: 2;
    letter-spacing: -0.05em;
  }
  .stats-table {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--ink);
  }
  .stat {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: clamp(105px, 10vw, 145px);
    padding: 0.75rem 30px;
    border-bottom: 1px solid var(--ink);
  }
  .stat:nth-child(odd) {
    border-right: 1px solid var(--ink);
  }
  /* An odd last figure spans the row, as the press cell does in the frame. */
  .stat:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    justify-content: center;
    border-right: 0;
  }
  .stat strong {
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    line-height: 0.7;
    letter-spacing: -0.05em;
    font-weight: 400;
  }
  .stat span {
    text-transform: lowercase;
    font-size: clamp(1.5rem, 3.4vw, 3.1rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .final-cta {
    display: grid;
    place-items: center;
    min-height: clamp(110px, 10.5vw, 152px);
    margin-top: 3.5rem;
    padding: 0.6rem 1rem;
    background: var(--acid);
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    font-size: clamp(1.9rem, 4.2vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .quicklinks {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
  }

  @media (max-width: 700px) {
    .hero,
    .feature {
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }
    .hero {
      gap: 0;
    }
    .hero-copy {
      padding: 1.4rem 10px 0.9rem;
    }
    .feature :global(img),
    .feature-empty {
      order: -1;
    }
    .feature .feature-copy,
    .feature.partner .feature-copy {
      order: 0;
    }
    .hero,
    .quicklinks,
    .feature,
    .stats,
    .final-cta {
      margin-inline: -10px;
    }
    .quicklinks,
    .feature,
    .stats-title,
    .stat {
      padding-inline: 10px;
    }
    .stats-table {
      display: block;
      border-bottom: 0;
    }
    .stat {
      justify-content: space-between;
      border-right: 0 !important;
    }
  }
</style>
