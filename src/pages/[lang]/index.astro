---
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import PageSections from '../../components/PageSections.astro';
import { LOCALE_IDS, type LocaleId } from '../../lib/locales';
import { useTranslations, formatDateRange } from '../../lib/i18n';
import { getHomepage, getCurrentEdition, getEditions, getNews } from '../../lib/queries';
import { resolveLink, type ResolvedLink } from '../../lib/links';
import { styleAttrs } from '../../lib/textStyle';

/**
 * The homepage. The hero - picture, statement, dates, quick links - is fixed,
 * as the design gives the page exactly one opening. Everything under it is
 * the `homepage` document's section stack, so the film, the features, the
 * banners and the key figures come in whatever order the editor set.
 *
 * The look is Lilanga's port of the Figma hand-off; every slot reads from
 * Sanity and only falls back to the hand-off photography when an editor has
 * left it empty.
 */
export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);

const [home, edition] = await Promise.all([getHomepage(lang), getCurrentEdition(lang)]);

const headline = home?.heroText ?? edition?.title ?? 'ceramic brussels';
// The hero falls back through three sources; style only applies to the one
// the editor actually wrote.
const headlineStyle = home?.heroText ? home?.heroTextStyle : null;
const heroLink = resolveLink(lang, home?.heroLink);

const quickLinks: ResolvedLink[] = (home?.quickLinks ?? [])
  .map((link: any) => resolveLink(lang, link))
  .filter(Boolean);

/**
 * A homepage with no sections yet - a fresh dataset, or an editor who
 * cleared the stack - still shows the hand-off's shape: latest news, the
 * film, the key figures. Built here from the same data the blocks would
 * have been given, so it renders through the same components.
 */
let sections: any[] = home?.sections ?? [];
if (sections.length === 0) {
  const [editions, news] = await Promise.all([getEditions(lang), getNews(lang)]);
  const figuresEdition = editions.find((e: any) => e.keyFigures?.length) ?? null;
  sections = [
    { _key: 'fallback-news', _type: 'newsSection', count: 2, items: news },
    { _key: 'fallback-video', _type: 'videoSection', video: edition?.film },
    { _key: 'fallback-figures', _type: 'keyFiguresSection', edition: figuresEdition },
  ];
}

const eventSchema = edition
  ? {
      '@context': 'https://schema.org',
      '@type': 'ExhibitionEvent',
      name: edition.title ?? `ceramic brussels ${edition.year}`,
      startDate: edition.startDate,
      endDate: edition.endDate,
      eventStatus: 'https://schema.org/EventScheduled',
      location: { '@type': 'Place', name: edition.venue, address: 'Brussels, Belgium' },
      organizer: { '@type': 'Organization', name: 'ceramic brussels' },
      ...(edition.ticketsUrl ? { offers: { '@type': 'Offer', url: edition.ticketsUrl } } : {}),
    }
  : null;

const external = (link: ResolvedLink | null) =>
  link?.external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Base
  lang={lang}
  title={home?.seo?.title ?? 'ceramic brussels'}
  description={home?.seo?.description ?? home?.heroText ?? edition?.title}
  noIndex={home?.seo?.noIndex}
  image={home?.seo?.ogImage?.asset ? home.seo.ogImage : home?.heroImage}
  editId="homepage"
  editType="homepage"
>
  {eventSchema && <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} slot="head" />}

  <section class="page-grid hero">
    <div class="hero-shot">
      <Figure
        image={home?.heroImage}
        pool="fair"
        seed="hero"
        fallback={{
          src: '/assets/home-hero-1600.webp',
          srcset: '/assets/home-hero-900.webp 900w, /assets/home-hero-1600.webp 1600w',
          width: 1600,
          height: 1067,
        }}
        loading="eager"
        priority
        sizes="(max-width: 640px) 100vw, 66vw"
        widths={[600, 900, 1200, 1600, 2000]}
      />
    </div>

    <div class="hero-copy">
      <h1 class="display" {...styleAttrs(headlineStyle)}>{headline}</h1>
      {
        edition && (
          <p class="hero-dates">
            {formatDateRange(edition.startDate, edition.endDate, lang)}
            {edition.venue && <> · {edition.venue}</>}
          </p>
        )
      }
      {
        heroLink && (
          <a class="text-link" href={heroLink.href} {...external(heroLink)}>
            {heroLink.label} {heroLink.arrow}
          </a>
        )
      }
    </div>
  </section>

  {
    quickLinks.length > 0 && (
      <nav class="quicklinks" aria-label={t('nav.menu')}>
        {quickLinks.map((link, i) => (
          <a href={link.href} class:list={{ outline: i === quickLinks.length - 1 }} {...external(link)}>
            {link.label}
          </a>
        ))}
      </nav>
    )
  }

  <PageSections lang={lang} sections={sections} class="home-sections" />
</Base>

<style>
  .hero {
    align-items: stretch;
    row-gap: 1.5rem;
  }
  .hero-shot {
    grid-column: span 8;
  }
  .hero-shot :global(img) {
    width: 100%;
    height: 47vw;
    max-height: 690px;
    min-height: 340px;
    object-fit: cover;
  }
  .hero-copy {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 0;
  }
  .hero-copy h1 {
    /* Pulled up by the leading above the caps, so the first line sits level
       with the top edge of the picture rather than a line-height below it. */
    margin: -0.11em 0 0;
    font-size: clamp(3rem, 5vw, 4.5rem);
    font-weight: 400;
  }
  .hero-dates {
    margin: 1.25rem 0 0;
    font-size: clamp(0.95rem, 1.4vw, 1.3rem);
  }
  .hero-copy a {
    display: inline-block;
    margin-top: 2rem;
    font-size: clamp(1.25rem, 2.7vw, 2.5rem);
    letter-spacing: -0.05em;
  }

  .quicklinks {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 21px;
    margin-top: 27px;
  }
  .quicklinks a {
    display: grid;
    place-items: center;
    min-height: clamp(52px, 4.8vw, 69px);
    background: var(--acid);
    text-align: center;
    text-decoration: none;
    text-transform: lowercase;
    padding: 0.4rem 0.6rem;
    font-size: clamp(1.1rem, 2.75vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }
  /* The last quick link is the call to action: the same acid block, with a
     rule around it. */
  .quicklinks a.outline {
    border: 1px solid var(--ink);
  }
  .quicklinks a:hover {
    background: var(--ink);
    color: var(--ground);
  }

  .home-sections {
    margin-top: 1rem;
  }

  @media (max-width: 900px) {
    .quicklinks {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
  }

  /* Below 640 the grid is 4 columns, so both halves take the full width and
     the picture leads, as max-sm:col-span-full does in the hand-off. */
  @media (max-width: 640px) {
    .hero-shot,
    .hero-copy {
      grid-column: 1 / -1;
    }
    .hero-copy {
      padding: 1.4rem 0 0.9rem;
    }
    .hero-shot :global(img) {
      height: 67vw;
      min-height: 260px;
    }
  }
</style>
