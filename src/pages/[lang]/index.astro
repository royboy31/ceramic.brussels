---
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { LOCALE_IDS, type LocaleId } from '../../lib/locales';
import { useTranslations, localePath, formatDateRange } from '../../lib/i18n';
import { getCurrentEdition, getNews, getPartners, getSettings } from '../../lib/queries';

export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);

const [edition, news, partners, settings] = await Promise.all([
  getCurrentEdition(lang),
  getNews(lang),
  getPartners(lang),
  getSettings(lang),
]);

const lead = news[0];
const spotlight = partners.find((p: any) => p.tier === 'main');
const headline = settings?.tagline ?? edition?.title ?? settings?.siteName;

/**
 * Last edition's figures, as supplied with the design. These are reported
 * numbers rather than anything countable in Sanity, so they live here with
 * the year they describe - change the year in the same edit as the numbers.
 * The separator follows the locale, so French reads 19 200, not 19,200.
 */
const FIGURES_YEAR = 2026;
const num = (value: number) =>
  new Intl.NumberFormat({ en: 'en-GB', fr: 'fr-BE', nl: 'nl-BE' }[lang]).format(value);

const figures = [
  { value: num(19200), label: t('home.visitors') },
  { value: '70', label: t('home.exhibitors2') },
  { value: '200+', label: t('home.artists') },
  { value: num(3500), label: t('home.vips') },
  { value: '230+', label: t('home.pressClips') },
];

const eventSchema = edition
  ? {
      '@context': 'https://schema.org',
      '@type': 'ExhibitionEvent',
      name: edition.title ?? `Ceramic Brussels ${edition.year}`,
      startDate: edition.startDate,
      endDate: edition.endDate,
      eventStatus: 'https://schema.org/EventScheduled',
      location: { '@type': 'Place', name: edition.venue, address: 'Brussels, Belgium' },
      organizer: { '@type': 'Organization', name: 'Ceramic Brussels' },
      ...(edition.ticketsUrl ? { offers: { '@type': 'Offer', url: edition.ticketsUrl } } : {}),
    }
  : null;
---

<Base
  lang={lang}
  title={settings?.siteName ?? 'Ceramic Brussels'}
  description={settings?.tagline ?? edition?.title}
  image={edition?.cover}
>
  {eventSchema && <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} slot="head" />}

  <section class="page-grid hero">
    <div class="hero-shot">
      <Figure
      image={edition?.cover}
      pool="fair"
      seed="hero"
      fallback={{
        src: '/assets/home-hero-1600.webp',
        srcset: '/assets/home-hero-900.webp 900w, /assets/home-hero-1600.webp 1600w',
        width: 1600,
        height: 1067,
      }}
      loading="eager"
      priority
      sizes="(max-width: 640px) 100vw, 66vw"
      widths={[600, 900, 1200, 1600, 2000]}
      />
    </div>

    <div class="hero-copy">
      <h1 class="display">{headline}</h1>
      {
        edition && (
          <p class="hero-dates">
            {formatDateRange(edition.startDate, edition.endDate, lang)}
            {edition.venue && <> · {edition.venue}</>}
          </p>
        )
      }
      <a class="text-link" href={localePath(lang, 'about')}>{t('home.moreOnFair')} →</a>
    </div>
  </section>

  <nav class="quicklinks" aria-label={settings?.siteName ?? 'Ceramic Brussels'}>
    <a href={localePath(lang, 'exhibitors')}>{t('nav.exhibitors')}</a>
    <a href={localePath(lang, 'awards')}>{t('nav.awards')}</a>
    <a href={localePath(lang, 'programme')}>{t('nav.programme')}</a>
    {
      edition?.ticketsUrl && (
        <a class="outline" href={edition.ticketsUrl}>
          {t('home.tickets')}
        </a>
      )
    }
  </nav>

  {
    lead && (
      <>
        <h2 class="latest">{t('home.latestNews')}</h2>

        <section class="page-grid feature">
          <div class="feature-copy">
            {lead.category && <p class="eyebrow-lg">{lead.category}</p>}
            <h3>{lead.title}</h3>
            <a class="text-link" href={localePath(lang, `news/${lead.slug}`)}>
              {t('news.readMore')} →
            </a>
          </div>

          <div class="feature-shot">
          <Figure
            image={lead.cover}
            pool="fair"
            seed={lead.slug}
            fallback={{
              src: '/assets/guest-1200.webp',
              srcset: '/assets/guest-700.webp 700w, /assets/guest-1200.webp 1200w',
              width: 1200,
              height: 800,
            }}
            sizes="(max-width: 640px) 100vw, 50vw"
          />
          </div>
        </section>
      </>
    )
  }

  <VideoEmbed
    url="https://www.youtube.com/watch?v=IyklMBqj4L4"
    poster="/assets/video-still.webp"
    label={t('home.watch')}
  />

  {
    spotlight && (
      <section class="page-grid feature partner">
        <div class="feature-shot">
        <Figure
          image={spotlight.logo}
          pool="fair"
          seed={spotlight.name}
          fallback={{
            src: '/assets/partner-hoxton.webp',
            srcset: '/assets/partner-hoxton.webp 800w',
            width: 800,
            height: 533,
          }}
          sizes="(max-width: 640px) 100vw, 50vw"
        />
        </div>

        <div class="feature-copy">
          <p class="eyebrow-lg">{t('home.partnerSpotlight')}</p>
          <h3>{spotlight.name}</h3>
          <a class="text-link" href={localePath(lang, 'partners')}>{t('nav.partners')} →</a>
        </div>
      </section>
    )
  }

  {
    figures.length > 0 && (
      <section class="stats">
        <p class="stats-title">
          {t('home.keyFigures')} {FIGURES_YEAR}
        </p>

        <div class="stats-table">
          {figures.map((figure) => (
            <div class="stat">
              <strong>{figure.value}</strong>
              <span>{figure.label}</span>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <a class="final-cta" href={localePath(lang, 'exhibitors')}>
    {t('nav.exhibitors')} →
  </a>
</Base>

<style>
  /* Hero, quicklinks and the feature blocks sit inside the page gutter, as
     they do in the hand-off. Only the video, the figures table and the call
     to action run edge to edge. */
  .video,
  .stats,
  .final-cta {
    margin-inline: -30px;
  }

  .hero {
    align-items: stretch;
    row-gap: 1.5rem;
  }
  .hero-shot {
    grid-column: span 8;
  }
  .hero-shot :global(img) {
    width: 100%;
    height: 43vw;
    max-height: 625px;
    min-height: 320px;
    object-fit: cover;
  }
  .hero-copy {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 0;
  }
  .hero-copy h1 {
    margin: 0;
    font-size: clamp(3rem, 5vw, 4.5rem);
    font-weight: 400;
  }
  .hero-dates {
    margin: 1.25rem 0 0;
    font-size: clamp(0.95rem, 1.4vw, 1.3rem);
  }
  .hero-copy a {
    display: inline-block;
    margin-top: 2rem;
    font-size: clamp(1.25rem, 2.7vw, 2.5rem);
    letter-spacing: -0.05em;
  }

  .quicklinks {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 21px;
    margin-top: 27px;
  }
  .quicklinks a {
    display: grid;
    place-items: center;
    min-height: clamp(52px, 4.8vw, 69px);
    background: var(--acid);
    text-align: center;
    text-decoration: none;
    text-transform: lowercase;
    padding: 0.4rem 0.6rem;
    font-size: clamp(1.1rem, 2.75vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }
  .quicklinks a.outline {
    background: none;
    border: 1px solid var(--ink);
  }
  .quicklinks a:hover {
    background: var(--ink);
    color: var(--ground);
  }

  .latest {
    margin: 2.5rem 0 0;
    text-align: center;
    text-transform: lowercase;
    font-size: clamp(2.4rem, 4.85vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-weight: 600;
  }

  .feature {
    align-items: center;
    row-gap: 1.25rem;
    margin-top: 30px;
    padding-bottom: 2.5rem;
  }
  .feature-copy {
    grid-column: span 6;
    padding: 1.5rem 0;
  }
  .feature-shot {
    grid-column: span 6;
  }
  .feature-shot :global(img) {
    width: 100%;
    height: 31vw;
    min-height: 280px;
    object-fit: cover;
  }
  /* The partner block puts the image first, the news feature the copy. */
  .feature.partner {
    align-items: start;
    padding: 1.5rem 0 0;
  }

  .eyebrow-lg {
    margin: 0;
    text-transform: lowercase;
    font-size: clamp(1.25rem, 2.7vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }
  .feature-copy h3 {
    margin: 0.5rem 0 0;
    font-size: clamp(2rem, 3.6vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 400;
  }
  .feature-copy a {
    display: inline-block;
    margin-top: 2rem;
    font-size: clamp(1.3rem, 2.6vw, 2.5rem);
    letter-spacing: -0.05em;
  }

  .video {
    margin-top: 3rem;
    overflow: hidden;
  }
  .video-frame {
    position: relative;
  }
  .video img {
    width: 100%;
    height: clamp(300px, 47.6vw, 686px);
    object-fit: cover;
  }
  .video p {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 0 1rem;
    text-align: center;
    text-transform: lowercase;
    color: var(--acid);
    font-size: clamp(2.5rem, 8.9vw, 8rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .stats {
    margin-top: 3.4rem;
  }
  .stats-title {
    margin: 0;
    padding: 0 30px;
    text-transform: lowercase;
    font-size: clamp(1.25rem, 2.75vw, 2.5rem);
    line-height: 2;
    letter-spacing: -0.05em;
  }
  .stats-table {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--ink);
  }
  .stat {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: clamp(105px, 10vw, 145px);
    padding: 0.75rem 30px;
    border-bottom: 1px solid var(--ink);
  }
  .stat:nth-child(odd) {
    border-right: 1px solid var(--ink);
  }
  /* An odd last figure spans the row, as the press cell does in the frame. */
  .stat:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    justify-content: center;
    border-right: 0;
  }
  .stat strong {
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    line-height: 0.7;
    letter-spacing: -0.05em;
    font-weight: 400;
  }
  .stat span {
    font-size: clamp(1.5rem, 3.4vw, 3.1rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .final-cta {
    display: grid;
    place-items: center;
    min-height: clamp(110px, 10.5vw, 152px);
    margin-top: 3.5rem;
    padding: 0.6rem 1rem;
    background: var(--acid);
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    font-size: clamp(1.9rem, 4.2vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .quicklinks {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
  }

  /* Below 640 the grid is 4 columns, so both halves take the full width and
     the picture leads, as max-sm:col-span-full does in the hand-off. */
  @media (max-width: 640px) {
    .hero-shot,
    .hero-copy,
    .feature-copy,
    .feature-shot {
      grid-column: 1 / -1;
    }
    .feature-shot {
      order: -1;
    }
    .hero-copy {
      padding: 1.4rem 0 0.9rem;
    }
    .hero-shot :global(img) {
      height: 67vw;
      min-height: 260px;
    }
    .feature-shot :global(img) {
      height: auto;
      min-height: 0;
      aspect-ratio: 1.5;
    }
    .video,
    .stats,
    .final-cta {
      margin-inline: -10px;
    }
    .stats-title,
    .stat {
      padding-inline: 10px;
    }
    .stats-table {
      display: block;
      border-bottom: 0;
    }
    .stat {
      justify-content: space-between;
      border-right: 0 !important;
    }
  }
</style>
