---
import Base from '../../layouts/Base.astro';
import SanityImage from '../../components/SanityImage.astro';
import PageSections from '../../components/PageSections.astro';
import { LOCALE_IDS, type LocaleId } from '../../lib/locales';
import { useTranslations } from '../../lib/i18n';
import { getHomepage, getCurrentEdition } from '../../lib/queries';
import { resolveLink, type ResolvedLink } from '../../lib/links';
import { styleAttrs } from '../../lib/textStyle';

/**
 * The homepage, as the design's index.html draws it (2026-09-14 build): the
 * hero figure beside the statement and its arrow link, the down arrow, the
 * four bordered quick links (the last one grey), then the `homepage`
 * document's section stack rendered in its "home" variant - the centred
 * "latest news" title, the feature rows, the film with its poster, the
 * newsletter band, the key figures grid - in the order the editor set.
 *
 * Markup and classes are Lilanga's build of the Figma homepage; every slot
 * reads from Sanity.
 */
export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);

const [home, edition] = await Promise.all([getHomepage(lang), getCurrentEdition(lang)]);

const headline: string = home?.heroText ?? edition?.title ?? 'ceramic brussels';
const headlineStyle = home?.heroText ? home?.heroTextStyle : null;
const heroLink = resolveLink(lang, home?.heroLink);
/** The statement is written with line breaks in the Studio; keep them. */
const lines = headline.split(/\r?\n/);

const quickLinks: ResolvedLink[] = (home?.quickLinks ?? [])
  .map((link: any) => resolveLink(lang, link))
  .filter(Boolean);

/**
 * The stack as the editor left it, and nothing else. This used to invent
 * news, film and key-figures blocks when `sections` came back empty, so a
 * cleared homepage still looked full - and because the query drops hidden
 * blocks, hiding every one of them did the same. An editor could delete
 * their way to a page they could not change, which is most of why the
 * 10.09 demo was confusing. Empty now renders empty.
 */
const sections: any[] = home?.sections ?? [];
/** The down arrow under the hero jumps to the first block, by its anchor when it has one. */
const downTarget = sections[0]?.anchor ? `#${sections[0].anchor}` : '#sections';

const eventSchema = edition
  ? {
      '@context': 'https://schema.org',
      '@type': 'ExhibitionEvent',
      name: edition.title ?? `ceramic brussels ${edition.year}`,
      startDate: edition.startDate,
      endDate: edition.endDate,
      eventStatus: 'https://schema.org/EventScheduled',
      location: { '@type': 'Place', name: edition.venue, address: 'Brussels, Belgium' },
      organizer: { '@type': 'Organization', name: 'ceramic brussels' },
      ...(edition.ticketsUrl ? { offers: { '@type': 'Offer', url: edition.ticketsUrl } } : {}),
    }
  : null;

const external = (link: ResolvedLink | null) =>
  link?.external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Base
  lang={lang}
  title={home?.seo?.title ?? 'ceramic brussels'}
  description={home?.seo?.description ?? home?.heroText ?? edition?.title}
  noIndex={home?.seo?.noIndex}
  image={home?.seo?.ogImage?.asset ? home.seo.ogImage : home?.heroImage}
  editId="homepage"
  editType="homepage"
>
  {eventSchema && <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} slot="head" />}

  <section class="hero">
    {/* No stand-in: an empty Hero image reads as empty, so it can be found and filled. */}
    {
      home?.heroImage?.asset && (
        <figure>
          <SanityImage
            image={home.heroImage}
            widths={[800, 1200, 1600, 2000]}
            sizes="(max-width: 640px) 100vw, 66vw"
            loading="eager"
          />
        </figure>
      )
    }
    <div class="hero__copy">
      <h1 {...styleAttrs(headlineStyle)}>
        {lines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </h1>
      {
        heroLink && (
          <a class="arrow-link" href={heroLink.href} {...external(heroLink)}>
            {heroLink.label}{' '}
            <span class="link-arrow" data-arrow={heroLink.arrow} aria-hidden="true">
              {heroLink.arrow}
            </span>
          </a>
        )
      }
    </div>
  </section>

  {
    sections.length > 0 && (
      <a class="down-arrow" href={downTarget} aria-label={t('home.scrollDown')}>
        ↓
      </a>
    )
  }

  {
    quickLinks.length > 0 && (
      <nav class="quicklinks" aria-label={t('nav.menu')}>
        {quickLinks.map((link) => (
          <a href={link.href} {...external(link)}>
            {link.label}
          </a>
        ))}
      </nav>
    )
  }

  <div id="sections">
    <PageSections lang={lang} sections={sections} variant="home" />
  </div>
</Base>

<style>
  /* From the design's index.css (html pages/_astro/index.*.css, 2026-09-14 build). */
  .hero {
    grid-template-columns: minmax(0, 2fr) minmax(310px, 1fr);
    gap: 40px;
    /* Room under the header (client feedback, 2026-09-15); the site gutter at the sides. */
    margin: 60px var(--gutter) 30px;
    display: grid;
  }
  .hero figure {
    margin: 0;
    position: relative;
  }
  .hero figure > :global(img) {
    aspect-ratio: 887 / 591;
    object-fit: cover;
    width: 100%;
  }
  .hero__copy {
    padding-top: 6px;
  }
  .hero h1 {
    letter-spacing: -0.055em;
    /* Smaller than the build's 70px: the statement felt too big (client feedback, 2026-09-15). */
    font-size: clamp(40px, 3.75vw, 54px);
    font-weight: 400;
    line-height: 0.98;
  }
  /* The underline is a drawn line rather than text-decoration, so on hover
     it can run out to the right and back in from the left (client
     feedback, 2026-09-15); the arrow keeps its slide. */
  .arrow-link {
    align-items: center;
    gap: 0.22em;
    margin-top: 28px;
    padding-bottom: 0.12em;
    font-size: clamp(25px, 2.75vw, 40px);
    line-height: 1;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-size: 100% 1px;
    background-position: 0 100%;
    display: inline-flex;
  }
  .arrow-link:hover {
    animation: underline-slide 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes underline-slide {
    0% {
      background-size: 100% 1px;
      background-position: 0 100%;
    }
    45% {
      background-size: 0 1px;
      background-position: 100% 100%;
    }
    50% {
      background-size: 0 1px;
      background-position: 0 100%;
    }
    100% {
      background-size: 100% 1px;
      background-position: 0 100%;
    }
  }
  .arrow-link span {
    transition: transform 0.25s;
    display: inline-block;
  }
  .arrow-link:hover span {
    transform: translate(10px);
  }
  .down-arrow {
    width: max-content;
    margin: 8px auto 22px;
    font-size: 64px;
    font-weight: 200;
    line-height: 1;
    display: block;
  }
  .quicklinks {
    grid-template-columns: repeat(4, 1fr);
    gap: 98px;
    margin: 0 var(--gutter) 60px;
    display: grid;
  }
  .quicklinks a {
    text-align: center;
    background: #fff350;
    border: 1px solid #000;
    padding: 13px;
    font-size: 30px;
    line-height: 1;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .quicklinks a:last-child {
    background: #eee;
  }
  .quicklinks a:hover {
    color: #fff;
    background: #000;
  }
  @media (width<=900px) {
    .hero {
      gap: 20px;
    }
    .quicklinks {
      gap: 12px;
    }
  }
  @media (width<=640px) {
    .hero {
      flex-direction: column;
      margin: 30px var(--gutter) 40px;
      display: flex;
    }
    .hero__copy {
      padding-top: 10px;
    }
    .hero h1 {
      font-size: 48px;
    }
    .arrow-link {
      font-size: 26px;
    }
    .quicklinks {
      grid-template-columns: 1fr 1fr;
      margin: 0 var(--gutter) 45px;
    }
    .quicklinks a {
      font-size: 22px;
    }
  }
</style>
