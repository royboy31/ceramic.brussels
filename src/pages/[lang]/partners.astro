---
import Base from '../../layouts/Base.astro';
import SanityImage from '../../components/SanityImage.astro';
import { LOCALE_IDS, type LocaleId } from '../../lib/locales';
import { useTranslations } from '../../lib/i18n';
import { getPartners } from '../../lib/queries';

export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);
const partners = await getPartners(lang);

const TIERS = ['main', 'institutional', 'media', 'supplier'];
const TIER_LABELS: Record<string, string> = {
  main: 'Main partners',
  institutional: 'Institutional partners',
  media: 'Media partners',
  supplier: 'Suppliers',
};

const grouped = TIERS.map((tier) => ({
  tier,
  label: TIER_LABELS[tier],
  items: partners.filter((p: any) => p.tier === tier),
})).filter((g) => g.items.length > 0);
---

<Base lang={lang} title={t('nav.partners')} path="partners">
  <h1>{t('nav.partners')}</h1>

  {
    grouped.length ? (
      grouped.map((group) => (
        <section>
          <h2>{group.label}</h2>
          <ul class="grid logos">
            {group.items.map((p: any) => (
              <li class="card">
                <a class="card-link" href={p.url ?? '#'}>
                  <SanityImage image={p.logo} aspect={3 / 2} sizes="200px" widths={[200, 400, 600]} />
                  <h3>{p.name}</h3>
                </a>
                {p.description && <p class="meta">{p.description}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))
    ) : (
      <p class="empty">
        {t('partners.empty')} Add them in <a href="/studio">the Studio</a>.
      </p>
    )
  }
</Base>

<style>
  .logos {
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  }
</style>
