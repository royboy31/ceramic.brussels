---
import Base from '../../../layouts/Base.astro';
import ExhibitorHead from '../../../components/ExhibitorHead.astro';
import Slideshow from '../../../components/Slideshow.astro';
import PortableText from '../../../components/PortableText.astro';
import PageSections from '../../../components/PageSections.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations, localePath } from '../../../lib/i18n';
import { getAwards, getCurrentEdition, getHubPages } from '../../../lib/queries';
import { pageForTab } from '../../../lib/hubs';
import { countryCode } from '../../../lib/countries';
import { exhibitorPath } from '../../../lib/links';
import { styleAttrs } from '../../../lib/textStyle';

/**
 * /exhibitors/awards: the fair's exhibitor awards (best booth, best solo
 * show…), as the design's exhibitors/awards/index.html draws it
 * (2026-09-14 build): the exhibitors title band with the awards tab
 * active, an intro line, then one row per award, rebuilt to the client's
 * Figma frame of 2026-09-16: the pictures on the left; on the right the
 * award's name over a rule, what it rewards, and "PREVIOUS LAUREATE (2026)"
 * with the winning gallery - or "NEW THIS YEAR" for an award that has never
 * been given.
 *
 * Data: `award` documents of family "fair", one row per award name of this
 * edition or the last (see `awards` below). The intro is the `page` in
 * section "exhibitors" whose English slug is `awards`, when an editor makes
 * one; the list never comes from it. A static segment, so it wins over
 * exhibitors/[slug].astro.
 */
export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);

const [allAwards, edition, pages] = await Promise.all([getAwards(lang), getCurrentEdition(lang), getHubPages(lang, 'exhibitors')]);
const page = pageForTab(pages, 'awards');
const fair = allAwards.filter((a: any) => a.family === 'fair' && a.year);
const sameAward = (a: any, b: any) => String(a?.name ?? '').trim().toLowerCase() === String(b?.name ?? '').trim().toLowerCase();
/** The edition the page speaks for: the current one, else the newest with an award. */
const current: number | undefined = edition?.year ?? fair[0]?.year;
const year = current;

/**
 * One row per award *name* given in this edition or the one before it, so
 * the page reads the way the awards are entered: an award may be a document
 * on this edition, or only last edition's (with its winner) until this
 * year's is made. The row takes this edition's document when there is one,
 * else the latest; "previous laureate" is the latest earlier winner of that
 * name; an award nobody has won yet is "new this year". An older award not
 * given in either edition (Ceramic Art Andenne, 2025) stays off the page.
 * Rows follow the documents' Order field.
 */
const names: any[] = [];
for (const a of fair) {
  if (current && a.year < current - 1) continue;
  if (!names.some((n) => sameAward(n, a))) names.push(a);
}
const awards = names
  .map((first: any) => {
    const all = fair.filter((b: any) => sameAward(first, b));
    const shown = all.find((b: any) => b.year === current) ?? all[0];
    const previous = all.find((b: any) => b.gallery && (!current || b.year < current)) ?? null;
    return { ...shown, previous, isNew: !all.some((b: any) => b.gallery) };
  })
  .sort((a: any, b: any) => (a.order ?? 100) - (b.order ?? 100));

/**
 * The award's own slideshow (`images`, request #5), else its single image,
 * else its winning gallery's pictures, else the previous laureate's.
 */
const imagesOf = (a: any): any[] => {
  const slides = (a.images ?? []).filter((img: any) => img?.asset);
  if (slides.length) return slides;
  if (a.image?.asset) return [a.image];
  const own = (a.gallery?.images ?? []).filter((img: any) => img?.asset);
  return own.length ? own : (a.previous?.gallery?.images ?? []).filter((img: any) => img?.asset);
};
---

<Base
  lang={lang}
  title={page?.seo?.title ?? `${t('exhibitors.awardsPage')}${year ? ` ${year}` : ''}`}
  description={page?.seo?.description ?? page?.intro}
  noIndex={page?.seo?.noIndex}
  image={page?.seo?.ogImage ?? page?.cover}
  path="exhibitors/awards"
  editId={page?._id}
  editType={page?._type}
>
  <ExhibitorHead lang={lang} active="awards" edition={edition} />

  {
    page?.intro && (
      <div class="awards-intro">
        <p {...styleAttrs(page.introStyle)}>{page.intro}</p>
      </div>
    )
  }

  {
    awards.length ? (
      <div class="awards-list">
        {awards.map((a: any, i: number) => {
          const images = imagesOf(a);
          const prev = a.previous;
          const gallery = prev?.gallery;
          const code = gallery ? countryCode(gallery.countryCode ?? gallery.country) : null;
          return (
            <article>
              <figure>
                {images.length ? (
                  <Slideshow images={images} aspect={1.5} widths={[600, 900, 1200, 1600]} sizes="(max-width: 640px) 100vw, 50vw" label={a.name} id={`award-${i + 1}`} />
                ) : (
                  <div class="award-empty" />
                )}
              </figure>
              <div class="award-copy">
                <h2 {...styleAttrs(a.nameStyle)}>{a.name}</h2>
                {a.isNew && <p class="label">{t('exhibitors.newThisYear')}</p>}
                {a.description && <PortableText value={a.description} fieldStyle={a.descriptionStyle} />}
                {gallery && (
                  <div class="laureate">
                    <p class="label">{t('exhibitors.previousLaureate', { year: prev.year })}</p>
                    <p>
                      {gallery.slug ? (
                        <a class="hl-link" href={localePath(lang, exhibitorPath(gallery))}>
                          {gallery.name}
                          {code && ` (${code})`}
                        </a>
                      ) : (
                        <>
                          {gallery.name}
                          {code && ` (${code})`}
                        </>
                      )}
                      {prev.outcome && <span {...styleAttrs(prev.outcomeStyle)}>, {prev.outcome}</span>}
                    </p>
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <p class="empty">{t('exhibitors.awardsEmpty')}</p>
    )
  }
  {
    (page?.sections?.length ?? 0) > 0 && (
      <div class="content-wrap">
        <PageSections lang={lang} sections={page.sections} />
      </div>
    )
  }
</Base>

<style>
  /* From the design's exhibitors/awards/index.html (2026-09-14 build). */
  .awards-intro {
    padding: 36px var(--gutter) 34px;
  }
  .awards-intro p {
    letter-spacing: -0.035em;
    max-width: 1120px;
    font-size: clamp(28px, 2.6vw, 40px);
    line-height: 1.15;
  }
  /* The rows of the Figma frame: pictures on the left half, the text beside
     them, no rules between rows. */
  .awards-list {
    padding: 0 var(--gutter) 90px;
  }
  /* Without an intro the rows would touch the title band. */
  :global(.exhibitor-head) + .awards-list {
    padding-top: 36px;
  }
  .awards-list article {
    grid-template-columns: 1fr 1fr;
    gap: 30px 40px;
    padding-bottom: 50px;
    display: grid;
  }
  .awards-list figure {
    margin: 0;
    position: relative;
  }
  .awards-list :global(img),
  .award-empty {
    aspect-ratio: 1.5;
    object-fit: cover;
    width: 100%;
    background: #f0efed;
  }
  /* The guest of honour page's title: semibold, tight, a 2px rule right under it. */
  .award-copy h2 {
    border-bottom: 2px solid;
    text-transform: lowercase;
    letter-spacing: -0.04em;
    font-size: clamp(28px, 2.5vw, 36px);
    font-weight: 600;
    line-height: 1.2;
  }
  /* The text starts 22px under the rule, as in the frame. */
  .award-copy :global(.rich-text) {
    max-width: 640px;
    margin-top: 10px;
    font-size: var(--body-size);
    line-height: var(--body-lh);
    letter-spacing: var(--body-ls);
  }
  /* "PREVIOUS LAUREATE (2026)" / "NEW THIS YEAR": bold capitals at the
     frame's 22px. Noi Grotesk ships 400/600/900, so 600 is the bold cut. */
  .award-copy .label {
    margin-top: 18px;
    text-transform: uppercase;
    font-size: clamp(17px, 1.53vw, 22px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .laureate {
    margin-top: 26px;
    font-size: var(--body-size);
    line-height: var(--body-lh);
    letter-spacing: var(--body-ls);
  }
  .laureate .label {
    margin-top: 0;
  }
  /* Underlined, as the client's awards frame of 2026-09-24 draws the gallery. */
  .laureate a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }
  .empty {
    padding: 45px var(--gutter) 90px;
    font-size: 24px;
  }
  @media (width<=640px) {
    .awards-list article {
      display: block;
    }
    .award-copy {
      padding-top: 16px;
    }
  }
</style>
