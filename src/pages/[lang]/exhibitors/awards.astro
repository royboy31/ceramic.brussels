---
import Base from '../../../layouts/Base.astro';
import ExhibitorHead from '../../../components/ExhibitorHead.astro';
import LinkPill from '../../../components/LinkPill.astro';
import SanityImage from '../../../components/SanityImage.astro';
import Slideshow from '../../../components/Slideshow.astro';
import PortableText from '../../../components/PortableText.astro';
import PageSections from '../../../components/PageSections.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations, localePath } from '../../../lib/i18n';
import { getAwards, getCurrentEdition, getHubPages, getEditions, exhibitorEditions } from '../../../lib/queries';
import { pageForTab } from '../../../lib/hubs';
import { countryCode } from '../../../lib/countries';
import { exhibitorPath } from '../../../lib/links';
import { styleAttrs } from '../../../lib/textStyle';

/**
 * /exhibitors/awards: the fair's exhibitor awards (best booth, best solo
 * show…), as the design's exhibitors/awards/index.html draws it
 * (2026-09-14 build): the exhibitors title band with the awards tab
 * active, an intro line, then one row per award, rebuilt to the client's
 * Figma frame of 2026-09-16: the pictures on the left; on the right the
 * award's name over a rule, what it rewards, and "PREVIOUS LAUREATE (2026)"
 * with the winning gallery - or "NEW THIS YEAR" for an award that has never
 * been given.
 *
 * Data: `award` documents of family "fair", one row per award name of this
 * edition or the last (see `awards` below). The intro is the `page` in
 * section "exhibitors" whose English slug is `awards`, when an editor makes
 * one; the list never comes from it. A static segment, so it wins over
 * exhibitors/[slug].astro.
 */
export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);

const [allAwards, edition, pages, editions] = await Promise.all([
  getAwards(lang),
  getCurrentEdition(lang),
  getHubPages(lang, 'exhibitors'),
  getEditions(lang),
]);
/**
 * The title band's edition: the one the exhibitors list opens on, which is
 * the one with a catalogue — the current edition has none yet and the
 * catalogue tab vanished on this page (meeting, 2026-10-01). The awards
 * logic below keeps reading the *current* edition: which awards show is a
 * different question from which catalogue the band links.
 */
const { landingYear } = exhibitorEditions(editions);
const bandEdition = editions.find((e: any) => e.year === landingYear) ?? edition;
const page = pageForTab(pages, 'awards');
const fair = allAwards.filter((a: any) => a.family === 'fair' && a.year);
const sameAward = (a: any, b: any) => String(a?.name ?? '').trim().toLowerCase() === String(b?.name ?? '').trim().toLowerCase();
/** The edition the page speaks for: the current one, else the newest with an award. */
const current: number | undefined = edition?.year ?? fair[0]?.year;
const year = current;

/**
 * Every year's awards, newest year first, each award document its own row
 * with its own winner ("all the awards from all the years visible, not only
 * the most recent" - Tiphaine, 2026-11-24). Until then the page showed one
 * row per award name of this edition or the last, so 2025's best booth was
 * off the page. Within a year the rows follow the Order field. An award
 * nobody has won under that name yet is "new this year"; a won one says
 * "previous laureate (<year>)" over its winner, as before.
 *
 * The picture changes side with each year - left for the newest, right for
 * the year before, and so on - "to allow the visitors to notice the
 * difference from one year to the other" (same message). `flip` marks it.
 * Only years with a picture count, so a year whose awards have none (2027's
 * new award, so far) does not push the next year's pictures to the right.
 */
const years = [...new Set(fair.filter((a: any) => imagesOf(a).length).map((a: any) => a.year))].sort((a: any, b: any) => b - a);
const awards = fair
  .map((a: any) => ({
    ...a,
    previous: a.gallery ? a : null,
    isNew: !a.gallery && (!current || a.year >= current) && !fair.some((b: any) => sameAward(a, b) && b.gallery),
    flip: years.indexOf(a.year) % 2 === 1,
  }))
  .sort((a: any, b: any) => b.year - a.year || (a.order ?? 100) - (b.order ?? 100));

/**
 * The award's own slideshow (`images`, request #5), else its single image.
 * Nothing else: it used to fall back to the winning gallery's pictures, but
 * an award with no picture should show none ("see best group show" -
 * Tiphaine, 2026-10-02).
 */
function imagesOf(a: any): any[] {
  const slides = (a.images ?? []).filter((img: any) => img?.asset);
  if (slides.length) return slides;
  return a.image?.asset ? [a.image] : [];
}

/* The partner logos' slot height, as Partners.astro sizes its cards. */
const logoHeight = (image: any, max = 78, base = 92) => {
  const ar = image?.dimensions?.aspectRatio;
  if (!ar || !Number.isFinite(ar) || ar <= 0) return max;
  return Math.round(Math.min(max, Math.max(38, base / Math.pow(ar, 0.45))));
};
---

<Base
  lang={lang}
  title={page?.seo?.title ?? `${t('exhibitors.awardsPage')}${year ? ` ${year}` : ''}`}
  description={page?.seo?.description ?? page?.intro}
  noIndex={page?.seo?.noIndex}
  image={page?.seo?.ogImage ?? page?.cover}
  path="exhibitors/awards"
  editId={page?._id}
  editType={page?._type}
>
  <ExhibitorHead lang={lang} active="awards" edition={bandEdition} />

  {
    page?.intro && (
      <div class="awards-intro">
        <p {...styleAttrs(page.introStyle)}>{page.intro}</p>
      </div>
    )
  }

  {
    awards.length ? (
      <div class="awards-list">
        {awards.map((a: any, i: number) => {
          const images = imagesOf(a);
          const prev = a.previous;
          const gallery = prev?.gallery;
          const code = gallery ? countryCode(gallery.countryCode ?? gallery.country) : null;
          return (
            <article class:list={{ 'no-shot': !images.length, flip: a.flip }}>
              {/* No picture, no frame: an award with nothing to show drew an
                  empty grey rectangle beside its text ("we currently don't
                  have a photo to put there. Maybe just align the block of
                  text to the left?" - Léonie, 2026-10-05). The row then runs
                  as one column and the copy starts at the gutter. */}
              {images.length > 0 && (
                <figure>
                  <Slideshow images={images} aspect={1.5} widths={[600, 900, 1200, 1600]} sizes="(max-width: 640px) 100vw, 50vw" label={a.name} id={`award-${i + 1}`} captions={false} />
                </figure>
              )}
              <div class="award-copy">
                <h2 {...styleAttrs(a.nameStyle)}>{a.name}</h2>
                {a.isNew && <p class="label">{t('exhibitors.newThisYear')}</p>}
                {a.description && <PortableText value={a.description} fieldStyle={a.descriptionStyle} />}
                {/* The granting partner's website and logo under the
                    description, as on the art prize awards and the partner
                    cards ("add a logo and website redirection link box
                    under every award description" - Gilles, 2026-10-03). */}
                {(a.partner?.url || a.partner?.logo?.asset) && (
                  <div class="award-foot">
                    {a.partner?.url ? <LinkPill lang={lang} href={a.partner.url} label={t('common.website')} external /> : <span />}
                    {a.partner?.logo?.asset && (
                      <span class="logo-slot" style={`--logo-h:${logoHeight(a.partner.logo)}px`}>
                        <SanityImage image={a.partner.logo} widths={[250, 500]} sizes="250px" class="logo" placeholder={false} />
                      </span>
                    )}
                  </div>
                )}
                {gallery && (
                  <div class="laureate">
                    <p class="label">{t('exhibitors.previousLaureate', { year: prev.year })}</p>
                    <p>
                      {gallery.slug ? (
                        <a class="hl-link" href={localePath(lang, exhibitorPath(gallery))}>
                          {gallery.name}
                          {code && ` (${code})`}
                        </a>
                      ) : (
                        <>
                          {gallery.name}
                          {code && ` (${code})`}
                        </>
                      )}
                      {prev.outcome && <span {...styleAttrs(prev.outcomeStyle)}>, {prev.outcome}</span>}
                    </p>
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <p class="empty">{t('exhibitors.awardsEmpty')}</p>
    )
  }
  {
    (page?.sections?.length ?? 0) > 0 && (
      <div class="content-wrap">
        <PageSections lang={lang} sections={page.sections} />
      </div>
    )
  }
</Base>

<style>
  /* From the design's exhibitors/awards/index.html (2026-09-14 build). */
  .awards-intro {
    padding: 36px var(--gutter) 34px;
  }
  .awards-intro p {
    letter-spacing: -0.035em;
    max-width: 1120px;
    font-size: clamp(28px, 2.6vw, 40px);
    line-height: 1.15;
  }
  /* The rows of the Figma frame: pictures on the left half, the text beside
     them, no rules between rows. */
  .awards-list {
    padding: 0 var(--gutter) 90px;
  }
  /* Without an intro the rows would touch the title band. */
  :global(.exhibitor-head) + .awards-list {
    padding-top: 36px;
  }
  .awards-list article {
    grid-template-columns: 1fr 1fr;
    gap: 30px 40px;
    padding-bottom: 50px;
    display: grid;
  }
  /* Pictureless: one column, the text at the left where the pictures were.
     The copy keeps the half-width measure of the ruled rows above it rather
     than running the full page (Léonie, 2026-10-05). */
  .awards-list article.no-shot {
    grid-template-columns: minmax(0, 1fr);
  }
  .no-shot .award-copy {
    max-width: calc(50% - 20px);
  }
  /* Every other year the picture moves to the right half (Tiphaine,
     2026-11-24). Only the order changes; on a phone the row is one column
     and the picture stays on top. */
  .awards-list article.flip:not(.no-shot) figure {
    order: 2;
  }
  .awards-list figure {
    margin: 0;
    position: relative;
  }
  .awards-list :global(img) {
    aspect-ratio: 1.5;
    object-fit: cover;
    width: 100%;
    background: #f0efed;
  }
  /* The guest of honour page's title: semibold, tight, a 2px rule right under it. */
  .award-copy h2 {
    border-bottom: 2px solid;
    text-transform: lowercase;
    letter-spacing: -0.04em;
    font-size: clamp(28px, 2.5vw, 36px);
    font-weight: 600;
    line-height: 1.2;
  }
  /* The text starts 22px under the rule, as in the frame. */
  .award-copy :global(.rich-text) {
    max-width: 640px;
    margin-top: 10px;
    font-size: var(--body-size);
    line-height: var(--body-lh);
    letter-spacing: var(--body-ls);
  }
  /* "PREVIOUS LAUREATE (2026)" / "NEW THIS YEAR": bold capitals at the
     frame's 22px. Noi Grotesk ships 400/600/900, so 600 is the bold cut. */
  .award-copy .label {
    margin-top: 18px;
    text-transform: uppercase;
    font-size: clamp(17px, 1.53vw, 22px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .laureate {
    margin-top: 26px;
    font-size: var(--body-size);
    line-height: var(--body-lh);
    letter-spacing: var(--body-ls);
  }
  .laureate .label {
    margin-top: 0;
  }
  /* Underlined, as the client's awards frame of 2026-09-24 draws the gallery. */
  .laureate a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }
  .empty {
    padding: 45px var(--gutter) 90px;
    font-size: 24px;
  }
  @media (max-width: 640px) {
    .awards-list article {
      display: block;
    }
    .awards-list article.flip:not(.no-shot) figure {
      order: 0;
    }
    .award-copy {
      padding-top: 16px;
    }
    /* One column already: the half-width measure above is a desktop rule. */
    .no-shot .award-copy {
      max-width: none;
      padding-top: 0;
    }
  }
  /* The partner cards' foot (Partners.astro): website pill left, the
     granting partner's logo fitted right. */
  .award-foot {
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-top: 24px;
    display: flex;
  }
  .logo-slot {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 250px;
    margin-left: auto;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }
  .logo-slot :global(.logo) {
    object-fit: contain;
    object-position: right center;
    width: 100%;
    min-width: 0;
    height: var(--logo-h, 78px);
  }
</style>
