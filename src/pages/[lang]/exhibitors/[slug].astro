---
import Base from '../../../layouts/Base.astro';
import ExhibitorDetail from '../../../components/ExhibitorDetail.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { getExhibitor, getExhibitorPaths, getCurrentEdition } from '../../../lib/queries';

/**
 * /exhibitors/<slug>: a gallery of the edition whose galleries the site opens
 * on. A past edition's gallery is /exhibitors/<year>/<slug> ([year]/[slug]).
 *
 * **A past year's list was here too until 2026-10-01**, at `exhibitors/<year>`
 * - the address the old site gave it. That list is now the exhibitors tab of
 * the previous-editions section, so one year's content has one shape of URL;
 * `scripts/legacy-redirects.mjs` 301s the old addresses onto it.
 */
export async function getStaticPaths() {
  const { current } = await getExhibitorPaths();
  const slugs = [...new Set(current)];
  return LOCALE_IDS.flatMap((lang) => slugs.map((slug) => ({ params: { lang, slug } })));
}

const lang = Astro.params.lang as LocaleId;
const slug = Astro.params.slug as string;

const [exhibitor, edition] = await Promise.all([getExhibitor(lang, slug), getCurrentEdition(lang)]);
if (!exhibitor) return Astro.rewrite('/404');

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: exhibitor.name,
  ...(exhibitor.website ? { url: exhibitor.website } : {}),
};
---

<Base
  lang={lang}
  title={exhibitor.seo?.title ?? exhibitor.name}
  description={exhibitor.seo?.description}
  noIndex={exhibitor.seo?.noIndex}
  image={exhibitor.seo?.ogImage ?? exhibitor.images?.[0]}
  path={`exhibitors/${slug}`}
  editId={exhibitor._id}
  editType={exhibitor._type}
>
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} slot="head" />
  <ExhibitorDetail lang={lang} exhibitor={exhibitor} listPath="exhibitors" edition={edition} />
</Base>
