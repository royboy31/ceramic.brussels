---
import Base from '../../../layouts/Base.astro';
import SanityImage from '../../../components/SanityImage.astro';
import PortableText from '../../../components/PortableText.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations, localePath } from '../../../lib/i18n';
import { getExhibitor, getExhibitorSlugs } from '../../../lib/queries';

export async function getStaticPaths() {
  const slugs = await getExhibitorSlugs();
  return LOCALE_IDS.flatMap((lang) => slugs.map(({ slug }) => ({ params: { lang, slug } })));
}

const lang = Astro.params.lang as LocaleId;
const slug = Astro.params.slug as string;
const t = useTranslations(lang);

const exhibitor = await getExhibitor(lang, slug);
if (!exhibitor) return Astro.rewrite('/404');

const path = `exhibitors/${slug}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: exhibitor.name,
  ...(exhibitor.website ? { url: exhibitor.website } : {}),
  ...(exhibitor.country ? { address: { '@type': 'PostalAddress', addressCountry: exhibitor.country } } : {}),
};
---

<Base
  lang={lang}
  title={exhibitor.seo?.title ?? exhibitor.name}
  description={exhibitor.seo?.description}
  noIndex={exhibitor.seo?.noIndex}
  image={exhibitor.seo?.ogImage ?? exhibitor.images?.[0]}
  path={path}
  editId={exhibitor._id}
  editType={exhibitor._type}
>
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} slot="head" />

  <a class="back" href={localePath(lang, 'exhibitors')}>&larr; {t('common.backTo')} {t('nav.exhibitors')}</a>

  <header class="detail-head">
    <h1>{exhibitor.name}</h1>
    <p class="lede">
      {exhibitor.booth && <span class="booth">{t('exhibitors.booth')} {exhibitor.booth}</span>}
      {[exhibitor.city, exhibitor.country].filter(Boolean).join(', ')}
      {exhibitor.year && <span class="meta"> · {exhibitor.year}</span>}
    </p>

    <p class="links">
      {exhibitor.website && <a href={exhibitor.website}>{t('common.website')}</a>}
      {
        exhibitor.instagram && (
          <a href={`https://instagram.com/${exhibitor.instagram}`}>@{exhibitor.instagram}</a>
        )
      }
    </p>
  </header>

  {
    exhibitor.bio && (
      <div class="prose">
        <PortableText value={exhibitor.bio} />
      </div>
    )
  }

  {
    exhibitor.artists?.length > 0 && (
      <section>
        <h2>{t('exhibitors.represents')}</h2>
        <ul class="grid">
          {exhibitor.artists.map((a: any) => (
            <li class="card">
              <a class="card-link" href={localePath(lang, `artists/${a.slug}`)}>
                <SanityImage image={a.portrait} aspect={1} sizes="(max-width: 700px) 50vw, 220px" />
                <h3>{a.name}</h3>
                {a.nationality && <p class="meta">{a.nationality}</p>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    exhibitor.images?.length > 0 && (
      <section>
        <h2>Images</h2>
        <div class="gallery">
          {exhibitor.images.map((img: any, i: number) => (
            <figure>
              <SanityImage
                image={img}
                loading={i === 0 ? 'eager' : 'lazy'}
                sizes="(max-width: 700px) 100vw, 560px"
              />
              {img.credit && <figcaption class="meta">{img.credit}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .detail-head {
    margin-bottom: 2rem;
  }
  .booth {
    display: inline-block;
    background: var(--surface-2);
    padding: 0.1rem 0.45rem;
    margin-right: 0.5rem;
    font-size: 0.9rem;
  }
  .links {
    display: flex;
    gap: 1.2rem;
    font-size: 0.9rem;
    margin: 0.6rem 0 0;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.4rem;
    margin-top: 1.2rem;
  }
  .gallery figure {
    margin: 0;
  }
  .gallery figcaption {
    margin-top: 0.35rem;
  }
</style>
