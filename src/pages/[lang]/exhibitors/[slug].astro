---
import Base from '../../../layouts/Base.astro';
import SanityImage from '../../../components/SanityImage.astro';
import PortableText from '../../../components/PortableText.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations, localePath } from '../../../lib/i18n';
import { getExhibitor, getExhibitorSlugs, getExhibitors } from '../../../lib/queries';
import { instagramUrl } from '../../../lib/links';
import { styleAttrs } from '../../../lib/textStyle';

/**
 * One exhibitor, as the design's exhibitors/chaxartxrtm/index.html draws
 * it: the artwork with its dots and "1/6 · Artist, Title, year" caption on
 * the left; on the right a ruled header with the name, "City (CC) ● booth",
 * the instagram / website pills and "presenting" with the artists, then the
 * description in two columns; previous / next along the bottom, walking
 * the same alphabetical list as the index.
 */
export async function getStaticPaths() {
  const slugs = await getExhibitorSlugs();
  return LOCALE_IDS.flatMap((lang) => slugs.map(({ slug }) => ({ params: { lang, slug } })));
}

const lang = Astro.params.lang as LocaleId;
const slug = Astro.params.slug as string;
const t = useTranslations(lang);

const [exhibitor, all] = await Promise.all([getExhibitor(lang, slug), getExhibitors(lang)]);
if (!exhibitor) return Astro.rewrite('/404');

/** The design shows a two-letter code after the city; `country` holds the full name. */
const ISO: Record<string, string> = {
  france: 'FR', spain: 'ES', belgium: 'BE', netherlands: 'NL', 'the netherlands': 'NL', norway: 'NO',
  switzerland: 'CH', turkey: 'TR', germany: 'DE', italy: 'IT', 'united kingdom': 'GB', 'united states': 'US',
  portugal: 'PT', denmark: 'DK', sweden: 'SE', austria: 'AT', luxembourg: 'LU', japan: 'JP', china: 'CN',
  korea: 'KR', 'south korea': 'KR',
};
const countryCode = (value?: string) => {
  if (!value) return undefined;
  if (/^[A-Za-z]{2}$/.test(value)) return value.toUpperCase();
  return ISO[value.trim().toLowerCase()] ?? value;
};

const images: any[] = (exhibitor.images ?? []).filter((i: any) => i?.asset);
const artwork = images[0];

const index = all.findIndex((ex: any) => ex.slug === slug);
const previous = index > 0 ? all[index - 1] : null;
const next = index >= 0 && index < all.length - 1 ? all[index + 1] : null;

const code = countryCode(exhibitor.countryCode ?? exhibitor.country);
const place = [exhibitor.city, code && `(${code})`].filter(Boolean).join(' ');
/** The written list wins over the references: the design names every artist, not only the ones with a page. */
const presenting = !exhibitor.artistsText && exhibitor.artists?.length ? exhibitor.artists : null;

/** The description runs in two columns: the first half of its paragraphs left, the rest right. */
const bio: any[] = exhibitor.bio ?? [];
const split = Math.ceil(bio.length / 2);
const bioLeft = bio.slice(0, split);
const bioRight = bio.slice(split);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: exhibitor.name,
  ...(exhibitor.website ? { url: exhibitor.website } : {}),
  ...(code && code.length === 2
    ? { address: { '@type': 'PostalAddress', addressLocality: exhibitor.city, addressCountry: code } }
    : {}),
};
---

<Base
  lang={lang}
  title={exhibitor.seo?.title ?? exhibitor.name}
  description={exhibitor.seo?.description}
  noIndex={exhibitor.seo?.noIndex}
  image={exhibitor.seo?.ogImage ?? images[0]}
  path={`exhibitors/${slug}`}
  editId={exhibitor._id}
  editType={exhibitor._type}
>
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} slot="head" />

  <article class="page-grid exhibitor-detail">
    <figure class="artwork">
      <div class="relative">
        {
          artwork ? (
            <SanityImage image={artwork} widths={[433, 866, 1300]} sizes="(max-width: 1000px) 100vw, 433px" loading="eager" />
          ) : (
            <div class="artwork-empty" />
          )
        }
        {
          (exhibitor.soloShow || exhibitor.kind === 'jury-prize') && (
            <span class="absolute right-3 top-3 grid h-16 w-16 place-items-center rounded-full bg-black text-center text-sm leading-[.9] text-white">
              {exhibitor.kind === 'jury-prize' ? t('exhibitors.juryPrize') : t('exhibitors.soloShow')}
            </span>
          )
        }
      </div>
      {
        images.length > 1 && (
          <div class="dots" aria-hidden="true">
            {images.map(() => (
              <i />
            ))}
          </div>
        )
      }
      {
        artwork && (artwork.caption || artwork.workTitle || images.length > 1) && (
          <figcaption>
            <span>1/{images.length}</span>
            <span>
              {artwork.caption}
              {artwork.workTitle && (
                <>
                  {artwork.caption && ', '}
                  <em>{artwork.workTitle}</em>
                </>
              )}
              {artwork.year && `, ${artwork.year}`}
            </span>
          </figcaption>
        )
      }
    </figure>

    <div class="profile">
      <header>
        <div>
          <h2 {...styleAttrs(exhibitor.nameStyle)}>{exhibitor.name}</h2>
          {
            (place || exhibitor.booth) && (
              <p>
                {place}
                {place && exhibitor.booth && <br />}
                {exhibitor.booth && <>● {exhibitor.booth}</>}
              </p>
            )
          }
          {
            (exhibitor.instagram || exhibitor.website) && (
              <nav>
                {exhibitor.instagram && (
                  <a href={instagramUrl(exhibitor.instagram)} target="_blank" rel="noopener noreferrer">
                    {t('common.instagram')} ↗
                  </a>
                )}
                {exhibitor.website && (
                  <a href={exhibitor.website} target="_blank" rel="noopener noreferrer">
                    {t('common.website')} ↗
                  </a>
                )}
              </nav>
            )
          }
        </div>
        {
          (presenting || exhibitor.artistsText) && (
            <div>
              <small>{t('exhibitors.presenting')}</small>
              <h3>
                {presenting
                  ? presenting.map((a: any, i: number) => (
                      <>
                        {i > 0 && ', '}
                        {a.slug ? <a href={localePath(lang, `artists/${a.slug}`)}>{a.name}</a> : a.name}
                      </>
                    ))
                  : exhibitor.artistsText}
              </h3>
            </div>
          )
        }
      </header>

      {
        bio.length > 0 && (
          <div class="copy">
            <div>
              <PortableText value={bioLeft} fieldStyle={exhibitor.bioStyle} />
            </div>
            {bioRight.length > 0 && (
              <div>
                <PortableText value={bioRight} fieldStyle={exhibitor.bioStyle} />
              </div>
            )}
          </div>
        )
      }
    </div>

    <nav class="pager" aria-label={t('nav.exhibitors')}>
      {
        previous ? (
          <a href={localePath(lang, `exhibitors/${previous.slug}`)}>
            ← <span>{t('exhibitors.previous')}</span>
          </a>
        ) : (
          <a href={localePath(lang, 'exhibitors')}>
            ← <span>{t('exhibitors.backToAll')}</span>
          </a>
        )
      }
      {
        next ? (
          <a href={localePath(lang, `exhibitors/${next.slug}`)}>
            <span>{t('exhibitors.next')}</span> →
          </a>
        ) : (
          <a href={localePath(lang, 'exhibitors')}>
            <span>{t('exhibitors.backToAll')}</span> →
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  /* From the design's exhibitors/chaxartxrtm/index.html. */
  .exhibitor-detail {
    grid-template-columns: 433px minmax(0, 907px);
    gap: 40px;
    min-height: 1009px;
    padding-top: 14px;
    position: relative;
  }
  .artwork {
    grid-column: 1;
    margin: 0;
  }
  .artwork :global(img),
  .artwork-empty {
    object-fit: cover;
    width: 433px;
    height: 541px;
  }
  .artwork-empty {
    background: #f5f5f5;
  }
  .dots {
    justify-content: center;
    gap: 18px;
    margin-top: -26px;
    display: flex;
    position: relative;
  }
  .dots i {
    background: #ddd;
    border-radius: 50%;
    width: 12px;
    height: 12px;
  }
  .dots i:first-child {
    background: #fff;
  }
  .artwork figcaption {
    justify-content: space-between;
    margin-top: 18px;
    font-size: 16px;
    display: flex;
  }
  .profile {
    grid-column: 2;
  }
  .profile header {
    border-top: 2px solid;
    grid-template-columns: 434px 433px;
    gap: 40px;
    padding-top: 12px;
    display: grid;
  }
  .profile h2 {
    letter-spacing: -0.05em;
    font-size: 60px;
    line-height: 1;
  }
  .profile header p,
  .profile h3 {
    letter-spacing: -0.04em;
    font-size: 40px;
    line-height: 42px;
  }
  .profile header p {
    margin-top: 12px;
  }
  .profile small {
    font-size: 24px;
  }
  .profile nav {
    gap: 40px;
    margin-top: 26px;
    display: flex;
  }
  .profile nav a {
    border: 1px solid;
    border-radius: 999px;
    padding: 3px 18px;
    font-size: 28px;
    line-height: 36px;
  }
  .copy {
    letter-spacing: -0.03em;
    grid-template-columns: 434px 433px;
    gap: 40px;
    margin-top: 37px;
    font-size: 24px;
    line-height: 30px;
    display: grid;
  }
  .copy :global(p + p) {
    margin-top: 28px;
  }
  .pager {
    justify-content: space-between;
    font-size: 50px;
    display: flex;
    position: absolute;
    bottom: 20px;
    left: 30px;
    right: 30px;
  }
  .pager span {
    font-size: 40px;
  }
  @media (width<=1000px) {
    .exhibitor-detail {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      min-height: 0;
    }
    .artwork,
    .profile {
      grid-column: 1;
    }
    .artwork :global(img),
    .artwork-empty {
      aspect-ratio: 433 / 541;
      width: 100%;
      height: auto;
    }
    .profile {
      margin-top: 32px;
    }
    .profile header,
    .copy {
      grid-template-columns: 1fr;
    }
    .profile h2 {
      font-size: 42px;
    }
    .profile header p,
    .profile h3 {
      font-size: 28px;
      line-height: 1.05;
    }
    .copy {
      font-size: 18px;
      line-height: 1.3;
    }
    .pager {
      margin-top: 60px;
      position: static;
    }
    .pager span {
      font-size: 28px;
    }
  }
</style>
