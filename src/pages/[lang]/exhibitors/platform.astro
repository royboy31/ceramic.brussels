---
/**
 * The exhibitors platform's one route (docs/exhibitors-platform.md). With
 * the preview runtime on, src/integrations/vip-routes.mjs flips this route
 * to on-demand (`astro:route:setup`), so the Worker renders it behind
 * src/middleware.ts's gate and no static file exists to fetch around it. On
 * a plain static build getStaticPaths builds nothing and the address does
 * not exist. Under `astro dev` there is no Worker: the platform renders in
 * its entered state, exactly as the VIP locked tabs open without a code
 * there.
 */
import Page from '../../../server/routes/exhibitors-platform.astro';
import { LOCALE_IDS } from '../../../lib/locales';

export function getStaticPaths() {
  // Only a plain static build reads this; the preview runtime serves the
  // route on demand instead (vip-routes.mjs), and dev ignores it.
  if (import.meta.env.PROD) return [];
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}
