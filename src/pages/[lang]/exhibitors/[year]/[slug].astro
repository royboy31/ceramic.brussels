---
import Base from '../../../../layouts/Base.astro';
import ExhibitorDetail from '../../../../components/ExhibitorDetail.astro';
import { DEFAULT_LOCALE, LOCALE_IDS, type LocaleId } from '../../../../lib/locales';
import { getExhibitor, getExhibitorPaths, getEditions, exhibitorEditions } from '../../../../lib/queries';
import { editionTabPath } from '../../../../lib/previousEditions';
import { PAST_EDITIONS_PUBLIC } from '../../../../components/launch';

/**
 * A past edition's exhibitor: /exhibitors/<year>/<slug>. A gallery that came
 * back has one record per year, often on the same slug, so each year's record
 * gets its own address under that year's list and none hides behind another.
 */
export async function getStaticPaths() {
  const [{ past }, editions] = await Promise.all([getExhibitorPaths(), getEditions(DEFAULT_LOCALE)]);
  /**
   * With previous editions off for the launch, only the year `/exhibitors`
   * opens on keeps its gallery pages - the others would be reachable by
   * address alone. No legacy redirect points at one, so nothing breaks.
   */
  const { landingYear } = exhibitorEditions(editions);
  const shown = PAST_EDITIONS_PUBLIC ? past : past.filter((p) => p.year === landingYear);
  const keys = [...new Set(shown.map((p) => `${p.year}/${p.slug}`))];
  return LOCALE_IDS.flatMap((lang) =>
    keys.map((key) => {
      const [year, slug] = key.split('/');
      return { params: { lang, year, slug } };
    }),
  );
}

const lang = Astro.params.lang as LocaleId;
const year = Number(Astro.params.year);
const slug = Astro.params.slug as string;

const [exhibitor, editions] = await Promise.all([getExhibitor(lang, slug, year), getEditions(lang)]);
if (!exhibitor) return Astro.rewrite('/404');

/**
 * This year's edition, for the band's catalogue tab: a 2026 gallery links
 * the 2026 catalogue. The page passed no edition at all until 2026-10-02,
 * which is where the meeting's disappearing "Catalog" button lived.
 */
const edition = editions.find((e: any) => e.year === year) ?? null;

/**
 * A gallery of a previous edition wears that section's grey ground: "make
 * each of the individual gallery pages grey like the rest of the « previous
 * editions » section of the website, so that the user completely understands
 * they're in that part of the website and not consulting the current edition
 * pages" (Léonie, 2026-10-26).
 *
 * The same test `ExhibitorHead` makes for its one back pill, and for the
 * same reason: with the section off for the launch these addresses serve the
 * landing year, which *is* the current list, and must stay white.
 */
const inPastSection = PAST_EDITIONS_PUBLIC;
---

<Base
  lang={lang}
  title={exhibitor.seo?.title ?? `${exhibitor.name} ${year}`}
  description={exhibitor.seo?.description}
  noIndex={exhibitor.seo?.noIndex}
  image={exhibitor.seo?.ogImage ?? exhibitor.images?.[0]}
  path={`exhibitors/${year}/${slug}`}
  editId={exhibitor._id}
  editType={exhibitor._type}
  theme={inPastSection ? 'ash' : 'default'}
>
  <ExhibitorDetail
    lang={lang}
    exhibitor={exhibitor}
    listPath={PAST_EDITIONS_PUBLIC ? editionTabPath(year, 'exhibitors', lang) : 'exhibitors'}
    year={year}
    edition={edition}
  />
</Base>
