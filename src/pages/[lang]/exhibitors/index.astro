---
import Base from '../../../layouts/Base.astro';
import SanityImage from '../../../components/SanityImage.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations, localePath } from '../../../lib/i18n';
import { getExhibitors } from '../../../lib/queries';

export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);
const exhibitors = await getExhibitors(lang);
---

<Base lang={lang} title={t('nav.exhibitors')} path="exhibitors">
  <h1>{t('nav.exhibitors')}</h1>
  <p class="lede">{exhibitors.length} {t('exhibitors.count')}</p>

  {
    exhibitors.length ? (
      <>
        <label class="filter">
          <span class="visually-hidden">{t('exhibitors.filter')}</span>
          <input type="search" id="exhibitor-filter" placeholder={t('exhibitors.filter')} autocomplete="off" />
        </label>

        <p class="empty" id="no-match" hidden>
          {t('exhibitors.noneMatch')}
        </p>

        <ul class="grid" id="exhibitor-list">
          {exhibitors.map((ex: any) => (
            <li
              class="card"
              data-search={[ex.name, ex.country, ex.city, ex.booth, ...(ex.artists ?? []).map((a: any) => a.name)]
                .filter(Boolean)
                .join(' ')
                .toLowerCase()}
            >
              <a class="card-link" href={localePath(lang, `exhibitors/${ex.slug}`)}>
                <SanityImage image={ex.image} aspect={4 / 3} sizes="(max-width: 700px) 50vw, 260px" />
                <h3>{ex.name}</h3>
                <p class="meta">
                  {ex.booth && <span class="booth">{ex.booth}</span>}
                  {[ex.city, ex.country].filter(Boolean).join(', ')}
                </p>
              </a>
              {ex.artists?.length > 0 && (
                <p class="artists">{ex.artists.map((a: any) => a.name).join(' · ')}</p>
              )}
            </li>
          ))}
        </ul>
      </>
    ) : (
      <p class="empty">
        {t('exhibitors.empty')} Add galleries in <a href="/studio">the Studio</a> and tie them to the
        current edition.
      </p>
    )
  }
</Base>

<script>
  // The one island on the site. Filters an already-rendered list, so it costs
  // nothing until someone types and works fine without JavaScript.
  const input = document.getElementById('exhibitor-filter') as HTMLInputElement | null;
  const list = document.getElementById('exhibitor-list');
  const noMatch = document.getElementById('no-match');

  if (input && list && noMatch) {
    const cards = Array.from(list.querySelectorAll<HTMLLIElement>('li[data-search]'));

    input.addEventListener('input', () => {
      const term = input.value.trim().toLowerCase();
      let visible = 0;

      for (const card of cards) {
        const match = !term || (card.dataset.search ?? '').includes(term);
        card.hidden = !match;
        if (match) visible++;
      }

      noMatch.hidden = visible > 0;
    });
  }
</script>

<style>
  .filter {
    display: block;
    margin: 1.5rem 0 0;
  }
  .filter input {
    width: 100%;
    max-width: 26rem;
    padding: 0.55rem 0.7rem;
    font: inherit;
    font-size: 0.95rem;
    color: var(--ink);
    background: var(--ground);
    border: 1px solid var(--rule);
  }
  .filter input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .booth {
    display: inline-block;
    background: var(--surface-2);
    padding: 0.05rem 0.35rem;
    margin-right: 0.4rem;
    font-variant-numeric: tabular-nums;
  }
  .artists {
    font-size: 0.82rem;
    color: var(--ink-3);
    margin: 0.3rem 0 0;
  }
  #no-match {
    margin-top: 1.5rem;
  }
</style>
