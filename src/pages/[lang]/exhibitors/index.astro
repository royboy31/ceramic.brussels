---
import Base from '../../../layouts/Base.astro';
import SanityImage from '../../../components/SanityImage.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations, localePath } from '../../../lib/i18n';
import { getExhibitors } from '../../../lib/queries';

export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);
const exhibitors = await getExhibitors(lang);

const LETTERS = 'abcdefghijklmnopqrstuvwxyz'.split('');

/** First letter of the gallery name, folded so "Éclat" files under E. */
const initial = (name: string) =>
  (name ?? '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .trim()
    .charAt(0)
    .toLowerCase();

const used = new Set(exhibitors.map((ex: any) => initial(ex.name)));

/**
 * The design shows four filter pills (solo show, focus españa, publishers,
 * jury prize). Those are tags on the exhibitor, and no such field exists in
 * the schema yet - so this reads whatever is there and renders nothing until
 * one is added, rather than hard-coding the list.
 */
const tags = [...new Set(exhibitors.flatMap((ex: any) => ex.tags ?? []))] as string[];
---

<Base lang={lang} title={t('nav.exhibitors')} path="exhibitors">
  <h1 class="section-title">{t('nav.exhibitors')}</h1>

  {
    exhibitors.length ? (
      <>
        <nav class="alphabet" aria-label={t('exhibitors.byLetter')}>
          {LETTERS.map((letter, i) => (
            <>
              {i > 0 && <span class="dash" aria-hidden="true">–</span>}
              {used.has(letter) ? (
                <button type="button" data-letter={letter} aria-pressed="false">
                  {letter}
                </button>
              ) : (
                <span class="letter-off">{letter}</span>
              )}
            </>
          ))}
        </nav>

        {tags.length > 0 && (
          <div class="filters">
            <span class="filters-label">{t('exhibitors.filters')}</span>
            {tags.map((tag) => (
              <button type="button" class="pill" data-tag={tag} aria-pressed="false">
                {tag}
              </button>
            ))}
          </div>
        )}

        <p class="empty" id="no-match" hidden>{t('exhibitors.noneMatch')}</p>

        <ul class="page-grid cards" id="exhibitor-list">
          {exhibitors.map((ex: any) => (
            <li
              class="card"
              data-letter={initial(ex.name)}
              data-tags={(ex.tags ?? []).join('|')}
            >
              <a href={localePath(lang, `exhibitors/${ex.slug}`)}>
                <div class="thumb">
                  {ex.image?.asset ? (
                    <SanityImage
                      image={ex.image}
                      aspect={1.5}
                      sizes="(max-width: 640px) 100vw, (max-width: 900px) 50vw, 33vw"
                      widths={[400, 600, 900, 1200]}
                    />
                  ) : (
                    <div class="thumb-empty" />
                  )}
                </div>

                <h2>
                  {ex.name}
                  {ex.country && <sup>{ex.country}</sup>}
                </h2>
              </a>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <p class="empty">
        {t('exhibitors.empty')} Add galleries in <a href="/studio">the Studio</a> and tie them to the
        current edition.
      </p>
    )
  }
</Base>

<style>
  .section-title {
    text-transform: lowercase;
    font-size: clamp(2rem, 4.8vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 600;
    margin: 0 0 1.25rem;
  }

  .alphabet {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.35em;
    font-size: clamp(1.25rem, 3.2vw, 2.6rem);
    letter-spacing: -0.04em;
  }
  .alphabet button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .alphabet button:hover,
  .alphabet button[aria-pressed='true'] {
    background: var(--acid);
  }
  .letter-off {
    color: var(--ink-3);
  }
  .dash {
    color: var(--ink-3);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
    font-size: clamp(1rem, 2vw, 1.75rem);
  }
  .filters-label {
    text-transform: uppercase;
  }
  .filters .pill {
    padding: 0.15rem 1rem;
    font-size: inherit;
    background: none;
    color: inherit;
    font-family: inherit;
    cursor: pointer;
  }
  .filters .pill[aria-pressed='true'] {
    background: var(--acid);
  }

  .cards {
    list-style: none;
    margin: 2rem 0 0;
    row-gap: 1.75rem;
    padding-inline: 0;
  }
  .card {
    grid-column: span 4;
  }
  .card[hidden] {
    display: none;
  }
  .card a {
    display: block;
    text-decoration: none;
  }

  .thumb {
    position: relative;
    overflow: hidden;
  }
  .thumb-empty {
    aspect-ratio: 1.5;
    background: var(--surface-2);
  }
  .thumb :global(img) {
    width: 100%;
    transition: transform 0.5s ease;
  }
  .card a:hover .thumb :global(img) {
    transform: scale(1.025);
  }

  .card h2 {
    margin: 0.5rem 0 0;
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-weight: 400;
  }
  .card sup {
    font-size: 0.45em;
    letter-spacing: normal;
    margin-left: 0.15em;
  }

  #no-match {
    margin-top: 2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb :global(img),
    .card a:hover .thumb :global(img) {
      transition: none;
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .card {
      grid-column: span 6;
    }
  }

  @media (max-width: 640px) {
    .card {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  // Filters a list that is already in the HTML, so it costs nothing until
  // someone clicks and the page is complete without JavaScript.
  const list = document.getElementById('exhibitor-list');
  const noMatch = document.getElementById('no-match');

  if (list && noMatch) {
    const cards = [...list.querySelectorAll<HTMLLIElement>('li.card')];
    const letterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-letter][aria-pressed]')];
    const tagButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-tag]')];

    let letter = '';
    let tag = '';

    const apply = () => {
      let visible = 0;

      for (const card of cards) {
        const cardTags = (card.dataset.tags ?? '').split('|').filter(Boolean);
        const match =
          (!letter || card.dataset.letter === letter) && (!tag || cardTags.includes(tag));
        card.hidden = !match;
        if (match) visible++;
      }

      noMatch.hidden = visible > 0;

      for (const button of letterButtons) {
        button.setAttribute('aria-pressed', String(button.dataset.letter === letter));
      }
      for (const button of tagButtons) {
        button.setAttribute('aria-pressed', String(button.dataset.tag === tag));
      }
    };

    for (const button of letterButtons) {
      button.addEventListener('click', () => {
        // Clicking the active letter clears it, so there is always a way back.
        letter = button.dataset.letter === letter ? '' : (button.dataset.letter ?? '');
        apply();
      });
    }

    for (const button of tagButtons) {
      button.addEventListener('click', () => {
        tag = button.dataset.tag === tag ? '' : (button.dataset.tag ?? '');
        apply();
      });
    }
  }
</script>
