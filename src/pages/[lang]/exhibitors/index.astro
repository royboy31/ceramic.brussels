---
import Base from '../../../layouts/Base.astro';
import ExhibitorCard from '../../../components/ExhibitorCard.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations } from '../../../lib/i18n';
import { getExhibitors, getCurrentEdition } from '../../../lib/queries';

/**
 * Current-edition exhibitors: A–Z index, filter pills (solo show, country
 * focus, publishers, jury prize) and the card grid. Filters and letters work
 * on the rendered list; the page is complete without JavaScript.
 */
export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);
const [exhibitors, edition] = await Promise.all([getExhibitors(lang), getCurrentEdition(lang)]);

const letters = 'abcdefghijklmnopqrstuvwxyz'.split('');
const present = new Set(exhibitors.map((ex: any) => (ex.sortName ?? ex.name ?? '').trim().charAt(0).toLowerCase()));

const filters = [
  { id: 'solo-show', label: t('exhibitors.soloShow') },
  { id: 'country-focus', label: edition?.countryFocus ?? t('exhibitors.countryFocus') },
  { id: 'publishers', label: t('exhibitors.publishers') },
  { id: 'jury-prize', label: `${t('exhibitors.juryPrize')}${edition?.year ? ` ${edition.year - 1}` : ''}` },
].filter((f) => exhibitors.some((ex: any) => (ex.soloShow && f.id === 'solo-show') || (ex.inCountryFocus && f.id === 'country-focus') || (ex.kind === 'publisher' && f.id === 'publishers') || (ex.kind === 'jury-prize' && f.id === 'jury-prize')));
---

<Base lang={lang} title={t('nav.exhibitors')} path="exhibitors">
  <h1>{t('nav.exhibitors')}</h1>

  {
    exhibitors.length ? (
      <>
        <nav class="alphabet" aria-label="A–Z">
          {letters.map((l) => (present.has(l) ? <a href={`#letter-${l}`}>{l}</a> : <span>{l}</span>))}
        </nav>

        {filters.length > 0 && (
          <div class="filters" id="exhibitor-filters">
            <span class="filters-label">{t('exhibitors.filters')}</span>
            {filters.map((f) => (
              <button type="button" data-filter={f.id} aria-pressed="false">
                {f.label}
              </button>
            ))}
          </div>
        )}

        <p class="empty" id="no-match" hidden>
          {t('exhibitors.noneMatch')}
        </p>

        <ul class="grid" id="exhibitor-list">
          {exhibitors.map((ex: any, i: number) => {
            const letter = (ex.sortName ?? ex.name ?? '').trim().charAt(0).toLowerCase();
            const prev = i > 0 ? (exhibitors[i - 1].sortName ?? exhibitors[i - 1].name ?? '').trim().charAt(0).toLowerCase() : null;
            return (
              <>
                {letter !== prev && <li class="letter" id={`letter-${letter}`} aria-hidden="true" />}
                <ExhibitorCard lang={lang} exhibitor={ex} />
              </>
            );
          })}
        </ul>
      </>
    ) : (
      <p class="empty">{t('exhibitors.empty')}</p>
    )
  }
</Base>

<script>
  // Filter pills toggle; a card stays visible when it matches every active
  // filter. Works on the already-rendered list, costs nothing until clicked.
  const bar = document.getElementById('exhibitor-filters');
  const list = document.getElementById('exhibitor-list');
  const noMatch = document.getElementById('no-match');

  if (bar && list && noMatch) {
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('button[data-filter]'));
    const cards = Array.from(list.querySelectorAll<HTMLLIElement>('li[data-filters]'));

    const apply = () => {
      const active = buttons.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.dataset.filter!);
      let visible = 0;
      for (const card of cards) {
        const has = (card.dataset.filters ?? '').split(' ');
        const match = active.every((f) => has.includes(f));
        card.hidden = !match;
        if (match) visible++;
      }
      noMatch.hidden = visible > 0;
    };

    for (const b of buttons) {
      b.addEventListener('click', () => {
        b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        apply();
      });
    }
  }
</script>

<style>
  .alphabet {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
    font-size: 1.4rem;
    margin: 1rem 0;
  }
  .alphabet a {
    color: var(--ink);
    text-decoration: none;
  }
  .alphabet span {
    color: var(--ink-3);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 2rem;
  }
  .filters-label {
    text-transform: uppercase;
    margin-right: 0.5rem;
  }
  .filters button {
    font: inherit;
    background: var(--ground);
    color: var(--ink);
    border: 1px solid var(--ink);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    cursor: pointer;
  }
  .filters button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--ground);
  }
  .letter {
    display: none;
  }
</style>
