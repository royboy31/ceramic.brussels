---
import Base from '../../../layouts/Base.astro';
import ExhibitorsListing from '../../../components/ExhibitorsListing.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations } from '../../../lib/i18n';
import { getExhibitors, getCurrentEdition, getMainPage } from '../../../lib/queries';

/**
 * The current edition's exhibitors. The list and its filters are
 * ExhibitorsListing; past editions' lists are /exhibitors/<year>, rendered by
 * [slug].astro from the same component.
 */
export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);
// The main page document (Studio → Exhibitors → Exhibitors page): lead, SEO
// and blocks around the list. The list itself never comes from it.
const [exhibitors, edition, page] = await Promise.all([
  getExhibitors(lang),
  getCurrentEdition(lang),
  getMainPage(lang, 'exhibitors'),
]);
---

<Base
  lang={lang}
  title={page?.seo?.title ?? page?.title ?? t('nav.exhibitors')}
  description={page?.seo?.description ?? page?.intro}
  noIndex={page?.seo?.noIndex}
  image={page?.seo?.ogImage ?? page?.cover}
  path="exhibitors"
  editId={page?._id}
  editType={page?._type}
>
  <ExhibitorsListing lang={lang} exhibitors={exhibitors} edition={edition} page={page} />
</Base>
