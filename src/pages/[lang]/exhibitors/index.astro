---
import Base from '../../../layouts/Base.astro';
import ExhibitorCard from '../../../components/ExhibitorCard.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations } from '../../../lib/i18n';
import { getExhibitors, getCurrentEdition } from '../../../lib/queries';

/**
 * Current-edition exhibitors: the A–Z row, the FILTERS pills (solo show,
 * country focus, publishers, jury prize) and the three-column card grid.
 * Letters are anchors to the first card of that initial and filters work on
 * the rendered list, so the page is complete without JavaScript.
 */
export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
const t = useTranslations(lang);
const [exhibitors, edition] = await Promise.all([getExhibitors(lang), getCurrentEdition(lang)]);

const LETTERS = 'abcdefghijklmnopqrstuvwxyz'.split('');

/** First letter of the sort name, folded so "Éclat" files under E. */
const initial = (ex: any) =>
  (ex.sortName ?? ex.name ?? '')
    .normalize('NFD')
    .replace(/\p{M}/gu, '')
    .trim()
    .charAt(0)
    .toLowerCase();

const present = new Set(exhibitors.map(initial));

const filters = [
  { id: 'solo-show', label: t('exhibitors.soloShow'), has: (ex: any) => ex.soloShow },
  { id: 'country-focus', label: edition?.countryFocus ?? t('exhibitors.countryFocus'), has: (ex: any) => ex.inCountryFocus },
  { id: 'publishers', label: t('exhibitors.publishers'), has: (ex: any) => ex.kind === 'publisher' },
  {
    id: 'jury-prize',
    label: `${t('exhibitors.juryPrize')}${edition?.year ? ` ${edition.year - 1}` : ''}`,
    has: (ex: any) => ex.kind === 'jury-prize',
  },
].filter((f) => exhibitors.some(f.has));
---

<Base lang={lang} title={t('nav.exhibitors')} path="exhibitors">
  <h1 class="section-title">{t('nav.exhibitors')}</h1>

  {
    exhibitors.length ? (
      <>
        <nav class="alphabet" aria-label={t('exhibitors.byLetter')}>
          {LETTERS.map((letter, i) => (
            <>
              {i > 0 && (
                <span class="dash" aria-hidden="true">
                  –
                </span>
              )}
              {present.has(letter) ? <a href={`#letter-${letter}`}>{letter}</a> : <span class="letter-off">{letter}</span>}
            </>
          ))}
        </nav>

        {filters.length > 0 && (
          <div class="filters" id="exhibitor-filters">
            <span class="filters-label">{t('exhibitors.filters')}</span>
            {filters.map((f) => (
              <button type="button" class="pill" data-filter={f.id} aria-pressed="false">
                {f.label}
              </button>
            ))}
          </div>
        )}

        <p class="empty" id="no-match" hidden>
          {t('exhibitors.noneMatch')}
        </p>

        <ul class="page-grid cards" id="exhibitor-list">
          {exhibitors.map((ex: any, i: number) => {
            const letter = initial(ex);
            const first = i === 0 || initial(exhibitors[i - 1]) !== letter;
            return <ExhibitorCard lang={lang} exhibitor={ex} id={first ? `letter-${letter}` : undefined} />;
          })}
        </ul>
      </>
    ) : (
      <p class="empty">{t('exhibitors.empty')}</p>
    )
  }
</Base>

<style>
  .alphabet {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.35em;
    font-size: clamp(1.25rem, 3.2vw, 2.6rem);
    letter-spacing: -0.04em;
    line-height: 1.2;
  }
  .alphabet a {
    color: inherit;
    text-decoration: none;
  }
  .alphabet a:hover,
  .alphabet a[aria-current] {
    background: var(--acid);
  }
  .letter-off,
  .dash {
    color: var(--ink-3);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
    font-size: clamp(1rem, 2vw, 1.75rem);
  }
  .filters-label {
    text-transform: uppercase;
  }
  .filters .pill {
    padding: 0.15rem 1rem;
    font-size: inherit;
    text-transform: lowercase;
    background: none;
    color: inherit;
    font-family: inherit;
    cursor: pointer;
  }
  .filters .pill:hover,
  .filters .pill[aria-pressed='true'] {
    background: var(--acid);
  }

  .cards {
    list-style: none;
    margin: 2rem 0 0;
    row-gap: 1.75rem;
    padding-inline: 0;
  }

  #no-match {
    margin-top: 2rem;
  }
</style>

<script>
  // Filter pills toggle; a card stays visible when it matches every active
  // filter. Works on the already-rendered list and costs nothing until clicked.
  const bar = document.getElementById('exhibitor-filters');
  const list = document.getElementById('exhibitor-list');
  const noMatch = document.getElementById('no-match');

  if (bar && list && noMatch) {
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('button[data-filter]'));
    const cards = Array.from(list.querySelectorAll<HTMLLIElement>('li[data-filters]'));

    const apply = () => {
      const active = buttons.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.dataset.filter!);
      let visible = 0;
      for (const card of cards) {
        const has = (card.dataset.filters ?? '').split(' ');
        const match = active.every((f) => has.includes(f));
        card.hidden = !match;
        if (match) visible++;
      }
      noMatch.hidden = visible > 0;
    };

    for (const b of buttons) {
      b.addEventListener('click', () => {
        b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        apply();
      });
    }
  }

  // The letter row is plain anchors; this only paints the one just used.
  const letters = Array.from(document.querySelectorAll<HTMLAnchorElement>('.alphabet a[href^="#letter-"]'));
  const markLetter = () => {
    for (const a of letters) {
      if (a.getAttribute('href') === location.hash) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    }
  };
  window.addEventListener('hashchange', markLetter);
  markLetter();
</script>
