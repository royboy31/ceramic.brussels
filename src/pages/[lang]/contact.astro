---
import { LOCALE_IDS, type LocaleId } from '../../lib/locales';
import { localePath } from '../../lib/i18n';
import { hubTabPath } from '../../lib/hubs';

/**
 * /contact merged into about → "contact & team" on 2026-09-24 (client
 * feedback and Figma): the address, social links and newsletter now open
 * that tab (`hubs/About.astro`). This address stays alive for the links and
 * bookmarks that point at it, and forwards there. The old site's /contact
 * goes straight to the tab (scripts/legacy-redirects.mjs).
 */
export function getStaticPaths() {
  return LOCALE_IDS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleId;
return Astro.redirect(localePath(lang, hubTabPath('about', 'team', lang)), 301);
---
