---
import About from '../../../components/hubs/About.astro';
import ArtPrize from '../../../components/hubs/ArtPrize.astro';
import GuestOfHonour from '../../../components/hubs/GuestOfHonour.astro';
import Partners from '../../../components/hubs/Partners.astro';
import PressMedia from '../../../components/hubs/PressMedia.astro';
import Programme from '../../../components/hubs/Programme.astro';
import Visit from '../../../components/hubs/Visit.astro';
import Vip from '../../../components/hubs/Vip.astro';
import PreviousEdition from '../../../components/editions/PreviousEdition.astro';
import { DEFAULT_LOCALE, LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { HUBS, hubRouteParams, hubFromSegment, tabFromSegment } from '../../../lib/hubs';
import { getHubPages, getPastEditionsIndex } from '../../../lib/queries';
import {
  editionRouteParams,
  editionFromRest,
  sectionFromSegment,
  isSectionRoot,
  editionTabPath,
} from '../../../lib/previousEditions';
import { localePath } from '../../../lib/i18n';

/**
 * Every hub, in every language, from one route.
 *
 * The hub and tab segments are part of the URL, and they are translated
 * (`/fr/a-propos/equipe`, `/nl/over/team`), so they cannot be folders on
 * disk - a folder called `about` can only ever spell `/fr/about`. This route
 * makes both segments dynamic and hands the page to the component for that
 * hub; the six components are the former `src/pages/[lang]/<hub>/[...tab]`
 * files, markup untouched.
 *
 * `hubRouteParams` supplies the identifiers as props alongside the localized
 * segments, so nothing downstream has to translate a segment back. The
 * fallbacks below are for the preview runtime, which renders this file on
 * request and has no static paths, and for the VIP hub's locked tabs, which
 * src/server/routes/vip-tab.astro renders the same way with `route` set.
 *
 * Astro ranks static segments above dynamic ones, so the listing routes
 * (`exhibitors/`, `artists/`, `news/`, `editions/`) still win over `[hub]`,
 * and `[lang]/[...slug].astro` stays below both. Verified by build.
 *
 * A `pageTabs` hub's tab is built only while its page is published, so each
 * such hub's pages are read here first. Page documents are the same in every
 * language, and the hub components make the same (memoised) query.
 *
 * **Previous editions rides on this route too** (`src/lib/previousEditions.ts`,
 * `docs/previous-editions-plan.md`). It is not a hub - its pills change from
 * one year to the next - but it has the hubs' one binding constraint: its
 * segment is translated (`/fr/editions-precedentes/2025`), so it cannot be a
 * folder on disk, and two dynamic siblings cannot both sit under `[lang]`.
 * `[...tab]` is a rest param, so it carries `2025/art-prize` without any
 * change to the route's shape.
 */
export async function getStaticPaths() {
  const routes = Object.keys(HUBS).filter((route) => HUBS[route].pageTabs);
  const [pageEntries, editions] = await Promise.all([
    Promise.all(routes.map(async (route) => [route, await getHubPages(DEFAULT_LOCALE, route)])),
    getPastEditionsIndex(DEFAULT_LOCALE),
  ]);
  const pages = Object.fromEntries(pageEntries);
  return [...hubRouteParams(LOCALE_IDS, { pages }), ...editionRouteParams(LOCALE_IDS, editions)];
}

const lang = Astro.params.lang as LocaleId;
const segment = Astro.params.hub as string;
const props = Astro.props as {
  route?: string;
  tab?: string;
  previousEdition?: boolean;
  root?: boolean;
  year?: number;
};

// Previous editions is decided first: its segment is its own and is never a
// hub's, so this branch cannot shadow one. `edition` stays null for a hub,
// and the template below picks between the two. The rest param is parsed when
// there are no static props - the preview runtime renders this file on
// request.
const inSection = props.previousEdition || sectionFromSegment(segment, lang);
const rest = Astro.params.tab as string | undefined;

// The section root has no page of its own: it sends the reader to the newest
// past edition (docs/previous-editions-plan.md §2). Both the old site's
// `/{lang}/pasteditions` and this build's earlier `/{lang}/editions` land
// here through the redirect map.
if (inSection && (props.root || isSectionRoot(rest))) {
  const newest = (await getPastEditionsIndex(lang))[0]?.year;
  if (!newest) return Astro.rewrite('/404');
  return Astro.redirect(localePath(lang, editionTabPath(newest, undefined, lang)), 301);
}

const edition = inSection
  ? props.previousEdition
    ? { year: props.year as number, tab: props.tab as string }
    : editionFromRest(rest, lang)
  : null;

const route = edition ? null : (props.route ?? hubFromSegment(segment, lang));
if (!edition && !route) return Astro.rewrite('/404');

const tab = route ? (props.tab ?? tabFromSegment(route, Astro.params.tab as string | undefined, lang)) : null;

const HUB_COMPONENTS: Record<string, any> = {
  about: About,
  'art-prize': ArtPrize,
  'guest-of-honour': GuestOfHonour,
  partners: Partners,
  'press-media': PressMedia,
  programme: Programme,
  visit: Visit,
  vip: Vip,
};
const Hub = route ? HUB_COMPONENTS[route] : null;
if (!edition && !Hub) return Astro.rewrite('/404');
---

{
  edition ? (
    <PreviousEdition lang={lang} year={edition.year} tab={edition.tab} />
  ) : (
    <Hub lang={lang} tab={tab} />
  )
}
