---
import Base from '../../../layouts/Base.astro';
import HubNav from '../../../components/HubNav.astro';
import Sections from '../../../components/Sections.astro';
import PageSections from '../../../components/PageSections.astro';
import SanityImage from '../../../components/SanityImage.astro';
import PortableText from '../../../components/PortableText.astro';
import PersonCard from '../../../components/PersonCard.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations, formatDate } from '../../../lib/i18n';
import { instagramUrl } from '../../../lib/links';
import { getHubPages, getPeople, getPressClips, getSettings, getEditions } from '../../../lib/queries';
import { HUBS, hubTabParams, hubTabPath, pageForTab } from '../../../lib/hubs';
import { styleAttrs } from '../../../lib/textStyle';

/**
 * About hub, as the design's about pages draw it. The fair: the large
 * intro, the hero figure beside the first text section, the other sections
 * two a row, the closing strip of photos. Advisory board and team: the
 * intro and the two-column people grid (team followed by its
 * collaborators). Press and images have no design page and follow the same
 * patterns. Markup and rules are Lilanga's build of the frames.
 */
export function getStaticPaths() {
  return hubTabParams('about', LOCALE_IDS);
}

const lang = Astro.params.lang as LocaleId;
const tab = (Astro.params.tab as string | undefined) ?? HUBS.about.tabs[0].slug;
const t = useTranslations(lang);

/* Labels this hub needs that STRINGS does not carry yet - all three locales,
   so nothing ships in English on a French page. To move into src/lib/i18n.ts. */
const LOCAL = {
  en: {
    collaborators: 'collaborators',
    pressKit: 'press kit',
    imagesEmpty: 'No edition has a photo gallery yet.',
    peopleEmpty: 'Nobody has been published in this group yet.',
    pageEmpty: 'This page has no content yet.',
  },
  fr: {
    collaborators: 'collaborateurs',
    pressKit: 'dossier de presse',
    imagesEmpty: 'Aucune édition n’a encore de galerie photo.',
    peopleEmpty: 'Personne n’a encore été publié dans ce groupe.',
    pageEmpty: 'Cette page n’a pas encore de contenu.',
  },
  nl: {
    collaborators: 'medewerkers',
    pressKit: 'perskit',
    imagesEmpty: 'Nog geen enkele editie heeft een fotogalerij.',
    peopleEmpty: 'Nog niemand gepubliceerd in deze groep.',
    pageEmpty: 'Deze pagina heeft nog geen inhoud.',
  },
} as const;
const s = (key: keyof (typeof LOCAL)['en']) => LOCAL[lang][key] ?? LOCAL.en[key];

const pages = await getHubPages(lang, 'about');
const page = pageForTab(pages, tab);
const hubTab = HUBS.about.tabs.find((x) => x.slug === tab);
const tabLabel = page?.tabLabel ?? (hubTab ? t(hubTab.label) : tab);

const board = tab === 'advisory-board' ? await getPeople(lang, 'advisory-board') : [];
const team = tab === 'team' ? await getPeople(lang, 'team') : [];
const collaborators = tab === 'team' ? await getPeople(lang, 'collaborator') : [];
const people = tab === 'team' ? team : board;

const [clips, settings] = tab === 'press' ? await Promise.all([getPressClips(), getSettings(lang)]) : [[], null];
// Newest first, grouped by year, which is how a press list is actually read.
const years = [...new Set(clips.map((c: any) => c.publishedAt?.slice(0, 4)))]
  .filter(Boolean)
  .sort((a, b) => String(b).localeCompare(String(a)));

const editions = tab === 'images' ? (await getEditions(lang)).filter((e: any) => e.images?.some((img: any) => img?.asset)) : [];

// The fair: the first text section sits beside the hero, the rest two a
// row, as the design's about page lays them out.
const stack: any[] = page?.sections ?? [];
const leadSection = stack[0]?._type === 'contentSection' ? stack[0] : null;
const rest = leadSection ? stack.slice(1) : stack;
const textRest = rest.filter((x: any) => x._type === 'contentSection');
const otherRest = rest.filter((x: any) => x._type !== 'contentSection');
const closingImages = (page?.images ?? []).filter((img: any) => img?.asset);
const path = hubTabPath('about', tab);
const wrap = { 'the-fair': 'about', 'advisory-board': 'advisory', team: 'advisory', press: 'press', images: 'images' }[tab] ?? '';

const captionOf = (img: any) => [img.caption, img.workTitle, img.year].filter(Boolean).length > 0 || img.credit;
---

<Base
  lang={lang}
  title={`${t('nav.about')} — ${tabLabel}`}
  description={page?.seo?.description ?? page?.intro}
  noIndex={page?.seo?.noIndex}
  image={page?.seo?.ogImage ?? page?.cover}
  path={path}
  editId={page?._id}
  editType={page?._type}
>
  <HubNav lang={lang} route="about" active={tab} pages={pages} />

  <div class:list={['content-wrap', wrap]}>
    {
      page?.intro && (
        <p class="intro-large" {...styleAttrs(page.introStyle)}>
          {page.intro}
        </p>
      )
    }

    {/* ---------------------------------------------------------- the fair */}
    {
      tab === 'the-fair' &&
        (page ? (
          <>
            <div class="hero">
              <figure>
                {page.cover?.asset ? (
                  <SanityImage image={page.cover} widths={[900, 1200, 1800]} sizes="(max-width: 700px) 100vw, 66vw" loading="eager" />
                ) : (
                  <img src="/assets/video-still.webp" alt="" width="1600" height="1066" />
                )}
                <span class="dots" aria-hidden="true">
                  <i />
                  <i />
                  <i />
                </span>
              </figure>
              {leadSection && <Sections lang={lang} sections={[leadSection]} columns={1} textColumns={1} />}
            </div>
            {textRest.length > 0 && (
              <div class="two-col copy">
                {textRest.map((section: any) => (
                  <Sections lang={lang} sections={[section]} columns={1} textColumns={1} />
                ))}
              </div>
            )}
            {otherRest.length > 0 && <PageSections lang={lang} sections={otherRest} />}
            {closingImages.length > 0 && (
              <div class="strip">
                {closingImages.map((img: any) => (
                  <SanityImage image={img} aspect={1.5} widths={[440, 660, 880]} sizes="(max-width: 700px) 100vw, 33vw" />
                ))}
              </div>
            )}
          </>
        ) : (
          <p class="empty">
            {s('pageEmpty')} <a href="/studio">Studio</a>
          </p>
        ))
    }

    {/* --------------------------------------------- advisory board / team */}
    {
      (tab === 'advisory-board' || tab === 'team') &&
        (people.length ? (
          <div class="people">
            {people.map((p: any) => (
              <PersonCard lang={lang} person={p} />
            ))}
          </div>
        ) : (
          <p class="empty">{s('peopleEmpty')}</p>
        ))
    }
    {
      tab === 'team' && collaborators.length > 0 && (
        <section class="group">
          <h2 class="panel-title">{s('collaborators')}</h2>
          <div class="people">
            {collaborators.map((p: any) => (
              <PersonCard lang={lang} person={p} />
            ))}
          </div>
        </section>
      )
    }

    {/* ------------------------------------------------------------- press */}
    {
      tab === 'press' && (
        <div class="two-col press-cols">
          <section>
            {settings?.pressContacts?.length > 0 && (
              <>
                <h2 class="panel-title">{t('press.contacts')}</h2>
                <div class="body-24">
                  {settings.pressContacts.map((c: any) => (
                    <p>
                      {c.region && <strong {...styleAttrs(c.regionStyle)}>{c.region}</strong>}
                      {c.name && (
                        <>
                          <br />
                          {c.name}
                        </>
                      )}
                      {c.email && (
                        <>
                          <br />
                          <a class="text-link" href={`mailto:${c.email}`}>
                            {c.email}
                          </a>
                        </>
                      )}
                      {c.url && (
                        <>
                          <br />
                          <a class="text-link" href={c.url} target="_blank" rel="noopener noreferrer">
                            {t('common.website')} ↗
                          </a>
                        </>
                      )}
                      {c.instagram && (
                        <>
                          <br />
                          <a class="text-link" href={instagramUrl(c.instagram)} target="_blank" rel="noopener noreferrer">
                            {t('common.instagram')} ↗
                          </a>
                        </>
                      )}
                    </p>
                  ))}
                </div>
              </>
            )}
            {settings?.pressKitUrl && (
              <a class="pill dark" href={settings.pressKitUrl} target="_blank" rel="noopener noreferrer">
                {s('pressKit')} ↗
              </a>
            )}
            {settings?.pressEmail && (
              <p class="body-24">
                <a class="text-link" href={`mailto:${settings.pressEmail}`}>
                  {settings.pressEmail}
                </a>
              </p>
            )}
          </section>
          <section>
            <h2 class="panel-title">{t('press.clips')}</h2>
            {clips.length ? (
              years.map((year) => (
                <div class="body-24 year">
                  <strong class="year-label">{year}</strong>
                  {clips
                    .filter((c: any) => c.publishedAt?.slice(0, 4) === year)
                    .map((clip: any) => (
                      <p>
                        <strong>{clip.outlet}</strong>
                        <br />
                        {clip.url ? (
                          <a class="text-link" href={clip.url} target="_blank" rel="noopener noreferrer">
                            {clip.title} ↗
                          </a>
                        ) : (
                          clip.title
                        )}
                        <br />
                        <time datetime={clip.publishedAt}>{formatDate(clip.publishedAt, lang)}</time>
                        {clip.language && ` · ${clip.language.toUpperCase()}`}
                        {clip.pdfUrl && (
                          <>
                            {' · '}
                            <a class="text-link" href={clip.pdfUrl} target="_blank" rel="noopener noreferrer">
                              pdf ↓
                            </a>
                          </>
                        )}
                      </p>
                    ))}
                </div>
              ))
            ) : (
              <p class="empty">{t('press.empty')}</p>
            )}
          </section>
        </div>
      )
    }

    {/* ------------------------------------------------------------ images */}
    {
      tab === 'images' &&
        (editions.length ? (
          editions.map((e: any) => (
            <section class="gallery">
              <h2 class="panel-title">{e.title ?? `ceramic brussels ${e.year}`}</h2>
              <div class="strip photos">
                {e.images
                  .filter((img: any) => img?.asset)
                  .map((img: any) => (
                    <figure>
                      <SanityImage image={img} aspect={1.5} widths={[440, 660, 880]} sizes="(max-width: 700px) 100vw, 33vw" />
                      {captionOf(img) && (
                        <figcaption>
                          {img.caption}
                          {img.workTitle && (
                            <>
                              {img.caption ? ', ' : ''}
                              <em>{img.workTitle}</em>
                            </>
                          )}
                          {img.year && `, ${img.year}`}
                          {img.credit && <span class="credit"> © {img.credit}</span>}
                        </figcaption>
                      )}
                    </figure>
                  ))}
              </div>
            </section>
          ))
        ) : (
          <p class="empty">{s('imagesEmpty')}</p>
        ))
    }

    {/* ------------------------------ page text on the tabs that carry one */}
    {page && tab !== 'the-fair' && <PageSections lang={lang} sections={page.sections} />}
    {
      page?.body && (
        <div class="body-24 page-body">
          <PortableText value={page.body} fieldStyle={page.bodyStyle} />
        </div>
      )
    }
    {
      tab !== 'the-fair' && closingImages.length > 0 && (
        <div class="strip">
          {closingImages.map((img: any) => (
            <SanityImage image={img} aspect={1.5} widths={[440, 660, 880]} sizes="(max-width: 700px) 100vw, 33vw" />
          ))}
        </div>
      )
    }
  </div>
</Base>

<style>
  /* From the design's about page. */
  .about > .intro-large {
    margin-bottom: 60px;
  }
  .hero {
    grid-template-columns: 2fr 1fr;
    gap: 40px;
    display: grid;
  }
  .hero figure {
    margin: 0;
    position: relative;
  }
  .hero :global(img) {
    object-fit: cover;
    width: 100%;
    height: 605px;
  }
  .dots {
    gap: 14px;
    display: flex;
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translate(-50%);
  }
  .dots i {
    background: #fff;
    border-radius: 50%;
    width: 12px;
    height: 12px;
  }
  .copy {
    margin-top: 50px;
  }
  .strip {
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 60px;
    display: grid;
  }
  .strip :global(img) {
    aspect-ratio: 1.5;
    object-fit: cover;
    width: 100%;
  }
  .strip figure {
    margin: 0;
  }
  .strip figcaption {
    margin-top: 8px;
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .credit {
    color: var(--ink-3);
  }
  @media (width<=700px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero :global(img) {
      height: auto;
    }
    .strip {
      grid-template-columns: 1fr;
    }
  }

  /* From the design's advisory-board page. */
  .people {
    grid-template-columns: 1fr 1fr;
    gap: 70px 40px;
    margin-top: 55px;
    display: grid;
  }
  .group {
    margin-top: 80px;
  }
  @media (width<=800px) {
    .people {
      grid-template-columns: 1fr;
    }
  }

  /* press and images: the same panels. */
  .press-cols {
    margin-top: 40px;
  }
  .press-cols .pill.dark {
    color: #fff;
    background: #000;
    margin-top: 30px;
  }
  .year + .year {
    margin-top: 40px;
  }
  .year-label {
    display: block;
    margin-bottom: 16px;
  }
  .gallery + .gallery {
    margin-top: 80px;
  }
  .page-body {
    margin-top: 40px;
    max-width: 1160px;
  }
</style>
