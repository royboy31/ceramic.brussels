---
import Base from '../../../layouts/Base.astro';
import HubNav from '../../../components/HubNav.astro';
import PageSections from '../../../components/PageSections.astro';
import Slideshow from '../../../components/Slideshow.astro';
import Figure from '../../../components/Figure.astro';
import SanityImage from '../../../components/SanityImage.astro';
import PortableText from '../../../components/PortableText.astro';
import LinkPill from '../../../components/LinkPill.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations } from '../../../lib/i18n';
import { getHubPages, getSettings, getCurrentEdition, getPartners } from '../../../lib/queries';
import { HUBS, hubTabParams, hubTabPath, pageForTab } from '../../../lib/hubs';
import { instagramUrl } from '../../../lib/links';
import { styleAttrs } from '../../../lib/textStyle';

/**
 * Visitors info. Practical info is the design's two-column page: photo,
 * address, tickets and hotel deal on the left; intro, opening hours and
 * access on the right - assembled from the current edition (hours, tickets)
 * and site settings (address, access, hotel deal). Food & drinks is a 2x2
 * grid of the `food-drinks` partners; floor plan and FAQ read the edition's
 * map and the settings' FAQ. A hub page with the same slug adds intro and
 * text to any tab.
 */
export function getStaticPaths() {
  return hubTabParams('visit', LOCALE_IDS);
}

const lang = Astro.params.lang as LocaleId;
const tab = (Astro.params.tab as string | undefined) ?? HUBS.visit.tabs[0].slug;
const t = useTranslations(lang);

const [pages, settings, edition, partners] = await Promise.all([
  getHubPages(lang, 'visit'),
  getSettings(lang),
  getCurrentEdition(lang),
  getPartners(lang),
]);
const page = pageForTab(pages, tab);
const hubTab = HUBS.visit.tabs.find((x) => x.slug === tab);
const tabLabel = page?.tabLabel ?? (hubTab ? t(hubTab.label) : tab);

const practical = tab === 'practical-info';
const info = settings?.practicalInfo ?? {};
const vendors = partners.filter((p: any) => p.tier === 'food-drinks');
const hotel = info.hotelDeal?.partner;
const hotelUrl = info.hotelDeal?.url ?? hotel?.url;
const intro = page?.intro ?? (practical ? info.intro : undefined);
/** The photo row at the foot of the page: site-settings images, then the hub page's own. */
const gallery: any[] = practical ? [...(info.images ?? []), ...(page?.images ?? [])] : (page?.images ?? []);
const path = hubTabPath('visit', tab);
---

<Base
  lang={lang}
  title={`${t('nav.visit')} — ${tabLabel}`}
  description={page?.seo?.description ?? intro}
  image={page?.seo?.ogImage ?? page?.cover ?? (practical ? info.heroImage : undefined)}
  path={path}
  editId={practical ? 'siteSettings' : page?._id}
  editType={practical ? 'siteSettings' : page?._type}
>
  <HubNav lang={lang} route="visit" active={tab} pages={pages} />

  {
    practical && (
      <div class="practical page-grid">
        <div class="col col-left">
          <Figure
            image={info.heroImage}
            pool="fair"
            seed="practical-info"
            aspect={3 / 2}
            sizes="(max-width: 800px) 100vw, 670px"
            widths={[670, 1000, 1340]}
            loading="eager"
            alt=""
            class="hero"
          />

          <section class="panel" id="address">
            <h2 class="panel-title">{t('visit.address')}</h2>
            <div class="body-24">
              {info.venueName && <p class="label">{info.venueName}</p>}
              {info.address && <p class="addr">{info.address}</p>}
            </div>
            {info.mapUrl && (
              <p class="map-link">
                <LinkPill lang={lang} href={info.mapUrl} label="Google Maps" variant="text" />
              </p>
            )}
          </section>

          <section class="panel" id="tickets">
            <h2 class="panel-title">{t('visit.tickets')}</h2>
            {edition?.tickets?.length ? (
              <dl class="rows body-24">
                {edition.tickets.map((tk: any) => (
                  <div class="row">
                    <dt {...styleAttrs(tk.nameStyle)}>{tk.name}</dt>
                    <dd>
                      {tk.price}
                      {tk.note && <span class="note"> ({tk.note})</span>}
                    </dd>
                  </div>
                ))}
              </dl>
            ) : (
              <p class="empty">No ticket prices on the current edition yet.</p>
            )}
            {edition?.ticketsNote && <p class="note-line" {...styleAttrs(edition.ticketsNoteStyle)}>{edition.ticketsNote}</p>}
            {edition?.ticketsUrl && (
              <p class="cta">
                <LinkPill lang={lang} href={edition.ticketsUrl} label={t('visit.bookTickets')} variant="solid" />
              </p>
            )}
          </section>

          {(hotel || info.hotelDeal?.text) && (
            <section class="panel" id="hotel">
              <h2 class="panel-title">{t('visit.hotelDeal')}</h2>
              <div class="body-24">
                {hotel?.name && <p class="label" {...styleAttrs(hotel.nameStyle)}>{hotel.name}</p>}
                {info.hotelDeal.text && <p class="deal">{info.hotelDeal.text}</p>}
              </div>
              {hotelUrl && (
                <p class="cta">
                  <LinkPill lang={lang} href={hotelUrl} label={t('visit.discoverHotel')} variant="solid" />
                </p>
              )}
            </section>
          )}
        </div>

        <div class="col col-right">
          {intro && <p class="intro-large practical-intro">{intro}</p>}

          <section class="panel" id="opening-hours">
            <h2 class="panel-title">{t('visit.openingHours')}</h2>
            {edition?.openingHours?.length ? (
              <dl class="rows body-24">
                {edition.openingHours.map((d: any) => (
                  <div class="row">
                    <dt {...styleAttrs(d.labelStyle)}>{d.label}</dt>
                    {(d.slots ?? []).map((s: any) => (
                      <dd>
                        {s.time && <span class="slot-time">{s.time}</span>}
                        {s.time && s.label && ' '}
                        {s.label}
                        {s.invitationOnly && <span class="note"> ({t('visit.invitation')})</span>}
                      </dd>
                    ))}
                  </div>
                ))}
              </dl>
            ) : (
              <p class="empty">No opening hours on the current edition yet.</p>
            )}
            {edition?.lastEntry && <p class="note-line" {...styleAttrs(edition.lastEntryStyle)}>{edition.lastEntry}</p>}
          </section>

          {info.access?.length > 0 && (
            <section class="panel" id="access">
              <h2 class="panel-title">{t('visit.access')}</h2>
              <dl class="rows body-24">
                {info.access.map((a: any) => (
                  <div class="row">
                    <dt {...styleAttrs(a.modeStyle)}>{a.mode}</dt>
                    <dd class="access-text" {...styleAttrs(a.textStyle)}>{a.text}</dd>
                  </div>
                ))}
              </dl>
              {info.accessibility && <p class="body-24 accessibility" {...styleAttrs(info.accessibilityStyle)}>{info.accessibility}</p>}
            </section>
          )}
        </div>
      </div>
    )
  }

  {!practical && intro && <p class="intro-large">{intro}</p>}

  {
    !practical && page?.cover?.asset && (
      <SanityImage
        image={page.cover}
        loading="eager"
        aspect={16 / 9}
        widths={[600, 900, 1200, 1600]}
        sizes="(max-width: 1440px) 100vw, 1380px"
        class="cover"
      />
    )
  }

  {
    tab === 'food-drinks' &&
      (vendors.length ? (
        <div class="vendors">
          {vendors.map((v: any) => (
            <article class="vendor">
              <h2 class="name">
                {v.url ? (
                  <a href={v.url} target="_blank" rel="noopener noreferrer">
                    {v.name}&nbsp;<span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  v.name
                )}
              </h2>
              {v.subtitle && <p class="subtitle" {...styleAttrs(v.subtitleStyle)}>{v.subtitle}</p>}
              {v.images?.length > 0 ? (
                <Slideshow images={v.images} aspect={3 / 2} sizes="(max-width: 800px) 100vw, 670px" class="vendor-slides" />
              ) : (
                <Figure pool="fair" seed={v._id} aspect={3 / 2} sizes="(max-width: 800px) 100vw, 670px" widths={[670, 1000, 1340]} alt="" class="vendor-ph" />
              )}
              {v.description && (
                <div class="body-24 text">
                  <PortableText value={v.description} fieldStyle={v.descriptionStyle} />
                </div>
              )}
              {v.instagram && (
                <p class="pills">
                  <LinkPill lang={lang} href={instagramUrl(v.instagram)} label={t('common.instagram')} />
                </p>
              )}
            </article>
          ))}
        </div>
      ) : (
        <p class="empty">{t('partners.empty')}</p>
      ))
  }

  {
    tab === 'floor-plan' &&
      (edition?.fairMapUrl ? (
        <p class="cta">
          <LinkPill lang={lang} href={edition.fairMapUrl} label={t('visit.downloadMap')} variant="solid" />
        </p>
      ) : (
        <p class="empty">No floor plan on the current edition yet.</p>
      ))
  }

  {
    tab === 'faq' &&
      (settings?.faq?.length ? (
        <div class="faq-list">
          {settings.faq.map((q: any) => (
            <details class="faq">
              <summary>
                <span class="question" {...styleAttrs(q.questionStyle)}>{q.question}</span>
                <span class="arrow" aria-hidden="true">
                  ↓
                </span>
              </summary>
              <div class="body-24 answer">
                <PortableText value={q.answer} fieldStyle={q.answerStyle} />
              </div>
            </details>
          ))}
        </div>
      ) : (
        <p class="empty">No questions in Site settings yet.</p>
      ))
  }

  {page && <PageSections lang={lang} sections={page.sections} />}
  {
    page?.body && (
      <div class="body-24 page-body">
        <PortableText value={page.body} fieldStyle={page.bodyStyle} />
      </div>
    )
  }

  {
    gallery.length > 0 && (
      <ul class="image-row">
        {gallery.map((img: any) => (
          <li>
            <SanityImage image={img} aspect={3 / 2} sizes="(max-width: 640px) 100vw, 440px" widths={[440, 880]} />
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  /* Practical info: the design's two 6-column halves. */
  .practical {
    row-gap: 0;
    margin-top: 0.5rem;
  }
  .col-left {
    grid-column: 1 / span 6;
  }
  .col-right {
    grid-column: 7 / span 6;
  }
  .col :global(.hero) {
    width: 100%;
    margin: 0 0 2.5rem;
  }
  .practical-intro {
    margin-bottom: 2.5rem;
  }

  .panel {
    margin: 0 0 3rem;
  }
  .panel .panel-title {
    margin-bottom: 1rem;
  }
  .panel .body-24 > p {
    margin: 0;
  }
  .label {
    font-weight: 600;
    text-transform: uppercase;
  }
  .addr {
    white-space: pre-line;
  }
  .panel .body-24 > p.deal {
    margin-top: 0.5rem;
  }
  .map-link {
    margin: 0.75rem 0 0;
  }

  /* Rows of "LABEL / text", as the hours, access and ticket lists. */
  .rows {
    margin: 0;
  }
  .row {
    margin: 0 0 1.1rem;
  }
  .row:last-child {
    margin-bottom: 0;
  }
  dt {
    font-weight: 600;
    text-transform: uppercase;
  }
  dd {
    margin: 0;
  }
  .access-text {
    white-space: pre-line;
  }
  .slot-time {
    font-variant-numeric: tabular-nums;
  }
  .note-line {
    margin: 1rem 0 0;
    font-size: clamp(0.95rem, 1.2vw, 1.125rem);
    color: var(--ink-2);
  }
  .accessibility {
    margin: 1.1rem 0 0;
  }
  .cta {
    margin: 1.5rem 0 0;
  }

  .cover {
    margin: 0 0 2.5rem;
    width: 100%;
  }

  /* Food & drinks: 2x2 vendor grid, the name doubling as the external link. */
  .vendors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3.5rem 30px;
  }
  .vendor .name {
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.3rem;
    margin: 0 0 1.25rem;
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
    font-weight: 600;
  }
  .vendor .name a {
    text-decoration: none;
  }
  .vendor .name a:hover,
  .vendor .name a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.1em;
  }
  .subtitle {
    margin: -0.75rem 0 1.25rem;
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    letter-spacing: -0.01em;
    color: var(--ink-2);
  }
  .vendor :global(.vendor-slides),
  .vendor :global(.vendor-ph) {
    width: 100%;
    margin: 0 0 1.25rem;
  }
  .text :global(p) {
    margin: 0 0 1em;
  }
  .text :global(p:last-child) {
    margin-bottom: 0;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.25rem 0 0;
  }

  /* FAQ: the same accordion as the programme days. */
  .faq-list {
    margin-top: 1rem;
  }
  .faq {
    border-top: 1px solid var(--ink);
  }
  .faq-list .faq:last-of-type {
    border-bottom: 1px solid var(--ink);
  }
  .faq summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
    cursor: pointer;
    list-style: none;
    font-size: clamp(1.25rem, 2.2vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 600;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .arrow {
    font-size: 0.8em;
    transition: transform 0.2s ease;
  }
  .faq[open] .arrow {
    transform: rotate(180deg);
  }
  .answer {
    padding: 0 0 1.5rem;
    max-width: 62ch;
  }
  .answer :global(p) {
    margin: 0 0 1em;
  }

  .page-body :global(h2) {
    text-transform: lowercase;
    border-bottom: 2px solid var(--ink);
    margin: 3rem 0 1.25rem;
    padding-bottom: 0.2rem;
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
    font-weight: 600;
  }
  .page-body :global(p) {
    margin: 0 0 1.5rem;
    max-width: 62ch;
  }

  .image-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .vendors {
      gap: 2.5rem 16px;
    }
    .image-row {
      gap: 16px;
    }
  }

  @media (max-width: 800px) {
    .col-left,
    .col-right {
      grid-column: 1 / -1;
    }
    /* The intro and the hours read first on a phone. */
    .col-right {
      order: -1;
    }
    .vendors {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .image-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
