---
import Base from '../../../layouts/Base.astro';
import HubNav from '../../../components/HubNav.astro';
import Sections from '../../../components/Sections.astro';
import SanityImage from '../../../components/SanityImage.astro';
import PortableText from '../../../components/PortableText.astro';
import { LOCALE_IDS, type LocaleId } from '../../../lib/locales';
import { useTranslations, formatDay, formatTime, localePath } from '../../../lib/i18n';
import { getHubPages, getProgramme } from '../../../lib/queries';
import { HUBS, hubTabParams, hubTabPath, pageForTab } from '../../../lib/hubs';

/**
 * The programme hub. Tabs: La Cambre (a page), talks / awards / VIP (events
 * of the current edition filtered on `section`, grouped by day).
 */
export function getStaticPaths() {
  return hubTabParams('programme', LOCALE_IDS);
}

const lang = Astro.params.lang as LocaleId;
const tab = (Astro.params.tab as string | undefined) ?? HUBS.programme.tabs[0].slug;
const t = useTranslations(lang);

const [pages, events] = await Promise.all([getHubPages(lang, 'programme'), getProgramme(lang)]);
const page = pageForTab(pages, tab);

const KIND_LABEL: Record<string, string> = {
  'artist-talk': 'Artist Talk',
  roundtable: 'Roundtable',
  talk: 'Talk',
  'book-launch': 'Book launch',
  tour: 'Guided tour',
  workshop: 'Workshop',
  ceremony: 'Award ceremony',
  opening: 'Preview',
};

const section = tab === 'la-cambre' ? 'project' : tab;
const listed = events.filter((e: any) => e.section === section);
const days = [...new Set(listed.map((e: any) => e.startsAt.slice(0, 10)))] as string[];
const path = hubTabPath('programme', tab);
---

<Base lang={lang} title={`${t('nav.programme')} — ${page?.tabLabel ?? tab}`} description={page?.seo?.description ?? page?.intro} path={path} editId={page?._id} editType={page?._type}>
  <HubNav lang={lang} route="programme" active={tab} pages={pages} />

  {page?.intro && <p class="lede">{page.intro}</p>}
  {page && <Sections lang={lang} sections={page.sections} />}
  {
    page?.body && (
      <div class="prose">
        <PortableText value={page.body} />
      </div>
    )
  }

  {
    days.length > 0 ? (
      days.map((day, i) => (
        <details class="day" open={i === 0}>
          <summary>
            <span>{formatDay(day, lang)}</span>
            <span aria-hidden="true">↓</span>
          </summary>
          <ul class="events">
            {listed
              .filter((e: any) => e.startsAt.startsWith(day))
              .map((e: any, j: number) => (
                <li class:list={['event', { flip: j % 2 === 1 }]}>
                  <div>
                    <p class="event-head">
                      <span class="kind">{e.kind && `{ ${KIND_LABEL[e.kind] ?? e.kind} }`}</span>
                      <span class="time">
                        {formatTime(e.startsAt, lang)}
                        {e.endsAt && ` – ${formatTime(e.endsAt, lang)}`}
                      </span>
                    </p>
                    <h3>{e.title}</h3>
                    <p class="meta">
                      {e.languages?.length > 0 && <span>{e.languages.join(', ')} </span>}
                      {e.speakersText ?? (e.speakers?.length > 0 && `${t('programme.speakers')} ${e.speakers.map((s: any) => s.name).join(', ')}`)}
                      {e.moderator && ` · ${e.moderator}`}
                      {e.location && ` · ${e.location}`}
                      {e.invitationOnly && ` · ${t('visit.invitation')}`}
                    </p>
                    {e.description && (
                      <div class="prose">
                        <PortableText value={e.description} />
                      </div>
                    )}
                  </div>
                  {e.image?.asset && <SanityImage image={e.image} aspect={3 / 2} sizes="200px" widths={[200, 400]} class="thumb" />}
                </li>
              ))}
          </ul>
        </details>
      ))
    ) : tab !== 'la-cambre' ? (
      <p class="empty">{t('programme.empty')}</p>
    ) : null
  }
</Base>

<style>
  .day {
    border-top: 1px solid var(--ink);
  }
  .day summary {
    display: flex;
    justify-content: space-between;
    font-size: 1.6rem;
    padding: 0.8rem 0;
    cursor: pointer;
    list-style: none;
  }
  .day summary::-webkit-details-marker {
    display: none;
  }
  .day[open] summary span:last-child {
    transform: rotate(180deg);
  }
  .events {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
  }
  .event {
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: 2rem;
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
  }
  .event.flip :global(.thumb) {
    order: -1;
  }
  .event-head {
    display: flex;
    justify-content: space-between;
    font-weight: 600;
    margin: 0;
  }
  .event h3 {
    margin: 0.3rem 0;
    font-weight: 400;
    font-size: 1.3rem;
  }
</style>
