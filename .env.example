# Safe to expose - these ship in the client bundle and identify a public dataset.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Canonical origin. Used for canonical tags, hreflang and the sitemap.
PUBLIC_SITE_URL=https://www.ceramic.brussels

# Show "Edit" links on a deployed build. Leave unset for production; set it to
# "true" on a staging domain so editors can jump into the Studio from any page.
PUBLIC_SHOW_EDIT_LINKS=

# SECRET. Server-side only - never rename this to PUBLIC_*.
# The `production` dataset is ACL-public, so reads do NOT need this token, and
# it must NOT be added to the Cloudflare build environment.
# It is only used locally by scripts/seed.mjs and scripts/create-deploy-webhook.mjs.
SANITY_API_WRITE_TOKEN=

# SECRET. Read-only Sanity token (role: viewer) the /preview routes read drafts
# with. On Cloudflare it is a Pages secret, set in the dashboard for each
# environment; here it only matters if you run the preview runtime locally.
SANITY_VIEWER_TOKEN=

# Build switch for the preview runtime (Cloudflare adapter + /preview and /api
# on a Worker). wrangler.toml sets it per environment on Pages; leave it unset
# on a laptop unless workerd runs there. See astro.config.mjs.
PREVIEW_RUNTIME=
PUBLIC_PREVIEW_ENABLED=
